name: Two-stage timer demonstration
status: idle
startedAt: 0
firstFiredAt: 0
secondFiredAt: 0
firstCount: 0
secondCount: 0
contracts:
  owner:
    type: Coordination / Timeline Channel
    timeline: {timelineId: time-demo}
    actor: {accountId: owner}
  clock:
    type: Time / Timer Channel
  start:
    type: Contracts / Sequential Workflow Operation
    channel: owner
    steps:
      - type: Contracts / Compute
        do:
          - $failIf:
              cond: {$ne: [{$document: /status}, idle]}
              message: This demonstration has already started.
          - $appendChange: {op: replace, path: /status, val: started}
          - $appendChange: {op: replace, path: /startedAt, val: {$binding: timestamp}}
      - type: Time / Schedule Timer
        request:
          channel: clock
          key: first
          timestamp: {$add: [{$binding: timestamp}, 15000000]}
  first:
    type: Contracts / Sequential Workflow
    channel: clock
    event: {request: {key: first}}
    steps:
      - type: Contracts / Compute
        do:
          - $appendChange: {op: replace, path: /status, val: first-completed}
          - $appendChange: {op: replace, path: /firstFiredAt, val: {$binding: timestamp}}
          - $appendChange: {op: replace, path: /firstCount, val: {$add: [{$document: /firstCount}, 1]}}
          - $appendEvent: {kind: First timer completed}
      - type: Time / Schedule Timer
        request:
          channel: clock
          key: second
          timestamp: {$add: [{$binding: timestamp}, 20000000]}
  second:
    type: Contracts / Sequential Workflow
    channel: clock
    event: {request: {key: second}}
    steps:
      - type: Contracts / Compute
        do:
          - $appendChange: {op: replace, path: /status, val: completed}
          - $appendChange: {op: replace, path: /secondFiredAt, val: {$binding: timestamp}}
          - $appendChange: {op: replace, path: /secondCount, val: {$add: [{$document: /secondCount}, 1]}}
          - $appendEvent: {kind: Second timer completed}
  cancel:
    type: Contracts / Sequential Workflow Operation
    channel: owner
    steps:
      - type: Time / Cancel Timer
        request: {channel: clock, key: first}
      - type: Time / Cancel Timer
        request: {channel: clock, key: second}
