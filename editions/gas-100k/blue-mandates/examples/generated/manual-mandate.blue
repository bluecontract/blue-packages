{
  "contracts": {
    "acknowledgeOrderApproval": {
      "channel": "authorityHolderChannel",
      "request": {},
      "steps": [
        {
          "do": [
            {
              "$failIf": {
                "cond": {
                  "$ne": [
                    {
                      "$document": "/status"
                    },
                    "Active"
                  ]
                },
                "message": "NOT_ACTIVE"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$ne": [
                    {
                      "$document": "/stage"
                    },
                    "ApprovalEnabled"
                  ]
                },
                "message": "WRONG_STAGE"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$ne": [
                    {
                      "$keys": {
                        "$binding": "call/request"
                      }
                    },
                    []
                  ]
                },
                "message": "EMPTY_REQUEST"
              }
            },
            {
              "$appendChange": {
                "op": "replace",
                "path": "/scope",
                "val": {
                  "release": {
                    "$document": "/grantTemplates/release"
                  }
                }
              }
            },
            {
              "$appendChange": {
                "op": "replace",
                "path": "/stage",
                "val": "ReleaseEnabled"
              }
            }
          ],
          "type": {
            "blueId": "92eWpSLhfvP2TDsSzZiVVh5ue4hdZTZHDm1Foft3SeLp"
          }
        }
      ],
      "type": {
        "blueId": "7EzGCoMRkPtknVU2JeL4TeswL2T57YGp9XUrJHU9LCra"
      }
    },
    "authorityHolderChannel": {
      "actor": {
