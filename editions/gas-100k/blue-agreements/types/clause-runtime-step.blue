{
  "name": "Clause Runtime Step",
  "type": "Contracts/Compute",
  "functions": {
    "resolveFill": {
      "args": {
        "spec": {},
        "bindings": {},
        "params": {}
      },
      "expr": {
        "$choose": {
          "cond": {
            "$hasKey": {
              "object": {
                "$var": "spec"
              },
              "key": "binding"
            }
          },
          "then": {
            "$choose": {
              "cond": {
                "$eq": [
                  {
                    "$pointerGet": {
                      "object": {
                        "$var": "spec"
                      },
                      "path": "/asKey",
                      "default": false
                    }
                  },
                  true
                ]
              },
              "then": {
                "$sliceAfter": [
                  {
                    "$get": {
                      "object": {
                        "$var": "bindings"
                      },
                      "key": {
                        "$var": {
                          "name": "spec",
                          "path": "/binding"
                        }
                      }
                    }
                  },
                  "/contracts/"
                ]
              },
              "else": {
                "$get": {
                  "object": {
                    "$var": "bindings"
                  },
                  "key": {
                    "$var": {
                      "name": "spec",
                      "path": "/binding"
                    }
                  }
                }
              }
            }
          },
          "else": {
            "$choose": {
              "cond": {
                "$hasKey": {
                  "object": {
                    "$var": "spec"
                  },
                  "key": "parameter"
                }
              },
              "then": {
                "$get": {
                  "object": {
                    "$var": "params"
                  },
                  "key": {
                    "$var": {
                      "name": "spec",
                      "path": "/parameter"
                    }
                  }
                }
              },
              "else": {
                "$var": {
                  "name": "spec",
                  "path": "/literal"
                }
              }
            }
          }
        }
      }
    },
    "install": {
      "do": [
        {
          "$if": {
            "cond": {
              "$eq": [
                {
                  "$document": "/clauseRuntime/amending"
                },
                true
              ]
            },
            "then": [
              {
                "$return": {}
              }
            ]
          }
        },
        {
          "$failIf": {
            "cond": {
              "$not": {
                "$isKind": {
                  "val": {
                    "$document": "/clauses"
                  },
                  "kind": "object"
                }
              }
            },
            "message": "CLAUSES_MUST_BE_OBJECT"
          }
        },
        {
          "$failIf": {
            "cond": {
              "$not": {
                "$isKind": {
                  "val": {
                    "$document": "/parameters"
                  },
                  "kind": "object"
                }
              }
            },
            "message": "PARAMETERS_MUST_BE_OBJECT"
          }
        },
        {
          "$let": {
            "name": "old",
            "expr": {
              "$choose": {
                "cond": {
                  "$exists": {
                    "$document": "/clauseRuntime"
                  }
                },
                "then": {
                  "$document": "/clauseRuntime"
                },
                "else": {
                  "$literal": {
                    "contracts": {},
                    "states": {},
                    "entries": {},
                    "revision": 0,
                    "configId": ""
                  }
                }
              }
            }
          }
        },
        {
          "$let": {
            "name": "oldStates",
            "expr": {
              "$pointerGet": {
                "object": {
                  "$var": "old"
                },
                "path": "/states",
                "default": {
                  "$emptyObject": true
                }
              }
            }
          }
        },
        {
          "$let": {
            "name": "oldBindings",
            "expr": {
              "$emptyObject": true
            }
          }
        },
        {
          "$forEach": {
            "in": {
              "$keys": {
                "$var": "oldStates"
              }
            },
            "item": "oldPath",
            "do": [
              {
                "$let": {
                  "name": "os",
                  "expr": {
                    "$get": {
                      "object": {
                        "$var": "oldStates"
                      },
                      "key": {
                        "$var": "oldPath"
                      }
                    }
                  }
                }
              },
              {
                "$set": {
                  "name": "oldBindings",
                  "expr": {
                    "$objectSet": {
                      "object": {
                        "$var": "oldBindings"
                      },
                      "key": {
                        "$concat": [
                          {
                            "$var": {
                              "name": "os",
                              "path": "/owner"
                            }
                          },
                          "/",
                          {
                            "$var": {
                              "name": "os",
                              "path": "/binding"
                            }
                          }
                        ]
                      },
                      "val": {
                        "$var": "oldPath"
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "$let": {
            "name": "configurations",
            "expr": {
              "$emptyObject": true
            }
          }
        },
        {
          "$forEach": {
            "in": {
              "$keys": {
                "$document": "/clauses"
              }
            },
            "item": "configKey",
            "do": [
              {
                "$set": {
                  "name": "configurations",
                  "expr": {
                    "$objectSet": {
                      "object": {
                        "$var": "configurations"
                      },
                      "key": {
                        "$var": "configKey"
                      },
                      "val": {
                        "typeId": {
                          "$nodeBlueId": {
                            "$document": {
                              "$concat": [
                                "/clauses/",
                                {
                                  "$var": "configKey"
                                },
                                "/type"
                              ]
                            }
                          }
                        },
                        "parameters": {
                          "$document": {
                            "$concat": [
                              "/clauses/",
                              {
                                "$var": "configKey"
                              },
                              "/parameters"
                            ]
                          }
                        },
                        "bindings": {
                          "$document": {
                            "$concat": [
                              "/clauses/",
                              {
                                "$var": "configKey"
                              },
                              "/bindings"
                            ]
                          }
                        },
                        "text": {
                          "$pointerGet": {
                            "object": {
                              "$document": {
                                "$concat": [
                                  "/clauses/",
                                  {
                                    "$var": "configKey"
                                  }
                                ]
                              }
                            },
                            "path": "/text",
                            "default": ""
                          }
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "$let": {
            "name": "configId",
            "expr": {
              "$nodeBlueId": {
                "clauses": {
                  "$var": "configurations"
                },
                "parameters": {
                  "$document": "/parameters"
                },
                "channels": {
                  "$document": "/channels"
                }
              }
            }
          }
        },
        {
          "$if": {
            "cond": {
              "$eq": [
                {
                  "$var": "configId"
                },
                {
                  "$pointerGet": {
                    "object": {
                      "$var": "old"
                    },
                    "path": "/configId",
                    "default": ""
                  }
                }
              ]
            },
            "then": [
              {
                "$return": {}
              }
            ]
          }
        },
        {
          "$forEach": {
            "in": {
              "$keys": {
                "$pointerGet": {
                  "object": {
                    "$var": "old"
                  },
                  "path": "/entries",
                  "default": {
                    "$emptyObject": true
                  }
                }
              }
            },
            "item": "oldClause",
            "do": [
              {
                "$let": {
                  "name": "entry",
                  "expr": {
                    "$get": {
                      "object": {
                        "$pointerGet": {
                          "object": {
                            "$var": "old"
                          },
                          "path": "/entries",
                          "default": {
                            "$emptyObject": true
                          }
                        }
                      },
                      "key": {
                        "$var": "oldClause"
                      }
                    }
                  }
                }
              },
              {
                "$forEach": {
                  "in": {
                    "$pointerGet": {
                      "object": {
                        "$var": "entry"
                      },
                      "path": "/freezePaths",
                      "default": {
                        "$emptyList": true
                      }
                    }
                  },
                  "item": "fp",
                  "do": [
                    {
                      "$failIf": {
                        "cond": {
                          "$eq": [
                            {
                              "$document": {
                                "$var": "fp"
                              }
                            },
                            true
                          ]
                        },
                        "message": "CONFIGURATION_FROZEN"
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "$forEach": {
            "in": {
              "$literal": [
                "_life",
                "_initializeClauses",
                "_clauseChanges",
                "_parameterChanges",
                "_reconcileClauses",
                "_reconcileParameters",
                "_installation"
              ]
            },
            "item": "seed",
            "do": [
              {
                "$failIf": {
                  "cond": {
                    "$not": {
                      "$eq": [
                        {
                          "$nodeBlueId": {
                            "$document": {
                              "$concat": [
                                "/contracts/",
                                {
                                  "$var": "seed"
                                }
                              ]
                            }
                          }
                        },
                        {
                          "$nodeBlueId": {
                            "$document": {
                              "$concat": [
                                "/type/contracts/",
                                {
                                  "$var": "seed"
                                }
                              ]
                            }
                          }
                        }
                      ]
                    }
                  },
                  "message": "BOOTSTRAP_OVERRIDE"
                }
              }
            ]
          }
        },
        {
          "$let": {
            "name": "wanted",
            "expr": {
              "$emptyObject": true
            }
          }
        },
        {
          "$let": {
            "name": "categories",
            "expr": {
              "$emptyObject": true
            }
          }
        },
        {
          "$let": {
            "name": "owners",
            "expr": {
              "$emptyObject": true
            }
          }
        },
        {
          "$let": {
            "name": "states",
            "expr": {
              "$emptyObject": true
            }
          }
        },
        {
          "$let": {
            "name": "entries",
            "expr": {
              "$emptyObject": true
            }
          }
        },
        {
          "$forEach": {
            "in": {
              "$literal": [
                "A",
                "B"
              ]
            },
            "item": "side",
            "do": [
              {
                "$set": {
                  "name": "wanted",
                  "expr": {
                    "$objectSet": {
                      "object": {
                        "$var": "wanted"
                      },
                      "key": {
                        "$concat": [
                          "/contracts/amend",
                          {
                            "$var": "side"
                          }
                        ]
                      },
                      "val": {
                        "$get": {
                          "object": {
                            "$document": "/type/amendTemplates"
                          },
                          "key": {
                            "$var": "side"
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "$set": {
                  "name": "categories",
                  "expr": {
                    "$objectSet": {
                      "object": {
                        "$var": "categories"
                      },
                      "key": {
                        "$concat": [
                          "/contracts/amend",
                          {
                            "$var": "side"
                          }
                        ]
                      },
                      "val": "handler"
                    }
                  }
                }
              },
              {
                "$set": {
                  "name": "owners",
                  "expr": {
                    "$objectSet": {
                      "object": {
                        "$var": "owners"
                      },
                      "key": {
                        "$concat": [
                          "/contracts/amend",
                          {
                            "$var": "side"
                          }
                        ]
                      },
                      "val": "@framework"
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "$forEach": {
            "in": {
              "$literal": [
                "A",
                "B"
              ]
            },
            "item": "side",
            "do": [
              {
                "$let": {
                  "name": "ch",
                  "expr": {
                    "$document": {
                      "$concat": [
                        "/channels/",
                        {
                          "$var": "side"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "$failIf": {
                  "cond": {
                    "$not": {
                      "$exists": {
                        "$var": "ch"
                      }
                    }
                  },
                  "message": "PARTY_CHANNEL_REQUIRED"
                }
              },
              {
                "$set": {
                  "name": "wanted",
                  "expr": {
                    "$objectSet": {
                      "object": {
                        "$var": "wanted"
                      },
                      "key": {
                        "$concat": [
                          "/contracts/party",
                          {
                            "$var": "side"
                          }
                        ]
                      },
                      "val": {
                        "$var": "ch"
                      }
                    }
                  }
                }
              },
              {
                "$set": {
                  "name": "categories",
                  "expr": {
                    "$objectSet": {
                      "object": {
                        "$var": "categories"
                      },
                      "key": {
                        "$concat": [
                          "/contracts/party",
                          {
                            "$var": "side"
                          }
                        ]
                      },
                      "val": "channel"
                    }
                  }
                }
              },
              {
                "$set": {
                  "name": "owners",
                  "expr": {
                    "$objectSet": {
                      "object": {
                        "$var": "owners"
                      },
                      "key": {
                        "$concat": [
                          "/contracts/party",
                          {
                            "$var": "side"
                          }
                        ]
                      },
                      "val": "@channels"
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "$failIf": {
            "cond": {
              "$not": {
                "$ne": [
                  {
                    "$nodeBlueId": {
                      "$document": "/channels/A"
                    }
                  },
                  {
                    "$nodeBlueId": {
                      "$document": "/channels/B"
                    }
                  }
                ]
              }
            },
            "message": "PARTIES_REQUIRE_DISTINCT_CHANNELS"
          }
        },
        {
          "$if": {
            "cond": {
              "$and": [
                {
                  "$exists": {
                    "$document": "/channels/A/actor"
                  }
                },
                {
                  "$exists": {
                    "$document": "/channels/B/actor"
                  }
                }
              ]
            },
            "then": [
              {
                "$failIf": {
                  "cond": {
                    "$not": {
                      "$ne": [
                        {
                          "$nodeBlueId": {
                            "$document": "/channels/A/actor"
                          }
                        },
                        {
                          "$nodeBlueId": {
                            "$document": "/channels/B/actor"
                          }
                        }
                      ]
                    }
                  },
                  "message": "PARTIES_REQUIRE_DISTINCT_ACTORS"
                }
              }
            ]
          }
        },
        {
          "$forEach": {
            "in": {
              "$keys": {
                "$document": "/clauses"
              }
            },
            "item": "clauseKey",
            "do": [
              {
                "$failIf": {
                  "cond": {
                    "$not": {
                      "$and": [
                        {
                          "$isKind": {
                            "val": {
                              "$var": "clauseKey"
                            },
                            "kind": "text"
                          }
                        },
                        {
                          "$ne": [
                            {
                              "$var": "clauseKey"
                            },
                            ""
                          ]
                        },
                        {
                          "$eq": [
                            {
                              "$size": {
                                "$split": {
                                  "text": {
                                    "$var": "clauseKey"
                                  },
                                  "separator": "/"
                                }
                              }
                            },
                            1
                          ]
                        },
                        {
                          "$eq": [
                            {
                              "$size": {
                                "$split": {
                                  "text": {
                                    "$var": "clauseKey"
                                  },
                                  "separator": "~"
                                }
                              }
                            },
                            1
                          ]
                        }
                      ]
                    }
                  },
                  "message": "CLAUSE_KEY_MUST_BE_SIMPLE"
                }
              },
              {
                "$let": {
                  "name": "clause",
                  "expr": {
                    "$get": {
                      "object": {
                        "$document": "/clauses"
                      },
                      "key": {
                        "$var": "clauseKey"
                      }
                    }
                  }
                }
              },
              {
                "$let": {
                  "name": "clauseType",
                  "expr": {
                    "$nodeBlueId": {
                      "$pointerGet": {
                        "object": {
                          "$var": "clause"
                        },
                        "path": "/type"
                      }
                    }
                  }
                }
              },
              {
                "$failIf": {
                  "cond": {
                    "$not": {
                      "$includes": {
                        "list": {
                          "$document": "/clauseTypes"
                        },
                        "val": {
                          "$var": "clauseType"
                        }
                      }
                    }
                  },
                  "message": "CLAUSE_TYPE_NOT_APPROVED"
                }
              },
              {
                "$let": {
                  "name": "blueprint",
                  "expr": {
                    "$document": {
                      "$concat": [
                        "/clauses/",
                        {
                          "$var": "clauseKey"
                        },
                        "/type"
                      ]
                    }
                  }
                }
              },
              {
                "$let": {
                  "name": "bindings",
                  "expr": {
                    "$pointerGet": {
                      "object": {
                        "$var": "clause"
                      },
                      "path": "/bindings"
                    }
                  }
                }
              },
              {
                "$let": {
                  "name": "params",
                  "expr": {
                    "$emptyObject": true
                  }
                }
              },
              {
                "$let": {
                  "name": "constantParams",
                  "expr": {
                    "$emptyObject": true
                  }
                }
              },
              {
                "$let": {
                  "name": "freezes",
                  "expr": {
                    "$emptyList": true
                  }
                }
              },
              {
                "$failIf": {
                  "cond": {
                    "$not": {
                      "$isKind": {
                        "val": {
                          "$var": "bindings"
                        },
                        "kind": "object"
                      }
                    }
                  },
                  "message": "BINDINGS_REQUIRED"
                }
              },
              {
                "$failIf": {
                  "cond": {
                    "$not": {
                      "$eq": [
                        {
                          "$keys": {
                            "$var": "bindings"
                          }
                        },
                        {
                          "$keys": {
                            "$pointerGet": {
                              "object": {
                                "$var": "blueprint"
                              },
                              "path": "/bindingDefinitions"
                            }
                          }
                        }
                      ]
                    }
                  },
                  "message": "BINDING_NAMES_MISMATCH"
                }
              },
              {
                "$forEach": {
                  "in": {
                    "$keys": {
                      "$pointerGet": {
                        "object": {
                          "$var": "blueprint"
                        },
                        "path": "/bindingDefinitions"
                      }
                    }
                  },
                  "item": "bname",
                  "do": [
                    {
                      "$let": {
                        "name": "bd",
                        "expr": {
                          "$get": {
                            "object": {
                              "$pointerGet": {
                                "object": {
                                  "$var": "blueprint"
                                },
                                "path": "/bindingDefinitions"
                              }
                            },
                            "key": {
                              "$var": "bname"
                            }
                          }
                        }
                      }
                    },
                    {
                      "$let": {
                        "name": "bp",
                        "expr": {
                          "$get": {
                            "object": {
                              "$var": "bindings"
                            },
                            "key": {
                              "$var": "bname"
                            }
                          }
                        }
                      }
                    },
                    {
                      "$if": {
                        "cond": {
                          "$eq": [
                            {
                              "$var": "bd"
                            },
                            "contract"
                          ]
                        },
                        "then": [
                          {
                            "$failIf": {
                              "cond": {
                                "$not": {
                                  "$and": [
                                    {
                                      "$isKind": {
                                        "val": {
                                          "$var": "bp"
                                        },
                                        "kind": "text"
                                      }
                                    },
                                    {
                                      "$startsWith": [
                                        {
                                          "$var": "bp"
                                        },
                                        "/contracts/"
                                      ]
                                    },
                                    {
                                      "$and": [
                                        {
                                          "$isKind": {
                                            "val": {
                                              "$sliceAfter": [
                                                {
                                                  "$var": "bp"
                                                },
                                                "/contracts/"
                                              ]
                                            },
                                            "kind": "text"
                                          }
                                        },
                                        {
                                          "$ne": [
                                            {
                                              "$sliceAfter": [
                                                {
                                                  "$var": "bp"
                                                },
                                                "/contracts/"
                                              ]
                                            },
                                            ""
                                          ]
                                        },
                                        {
                                          "$eq": [
                                            {
                                              "$size": {
                                                "$split": {
                                                  "text": {
                                                    "$sliceAfter": [
                                                      {
                                                        "$var": "bp"
                                                      },
                                                      "/contracts/"
                                                    ]
                                                  },
                                                  "separator": "/"
                                                }
                                              }
                                            },
                                            1
                                          ]
                                        },
                                        {
                                          "$eq": [
                                            {
                                              "$size": {
                                                "$split": {
                                                  "text": {
                                                    "$sliceAfter": [
                                                      {
                                                        "$var": "bp"
                                                      },
                                                      "/contracts/"
                                                    ]
                                                  },
                                                  "separator": "~"
                                                }
                                              }
                                            },
                                            1
                                          ]
                                        }
                                      ]
                                    },
                                    {
                                      "$not": {
                                        "$includes": {
                                          "list": {
                                            "$literal": [
                                              "/contracts/_life",
                                              "/contracts/_initializeClauses",
                                              "/contracts/_clauseChanges",
                                              "/contracts/_parameterChanges",
                                              "/contracts/_reconcileClauses",
                                              "/contracts/_reconcileParameters",
                                              "/contracts/_installation",
                                              "/contracts/initialized",
                                              "/contracts/checkpoint",
                                              "/contracts/terminated",
                                              "/contracts/generalization",
                                              "/contracts/embedded",
                                              "/contracts/partyA",
                                              "/contracts/partyB",
                                              "/contracts/amendA",
                                              "/contracts/amendB"
                                            ]
                                          },
                                          "val": {
                                            "$var": "bp"
                                          }
                                        }
                                      }
                                    }
                                  ]
                                }
                              },
                              "message": "INVALID_CONTRACT_BINDING"
                            }
                          }
                        ],
                        "else": [
                          {
                            "$if": {
                              "cond": {
                                "$eq": [
                                  {
                                    "$var": "bd"
                                  },
                                  "state"
                                ]
                              },
                              "then": [
                                {
