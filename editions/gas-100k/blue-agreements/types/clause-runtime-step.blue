                    }
                  },
                  "then": [
                    {
                      "$appendEvent": {
                        "$merge": [
                          {
                            "$literal": {
                              "type": "Agreements/Clause Removed"
                            }
                          },
                          {
                            "kind": "Clause Removed",
                            "clauseKey": {
                              "$var": "changedKey"
                            },
                            "revision": {
                              "$var": "revision"
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "$forEach": {
            "in": {
              "$keys": {
                "$var": "configurations"
              }
            },
            "item": "changedKey",
            "do": [
              {
                "$if": {
                  "cond": {
                    "$not": {
                      "$hasKey": {
                        "object": {
                          "$pointerGet": {
                            "object": {
                              "$var": "old"
                            },
                            "path": "/configurations",
                            "default": {
                              "$emptyObject": true
                            }
                          }
                        },
                        "key": {
                          "$var": "changedKey"
                        }
                      }
                    }
                  },
                  "then": [
                    {
                      "$appendEvent": {
                        "$merge": [
                          {
                            "$literal": {
                              "type": "Agreements/Clause Added"
                            }
                          },
                          {
                            "kind": "Clause Added",
                            "clauseKey": {
                              "$var": "changedKey"
                            },
                            "revision": {
                              "$var": "revision"
                            }
                          }
                        ]
                      }
                    }
                  ],
                  "else": [
                    {
                      "$if": {
                        "cond": {
                          "$ne": [
                            {
                              "$nodeBlueId": {
                                "$get": {
                                  "object": {
                                    "$var": "configurations"
                                  },
                                  "key": {
                                    "$var": "changedKey"
                                  }
                                }
                              }
                            },
                            {
                              "$nodeBlueId": {
                                "$get": {
                                  "object": {
                                    "$pointerGet": {
                                      "object": {
                                        "$var": "old"
                                      },
                                      "path": "/configurations",
                                      "default": {
                                        "$emptyObject": true
                                      }
                                    }
                                  },
                                  "key": {
                                    "$var": "changedKey"
                                  }
                                }
                              }
                            }
                          ]
                        },
                        "then": [
                          {
                            "$appendEvent": {
                              "$merge": [
                                {
                                  "$literal": {
                                    "type": "Agreements/Clause Edited"
                                  }
                                },
                                {
                                  "kind": "Clause Edited",
                                  "clauseKey": {
                                    "$var": "changedKey"
                                  },
                                  "revision": {
                                    "$var": "revision"
                                  }
                                }
                              ]
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "$appendEvent": {
            "$merge": [
              {
                "$literal": {
                  "type": "Agreements/Clauses Installed"
                }
              },
              {
                "kind": "Clauses Installed",
                "revision": {
                  "$var": "revision"
                },
                "configurationId": {
                  "$var": "configId"
                }
              }
            ]
          }
        }
      ]
    },
    "initialize": {
      "do": [
        {
          "$failIf": {
            "cond": {
              "$not": {
                "$not": {
                  "$exists": {
                    "$document": "/clauseRuntime"
                  }
                }
              }
            },
            "message": "PRESEEDED_RUNTIME_NOT_ALLOWED"
          }
        },
        {
          "$if": {
            "cond": {
              "$and": [
                {
                  "$eq": [
                    {
                      "$size": {
                        "$keys": {
                          "$document": "/clauses"
                        }
                      }
                    },
                    0
                  ]
                },
                {
                  "$ne": [
                    {
                      "$size": {
                        "$keys": {
                          "$document": "/initialClauses"
                        }
                      }
                    },
                    0
                  ]
                }
              ]
            },
            "then": [
              {
                "$appendChange": {
                  "op": "add",
                  "path": "/clauses",
                  "val": {
                    "$objectSet": {
                      "object": {
                        "$emptyObject": true
                      },
                      "key": "blueId",
                      "val": {
                        "$nodeBlueId": {
                          "$document": "/initialClauses"
                        }
                      }
                    }
                  }
                }
              }
            ],
            "else": [
              {
                "$call": {
                  "function": "install",
                  "args": {}
                }
              }
            ]
          }
        }
      ]
    }
  }
}
