name: Cancel Purchase Step
type: Contracts/Compute
do:
- $if:
    cond:
      $ne:
      - $document: /purchase/status
      - pending
    then:
    - $return: {}
- $appendChange:
    op: add
    path: /purchase
    val:
      status: cancelled
      confirmations: 0
- $appendEvent:
    $merge:
    - type: Orders/Order Cancelled
    - orderId:
        $document: /orderId
      documentId:
        $nodeBlueId:
          $document: /contracts/initialized/document
      reason: purchase_deadline
