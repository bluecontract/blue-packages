name: Purchase Step
type: Contracts/Compute
constants: {}
do:
- $if:
    cond:
      $ne:
      - $document: /purchase/status
      - pending
    then:
    - $appendEvent:
        $merge:
        - type: Clauses/Business Operation Rejected
        - code: ORDER_NOT_PENDING
    - $return: {}
- $if:
    cond:
      $gte:
      - $binding: timestamp
      - $add:
        - $document: /startedAt
        - $const: durationMicros
    then:
    - $appendEvent:
        $merge:
        - type: Clauses/Business Operation Rejected
        - code: PURCHASE_DEADLINE_PASSED
    - $return: {}
- $let:
    name: product
    expr:
      $document:
        $const: product
- $if:
    cond:
      $not:
        $and:
        - $isKind:
            val:
              $var:
                name: product
                path: /amountMinor
            kind: integer
        - $gte:
          - $var:
              name: product
              path: /amountMinor
          - 1
        - $lte:
          - $var:
              name: product
              path: /amountMinor
          - 1000000000000
    then:
    - $appendEvent:
        $merge:
        - type: Clauses/Business Operation Rejected
        - code: INVALID_PURCHASE_AMOUNT
    - $return: {}
- $appendChange:
    op: add
    path: /purchase
    val:
      status: confirmed
      confirmations: 1
- $appendEvent:
    $merge:
    - type: Orders/Purchase Confirmed
    - orderId:
        $document: /orderId
      documentId:
        $nodeBlueId:
          $document: /contracts/initialized/document
      amountMinor:
        $var:
          name: product
          path: /amountMinor
      currency:
        $var:
          name: product
          path: /currency
      status: confirmed
