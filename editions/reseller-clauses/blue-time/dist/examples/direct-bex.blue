# Alternative to the Schedule Timer step. Add this field to the document:
# requestTemplate:
#   type: Time / Timer Request
#   channel: clock
#   timestamp: 0
# A stored request is inactive until emitted. This step uses its exact type
# reference while constructing the evaluated request as ordinary BEX data.
type: Contracts / Compute
do:
  - $appendEvent:
      $objectSet:
        object:
          channel: clock
          key: first
          timestamp: {$add: [{$binding: timestamp}, 15000000]}
        key: type
        val: {$document: /requestTemplate/type}
