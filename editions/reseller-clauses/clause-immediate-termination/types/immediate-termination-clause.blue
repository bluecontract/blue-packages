description: Allows configured participants to terminate an active document with a
  reason.
name: Immediate Termination Clause
templates:
  terminate:
    constants:
      activationPath: ''
      actorChannel: ''
      statePath: ''
    do:
    - $let:
        expr:
          $document:
            $const: statePath
        name: s
    - $if:
        cond:
          $var:
            name: s
            path: /terminated
        then:
        - $appendEvent:
            $merge:
            - type: Clauses/Business Operation Rejected
            - code: ALREADY_TERMINATED
        - $return: {}
    - $if:
        cond:
          $not:
            $pointerGet:
              default: false
              object:
                $document:
                  $const: activationPath
              path: /active
        then:
        - $appendEvent:
            $merge:
            - type: Clauses/Business Operation Rejected
            - code: DOCUMENT_NOT_ACTIVE
        - $return: {}
    - $let:
        expr:
          $binding: call/request/reason
        name: reason
    - $if:
        cond:
          $or:
          - $not:
              $isKind:
                kind: text
                val:
                  $var: reason
          - $eq:
            - $var: reason
            - ''
        then:
        - $appendEvent:
            $merge:
            - type: Clauses/Business Operation Rejected
            - code: TERMINATION_REASON_REQUIRED
        - $return: {}
    - $appendChange:
        op: add
        path:
          $const: statePath
        val:
          actorChannel:
            $const: actorChannel
          reason:
            $var: reason
          terminated: true
    - $appendEvent:
        $merge:
        - type: ImmediateTermination/Document Terminated
        - reason:
            $var: reason
    type: Contracts/Compute
type: Clauses/Clause
hookDefinition:
  type: Contracts/Compute Definition
  functions:
    plan:
      args: {}
      do:
      - $let:
          expr: {}
          name: contributions
      - $forEach:
          do:
          - $set:
              expr:
                $objectSet:
                  object:
                    $var: contributions
                  key:
                    $var: operation
                  val:
                    contract:
                      $merge:
                      - type: Contracts/Sequential Workflow Operation
                      - channel:
                          $get:
                            key:
                              $var: operation
                            object:
                              $pointerGet:
                                object:
                                  $pointerGet:
                                    default: {}
                                    object:
                                      $document: /clauseRuntime/work/candidate
                                    path:
                                      $concat:
                                      - /
                                      - $const: clauseKey
                                path: /parameters/operations
                        steps:
                        - $objectSet:
                            object:
                              $pointerGet:
                                object:
                                  $document:
                                    $concat:
                                    - $choose:
                                        cond:
                                          $eq:
                                          - $const: mode
                                          - configuration
                                        then: /clauseRuntime/work/candidate/
                                        else: /clauses/
                                    - $const: clauseKey
                                    - /type
                                path: /templates/terminate
                            key: constants
                            val:
                              activationPath:
                                $pointerGet:
                                  object:
                                    $pointerGet:
                                      default: {}
                                      object:
                                        $document: /clauseRuntime/work/candidate
                                      path:
                                        $concat:
                                        - /
                                        - $const: clauseKey
                                  path: /bindings/activation
                              actorChannel:
                                $get:
                                  key:
                                    $var: operation
                                  object:
                                    $pointerGet:
                                      object:
                                        $pointerGet:
                                          default: {}
                                          object:
                                            $document: /clauseRuntime/work/candidate
                                          path:
                                            $concat:
                                            - /
                                            - $const: clauseKey
                                      path: /parameters/operations
                              statePath:
                                $pointerGet:
                                  object:
                                    $pointerGet:
                                      default: {}
                                      object:
                                        $document: /clauseRuntime/work/candidate
                                      path:
                                        $concat:
                                        - /
                                        - $const: clauseKey
                                  path: /bindings/state
                    kind: handler
              name: contributions
          in:
            $keys:
              $pointerGet:
                object:
                  $pointerGet:
                    default: {}
                    object:
                      $document: /clauseRuntime/work/candidate
                    path:
                      $concat:
                      - /
                      - $const: clauseKey
                path: /parameters/operations
          item: operation
      - $return:
          contracts:
            $var: contributions
          reads:
          - kind: object
            path:
              $pointerGet:
                object:
                  $pointerGet:
                    default: {}
                    object:
                      $document: /clauseRuntime/work/candidate
                    path:
                      $concat:
                      - /
                      - $const: clauseKey
                path: /bindings/activation
          states:
            state:
              initial:
                actorChannel: ''
                reason: ''
                terminated: false
              kind: object
              path:
                $pointerGet:
                  object:
                    $pointerGet:
                      default: {}
                      object:
                        $document: /clauseRuntime/work/candidate
                      path:
                        $concat:
                        - /
                        - $const: clauseKey
                  path: /bindings/state
    validateConfiguration:
      args: {}
      do:
      - $if:
          cond:
            $or:
            - $not:
                $isKind:
                  kind: object
                  val:
                    $pointerGet:
                      object:
                        $pointerGet:
                          default: {}
                          object:
                            $document: /clauseRuntime/work/candidate
                          path:
                            $concat:
                            - /
                            - $const: clauseKey
                      path: /parameters/operations
            - $eq:
              - $size:
                  $keys:
                    $pointerGet:
                      object:
                        $pointerGet:
                          default: {}
                          object:
                            $document: /clauseRuntime/work/candidate
                          path:
                            $concat:
                            - /
                            - $const: clauseKey
                      path: /parameters/operations
              - 0
          then:
          - $return:
              allowed: false
              code: TERMINATION_OPERATIONS_REQUIRED
      - $if:
          cond:
            $ne:
            - $keys:
                $pointerGet:
                  object:
                    $pointerGet:
                      default: {}
                      object:
                        $document: /clauseRuntime/work/candidate
                      path:
                        $concat:
                        - /
                        - $const: clauseKey
                  path: /bindings
            - $literal:
              - activation
              - state
          then:
          - $return:
              allowed: false
              code: TERMINATION_BINDING_FIELDS
      - $return:
          allowed: true
          code: ''
    validateTransition:
      args: {}
      do:
      - $if:
          cond:
            $and:
            - $eq:
              - $pointerGet:
                  default: false
                  object:
                    $document:
                      $pointerGet:
                        object:
                          $choose:
                            cond:
                              $document: /clauseRuntime/work/initializing
                            then: {}
                            else:
                              $pointerGet:
                                object:
                                  $document: /clauses
                                path:
                                  $concat:
                                  - /
                                  - $const: clauseKey
                                default: {}
                        path: /bindings/state
                  path: /terminated
              - true
            - $ne:
              - $nodeBlueId:
                  $choose:
                    cond:
                      $document: /clauseRuntime/work/initializing
                    then: {}
                    else:
                      $document: /clauses
              - $nodeBlueId:
                  $document: /clauseRuntime/work/candidate
          then:
          - $return:
              allowed: false
              code: TERMINATED_CONFIGURATION_FROZEN
      - $return:
          allowed: true
          code: ''
hookAbi: document-context-1
