description: Configurable N-party readiness and exact-configuration approval.
name: Mutual Activation Clause
templates:
  action:
    constants:
      action: ''
      actorChannel: ''
      clauseKey: ''
      statePath: ''
      terminationPath: ''
    do:
    - $let:
        expr:
          $binding: call/request
        name: request
    - $if:
        cond:
          $or:
          - $ne:
            - $pointerGet:
                object:
                  $var: request
                path: /expectedRevision
            - $document: /clauseRuntime/revision
          - $ne:
            - $pointerGet:
                object:
                  $var: request
                path: /expectedConfigurationId
            - $document: /clauseRuntime/configurationId
        then:
        - $appendEvent:
            $merge:
            - type: Clauses/Business Operation Rejected
            - code: STALE_CONFIGURATION
        - $return: {}
    - $let:
        expr:
          $document:
            $const: statePath
        name: s
    - $if:
        cond:
          $or:
          - $var:
              name: s
              path: /active
          - $var:
              name: s
              path: /declined
        then:
        - $appendEvent:
            $merge:
            - type: Clauses/Business Operation Rejected
            - code: ACTIVATION_CLOSED
        - $return: {}
    - $if:
        cond:
          $eq:
          - $pointerGet:
              default: false
              object:
                $document:
                  $const: terminationPath
              path: /terminated
          - true
        then:
        - $appendEvent:
            $merge:
            - type: Clauses/Business Operation Rejected
            - code: DOCUMENT_TERMINATED
        - $return: {}
    - $let:
        expr:
          $document:
            $concat:
            - /clauses/
            - $const: clauseKey
            - /parameters/participants
        name: participants
    - $if:
        cond:
          $eq:
          - $const: action
          - ready
        then:
        - $set:
            expr:
              $objectSet:
                object:
                  $var: s
                key: ready
                val:
                  $objectSet:
                    object:
                      $var:
                        name: s
                        path: /ready
                    key:
                      $const: actorChannel
                    val: true
            name: s
    - $if:
        cond:
          $eq:
          - $const: action
          - approve
        then:
        - $let:
            expr: true
            name: allReady
        - $forEach:
            do:
            - $if:
                cond:
                  $ne:
                  - $pointerGet:
                      default: false
                      object:
                        $var:
                          name: s
                          path: /ready
                      path:
                        $concat:
                        - /
                        - $var: party
                  - true
                then:
                - $set:
                    expr: false
                    name: allReady
            in:
              $var: participants
            item: party
        - $if:
            cond:
              $not:
                $var: allReady
            then:
            - $appendEvent:
                $merge:
                - type: Clauses/Business Operation Rejected
                - code: ALL_PARTICIPANTS_MUST_BE_READY
            - $return: {}
        - $set:
            expr:
              $objectSet:
                object:
                  $var: s
                key: approved
                val:
                  $objectSet:
                    object:
                      $var:
                        name: s
                        path: /approved
                    key:
                      $const: actorChannel
                    val: true
            name: s
        - $let:
            expr: true
            name: allApproved
        - $forEach:
            do:
            - $if:
                cond:
                  $ne:
                  - $pointerGet:
                      default: false
                      object:
                        $var:
                          name: s
                          path: /approved
                      path:
                        $concat:
                        - /
                        - $var: party
                  - true
                then:
                - $set:
                    expr: false
                    name: allApproved
            in:
              $var: participants
            item: party
        - $if:
            cond:
              $var: allApproved
            then:
            - $set:
                expr:
                  $objectSet:
                    object:
                      $objectSet:
                        object:
                          $var: s
                        key: active
                        val: true
                    key: acceptedConfigurationId
                    val:
                      $document: /clauseRuntime/configurationId
                name: s
    - $if:
        cond:
          $eq:
          - $const: action
          - decline
        then:
        - $set:
            expr:
              $objectSet:
                object:
                  $var: s
                key: declined
                val: true
            name: s
    - $appendChange:
        op: add
        path:
          $const: statePath
        val:
          $var: s
    - $appendEvent:
        $merge:
        - type: MutualActivation/Activation Decision Recorded
        - action:
            $const: action
          actorChannel:
            $const: actorChannel
          clauseKey:
            $const: clauseKey
          configurationId:
            $document: /clauseRuntime/configurationId
          revision:
            $document: /clauseRuntime/revision
    - $if:
        cond:
          $var:
            name: s
            path: /active
        then:
        - $appendEvent:
            $merge:
            - type: MutualActivation/Document Activated
            - configurationId:
                $document: /clauseRuntime/configurationId
    type: Contracts/Compute
  reset:
    constants:
      statePath: ''
    do:
    - $let:
        expr:
          $document:
            $const: statePath
        name: s
    - $if:
        cond:
          $or:
          - $var:
              name: s
              path: /active
          - $var:
              name: s
              path: /declined
        then:
        - $return: {}
    - $appendChange:
        op: add
        path:
          $const: statePath
        val:
          acceptedConfigurationId: ''
          active: false
          approved: {}
          currentRevision:
            $document: /clauseRuntime/revision
          declined: false
          ready: {}
    type: Contracts/Compute
type: Clauses/Clause
hookDefinition:
  type: Contracts/Compute Definition
  functions:
    plan:
      args: {}
      do:
      - $let:
          expr: {}
          name: contributions
      - $forEach:
          do:
          - $forEach:
              do:
              - $let:
                  expr:
                    $concat:
                    - $get:
                        key:
                          $var: action
                        object:
                          $pointerGet:
                            object:
                              $pointerGet:
                                default: {}
                                object:
                                  $document: /clauseRuntime/work/candidate
                                path:
                                  $concat:
                                  - /
                                  - $const: clauseKey
                            path: /bindings
                    - _
                    - $var: party
                  name: operationKey
              - $let:
                  expr:
                    $objectSet:
                      object:
                        $pointerGet:
                          object:
                            $document:
                              $concat:
                              - $choose:
                                  cond:
                                    $eq:
                                    - $const: mode
                                    - configuration
                                  then: /clauseRuntime/work/candidate/
                                  else: /clauses/
                              - $const: clauseKey
                              - /type
                          path: /templates/action
                      key: constants
                      val:
                        action:
                          $var: action
                        actorChannel:
                          $var: party
                        clauseKey:
                          $const: clauseKey
                        statePath:
                          $pointerGet:
                            object:
                              $pointerGet:
                                default: {}
                                object:
                                  $document: /clauseRuntime/work/candidate
                                path:
                                  $concat:
                                  - /
                                  - $const: clauseKey
                            path: /bindings/state
                        terminationPath:
                          $pointerGet:
                            object:
                              $pointerGet:
                                default: {}
                                object:
                                  $document: /clauseRuntime/work/candidate
                                path:
                                  $concat:
                                  - /
                                  - $const: clauseKey
                            path: /bindings/termination
                  name: step
              - $set:
                  expr:
                    $objectSet:
                      object:
                        $var: contributions
                      key:
                        $var: operationKey
                      val:
                        contract:
                          $merge:
                          - type: Contracts/Sequential Workflow Operation
                          - channel:
                              $var: party
                            steps:
                            - $var: step
                        kind: handler
                  name: contributions
              in:
                $literal:
                - ready
                - approve
                - decline
              item: action
          in:
            $pointerGet:
              object:
                $pointerGet:
                  default: {}
                  object:
                    $document: /clauseRuntime/work/candidate
                  path:
                    $concat:
                    - /
                    - $const: clauseKey
              path: /parameters/participants
          item: party
      - $forEach:
          do:
          - $set:
              expr:
                $objectSet:
                  object:
                    $var: contributions
                  key:
                    $concat:
                    - $pointerGet:
                        object:
                          $pointerGet:
                            default: {}
                            object:
                              $document: /clauseRuntime/work/candidate
                            path:
                              $concat:
                              - /
                              - $const: clauseKey
                        path: /bindings/reset
                    - $var: channel
                  val:
                    contract:
                      $merge:
                      - type: Contracts/Sequential Workflow
                      - channel:
                          $var: channel
                        steps:
                        - $objectSet:
                            object:
                              $pointerGet:
                                object:
                                  $document:
                                    $concat:
                                    - $choose:
                                        cond:
                                          $eq:
                                          - $const: mode
                                          - configuration
                                        then: /clauseRuntime/work/candidate/
                                        else: /clauses/
                                    - $const: clauseKey
                                    - /type
                                path: /templates/reset
                            key: constants
                            val:
                              statePath:
                                $pointerGet:
                                  object:
                                    $pointerGet:
                                      default: {}
                                      object:
                                        $document: /clauseRuntime/work/candidate
                                      path:
                                        $concat:
                                        - /
                                        - $const: clauseKey
                                  path: /bindings/state
                    kind: handler
              name: contributions
          in:
            $literal:
            - __clausesAccepted
            - __clausesInitialized
          item: channel
      - $return:
          contracts:
            $var: contributions
          reads:
          - kind: object
            path:
              $pointerGet:
                object:
                  $pointerGet:
                    default: {}
                    object:
                      $document: /clauseRuntime/work/candidate
                    path:
                      $concat:
                      - /
                      - $const: clauseKey
                path: /bindings/termination
          states:
            state:
              initial:
                acceptedConfigurationId: ''
                active: false
                approved: {}
                currentRevision: 0
                declined: false
                ready: {}
              kind: object
              path:
                $pointerGet:
                  object:
                    $pointerGet:
                      default: {}
                      object:
                        $document: /clauseRuntime/work/candidate
                      path:
                        $concat:
                        - /
                        - $const: clauseKey
                  path: /bindings/state
    validateConfiguration:
      args: {}
      do:
      - $if:
          cond:
            $or:
            - $not:
                $isKind:
                  kind: list
                  val:
                    $pointerGet:
                      object:
                        $pointerGet:
                          default: {}
                          object:
                            $document: /clauseRuntime/work/candidate
                          path:
                            $concat:
                            - /
                            - $const: clauseKey
                      path: /parameters/participants
            - $eq:
              - $size:
                  $pointerGet:
                    object:
                      $pointerGet:
                        default: {}
                        object:
                          $document: /clauseRuntime/work/candidate
                        path:
                          $concat:
                          - /
                          - $const: clauseKey
                    path: /parameters/participants
              - 0
          then:
          - $return:
              allowed: false
              code: ACTIVATION_PARTICIPANTS_REQUIRED
      - $let:
          expr: {}
          name: parties
      - $forEach:
          do:
          - $if:
              cond:
                $not:
                  $and:
                  - $isKind:
                      kind: text
                      val:
                        $var: party
                  - $ne:
                    - $var: party
                    - ''
                  - $eq:
                    - $size:
                        $split:
                          separator: /
                          text:
                            $var: party
                    - 1
                  - $eq:
                    - $size:
                        $split:
                          separator: '~'
                          text:
                            $var: party
                    - 1
              then:
              - $return:
                  allowed: false
                  code: INVALID_ACTIVATION_PARTICIPANT
          - $if:
              cond:
                $hasKey:
                  key:
                    $var: party
                  object:
                    $var: parties
              then:
              - $return:
                  allowed: false
                  code: DUPLICATE_ACTIVATION_PARTICIPANT
          - $set:
              expr:
                $objectSet:
                  object:
                    $var: parties
                  key:
                    $var: party
                  val: true
              name: parties
          in:
            $pointerGet:
              object:
                $pointerGet:
                  default: {}
                  object:
                    $document: /clauseRuntime/work/candidate
                  path:
                    $concat:
                    - /
                    - $const: clauseKey
              path: /parameters/participants
          item: party
      - $if:
          cond:
            $ne:
            - $keys:
                $pointerGet:
                  object:
                    $pointerGet:
                      default: {}
                      object:
                        $document: /clauseRuntime/work/candidate
                      path:
                        $concat:
                        - /
                        - $const: clauseKey
                  path: /bindings
            - $literal:
              - approve
              - decline
              - ready
              - reset
              - state
              - termination
          then:
          - $return:
              allowed: false
              code: ACTIVATION_BINDING_FIELDS
      - $return:
          allowed: true
          code: ''
    validateTransition:
      args: {}
      do:
      - $let:
          expr:
            $document:
              $pointerGet:
                object:
                  $choose:
                    cond:
                      $document: /clauseRuntime/work/initializing
                    then: {}
                    else:
                      $pointerGet:
                        object:
                          $document: /clauses
                        path:
                          $concat:
                          - /
                          - $const: clauseKey
                        default: {}
                path: /bindings/state
          name: s
      - $if:
          cond:
            $and:
            - $or:
              - $pointerGet:
                  default: false
                  object:
                    $var: s
                  path: /active
              - $pointerGet:
                  default: false
                  object:
                    $var: s
                  path: /declined
            - $ne:
              - $nodeBlueId:
                  $choose:
                    cond:
                      $document: /clauseRuntime/work/initializing
                    then: {}
                    else:
                      $document: /clauses
              - $nodeBlueId:
                  $document: /clauseRuntime/work/candidate
          then:
          - $return:
              allowed: false
              code: ACTIVATION_CONFIGURATION_FROZEN
      - $return:
          allowed: true
          code: ''
hookAbi: document-context-1
