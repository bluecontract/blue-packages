description: Reusable Prepare Amendment Step definition for the Clauses host profile.
do:
- $if:
    cond:
      $eq:
      - $size:
          $keys:
            $document: /clauseRuntime/work
      - 0
    then:
    - $return: {}
- $call:
    args: {}
    function: prepare
functions:
  makeStep:
    args:
      clauseKey:
        type: Text
      mode:
        type: Text
      typeId:
        type: Text
    do:
    - $let:
        name: prefix
        expr:
          $concat:
          - $choose:
              cond:
                $eq:
                - $var: mode
                - configuration
              then: /clauseRuntime/work/candidate/
              else: /clauses/
          - $var: clauseKey
          - /type
    - $let:
        name: step
        expr:
          $objectSet:
            object:
              $merge:
              - $choose:
                  cond:
                    $hasKey:
                      object:
                        $choose:
                          cond:
                            $exists:
                              $document:
                                $concat:
                                - $var: prefix
                                - /hookDefinition
                          then:
                            $document:
                              $concat:
                              - $var: prefix
                              - /hookDefinition/functions/validateConfiguration/args
                          else:
                            $document:
                              $concat:
                              - $var: prefix
                              - /functions/validateConfiguration/args
                      key: context
                  then:
                    type: Clauses/Legacy Clause Hook Step
                  else:
                    type: Clauses/Clause Hook Step
              - constants:
                  clauseKey:
                    $var: clauseKey
                  mode:
                    $var: mode
                  typeId:
                    $var: typeId
            key: name
            val:
              $concat:
              - $var: mode
              - '-'
              - $var: clauseKey
    - $return:
        $choose:
          cond:
            $exists:
              $document:
                $concat:
                - $var: prefix
                - /hookDefinition
          then:
            $objectSet:
              object:
                $var: step
              key: definition
              val:
                $concat:
                - $var: prefix
                - /hookDefinition
          else:
            $objectSet:
              object:
                $var: step
              key: functions
              val:
                $document:
                  $concat:
                  - $var: prefix
                  - /functions
  normalize:
    args: {}
    do:
    - $let:
        name: candidate
        expr:
          $document: /clauseRuntime/work/candidate
    - $let:
        expr: {}
        name: out
    - $forEach:
        do:
        - $if:
            cond:
              $not:
                $and:
                - $isKind:
                    kind: text
                    val:
                      $var: ck
                - $ne:
                  - $var: ck
                  - ''
                - $eq:
                  - $size:
                      $split:
                        separator: /
                        text:
                          $var: ck
                  - 1
                - $eq:
                  - $size:
                      $split:
                        separator: '~'
                        text:
                          $var: ck
                  - 1
            then:
            - $return:
                allowed: false
                code: INVALID_CLAUSE_KEY
        - $let:
            expr:
              $get:
                key:
                  $var: ck
                object:
                  $var: candidate
            name: item
        - $if:
            cond:
              $not:
                $isKind:
                  kind: object
                  val:
                    $var: item
            then:
            - $return:
                allowed: false
                code: CLAUSE_MUST_BE_OBJECT
        - $if:
            cond:
              $not:
                $hasKey:
                  key: type
                  object:
                    $var: item
            then:
            - $return:
                allowed: false
                code: CLAUSE_TYPE_REQUIRED
        - $let:
            expr:
              $nodeBlueId:
                $pointerGet:
                  object:
                    $var: item
                  path: /type
            name: tid
        - $let:
            expr:
              $document:
                $concat:
                - /clauseRuntime/work/candidate/
                - $var: ck
                - /type
            name: bp
        - $forEach:
            in:
              $literal:
              - validateConfiguration
              - validateTransition
              - plan
            item: fn
            do:
            - $if:
                cond:
                  $not:
                    $hasKey:
                      key:
                        $var: fn
                      object:
                        $pointerGet:
                          object:
                            $var: bp
                          path: /hookDefinition/functions
                          default:
                            $pointerGet:
                              object:
                                $var: bp
                              path: /functions
                              default: {}
                then:
                - $return:
                    allowed: false
                    code: CLAUSE_HOOK_REQUIRED
        - $if:
            cond:
              $or:
              - $not:
                  $isKind:
                    kind: object
                    val:
                      $pointerGet:
                        object:
                          $var: item
                        path: /parameters
              - $not:
                  $isKind:
                    kind: object
                    val:
                      $pointerGet:
                        object:
                          $var: item
                        path: /bindings
            then:
            - $return:
                allowed: false
                code: CLAUSE_CONFIGURATION_REQUIRED
        - $let:
            expr:
              $objectSet:
                object:
                  bindings:
                    $pointerGet:
                      object:
                        $var: item
                      path: /bindings
                  parameters:
                    $pointerGet:
                      object:
                        $var: item
                      path: /parameters
                key: type
                val:
                  $objectSet:
                    object: {}
                    key: blueId
                    val:
                      $var: tid
            name: normalized
        - $forEach:
            do:
            - $if:
                cond:
                  $hasKey:
                    key:
                      $var: label
                    object:
                      $var: item
                then:
                - $set:
                    expr:
                      $objectSet:
                        object:
                          $var: normalized
                        key:
                          $var: label
                        val:
                          $get:
                            key:
                              $var: label
                            object:
                              $var: item
                    name: normalized
            in:
              $literal:
              - name
              - description
            item: label
        - $set:
            expr:
              $objectSet:
                object:
                  $var: out
                key:
                  $var: ck
                val:
                  $var: normalized
            name: out
        in:
          $keys:
            $var: candidate
        item: ck
    - $return:
        allowed: true
        clauses:
          $var: out
        code: ''
  prepare:
    args: {}
    do:
    - $let:
        name: actorChannel
        expr:
          $document: /clauseRuntime/work/actorChannel
    - $let:
        name: candidate
        expr:
          $document: /clauseRuntime/work/candidate
    - $let:
        name: initializing
        expr:
          $document: /clauseRuntime/work/initializing
    - $let:
        name: request
        expr:
          $document: /clauseRuntime/work/request
    - $let:
        expr:
          $call:
            args: {}
            function: normalize
        name: normalized
    - $appendChange:
        op: add
        path: /clauseRuntime/work
        val:
          actorChannel:
            $var: actorChannel
          candidate: {}
          code: ''
          governors: 0
          initializing:
            $var: initializing
          plans: {}
          request:
            $var: request
    - $if:
        cond:
          $not:
            $var:
              name: normalized
              path: /allowed
        then:
        - $call:
            args:
              code:
                $var:
                  name: normalized
                  path: /code
            function: reject
        - $return: {}
    - $let:
        expr:
          $var:
            name: normalized
            path: /clauses
        name: nextClauses
    - $appendChange:
        op: add
        path: /clauseRuntime/work/candidate
        val:
          $var: nextClauses
    - $let:
        expr: []
        name: steps
    - $let:
        expr:
          $choose:
            cond:
              $document: /clauseRuntime/work/initializing
            then: {}
            else:
              $document: /clauses
        name: old
    - $forEach:
        do:
        - $if:
            cond:
              $not:
                $pointerGet:
                  object:
                    $document:
                      $concat:
                      - /clauses/
                      - $var: ck
                      - /type
                  path: /transitionUnconditional
                  default: false
            then:
            - $set:
                expr:
                  $listConcat:
                  - $var: steps
                  - - $call:
                        args:
                          clauseKey:
                            $var: ck
                          mode: transition
                          typeId:
                            $nodeBlueId:
                              $pointerGet:
                                object:
                                  $get:
                                    key:
                                      $var: ck
                                    object:
                                      $var: old
                                path: /type
                        function: makeStep
                name: steps
        in:
          $keys:
            $var: old
        item: ck
    - $forEach:
        do:
        - $set:
            expr:
              $listConcat:
              - $var: steps
              - - $call:
                    args:
                      clauseKey:
                        $var: ck
                      mode: configuration
                      typeId:
                        $nodeBlueId:
                          $pointerGet:
                            object:
                              $get:
                                key:
                                  $var: ck
                                object:
                                  $var: nextClauses
                            path: /type
                    function: makeStep
            name: steps
        in:
          $keys:
            $var: nextClauses
        item: ck
    - $set:
        expr:
          $listConcat:
          - $var: steps
          - - type: Clauses/Commit Amendment Step
        name: steps
    - $appendChange:
        op: add
        path: /contracts/__clausesApply
        val:
          $merge:
          - type: Contracts/Sequential Workflow
          - channel: __clausesRun
            steps:
              $var: steps
    - $appendEvent:
        $merge:
        - type: Clauses/Run Amendment
        - {}
    - $return: {}
  reject:
    args:
      code:
        type: Text
    do:
    - $if:
        cond:
          $document: /clauseRuntime/work/initializing
        then:
        - $fail:
            $var: code
    - $appendEvent:
        $merge:
        - type: Clauses/Amendment Rejected
        - code:
            $var: code
          configurationId:
            $document: /clauseRuntime/configurationId
          requestId:
            $choose:
              cond:
                $isKind:
                  kind: text
                  val:
                    $pointerGet:
                      default: ''
                      object:
                        $document: /clauseRuntime/work/request
                      path: /requestId
              else: ''
              then:
                $pointerGet:
                  default: ''
                  object:
                    $document: /clauseRuntime/work/request
                  path: /requestId
          revision:
            $document: /clauseRuntime/revision
    - $appendChange:
        op: add
        path: /clauseRuntime/work
        val: {}
    - $if:
        cond:
          $exists:
            $document: /contracts/__clausesApply
        then:
        - $appendChange:
            op: remove
            path: /contracts/__clausesApply
    - $return: {}
name: Prepare Amendment Step
type: Contracts/Compute
