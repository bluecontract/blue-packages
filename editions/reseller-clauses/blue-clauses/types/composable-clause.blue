name: Composable Clause
type: Clauses/Clause
description: Portable contribution clause. Configure native workflow contracts, shared
  channels, embedding declarations, state claims and reads. BEX workflow bodies are
  executable code and are admitted by the outgoing clause governance.
hookDefinition:
  type: Contracts/Compute Definition
  functions:
    validateConfiguration:
      args: {}
      do:
      - $return:
          allowed: true
          code: ''
    validateTransition:
      args: {}
      do:
      - $return:
          allowed: true
          code: ''
    plan:
      args: {}
      do:
      - $return:
          contracts:
            $pointerGet:
              object:
                $pointerGet:
                  default: {}
                  object:
                    $document: /clauseRuntime/work/candidate
                  path:
                    $concat:
                    - /
                    - $const: clauseKey
              path: /parameters/contracts
              default: {}
          states:
            $pointerGet:
              object:
                $pointerGet:
                  default: {}
                  object:
                    $document: /clauseRuntime/work/candidate
                  path:
                    $concat:
                    - /
                    - $const: clauseKey
              path: /parameters/states
              default: {}
          reads:
            $pointerGet:
              object:
                $pointerGet:
                  default: {}
                  object:
                    $document: /clauseRuntime/work/candidate
                  path:
                    $concat:
                    - /
                    - $const: clauseKey
              path: /parameters/reads
              default: []
configurationUnconditional: true
transitionUnconditional: true
hookAbi: document-context-1
