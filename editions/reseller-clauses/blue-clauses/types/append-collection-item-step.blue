name: Append Collection Item Step
type: Contracts/Compute
constants: {}
do:
- $if:
    cond:
      $not:
        $and:
        - $isKind:
            val:
              $binding: call/request/key
            kind: text
        - $ne:
          - $binding: call/request/key
          - ''
        - $eq:
          - $size:
              $split:
                text:
                  $binding: call/request/key
                separator: /
          - 1
        - $eq:
          - $size:
              $split:
                text:
                  $binding: call/request/key
                separator: '~'
          - 1
    then:
    - $fail: INVALID_COLLECTION_KEY
- $appendChange:
    op: add
    path:
      $concat:
      - $const: path
      - /
      - $binding: call/request/key
    val:
      $binding: call/request/document
