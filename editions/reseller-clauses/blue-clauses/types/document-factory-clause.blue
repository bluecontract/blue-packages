name: Document Factory Clause
type: Clauses/Clause
description: Starts unique documents from bindings.template and embeds them in bindings.context,
  a named document collection. The native processor initializes each new child, including
  its clauses. Required arguments map only to configured clause paths. startedAt records
  the originating operation timestamp. Optional activation binding prevents creation
  before activation.
hookAbi: document-context-1
transitionUnconditional: true
hookDefinition:
  type: Contracts/Compute Definition
  functions:
    validateConfiguration:
      args: {}
      do:
      - $let:
          name: p
          expr:
            $pointerGet:
              object:
                $document:
                  $concat:
                  - /clauseRuntime/work/candidate/
                  - $const: clauseKey
              path: /parameters
              default: {}
      - $let:
          name: b
          expr:
            $pointerGet:
              object:
                $document:
                  $concat:
                  - /clauseRuntime/work/candidate/
                  - $const: clauseKey
              path: /bindings
              default: {}
      - $forEach:
          item: arg
          in:
            $pointerGet:
              object:
                $var: p
              path: /arguments
              default: []
          do:
          - $if:
              cond:
                $not:
                  $and:
                  - $and:
                    - $isKind:
                        val:
                          $var:
                            name: arg
                            path: /name
                        kind: text
                    - $ne:
                      - $var:
                          name: arg
                          path: /name
                      - ''
                    - $eq:
                      - $size:
                          $split:
                            text:
                              $var:
                                name: arg
                                path: /name
                            separator: /
                      - 1
                    - $eq:
                      - $size:
                          $split:
                            text:
                              $var:
                                name: arg
                                path: /name
                            separator: '~'
                      - 1
                  - $isKind:
                      val:
                        $var:
                          name: arg
                          path: /path
                      kind: text
                  - $startsWith:
                    - $var:
                        name: arg
                        path: /path
                    - /clauses/
                  - $or:
                    - $eq:
                      - $var:
                          name: arg
                          path: /kind
                      - integer
                    - $eq:
                      - $var:
                          name: arg
                          path: /kind
                      - text
              then:
              - $return:
                  allowed: false
                  code: INVALID_FACTORY_ARGUMENT
      - $return:
          $choose:
            cond:
              $and:
              - $and:
                - $isKind:
                    val:
                      $var:
                        name: b
                        path: /template
                    kind: text
                - $startsWith:
                  - $var:
                      name: b
                      path: /template
                  - /
                - $and:
                  - $isKind:
                      val:
                        $sliceAfter:
                        - $var:
                            name: b
                            path: /template
                        - /
                      kind: text
                  - $ne:
                    - $sliceAfter:
                      - $var:
                          name: b
                          path: /template
                      - /
                    - ''
                  - $eq:
                    - $size:
                        $split:
                          text:
                            $sliceAfter:
                            - $var:
                                name: b
                                path: /template
                            - /
                          separator: /
                    - 1
                  - $eq:
                    - $size:
                        $split:
                          text:
                            $sliceAfter:
                            - $var:
                                name: b
                                path: /template
                            - /
                          separator: '~'
                    - 1
              - $and:
                - $isKind:
                    val:
                      $var:
                        name: b
                        path: /context
                    kind: text
                - $startsWith:
                  - $var:
                      name: b
                      path: /context
                  - /
                - $and:
                  - $isKind:
                      val:
                        $sliceAfter:
                        - $var:
                            name: b
                            path: /context
                        - /
                      kind: text
                  - $ne:
                    - $sliceAfter:
                      - $var:
                          name: b
                          path: /context
                      - /
                    - ''
                  - $eq:
                    - $size:
                        $split:
                          text:
                            $sliceAfter:
                            - $var:
                                name: b
                                path: /context
                            - /
                          separator: /
                    - 1
                  - $eq:
                    - $size:
                        $split:
                          text:
                            $sliceAfter:
                            - $var:
                                name: b
                                path: /context
                            - /
                          separator: '~'
                    - 1
              - $and:
                - $isKind:
                    val:
                      $var:
                        name: p
                        path: /operation
                    kind: text
                - $ne:
                  - $var:
                      name: p
                      path: /operation
                  - ''
                - $eq:
                  - $size:
                      $split:
                        text:
                          $var:
                            name: p
                            path: /operation
                        separator: /
                  - 1
                - $eq:
                  - $size:
                      $split:
                        text:
                          $var:
                            name: p
                            path: /operation
                        separator: '~'
                  - 1
              - $and:
                - $isKind:
                    val:
                      $var:
                        name: b
                        path: /actor
                    kind: text
                - $ne:
                  - $var:
                      name: b
                      path: /actor
                  - ''
                - $eq:
                  - $size:
                      $split:
                        text:
                          $var:
                            name: b
                            path: /actor
                        separator: /
                  - 1
                - $eq:
                  - $size:
                      $split:
                        text:
                          $var:
                            name: b
                            path: /actor
                        separator: '~'
                  - 1
              - $and:
                - $isKind:
                    val:
                      $pointerGet:
                        object:
                          $var: p
                        path: /keyField
                        default: documentKey
                    kind: text
                - $ne:
                  - $pointerGet:
                      object:
                        $var: p
                      path: /keyField
                      default: documentKey
                  - ''
                - $eq:
                  - $size:
                      $split:
                        text:
                          $pointerGet:
                            object:
                              $var: p
                            path: /keyField
                            default: documentKey
                        separator: /
                  - 1
                - $eq:
                  - $size:
                      $split:
                        text:
                          $pointerGet:
                            object:
                              $var: p
                            path: /keyField
                            default: documentKey
                        separator: '~'
                  - 1
              - $isKind:
                  val:
                    $document:
                      $var:
                        name: b
                        path: /template
                  kind: object
              - $ne:
                - $var:
                    name: b
                    path: /template
                - $var:
                    name: b
                    path: /context
            then:
              allowed: true
              code: ''
            else:
              allowed: false
              code: INVALID_FACTORY_CONFIGURATION
    validateTransition:
      args: {}
      do:
      - $return:
          allowed: true
          code: ''
    plan:
      args: {}
      do:
      - $let:
          name: p
          expr:
            $pointerGet:
              object:
                $document:
                  $concat:
                  - /clauseRuntime/work/candidate/
                  - $const: clauseKey
              path: /parameters
              default: {}
      - $let:
          name: b
          expr:
            $pointerGet:
              object:
                $document:
                  $concat:
                  - /clauseRuntime/work/candidate/
                  - $const: clauseKey
              path: /bindings
              default: {}
      - $return:
          contracts:
            $objectSet:
              object:
                embedded:
                  kind: embedding
                  contract:
                    $merge:
                    - type: Contracts/Process Embedded
                    - collectionPaths:
                      - $var:
                          name: b
                          path: /context
              key:
                $var:
                  name: p
                  path: /operation
              val:
                kind: handler
                contract:
                  $merge:
                  - type: Contracts/Sequential Workflow Operation
                  - channel:
                      $var:
                        name: b
                        path: /actor
                    steps:
                    - $merge:
                      - type: Clauses/Start Document Step
                      - constants:
                          template:
                            $var:
                              name: b
                              path: /template
                          collection:
                            $var:
                              name: b
                              path: /context
                          namePrefix:
                            $pointerGet:
                              object:
                                $var: p
                              path: /namePrefix
                              default: Document
                          keyField:
                            $pointerGet:
                              object:
                                $var: p
                              path: /keyField
                              default: documentKey
                          activation:
                            $pointerGet:
                              object:
                                $var: b
                              path: /activation
                              default: ''
                          arguments:
                            $pointerGet:
                              object:
                                $var: p
                              path: /arguments
                              default: []
                          termination:
                            $pointerGet:
                              object:
                                $var: b
                              path: /termination
                              default: ''
          states:
            collection:
              path:
                $var:
                  name: b
                  path: /context
              kind: object
              initial: {}
          reads:
          - path:
              $var:
                name: b
                path: /template
            kind: object
