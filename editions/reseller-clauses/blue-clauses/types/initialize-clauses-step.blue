description: Reusable Initialize Clauses Step definition for the Clauses host profile.
do:
- $failIf:
    cond:
      $exists:
        $document: /clauseRuntime
    message: RESERVED_RUNTIME_ALREADY_PRESENT
- $appendChange:
    op: add
    path: /clauseRuntime
    val:
      revision: 0
      configurationId: ''
      contracts: {}
      embedding:
        paths: []
        collectionPaths: []
      work:
        actorChannel: ''
        candidate:
          $document: /clauses
        initializing: true
        request:
          requestId: initialization
name: Initialize Clauses Step
type: Contracts/Compute
