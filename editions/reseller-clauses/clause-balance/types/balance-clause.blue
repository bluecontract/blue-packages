name: Balance Clause
type: Clauses/Clause
description: An attributed single-currency balance. Credits are keyed by stable business
  source and retained for deduplication. No payout or payment settlement is implied.
hookAbi: document-context-1
transitionUnconditional: false
hookDefinition:
  type: Contracts/Compute Definition
  functions:
    validateConfiguration:
      args: {}
      do:
      - $let:
          name: p
          expr:
            $pointerGet:
              object:
                $document:
                  $concat:
                  - /clauseRuntime/work/candidate/
                  - $const: clauseKey
              path: /parameters
              default: {}
      - $let:
          name: b
          expr:
            $pointerGet:
              object:
                $document:
                  $concat:
                  - /clauseRuntime/work/candidate/
                  - $const: clauseKey
              path: /bindings
              default: {}
      - $return:
          $choose:
            cond:
              $and:
              - $and:
                - $isKind:
                    val:
                      $var:
                        name: p
                        path: /currency
                    kind: text
                - $ne:
                  - $var:
                      name: p
                      path: /currency
                  - ''
                - $eq:
                  - $size:
                      $split:
                        text:
                          $var:
                            name: p
                            path: /currency
                        separator: /
                  - 1
                - $eq:
                  - $size:
                      $split:
                        text:
                          $var:
                            name: p
                            path: /currency
                        separator: '~'
                  - 1
              - $and:
                - $isKind:
                    val:
                      $var:
                        name: b
                        path: /state
                    kind: text
                - $startsWith:
                  - $var:
                      name: b
                      path: /state
                  - /
                - $and:
                  - $isKind:
                      val:
                        $sliceAfter:
                        - $var:
                            name: b
                            path: /state
                        - /
                      kind: text
                  - $ne:
                    - $sliceAfter:
                      - $var:
                          name: b
                          path: /state
                      - /
                    - ''
                  - $eq:
                    - $size:
                        $split:
                          text:
                            $sliceAfter:
                            - $var:
                                name: b
                                path: /state
                            - /
                          separator: /
                    - 1
                  - $eq:
                    - $size:
                        $split:
                          text:
                            $sliceAfter:
                            - $var:
                                name: b
                                path: /state
                            - /
                          separator: '~'
                    - 1
            then:
              allowed: true
              code: ''
            else:
              allowed: false
              code: INVALID_BALANCE
    validateTransition:
      args: {}
      do:
      - $let:
          name: old
          expr:
            $document:
              $concat:
              - /clauses/
              - $const: clauseKey
      - $let:
          name: next
          expr:
            $document:
              $concat:
              - /clauseRuntime/work/candidate/
              - $const: clauseKey
      - $return:
          $choose:
            cond:
              $or:
              - $not:
                  $exists:
                    $var: next
              - $eq:
                - $pointerGet:
                    object:
                      $var: old
                    path: /parameters/currency
                - $pointerGet:
                    object:
                      $var: next
                    path: /parameters/currency
            then:
              allowed: true
              code: ''
            else:
              allowed: false
              code: BALANCE_CURRENCY_IMMUTABLE
    plan:
      args: {}
      do:
      - $let:
          name: p
          expr:
            $pointerGet:
              object:
                $document:
                  $concat:
                  - /clauseRuntime/work/candidate/
                  - $const: clauseKey
              path: /parameters
              default: {}
      - $let:
          name: b
          expr:
            $pointerGet:
              object:
                $document:
                  $concat:
                  - /clauseRuntime/work/candidate/
                  - $const: clauseKey
              path: /bindings
              default: {}
      - $return:
          contracts: {}
          states:
            balance:
              path:
                $var:
                  name: b
                  path: /state
              kind: object
              initial:
                currency:
                  $var:
                    name: p
                    path: /currency
                amountMinor: 0
                credits: {}
          reads: []
