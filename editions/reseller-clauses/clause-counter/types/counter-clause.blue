description: Independent example clause with a configured increment and owned integer
  state.
name: Counter Clause
templates:
  increment:
    constants:
      clauseKey: ''
      statePath: ''
    do:
    - $let:
        expr:
          $add:
          - $document:
              $const: statePath
          - $document:
              $concat:
              - /clauses/
              - $const: clauseKey
              - /parameters/increment
        name: n
    - $appendChange:
        op: add
        path:
          $const: statePath
        val:
          $var: n
    - $appendEvent:
        $merge:
        - type: Counter/Counter Incremented
        - clauseKey:
            $const: clauseKey
          count:
            $var: n
    type: Contracts/Compute
type: Clauses/Clause
hookDefinition:
  type: Contracts/Compute Definition
  functions:
    plan:
      args: {}
      do:
      - $let:
          expr:
            $objectSet:
              object: {}
              key:
                $pointerGet:
                  object:
                    $pointerGet:
                      default: {}
                      object:
                        $document: /clauseRuntime/work/candidate
                      path:
                        $concat:
                        - /
                        - $const: clauseKey
                  path: /bindings/increment
              val:
                contract:
                  $merge:
                  - type: Contracts/Sequential Workflow Operation
                  - channel:
                      $pointerGet:
                        object:
                          $pointerGet:
                            default: {}
                            object:
                              $document: /clauseRuntime/work/candidate
                            path:
                              $concat:
                              - /
                              - $const: clauseKey
                        path: /bindings/actor
                    steps:
                    - $objectSet:
                        object:
                          $pointerGet:
                            object:
                              $document:
                                $concat:
                                - $choose:
                                    cond:
                                      $eq:
                                      - $const: mode
                                      - configuration
                                    then: /clauseRuntime/work/candidate/
                                    else: /clauses/
                                - $const: clauseKey
                                - /type
                            path: /templates/increment
                        key: constants
                        val:
                          clauseKey:
                            $const: clauseKey
                          statePath:
                            $pointerGet:
                              object:
                                $pointerGet:
                                  default: {}
                                  object:
                                    $document: /clauseRuntime/work/candidate
                                  path:
                                    $concat:
                                    - /
                                    - $const: clauseKey
                              path: /bindings/state
                kind: handler
          name: contributions
      - $return:
          contracts:
            $var: contributions
          reads: []
          states:
            state:
              initial: 0
              kind: integer
              path:
                $pointerGet:
                  object:
                    $pointerGet:
                      default: {}
                      object:
                        $document: /clauseRuntime/work/candidate
                      path:
                        $concat:
                        - /
                        - $const: clauseKey
                  path: /bindings/state
    validateConfiguration:
      args: {}
      do:
      - $if:
          cond:
            $or:
            - $not:
                $isKind:
                  kind: integer
                  val:
                    $pointerGet:
                      object:
                        $pointerGet:
                          default: {}
                          object:
                            $document: /clauseRuntime/work/candidate
                          path:
                            $concat:
                            - /
                            - $const: clauseKey
                      path: /parameters/increment
            - $lte:
              - $pointerGet:
                  object:
                    $pointerGet:
                      default: {}
                      object:
                        $document: /clauseRuntime/work/candidate
                      path:
                        $concat:
                        - /
                        - $const: clauseKey
                  path: /parameters/increment
              - 0
          then:
          - $return:
              allowed: false
              code: POSITIVE_INCREMENT_REQUIRED
      - $if:
          cond:
            $ne:
            - $keys:
                $pointerGet:
                  object:
                    $pointerGet:
                      default: {}
                      object:
                        $document: /clauseRuntime/work/candidate
                      path:
                        $concat:
                        - /
                        - $const: clauseKey
                  path: /bindings
            - $literal:
              - actor
              - increment
              - state
          then:
          - $return:
              allowed: false
              code: COUNTER_BINDING_FIELDS
      - $return:
          allowed: true
          code: ''
    validateTransition:
      args: {}
      do:
      - $return:
          allowed: true
          code: ''
transitionUnconditional: true
hookAbi: document-context-1
