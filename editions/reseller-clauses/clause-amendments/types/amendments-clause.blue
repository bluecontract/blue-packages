description: Configures draft-edit operations and validates authority under the outgoing
  policy.
governsAmendments: true
name: Amendments Clause
type: Clauses/Clause
hookDefinition:
  type: Contracts/Compute Definition
  functions:
    plan:
      args: {}
      do:
      - $let:
          expr: {}
          name: contributions
      - $forEach:
          do:
          - $set:
              expr:
                $objectSet:
                  object:
                    $var: contributions
                  key:
                    $var: operation
                  val:
                    contract:
                      $merge:
                      - type: Contracts/Sequential Workflow Operation
                      - channel:
                          $get:
                            key:
                              $var: operation
                            object:
                              $pointerGet:
                                object:
                                  $pointerGet:
                                    default: {}
                                    object:
                                      $document: /clauseRuntime/work/candidate
                                    path:
                                      $concat:
                                      - /
                                      - $const: clauseKey
                                path: /parameters/operations
                        steps:
                        - constants:
                            actorChannel:
                              $get:
                                key:
                                  $var: operation
                                object:
                                  $pointerGet:
                                    object:
                                      $pointerGet:
                                        default: {}
                                        object:
                                          $document: /clauseRuntime/work/candidate
                                        path:
                                          $concat:
                                          - /
                                          - $const: clauseKey
                                    path: /parameters/operations
                          type: Clauses/Dispatch Clause Change Step
                    kind: handler
              name: contributions
          in:
            $keys:
              $pointerGet:
                object:
                  $pointerGet:
                    default: {}
                    object:
                      $document: /clauseRuntime/work/candidate
                    path:
                      $concat:
                      - /
                      - $const: clauseKey
                path: /parameters/operations
          item: operation
      - $return:
          contracts:
            $var: contributions
          reads: []
          states: {}
    validateConfiguration:
      args: {}
      do:
      - $if:
          cond:
            $or:
            - $not:
                $isKind:
                  kind: object
                  val:
                    $pointerGet:
                      object:
                        $pointerGet:
                          default: {}
                          object:
                            $document: /clauseRuntime/work/candidate
                          path:
                            $concat:
                            - /
                            - $const: clauseKey
                      path: /parameters/operations
            - $eq:
              - $size:
                  $keys:
                    $pointerGet:
                      object:
                        $pointerGet:
                          default: {}
                          object:
                            $document: /clauseRuntime/work/candidate
                          path:
                            $concat:
                            - /
                            - $const: clauseKey
                      path: /parameters/operations
              - 0
          then:
          - $return:
              allowed: false
              code: AMENDMENT_OPERATIONS_REQUIRED
      - $forEach:
          do:
          - $if:
              cond:
                $not:
                  $and:
                  - $isKind:
                      kind: text
                      val:
                        $var: operation
                  - $ne:
                    - $var: operation
                    - ''
                  - $eq:
                    - $size:
                        $split:
                          separator: /
                          text:
                            $var: operation
                    - 1
                  - $eq:
                    - $size:
                        $split:
                          separator: '~'
                          text:
                            $var: operation
                    - 1
              then:
              - $return:
                  allowed: false
                  code: INVALID_OPERATION_NAME
          - $if:
              cond:
                $not:
                  $and:
                  - $isKind:
                      kind: text
                      val:
                        $get:
                          key:
                            $var: operation
                          object:
                            $pointerGet:
                              object:
                                $pointerGet:
                                  default: {}
                                  object:
                                    $document: /clauseRuntime/work/candidate
                                  path:
                                    $concat:
                                    - /
                                    - $const: clauseKey
                              path: /parameters/operations
                  - $ne:
                    - $get:
                        key:
                          $var: operation
                        object:
                          $pointerGet:
                            object:
                              $pointerGet:
                                default: {}
                                object:
                                  $document: /clauseRuntime/work/candidate
                                path:
                                  $concat:
                                  - /
                                  - $const: clauseKey
                            path: /parameters/operations
                    - ''
                  - $eq:
                    - $size:
                        $split:
                          separator: /
                          text:
                            $get:
                              key:
                                $var: operation
                              object:
                                $pointerGet:
                                  object:
                                    $pointerGet:
                                      default: {}
                                      object:
                                        $document: /clauseRuntime/work/candidate
                                      path:
                                        $concat:
                                        - /
                                        - $const: clauseKey
                                  path: /parameters/operations
                    - 1
                  - $eq:
                    - $size:
                        $split:
                          separator: '~'
                          text:
                            $get:
                              key:
                                $var: operation
                              object:
                                $pointerGet:
                                  object:
                                    $pointerGet:
                                      default: {}
                                      object:
                                        $document: /clauseRuntime/work/candidate
                                      path:
                                        $concat:
                                        - /
                                        - $const: clauseKey
                                  path: /parameters/operations
                    - 1
              then:
              - $return:
                  allowed: false
                  code: INVALID_CHANNEL_NAME
          in:
            $keys:
              $pointerGet:
                object:
                  $pointerGet:
                    default: {}
                    object:
                      $document: /clauseRuntime/work/candidate
                    path:
                      $concat:
                      - /
                      - $const: clauseKey
                path: /parameters/operations
          item: operation
      - $return:
          allowed: true
          code: ''
    validateTransition:
      args: {}
      do:
      - $let:
          expr: false
          name: authorized
      - $forEach:
          do:
          - $if:
              cond:
                $eq:
                - $get:
                    key:
                      $var: operation
                    object:
                      $pointerGet:
                        object:
                          $choose:
                            cond:
                              $document: /clauseRuntime/work/initializing
                            then: {}
                            else:
                              $pointerGet:
                                object:
                                  $document: /clauses
                                path:
                                  $concat:
                                  - /
                                  - $const: clauseKey
                                default: {}
                        path: /parameters/operations
                - $document: /clauseRuntime/work/actorChannel
              then:
              - $set:
                  expr: true
                  name: authorized
          in:
            $keys:
              $pointerGet:
                object:
                  $choose:
                    cond:
                      $document: /clauseRuntime/work/initializing
                    then: {}
                    else:
                      $pointerGet:
                        object:
                          $document: /clauses
                        path:
                          $concat:
                          - /
                          - $const: clauseKey
                        default: {}
                path: /parameters/operations
          item: operation
      - $if:
          cond:
            $not:
              $var: authorized
          then:
          - $return:
              allowed: false
              code: AMENDMENT_NOT_AUTHORIZED
      - $return:
          allowed: true
          code: ''
hookAbi: document-context-1
