name: Product Clause
type: Clauses/Clause
description: Keeps product terms authoritative in parameters.product. Fixed Product
  supports optional amountMinor; Bookable Product requires a resource and a positive
  interval. Does not claim external stock or availability.
hookAbi: document-context-1
transitionUnconditional: true
hookDefinition:
  type: Contracts/Compute Definition
  functions:
    validateConfiguration:
      args: {}
      do:
      - $let:
          name: p
          expr:
            $pointerGet:
              object:
                $document:
                  $concat:
                  - /clauseRuntime/work/candidate/
                  - $const: clauseKey
              path: /parameters
              default: {}
      - $let:
          name: b
          expr:
            $pointerGet:
              object:
                $document:
                  $concat:
                  - /clauseRuntime/work/candidate/
                  - $const: clauseKey
              path: /bindings
              default: {}
      - $return:
          $choose:
            cond:
              $and:
              - $or:
                - $is:
                    node:
                      $var:
                        name: p
                        path: /product
                    pattern:
                      type: Products/Fixed Product
                - $is:
                    node:
                      $var:
                        name: p
                        path: /product
                    pattern:
                      type: Products/Bookable Product
              - $and:
                - $isKind:
                    val:
                      $pointerGet:
                        object:
                          $var:
                            name: p
                            path: /product
                        path: /currency
                        default: ''
                    kind: text
                - $ne:
                  - $pointerGet:
                      object:
                        $var:
                          name: p
                          path: /product
                      path: /currency
                      default: ''
                  - ''
                - $eq:
                  - $size:
                      $split:
                        text:
                          $pointerGet:
                            object:
                              $var:
                                name: p
                                path: /product
                            path: /currency
                            default: ''
                        separator: /
                  - 1
                - $eq:
                  - $size:
                      $split:
                        text:
                          $pointerGet:
                            object:
                              $var:
                                name: p
                                path: /product
                            path: /currency
                            default: ''
                        separator: '~'
                  - 1
              - $choose:
                  cond:
                    $is:
                      node:
                        $var:
                          name: p
                          path: /product
                      pattern:
                        type: Products/Bookable Product
                  then:
                    $and:
                    - $and:
                      - $isKind:
                          val:
                            $pointerGet:
                              object:
                                $var:
                                  name: p
                                  path: /product
                              path: /resource
                              default: ''
                          kind: text
                      - $ne:
                        - $pointerGet:
                            object:
                              $var:
                                name: p
                                path: /product
                            path: /resource
                            default: ''
                        - ''
                      - $eq:
                        - $size:
                            $split:
                              text:
                                $pointerGet:
                                  object:
                                    $var:
                                      name: p
                                      path: /product
                                  path: /resource
                                  default: ''
                              separator: /
                        - 1
                      - $eq:
                        - $size:
                            $split:
                              text:
                                $pointerGet:
                                  object:
                                    $var:
                                      name: p
                                      path: /product
                                  path: /resource
                                  default: ''
                              separator: '~'
                        - 1
                    - $and:
                      - $isKind:
                          val:
                            $pointerGet:
                              object:
                                $var:
                                  name: p
                                  path: /product
                              path: /startsAt
                              default: 0
                          kind: integer
                      - $gte:
                        - $pointerGet:
                            object:
                              $var:
                                name: p
                                path: /product
                            path: /startsAt
                            default: 0
                        - 1
                      - $lte:
                        - $pointerGet:
                            object:
                              $var:
                                name: p
                                path: /product
                            path: /startsAt
                            default: 0
                        - 9007199254740991
                    - $gt:
                      - $pointerGet:
                          object:
                            $var:
                              name: p
                              path: /product
                          path: /endsAt
                          default: 0
                      - $pointerGet:
                          object:
                            $var:
                              name: p
                              path: /product
                          path: /startsAt
                          default: 0
                  else:
                    $or:
                    - $not:
                        $exists:
                          $pointerGet:
                            object:
                              $var:
                                name: p
                                path: /product
                            path: /amountMinor
                    - $and:
                      - $isKind:
                          val:
                            $pointerGet:
                              object:
                                $var:
                                  name: p
                                  path: /product
                              path: /amountMinor
                          kind: integer
                      - $gte:
                        - $pointerGet:
                            object:
                              $var:
                                name: p
                                path: /product
                            path: /amountMinor
                        - 1
                      - $lte:
                        - $pointerGet:
                            object:
                              $var:
                                name: p
                                path: /product
                            path: /amountMinor
                        - 1000000000000
            then:
              allowed: true
              code: ''
            else:
              allowed: false
              code: INVALID_PRODUCT
    validateTransition:
      args: {}
      do:
      - $return:
          allowed: true
          code: ''
    plan:
      args: {}
      do:
      - $let:
          name: p
          expr:
            $pointerGet:
              object:
                $document:
                  $concat:
                  - /clauseRuntime/work/candidate/
                  - $const: clauseKey
              path: /parameters
              default: {}
      - $let:
          name: b
          expr:
            $pointerGet:
              object:
                $document:
                  $concat:
                  - /clauseRuntime/work/candidate/
                  - $const: clauseKey
              path: /bindings
              default: {}
      - $return:
          contracts: {}
          states: {}
          reads: []
