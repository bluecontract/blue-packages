                "$if": {
                  "cond": {
                    "$hasKey": {
                      "object": {
                        "$var": "rule"
                      },
                      "key": "max"
                    }
                  },
                  "then": [
                    {
                      "$failIf": {
                        "cond": {
                          "$not": {
                            "$lte": [
                              {
                                "$var": "tv"
                              },
                              {
                                "$var": {
                                  "name": "rule",
                                  "path": "/max"
                                }
                              }
                            ]
                          }
                        },
                        "message": "NEGOTIATED_TERM_RANGE"
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "$appendChange": {
