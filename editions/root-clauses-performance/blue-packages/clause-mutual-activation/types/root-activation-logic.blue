                  },
                  "then": [
                    {
                      "$failIf": {
                        "cond": {
                          "$not": {
                            "$includes": {
                              "list": {
                                "$var": {
                                  "name": "rule",
                                  "path": "/enum"
                                }
                              },
                              "val": {
                                "$var": "tv"
                              }
                            }
                          }
                        },
                        "message": "NEGOTIATED_TERM_NOT_ALLOWED"
                      }
                    }
                  ]
                }
              },
              {
                "$if": {
                  "cond": {
                    "$hasKey": {
                      "object": {
                        "$var": "rule"
                      },
                      "key": "min"
                    }
                  },
                  "then": [
                    {
                      "$failIf": {
                        "cond": {
                          "$not": {
                            "$gte": [
                              {
                                "$var": "tv"
                              },
                              {
                                "$var": {
                                  "name": "rule",
                                  "path": "/min"
                                }
                              }
                            ]
                          }
                        },
                        "message": "NEGOTIATED_TERM_RANGE"
                      }
                    }
                  ]
                }
              },
