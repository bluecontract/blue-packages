        {
          "$forEach": {
            "in": {
              "$keys": {
                "$const": {
                  "name": "parameters",
                  "path": "/termSchema"
                }
              }
            },
            "item": "tk",
            "do": [
              {
                "$let": {
                  "name": "rule",
                  "expr": {
                    "$get": {
                      "object": {
                        "$const": {
                          "name": "parameters",
