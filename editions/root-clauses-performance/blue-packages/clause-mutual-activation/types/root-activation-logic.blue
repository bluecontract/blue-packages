                    "$not": {
                      "$eq": [
                        {
                          "$kind": {
                            "$var": "tv"
                          }
                        },
                        {
                          "$var": {
                            "name": "rule",
                            "path": "/kind"
                          }
                        }
                      ]
                    }
                  },
                  "message": "NEGOTIATED_TERM_KIND"
                }
              },
              {
                "$if": {
                  "cond": {
                    "$hasKey": {
                      "object": {
                        "$var": "rule"
                      },
                      "key": "enum"
