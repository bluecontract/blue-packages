{
  "name": "Root Activation Logic",
  "type": "Contracts/Compute Definition",
  "constants": {
    "messageTypes": {
      "proposal": {
        "type": "MutualActivation/Change Proposal"
      },
      "decision": {
        "type": "MutualActivation/Change Decision",
        "inResponseTo": {
          "type": "MutualActivation/Change Proposal"
        }
      },
      "progress": {
        "type": "Agreements/Clause Progress"
      },
      "transition": {
        "type": "MutualActivation/Activation Decision Recorded"
      },
      "succeeded": {
        "type": "MutualActivation/Activation Succeeded"
      },
      "declined": {
        "type": "MutualActivation/Activation Declined"
      }
    }
  },
  "functions": {
    "revision": {
      "args": {
        "terms": {}
      },
      "expr": {
        "$nodeBlueId": {
          "agreement": {
            "$document": "/agreementId"
          },
          "agreementType": {
            "$nodeBlueId": {
              "$document": "/type"
            }
          },
          "configurationId": {
            "$document": "/clauseRuntime/configId"
          },
          "partyAChannel": {
            "$document": "/channels/A"
          },
          "partyBChannel": {
            "$document": "/channels/B"
          },
          "terms": {
            "$var": "terms"
          }
        }
      }
    },
    "act": {
      "args": {
        "side": {
          "type": "Text"
        }
      },
      "do": [
        {
          "$failIf": {
            "cond": {
              "$eq": [
                {
                  "$document": {
                    "$const": {
                      "name": "bindings",
                      "path": "/terminated"
                    }
                  }
                },
                true
              ]
            },
            "message": "AGREEMENT_TERMINATED"
          }
        },
        {
          "$let": {
            "name": "req",
            "expr": {
              "$binding": "call/request"
            }
          }
        },
        {
          "$failIf": {
            "cond": {
              "$not": {
                "$isKind": {
                  "val": {
                    "$var": "req"
                  },
                  "kind": "object"
                }
              }
            },
            "message": "REQUEST_REQUIRED"
          }
        },
        {
          "$failIf": {
            "cond": {
              "$not": {
                "$isKind": {
                  "val": {
                    "$var": {
                      "name": "req",
                      "path": "/requestId"
                    }
                  },
                  "kind": "text"
                }
              }
            },
            "message": "REQUEST_ID_REQUIRED"
          }
        },
        {
          "$failIf": {
            "cond": {
              "$not": {
                "$ne": [
                  {
                    "$var": {
                      "name": "req",
                      "path": "/requestId"
                    }
                  },
                  ""
                ]
              }
            },
            "message": "REQUEST_ID_REQUIRED"
          }
        },
        {
          "$let": {
            "name": "s",
            "expr": {
              "$document": {
                "$const": {
                  "name": "bindings",
                  "path": "/state"
                }
              }
            }
          }
        },
        {
          "$let": {
            "name": "reqHash",
            "expr": {
              "$nodeBlueId": {
                "$var": "req"
              }
            }
          }
        },
        {
          "$let": {
            "name": "seenKey",
            "expr": {
              "$concat": [
                {
                  "$var": "side"
                },
                ":",
                {
                  "$var": {
                    "name": "req",
                    "path": "/requestId"
                  }
                }
              ]
            }
          }
        },
        {
          "$if": {
            "cond": {
              "$hasKey": {
                "object": {
                  "$var": {
                    "name": "s",
                    "path": "/seen"
                  }
                },
                "key": {
                  "$var": "seenKey"
                }
              }
            },
            "then": [
              {
                "$failIf": {
                  "cond": {
                    "$not": {
                      "$eq": [
                        {
                          "$get": {
                            "object": {
                              "$var": {
                                "name": "s",
                                "path": "/seen"
                              }
                            },
                            "key": {
                              "$var": "seenKey"
                            }
                          }
                        },
                        {
                          "$var": "reqHash"
                        }
                      ]
                    }
                  },
                  "message": "REQUEST_ID_REUSE"
                }
              },
              {
                "$return": true
              }
            ]
          }
        },
        {
          "$failIf": {
            "cond": {
              "$not": {
                "$eq": [
                  {
                    "$var": {
                      "name": "s",
                      "path": "/phase"
                    }
                  },
                  "NEGOTIATING"
                ]
              }
            },
            "message": "NEGOTIATION_CLOSED"
          }
        },
        {
          "$failIf": {
            "cond": {
              "$not": {
                "$eq": [
                  {
                    "$var": {
                      "name": "req",
                      "path": "/round"
                    }
                  },
                  {
                    "$var": {
                      "name": "s",
                      "path": "/round"
                    }
                  }
                ]
              }
            },
            "message": "STALE_ROUND"
          }
        },
        {
          "$failIf": {
            "cond": {
              "$not": {
                "$eq": [
                  {
                    "$var": {
                      "name": "req",
                      "path": "/termsId"
                    }
                  },
                  {
                    "$var": {
                      "name": "s",
                      "path": "/targetId"
                    }
                  }
                ]
              }
            },
            "message": "STALE_TERMS"
          }
        },
        {
          "$let": {
            "name": "action",
            "expr": {
              "$var": {
                "name": "req",
                "path": "/action"
              }
            }
          }
        },
        {
          "$let": {
            "name": "other",
            "expr": {
              "$choose": {
                "cond": {
                  "$eq": [
                    {
                      "$var": "side"
                    },
                    "A"
                  ]
                },
                "then": "B",
                "else": "A"
              }
            }
          }
        },
        {
          "$failIf": {
            "cond": {
              "$not": {
                "$includes": {
                  "list": [
                    "proposeChange",
                    "acceptChange",
                    "rejectChange",
                    "withdrawChange",
                    "ready",
                    "approve",
                    "withdrawApproval",
                    "rejectApproval",
                    "decline"
                  ],
                  "val": {
                    "$var": "action"
                  }
                }
              }
            },
            "message": "UNKNOWN_ACTION"
          }
        },
        {
          "$let": {
            "name": "intent",
            "expr": {
              "$default": [
                {
                  "$var": {
                    "name": "req",
                    "path": "/intention"
                  }
                },
                "NONE"
              ]
            }
          }
        },
        {
          "$failIf": {
            "cond": {
              "$not": {
                "$includes": {
                  "list": [
                    "NONE",
                    "READY",
                    "APPROVED"
                  ],
                  "val": {
                    "$var": "intent"
                  }
                }
              }
            },
            "message": "INVALID_INTENTION"
          }
        },
        {
          "$failIf": {
            "cond": {
              "$not": {
                "$or": [
                  {
                    "$includes": {
                      "list": [
                        "proposeChange",
                        "acceptChange"
                      ],
                      "val": {
                        "$var": "action"
                      }
                    }
                  },
                  {
                    "$eq": [
                      {
                        "$var": "intent"
                      },
                      "NONE"
                    ]
                  }
                ]
              }
            },
            "message": "INTENTION_ONLY_ON_EDIT_COMMANDS"
          }
        },
        {
          "$failIf": {
            "cond": {
              "$not": {
                "$isEmpty": {
                  "$filter": {
                    "in": {
                      "$keys": {
                        "$var": "req"
                      }
                    },
                    "item": "key",
                    "where": {
                      "$not": {
                        "$includes": {
                          "list": [
                            "type",
                            "action",
                            "requestId",
                            "round",
                            "termsId",
                            "message",
                            "intention",
                            "changes",
                            "proposalId"
                          ],
                          "val": {
                            "$var": "key"
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "message": "UNKNOWN_REQUEST_FIELD"
          }
        },
        {
          "$failIf": {
            "cond": {
              "$not": {
                "$or": [
                  {
                    "$not": {
                      "$hasKey": {
                        "object": {
                          "$var": "req"
                        },
                        "key": "message"
                      }
                    }
                  },
                  {
                    "$isKind": {
                      "val": {
                        "$var": {
                          "name": "req",
                          "path": "/message"
                        }
                      },
                      "kind": "text"
                    }
                  }
                ]
              }
            },
            "message": "MESSAGE_MUST_BE_TEXT"
          }
        },
        {
          "$if": {
            "cond": {
              "$eq": [
                {
                  "$var": "action"
                },
                "proposeChange"
              ]
            },
            "then": [
              {
                "$failIf": {
                  "cond": {
                    "$not": {
                      "$isKind": {
                        "val": {
                          "$var": {
                            "name": "req",
                            "path": "/message"
                          }
                        },
                        "kind": "text"
                      }
                    }
                  },
                  "message": "EXPLANATION_REQUIRED"
                }
              },
              {
                "$failIf": {
                  "cond": {
                    "$not": {
                      "$ne": [
                        {
                          "$var": {
                            "name": "req",
                            "path": "/message"
                          }
                        },
                        ""
                      ]
                    }
                  },
                  "message": "EXPLANATION_REQUIRED"
                }
              },
              {
                "$failIf": {
                  "cond": {
                    "$not": {
                      "$isKind": {
                        "val": {
                          "$var": {
                            "name": "req",
                            "path": "/changes"
                          }
                        },
                        "kind": "list"
                      }
                    }
                  },
                  "message": "CHANGES_REQUIRED"
                }
              },
              {
                "$failIf": {
                  "cond": {
                    "$not": {
                      "$gt": [
                        {
                          "$size": {
                            "$var": {
                              "name": "req",
                              "path": "/changes"
                            }
                          }
                        },
                        0
                      ]
                    }
                  },
                  "message": "CHANGES_REQUIRED"
                }
              },
              {
                "$let": {
                  "name": "candidate",
                  "expr": {
                    "$var": {
                      "name": "s",
                      "path": "/settled"
                    }
                  }
                }
              },
              {
                "$forEach": {
                  "in": {
                    "$var": {
                      "name": "req",
                      "path": "/changes"
                    }
                  },
                  "item": "change",
                  "do": [
                    {
                      "$failIf": {
                        "cond": {
                          "$not": {
                            "$isKind": {
                              "val": {
                                "$var": "change"
                              },
                              "kind": "object"
                            }
                          }
                        },
                        "message": "INVALID_PATCH"
                      }
                    },
                    {
                      "$failIf": {
                        "cond": {
                          "$not": {
                            "$includes": {
                              "list": [
                                "set",
                                "remove"
                              ],
                              "val": {
                                "$var": {
                                  "name": "change",
                                  "path": "/op"
                                }
                              }
                            }
                          }
                        },
                        "message": "INVALID_PATCH_OP"
                      }
                    },
                    {
                      "$failIf": {
                        "cond": {
                          "$not": {
                            "$isKind": {
                              "val": {
                                "$var": {
                                  "name": "change",
                                  "path": "/path"
                                }
                              },
                              "kind": "text"
                            }
                          }
                        },
                        "message": "INVALID_PATCH_PATH"
                      }
                    },
                    {
                      "$failIf": {
                        "cond": {
                          "$not": {
                            "$or": [
                              {
                                "$eq": [
                                  {
                                    "$var": {
                                      "name": "change",
                                      "path": "/path"
                                    }
                                  },
                                  ""
                                ]
                              },
                              {
                                "$startsWith": [
                                  {
                                    "$var": {
                                      "name": "change",
                                      "path": "/path"
                                    }
                                  },
                                  "/"
                                ]
                              }
                            ]
                          }
                        },
                        "message": "INVALID_PATCH_PATH"
                      }
                    },
                    {
                      "$failIf": {
                        "cond": {
                          "$not": {
                            "$isEmpty": {
                              "$filter": {
                                "in": {
                                  "$keys": {
                                    "$var": "change"
                                  }
                                },
                                "item": "key",
                                "where": {
                                  "$not": {
                                    "$includes": {
                                      "list": [
                                        "op",
                                        "path",
                                        "val"
                                      ],
                                      "val": {
                                        "$var": "key"
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        },
                        "message": "UNKNOWN_PATCH_FIELD"
                      }
                    },
                    {
                      "$failIf": {
                        "cond": {
                          "$not": {
                            "$eq": [
                              {
                                "$hasKey": {
                                  "object": {
                                    "$var": "change"
                                  },
                                  "key": "val"
                                }
                              },
                              {
                                "$ne": [
                                  {
                                    "$var": {
                                      "name": "change",
                                      "path": "/op"
                                    }
                                  },
                                  "remove"
                                ]
                              }
                            ]
                          }
                        },
                        "message": "PATCH_VALUE_MISMATCH"
                      }
                    },
                    {
                      "$failIf": {
                        "cond": {
                          "$not": {
                            "$eq": [
                              {
                                "$size": {
                                  "$split": {
                                    "text": {
                                      "$var": {
                                        "name": "change",
                                        "path": "/path"
                                      }
                                    },
                                    "separator": "~"
                                  }
                                }
                              },
                              1
                            ]
                          }
                        },
                        "message": "ESCAPED_PATH_USE_ROOT_REPLACEMENT"
                      }
                    },
                    {
                      "$if": {
                        "cond": {
                          "$and": [
                            {
                              "$ne": [
                                {
                                  "$var": {
                                    "name": "change",
                                    "path": "/path"
                                  }
                                },
                                ""
                              ]
                            },
                            {
                              "$ne": [
                                {
                                  "$var": {
                                    "name": "change",
                                    "path": "/path"
                                  }
                                },
                                "/"
                              ]
                            }
                          ]
                        },
                        "then": [
                          {
                            "$let": {
                              "name": "parts",
                              "expr": {
                                "$split": {
                                  "text": {
                                    "$var": {
                                      "name": "change",
                                      "path": "/path"
                                    }
                                  },
                                  "separator": "/"
                                }
                              }
                            }
                          },
                          {
                            "$let": {
                              "name": "at",
                              "expr": {
                                "$var": "candidate"
                              }
                            }
                          },
                          {
                            "$forEach": {
                              "in": {
                                "$var": "parts"
                              },
                              "item": "part",
                              "index": "index",
                              "do": [
                                {
                                  "$if": {
                                    "cond": {
                                      "$gt": [
                                        {
                                          "$var": "index"
                                        },
                                        0
                                      ]
                                    },
                                    "then": [
                                      {
                                        "$failIf": {
                                          "cond": {
                                            "$not": {
                                              "$isKind": {
                                                "val": {
                                                  "$var": "at"
                                                },
                                                "kind": "object"
                                              }
                                            }
                                          },
                                          "message": "EDIT_PARENT_MUST_BE_OBJECT"
                                        }
                                      },
                                      {
                                        "$if": {
                                          "cond": {
                                            "$lt": [
                                              {
                                                "$var": "index"
                                              },
                                              {
                                                "$subtract": [
                                                  {
                                                    "$size": {
                                                      "$var": "parts"
                                                    }
                                                  },
                                                  1
                                                ]
                                              }
                                            ]
                                          },
                                          "then": [
                                            {
                                              "$failIf": {
                                                "cond": {
                                                  "$not": {
                                                    "$hasKey": {
                                                      "object": {
                                                        "$var": "at"
                                                      },
                                                      "key": {
                                                        "$var": "part"
                                                      }
                                                    }
                                                  }
                                                },
                                                "message": "EDIT_PARENT_MISSING"
                                              }
                                            },
                                            {
                                              "$set": {
                                                "name": "at",
                                                "expr": {
                                                  "$get": {
                                                    "object": {
                                                      "$var": "at"
                                                    },
                                                    "key": {
                                                      "$var": "part"
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          ],
                                          "else": [
                                            {
                                              "$if": {
                                                "cond": {
                                                  "$eq": [
                                                    {
                                                      "$var": {
                                                        "name": "change",
                                                        "path": "/op"
                                                      }
                                                    },
                                                    "remove"
                                                  ]
                                                },
                                                "then": [
                                                  {
                                                    "$failIf": {
                                                      "cond": {
                                                        "$not": {
                                                          "$hasKey": {
                                                            "object": {
                                                              "$var": "at"
                                                            },
                                                            "key": {
                                                              "$var": "part"
                                                            }
                                                          }
                                                        }
                                                      },
                                                      "message": "REMOVE_TARGET_MISSING"
                                                    }
                                                  }
                                                ]
                                              }
                                            }
                                          ]
                                        }
                                      }
                                    ]
                                  }
                                }
                              ]
                            }
                          }
                        ],
                        "else": [
                          {
                            "$failIf": {
                              "cond": {
                                "$not": {
                                  "$eq": [
                                    {
                                      "$var": {
                                        "name": "change",
                                        "path": "/op"
                                      }
                                    },
                                    "set"
                                  ]
                                }
                              },
                              "message": "CANNOT_REMOVE_TERMS_ROOT"
                            }
                          }
                        ]
                      }
                    },
                    {
                      "$set": {
                        "name": "candidate",
                        "expr": {
                          "$pointerSet": {
                            "object": {
                              "$var": "candidate"
                            },
                            "path": {
                              "$var": {
                                "name": "change",
                                "path": "/path"
                              }
                            },
                            "op": {
                              "$var": {
                                "name": "change",
                                "path": "/op"
                              }
                            },
                            "val": {
                              "$var": {
                                "name": "change",
                                "path": "/val"
                              }
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              },
              {
                "$failIf": {
                  "cond": {
                    "$not": {
                      "$isKind": {
                        "val": {
                          "$var": "candidate"
                        },
                        "kind": "object"
                      }
                    }
                  },
                  "message": "TERMS_MUST_BE_OBJECT"
                }
              },
              {
                "$failIf": {
                  "cond": {
                    "$not": {
                      "$ne": [
                        {
                          "$nodeBlueId": {
                            "$var": "candidate"
                          }
                        },
                        {
                          "$nodeBlueId": {
                            "$var": {
                              "name": "s",
                              "path": "/settled"
                            }
                          }
                        }
                      ]
                    }
                  },
                  "message": "NO_CHANGE"
                }
              },
              {
                "$if": {
                  "cond": {
                    "$var": {
                      "name": "s",
                      "path": "/pending"
                    }
                  },
                  "then": [
                    {
                      "$appendEvent": {
                        "$objectSet": {
                          "object": {
                            "inResponseTo": {
                              "$objectSet": {
                                "object": {},
                                "key": "blueId",
                                "val": {
                                  "$nodeBlueId": {
                                    "$var": {
                                      "name": "s",
                                      "path": "/proposal"
                                    }
                                  }
                                }
                              }
                            },
                            "recipientChannel": {
                              "$concat": [
                                "party",
                                {
                                  "$var": "other"
                                }
                              ]
                            },
                            "result": "SUPERSEDED",
                            "message": {
                              "$default": [
                                {
                                  "$var": {
                                    "name": "req",
                                    "path": "/message"
                                  }
                                },
                                ""
                              ]
                            },
                            "decidedBy": {
                              "$var": "side"
                            },
                            "requestId": {
                              "$var": {
                                "name": "req",
                                "path": "/requestId"
                              }
                            }
                          },
                          "key": "type",
                          "val": {
                            "$const": {
                              "name": "messageTypes",
                              "path": "/decision/type"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              },
              {
                "$set": {
                  "name": "s",
                  "expr": {
                    "$objectSet": {
                      "object": {
                        "$var": "s"
                      },
                      "key": "round",
                      "val": {
                        "$add": [
                          {
                            "$var": {
                              "name": "s",
                              "path": "/round"
                            }
                          },
                          1
                        ]
                      }
                    }
                  }
                }
              },
              {
                "$set": {
                  "name": "s",
                  "expr": {
                    "$objectSet": {
                      "object": {
                        "$var": "s"
                      },
                      "key": "signals",
                      "val": {
                        "A": "NONE",
                        "B": "NONE"
                      }
                    }
                  }
                }
              },
              {
                "$set": {
                  "name": "s",
                  "expr": {
                    "$objectSet": {
                      "object": {
                        "$var": "s"
                      },
                      "key": "records",
                      "val": {
                        "A": {},
                        "B": {}
                      }
                    }
                  }
                }
              },
              {
                "$set": {
                  "name": "s",
                  "expr": {
                    "$objectSet": {
                      "object": {
                        "$var": "s"
                      },
                      "key": "target",
                      "val": {
                        "$var": "candidate"
