{
  "name": "Agreement",
  "description": "Root-local clause composition with deterministic initialization and source-change reconciliation. Clause code is data; no native business extension.",
  "agreementId": {
    "type": "Text"
  },
  "parameters": {},
  "clauses": {},
  "initialClauses": {},
  "channels": {},
  "clauseTypes": {
    "type": "List"
  },
  "amendTemplates": {
    "A": {
      "type": "Contracts/Sequential Workflow Operation",
      "channel": "partyA",
      "steps": [
        {
          "type": "Contracts/Compute",
          "do": [
            {
              "$let": {
                "name": "r",
                "expr": {
                  "$binding": "call/request"
                }
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$isKind": {
                      "val": {
                        "$var": "r"
                      },
                      "kind": "object"
                    }
                  }
                },
                "message": "REQUEST_REQUIRED"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$or": [
                      {
                        "$eq": [
                          {
                            "$keys": {
                              "$var": "r"
                            }
                          },
                          {
                            "$literal": [
                              "parameters"
                            ]
                          }
                        ]
                      },
                      {
                        "$eq": [
                          {
                            "$keys": {
                              "$var": "r"
                            }
                          },
                          {
                            "$literal": [
                              "clauses"
                            ]
                          }
                        ]
                      }
                    ]
                  }
                },
                "message": "AMEND_PARAMETERS_OR_CLAUSES_ONLY"
              }
            },
            {
              "$if": {
                "cond": {
                  "$hasKey": {
                    "object": {
                      "$var": "r"
                    },
                    "key": "parameters"
                  }
                },
                "then": [
                  {
                    "$failIf": {
                      "cond": {
                        "$not": {
                          "$isKind": {
                            "val": {
                              "$var": {
                                "name": "r",
                                "path": "/parameters"
                              }
                            },
                            "kind": "object"
                          }
                        }
                      },
                      "message": "PARAMETERS_MUST_BE_OBJECT"
                    }
                  },
                  {
                    "$appendChange": {
                      "op": "replace",
                      "path": "/parameters",
                      "val": {
                        "$var": {
                          "name": "r",
                          "path": "/parameters"
                        }
                      }
                    }
                  }
                ],
                "else": [
                  {
                    "$failIf": {
                      "cond": {
                        "$not": {
                          "$isKind": {
                            "val": {
                              "$var": {
                                "name": "r",
                                "path": "/clauses"
                              }
                            },
                            "kind": "object"
                          }
                        }
                      },
                      "message": "CLAUSES_MUST_BE_OBJECT"
                    }
                  },
                  {
                    "$appendChange": {
                      "op": "replace",
                      "path": "/clauses",
                      "val": {
                        "$var": {
                          "name": "r",
                          "path": "/clauses"
                        }
                      }
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    "B": {
      "type": "Contracts/Sequential Workflow Operation",
      "channel": "partyB",
      "steps": [
        {
          "type": "Contracts/Compute",
          "do": [
            {
              "$let": {
                "name": "r",
                "expr": {
                  "$binding": "call/request"
                }
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$isKind": {
                      "val": {
                        "$var": "r"
                      },
                      "kind": "object"
                    }
                  }
                },
                "message": "REQUEST_REQUIRED"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$or": [
                      {
                        "$eq": [
                          {
                            "$keys": {
                              "$var": "r"
                            }
                          },
                          {
                            "$literal": [
                              "parameters"
                            ]
                          }
                        ]
                      },
                      {
                        "$eq": [
                          {
                            "$keys": {
                              "$var": "r"
                            }
                          },
                          {
                            "$literal": [
                              "clauses"
                            ]
                          }
                        ]
                      }
                    ]
                  }
                },
                "message": "AMEND_PARAMETERS_OR_CLAUSES_ONLY"
              }
            },
            {
              "$if": {
                "cond": {
                  "$hasKey": {
                    "object": {
                      "$var": "r"
                    },
                    "key": "parameters"
                  }
                },
                "then": [
                  {
                    "$failIf": {
                      "cond": {
                        "$not": {
                          "$isKind": {
                            "val": {
                              "$var": {
                                "name": "r",
                                "path": "/parameters"
                              }
                            },
                            "kind": "object"
                          }
                        }
                      },
                      "message": "PARAMETERS_MUST_BE_OBJECT"
                    }
                  },
                  {
                    "$appendChange": {
                      "op": "replace",
                      "path": "/parameters",
                      "val": {
                        "$var": {
                          "name": "r",
                          "path": "/parameters"
                        }
                      }
                    }
                  }
                ],
                "else": [
                  {
                    "$failIf": {
                      "cond": {
                        "$not": {
                          "$isKind": {
                            "val": {
                              "$var": {
                                "name": "r",
                                "path": "/clauses"
                              }
                            },
                            "kind": "object"
                          }
                        }
                      },
                      "message": "CLAUSES_MUST_BE_OBJECT"
                    }
                  },
                  {
                    "$appendChange": {
                      "op": "replace",
                      "path": "/clauses",
                      "val": {
                        "$var": {
                          "name": "r",
                          "path": "/clauses"
                        }
                      }
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  },
  "contracts": {
    "_life": {
      "type": "Contracts/Lifecycle Event Channel",
      "event": {
        "type": "Contracts/Document Processing Initiated"
      }
    },
    "_initializeClauses": {
      "type": "Contracts/Sequential Workflow",
      "channel": "_life",
      "steps": [
        {
          "type": "Agreements/Clause Initializer Step",
          "entry": "initialize",
          "constants": {}
        }
      ]
    },
    "_clauseChanges": {
      "type": "Contracts/Document Update Channel",
      "path": "/clauses"
    },
    "_parameterChanges": {
      "type": "Contracts/Document Update Channel",
      "path": "/parameters"
    },
    "_reconcileClauses": {
      "type": "Contracts/Sequential Workflow",
      "channel": "_clauseChanges",
      "steps": [
        {
          "type": "Agreements/Clause Install Step",
          "entry": "install",
          "constants": {}
        }
      ]
    },
    "_reconcileParameters": {
      "type": "Contracts/Sequential Workflow",
      "channel": "_parameterChanges",
      "steps": [
        {
          "type": "Agreements/Clause Install Step",
          "entry": "install",
          "constants": {}
        }
      ]
    },
    "_installation": {
      "type": "Contracts/Document Update Channel",
      "path": "/clauseRuntime/revision"
    }
  }
}
