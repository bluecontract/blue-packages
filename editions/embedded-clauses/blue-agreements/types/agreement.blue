{
  "name": "Agreement",
  "declaredContracts": [
    "embedded",
    "clauseProgress",
    "applyClause",
    "lifecycle",
    "initialize"
  ],
  "description": "Two-party Agreement root. Its designated embedded activation clause owns negotiation; the root owns ACTIVE.",
  "agreementId": {
    "type": "Text"
  },
  "partyA": {
    "type": "Coordination/Actor",
    "schema": {
      "required": true
    }
  },
  "partyB": {
    "type": "Coordination/Actor",
    "schema": {
      "required": true
    }
  },
  "activation": {
    "type": "Agreements/Clause"
  },
  "contracts": {
    "embedded": {
      "type": "Contracts/Process Embedded",
      "paths": [
        "/activation"
      ]
    },
    "clauseProgress": {
      "type": "Contracts/Embedded Node Channel",
      "sourcePath": "/activation",
      "event": {
        "type": "Agreements/Clause Progress"
      }
    },
    "applyClause": {
      "type": "Contracts/Sequential Workflow",
      "channel": "clauseProgress",
      "steps": [
        {
          "type": "Contracts/Compute",
          "do": [
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$isEmpty": {
                      "$filter": {
                        "in": {
                          "$keys": {
                            "$document": "/contracts"
                          }
                        },
                        "item": "key",
                        "where": {
                          "$not": {
                            "$includes": {
                              "list": {
                                "$listConcat": [
                                  {
                                    "$document": "/type/declaredContracts"
                                  },
                                  [
                                    "initialized",
                                    "checkpoint",
                                    "terminated"
                                  ]
                                ]
                              },
                              "val": {
                                "$var": "key"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "message": "UNAPPROVED_CONTRACT_DECLARATION"
              }
            },
            {
              "$forEach": {
                "in": {
                  "$document": "/type/declaredContracts"
                },
                "item": "guardContract",
                "do": [
                  {
                    "$if": {
                      "cond": {
                        "$not": {
                          "$includes": {
                            "list": [
                              "partyA",
                              "partyB"
                            ],
                            "val": {
                              "$var": "guardContract"
                            }
                          }
                        }
                      },
                      "then": [
                        {
                          "$failIf": {
                            "cond": {
                              "$not": {
                                "$eq": [
                                  {
                                    "$nodeBlueId": {
                                      "$document": {
                                        "$concat": [
                                          "/contracts/",
                                          {
                                            "$var": "guardContract"
                                          }
                                        ]
                                      }
                                    }
                                  },
                                  {
                                    "$nodeBlueId": {
                                      "$document": {
                                        "$concat": [
                                          "/type/contracts/",
                                          {
                                            "$var": "guardContract"
                                          }
                                        ]
                                      }
                                    }
                                  }
                                ]
                              }
                            },
                            "message": "EXECUTABLE_OVERRIDE_NOT_ALLOWED"
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$document": "/activation/agreementId"
                      },
                      {
                        "$document": "/agreementId"
                      }
                    ]
                  }
                },
                "message": "CLAUSE_AGREEMENT_MISMATCH"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$nodeBlueId": {
                          "$document": "/activation/partyA"
                        }
                      },
                      {
                        "$nodeBlueId": {
                          "$document": "/partyA"
                        }
                      }
                    ]
                  }
                },
                "message": "CLAUSE_PARTY_A_MISMATCH"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$nodeBlueId": {
                          "$document": "/activation/partyB"
                        }
                      },
                      {
                        "$nodeBlueId": {
                          "$document": "/partyB"
                        }
                      }
                    ]
                  }
                },
                "message": "CLAUSE_PARTY_B_MISMATCH"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$nodeBlueId": {
                          "$document": "/activation/type"
                        }
                      },
                      {
                        "$document": "/activationType"
                      }
                    ]
                  }
                },
                "message": "CLAUSE_TYPE_MISMATCH"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$document": "/activation/agreementType"
                      },
                      {
                        "$nodeBlueId": {
                          "$document": "/type"
                        }
                      }
                    ]
                  }
                },
                "message": "AGREEMENT_TYPE_MISMATCH"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$or": [
                      {
                        "$eq": [
                          {
                            "$document": "/activation/state/phase"
                          },
                          "NEGOTIATING"
                        ]
                      },
                      {
                        "$eq": [
                          {
                            "$document": "/activation/state/phase"
                          },
                          "CONSENTED"
                        ]
                      },
                      {
                        "$eq": [
                          {
                            "$document": "/activation/state/phase"
                          },
                          "DECLINED"
                        ]
                      }
                    ]
                  }
                },
                "message": "INVALID_CLAUSE_PHASE"
              }
            },
            {
              "$let": {
                "name": "priorPhase",
                "expr": {
                  "$document": "/phase"
                }
              }
            },
            {
              "$appendChange": {
                "op": "add",
                "path": "/terms",
                "val": {
                  "$document": "/activation/state/settled"
                }
              }
            },
            {
              "$appendChange": {
                "op": "add",
                "path": "/phase",
                "val": {
                  "$choose": {
                    "cond": {
                      "$eq": [
                        {
                          "$document": "/activation/state/phase"
                        },
                        "CONSENTED"
                      ]
                    },
                    "then": "ACTIVE",
                    "else": {
                      "$document": "/activation/state/phase"
                    }
                  }
                }
              }
            },
            {
              "$if": {
                "cond": {
                  "$eq": [
                    {
                      "$document": "/activation/state/phase"
                    },
                    "CONSENTED"
                  ]
                },
                "then": [
                  {
                    "$failIf": {
                      "cond": {
                        "$not": {
                          "$not": {
                            "$document": "/activation/state/pending"
                          }
                        }
                      },
                      "message": "UNSETTLED_CONSENT"
                    }
                  },
                  {
                    "$failIf": {
                      "cond": {
                        "$not": {
                          "$and": [
                            {
                              "$eq": [
                                {
                                  "$document": "/activation/state/signals/A"
                                },
                                "APPROVED"
                              ]
                            },
                            {
                              "$eq": [
                                {
                                  "$document": "/activation/state/signals/B"
                                },
                                "APPROVED"
                              ]
                            }
                          ]
                        }
                      },
                      "message": "TWO_APPROVALS_REQUIRED"
                    }
                  },
                  {
                    "$failIf": {
                      "cond": {
                        "$not": {
                          "$eq": [
                            {
                              "$document": "/activation/state/consent/termsId"
                            },
                            {
                              "$document": "/activation/state/targetId"
                            }
                          ]
                        }
                      },
                      "message": "CONSENT_TERMS_MISMATCH"
                    }
                  },
                  {
                    "$failIf": {
                      "cond": {
                        "$not": {
                          "$eq": [
                            {
                              "$document": "/activation/state/consent/round"
                            },
                            {
                              "$document": "/activation/state/round"
                            }
                          ]
                        }
                      },
                      "message": "CONSENT_ROUND_MISMATCH"
                    }
                  },
                  {
                    "$failIf": {
                      "cond": {
                        "$not": {
                          "$eq": [
                            {
                              "$nodeBlueId": {
                                "$document": "/activation/state/target"
                              }
                            },
                            {
                              "$nodeBlueId": {
                                "$document": "/activation/state/settled"
                              }
                            }
                          ]
                        }
                      },
                      "message": "CONSENT_NOT_SETTLED"
                    }
                  },
                  {
                    "$appendChange": {
                      "op": "add",
                      "path": "/acceptedRevision",
                      "val": {
                        "$document": "/activation/state/consent"
                      }
                    }
                  },
                  {
                    "$if": {
                      "cond": {
                        "$ne": [
                          {
                            "$var": "priorPhase"
                          },
                          "ACTIVE"
                        ]
                      },
                      "then": [
                        {
                          "$appendEvent": {
                            "type": "Agreements/Agreement Activated",
                            "kind": "Agreement Activated",
                            "agreementId": {
                              "$document": "/agreementId"
                            },
                            "termsId": {
                              "$document": "/activation/state/targetId"
                            },
                            "round": {
                              "$document": "/activation/state/round"
                            }
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "$if": {
                "cond": {
                  "$and": [
                    {
                      "$eq": [
                        {
                          "$document": "/activation/state/phase"
                        },
                        "DECLINED"
                      ]
                    },
                    {
                      "$ne": [
                        {
                          "$var": "priorPhase"
                        },
                        "DECLINED"
                      ]
                    }
                  ]
                },
                "then": [
                  {
                    "$appendEvent": {
                      "type": "Agreements/Agreement Declined",
                      "kind": "Agreement Declined",
                      "agreementId": {
                        "$document": "/agreementId"
                      },
                      "message": {
                        "$document": "/activation/state/message"
                      }
                    }
                  }
                ]
              }
            },
            {
              "$appendEvent": {
                "type": "Agreements/Agreement Progressed",
                "kind": "Agreement Progressed",
                "agreementId": {
                  "$document": "/agreementId"
                },
                "phase": {
                  "$choose": {
                    "cond": {
                      "$eq": [
                        {
                          "$document": "/activation/state/phase"
                        },
                        "CONSENTED"
                      ]
                    },
                    "then": "ACTIVE",
                    "else": {
                      "$document": "/activation/state/phase"
                    }
                  }
                },
                "round": {
                  "$document": "/activation/state/round"
                }
              }
            }
          ]
        }
      ]
    },
    "lifecycle": {
      "type": "Contracts/Lifecycle Event Channel",
      "event": {
        "type": "Contracts/Document Processing Initiated"
      }
    },
    "initialize": {
      "type": "Contracts/Sequential Workflow",
      "channel": "lifecycle",
      "steps": [
        {
          "type": "Contracts/Compute",
          "do": [
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$isEmpty": {
                      "$filter": {
                        "in": {
                          "$keys": {
                            "$document": "/contracts"
                          }
                        },
                        "item": "key",
                        "where": {
                          "$not": {
                            "$includes": {
                              "list": {
                                "$listConcat": [
                                  {
                                    "$document": "/type/declaredContracts"
                                  },
                                  [
                                    "initialized",
                                    "checkpoint",
                                    "terminated"
                                  ]
                                ]
                              },
                              "val": {
                                "$var": "key"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "message": "UNAPPROVED_CONTRACT_DECLARATION"
              }
            },
            {
              "$forEach": {
                "in": {
                  "$document": "/type/declaredContracts"
                },
                "item": "guardContract",
                "do": [
                  {
                    "$if": {
                      "cond": {
                        "$not": {
                          "$includes": {
                            "list": [
                              "partyA",
                              "partyB"
                            ],
                            "val": {
                              "$var": "guardContract"
                            }
                          }
                        }
                      },
                      "then": [
                        {
                          "$failIf": {
                            "cond": {
                              "$not": {
                                "$eq": [
                                  {
                                    "$nodeBlueId": {
                                      "$document": {
                                        "$concat": [
                                          "/contracts/",
                                          {
                                            "$var": "guardContract"
                                          }
                                        ]
                                      }
                                    }
                                  },
                                  {
                                    "$nodeBlueId": {
                                      "$document": {
                                        "$concat": [
                                          "/type/contracts/",
                                          {
                                            "$var": "guardContract"
                                          }
                                        ]
                                      }
                                    }
                                  }
                                ]
                              }
                            },
                            "message": "EXECUTABLE_OVERRIDE_NOT_ALLOWED"
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$document": "/activation/agreementId"
                      },
                      {
                        "$document": "/agreementId"
                      }
                    ]
                  }
                },
                "message": "CLAUSE_AGREEMENT_MISMATCH"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$nodeBlueId": {
                          "$document": "/activation/partyA"
                        }
                      },
                      {
                        "$nodeBlueId": {
                          "$document": "/partyA"
                        }
                      }
                    ]
                  }
                },
                "message": "CLAUSE_PARTY_A_MISMATCH"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$nodeBlueId": {
                          "$document": "/activation/partyB"
                        }
                      },
                      {
                        "$nodeBlueId": {
                          "$document": "/partyB"
                        }
                      }
                    ]
                  }
                },
                "message": "CLAUSE_PARTY_B_MISMATCH"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$nodeBlueId": {
                          "$document": "/activation/type"
                        }
                      },
                      {
                        "$document": "/activationType"
                      }
                    ]
                  }
                },
                "message": "CLAUSE_TYPE_MISMATCH"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$document": "/activation/agreementType"
                      },
                      {
                        "$nodeBlueId": {
                          "$document": "/type"
                        }
                      }
                    ]
                  }
                },
                "message": "AGREEMENT_TYPE_MISMATCH"
              }
            },
            {
              "$appendChange": {
                "op": "add",
                "path": "/phase",
                "val": "NEGOTIATING"
              }
            },
            {
              "$appendChange": {
                "op": "add",
                "path": "/acceptedRevision",
                "val": {}
              }
            },
            {
              "$appendChange": {
                "op": "add",
                "path": "/terms",
                "val": {
                  "$document": "/activation/initialTerms"
                }
              }
            }
          ]
        }
      ]
    }
  }
}
