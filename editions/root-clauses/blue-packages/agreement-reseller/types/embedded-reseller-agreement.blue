{
  "name": "Reseller Agreement",
  "type": {
    "blueId": "GTt8bTxdbASfCnzMQm4nE125gZgDf1SDZGQHG5EpXMxr"
  },
  "description": "Complete non-exclusive supplier/reseller template. A is Supplier; B is Reseller. Reuses exact mutual activation and immediate termination packages without native business code.",
  "declaredContracts": [
    "embedded",
    "clauseProgress",
    "applyClause",
    "lifecycle",
    "initialize",
    "guardActivation",
    "terminationProgress",
    "applyTermination",
    "partyA",
    "partyB"
  ],
  "activationType": "BrpkbsUfHR3JpECmxQ9c3WFub41wHtCZWVc9A5VoGepz",
  "terminationTermsType": "Hqb7bGj7BMj9Wr6jC3X6qvreBmJYD2VDcZVNa2En8AX7",
  "terminationClauseType": "3sBnjB7A7LjjvYWcnhFi5Q43VjCQ57PKovxMWVecNokp",
  "defaultTerms": {
    "title": "Non-exclusive Reseller Agreement",
    "commercial": {
      "supplierName": "Example Supplier",
      "resellerName": "Example Reseller",
      "products": "Supplier standard products identified in accepted orders",
      "territory": "Spain",
      "currency": "EUR",
      "resellerDiscountBps": 1500,
      "paymentTermDays": 30,
      "confidentialitySurvivalMonths": 24,
      "supplierContact": "Supplier commercial contact",
      "resellerContact": "Reseller commercial contact"
    },
    "clauses": {
      "appointment": {
        "heading": "1. Appointment and relationship",
        "text": "Party A is the Supplier and Party B is the Reseller. Upon activation, the Supplier appoints the Reseller on a non-exclusive basis to market and resell the Products within the Territory. The Reseller acts in its own name and for its own account, is not an agent of the Supplier, and cannot bind the Supplier or make commitments on its behalf."
      },
      "productsAndTerritory": {
        "heading": "2. Products and territory",
        "text": "Products and Territory are those recorded in the commercial schedule. No exclusivity, minimum purchase volume, protected customer list or right outside that scope is granted unless expressly added to the agreed terms. Material changes to the Products or Territory require a separately agreed amendment; this template automates pre-activation negotiation only."
      },
      "ordersAndFulfilment": {
        "heading": "3. Orders and fulfilment",
        "text": "Each purchase requires a separate order accepted by the Supplier. A quotation or customer commitment made by the Reseller does not itself oblige the Supplier to accept an order. Accepted orders specify quantities, delivery, applicable charges and any support obligations. This agreement does not automatically create, accept, cancel or fulfil orders."
      },
      "pricingAndPayment": {
        "heading": "4. Wholesale price and payment",
        "text": "The Reseller discount in the commercial schedule applies to the Supplier list price specified in each accepted order. Taxes, delivery costs and other charges must be stated in that order. Payment is due within the scheduled payment term from the invoice date unless that order states otherwise. The Reseller determines its own resale prices. This document records commercial terms but does not initiate payments."
      },
      "marketingAndMarks": {
        "heading": "5. Marketing and intellectual property",
        "text": "During the active term, the Reseller may use Supplier-approved product descriptions and marks solely to market the Products within the agreed scope. The Supplier retains ownership of its intellectual property. The Reseller must not claim to be the Supplier, alter product claims without approval, or grant rights it does not hold. Permission to use the marks for new marketing ends on termination."
      },
      "customerResponsibilities": {
        "heading": "6. Customer responsibilities",
        "text": "The Reseller is responsible for its own customer offers, resale terms and communications. Each party is responsible for the personnel and services it expressly undertakes to provide. Product warranties, returns, service levels and support commitments must be stated in the relevant order or another expressly accepted document; they are not inferred from activation of this agreement."
      },
      "confidentiality": {
        "heading": "7. Confidentiality and customer information",
        "text": "Each party will protect the other party confidential information, use it only for this relationship, and disclose it only to people who need it for that purpose and are bound to protect it. This excludes information already lawfully known, independently developed, public without breach, or lawfully obtained from another source. Any required disclosure is limited to what is required. The confidentiality period after termination is specified in the commercial schedule. Neither party may share personal customer information merely because this agreement is active."
      },
      "authorityAndCompliance": {
        "heading": "8. Authority and compliance",
        "text": "Each party remains responsible for the authority of people or agents acting for it and for the requirements applicable to its own activities. Participation by an agent does not by itself authorize it to approve terms, place orders or terminate. This demonstration submits actions directly from the two principal actors; delegated authority, when used, requires a separately verified Mandate."
      },
      "activation": {
        "heading": "9. Negotiation and mutual activation",
        "text": "This agreement is not active while it is being negotiated. Accepting a proposed edit and marking READY are not activation approval. Both principals must approve the same settled terms and review round through the Mutual Activation Clause. Changes to the reviewed candidate invalidate prior-round signals. The accepted revision and both approval records are retained when the agreement becomes ACTIVE."
      },
      "terminationEffects": {
        "heading": "10. End of the relationship",
        "text": "When the optional Immediate Termination Terms clause is present in the accepted revision, the specified party, or either party if EITHER is selected, may terminate this agreement immediately through the executable clause without a second approval or a notice period. No cause is required; an optional reason is recorded. If the clause is absent, this template provides no immediate-termination operation. Termination takes effect in the recorded business state when the agreement commits TERMINATED after processing the authorized notice. It ends authorization for new activity under this agreement but does not automatically cancel previously accepted orders, discharge accrued payment obligations, refund money or terminate other Blue documents. Confidentiality and obligations expressly stated to survive continue as written."
      },
      "noticesAndRecords": {
        "heading": "11. Notices and records",
        "text": "The agreed principal actors and Timeline channels identify who submits automated actions. The agreement records exact terms, approval evidence and termination evidence. A termination event is a recorded outcome, not a request that the counterparty must accept. A notice outside those configured operations has no automatic state-changing effect in this template."
      },
      "completeTermsAndDisputes": {
        "heading": "12. Complete terms and unresolved matters",
        "text": "The commercial schedule and numbered clauses together form the proposed relationship terms. Operational changes after activation require another expressly agreed instrument; no post-activation amendment workflow is implemented here. The parties will first attempt to resolve disputes through their named business contacts. This demonstration intentionally makes no governing-law, venue, statutory-remedy or enforceability determination; those matters and any sector-specific requirements must be settled before real use."
      },
      "immediateTermination": {
        "type": "ImmediateTermination/Immediate Termination Terms",
        "allowedParty": "EITHER"
      }
    }
  },
  "activation": {
    "type": {
      "blueId": "BrpkbsUfHR3JpECmxQ9c3WFub41wHtCZWVc9A5VoGepz"
    }
  },
  "clauses": {},
  "termination": {},
  "contracts": {
    "embedded": {
      "type": "Contracts/Process Embedded",
      "paths": [
        "/activation"
      ],
      "collectionPaths": [
        "/clauses"
      ]
    },
    "clauseProgress": {
      "type": "Contracts/Embedded Node Channel",
      "sourcePath": "/activation",
      "event": {
        "type": "Agreements/Clause Progress"
      }
    },
    "applyClause": {
      "type": "Contracts/Sequential Workflow",
      "channel": "clauseProgress",
      "steps": [
        {
          "type": "Contracts/Compute",
          "do": [
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$isEmpty": {
                      "$filter": {
                        "in": {
                          "$keys": {
                            "$document": "/contracts"
                          }
                        },
                        "item": "key",
                        "where": {
                          "$not": {
                            "$includes": {
                              "list": {
                                "$listConcat": [
                                  {
                                    "$document": "/type/declaredContracts"
                                  },
                                  [
                                    "initialized",
                                    "checkpoint",
                                    "terminated"
                                  ]
                                ]
                              },
                              "val": {
                                "$var": "key"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "message": "UNAPPROVED_CONTRACT_DECLARATION"
              }
            },
            {
              "$forEach": {
                "in": {
                  "$document": "/type/declaredContracts"
                },
                "item": "guardContract",
                "do": [
                  {
                    "$if": {
                      "cond": {
                        "$not": {
                          "$includes": {
                            "list": [
                              "partyA",
                              "partyB"
                            ],
                            "val": {
                              "$var": "guardContract"
                            }
                          }
                        }
                      },
                      "then": [
                        {
                          "$failIf": {
                            "cond": {
                              "$not": {
                                "$eq": [
                                  {
                                    "$nodeBlueId": {
                                      "$document": {
                                        "$concat": [
                                          "/contracts/",
                                          {
                                            "$var": "guardContract"
                                          }
                                        ]
                                      }
                                    }
                                  },
                                  {
                                    "$nodeBlueId": {
                                      "$document": {
                                        "$concat": [
                                          "/type/contracts/",
                                          {
                                            "$var": "guardContract"
                                          }
                                        ]
                                      }
                                    }
                                  }
                                ]
                              }
                            },
                            "message": "EXECUTABLE_OVERRIDE_NOT_ALLOWED"
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$document": "/activation/agreementId"
                      },
                      {
                        "$document": "/agreementId"
                      }
                    ]
                  }
                },
                "message": "CLAUSE_AGREEMENT_MISMATCH"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$nodeBlueId": {
                          "$document": "/activation/partyA"
                        }
                      },
                      {
                        "$nodeBlueId": {
                          "$document": "/partyA"
                        }
                      }
                    ]
                  }
                },
                "message": "CLAUSE_PARTY_A_MISMATCH"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$nodeBlueId": {
                          "$document": "/activation/partyB"
                        }
                      },
                      {
                        "$nodeBlueId": {
                          "$document": "/partyB"
                        }
                      }
                    ]
                  }
                },
                "message": "CLAUSE_PARTY_B_MISMATCH"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$nodeBlueId": {
                          "$document": "/activation/type"
                        }
                      },
                      {
                        "$document": "/activationType"
                      }
                    ]
                  }
                },
                "message": "CLAUSE_TYPE_MISMATCH"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$document": "/activation/agreementType"
                      },
                      {
                        "$nodeBlueId": {
                          "$document": "/type"
                        }
                      }
                    ]
                  }
                },
                "message": "AGREEMENT_TYPE_MISMATCH"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$or": [
                      {
                        "$eq": [
                          {
                            "$document": "/activation/state/phase"
                          },
                          "NEGOTIATING"
                        ]
                      },
                      {
                        "$eq": [
                          {
                            "$document": "/activation/state/phase"
                          },
                          "CONSENTED"
                        ]
                      },
                      {
                        "$eq": [
                          {
                            "$document": "/activation/state/phase"
                          },
                          "DECLINED"
                        ]
                      }
                    ]
                  }
                },
                "message": "INVALID_CLAUSE_PHASE"
              }
            },
            {
              "$let": {
                "name": "priorPhase",
                "expr": {
                  "$document": "/phase"
                }
              }
            },
            {
              "$appendChange": {
                "op": "add",
                "path": "/terms",
                "val": {
                  "$document": "/activation/state/settled"
                }
              }
            },
            {
              "$appendChange": {
                "op": "add",
                "path": "/phase",
                "val": {
                  "$choose": {
                    "cond": {
                      "$eq": [
                        {
                          "$document": "/activation/state/phase"
                        },
                        "CONSENTED"
                      ]
                    },
                    "then": "ACTIVE",
                    "else": {
                      "$document": "/activation/state/phase"
                    }
                  }
                }
              }
            },
            {
              "$if": {
                "cond": {
                  "$eq": [
                    {
                      "$document": "/activation/state/phase"
                    },
                    "CONSENTED"
                  ]
                },
                "then": [
                  {
                    "$failIf": {
                      "cond": {
                        "$not": {
                          "$not": {
                            "$document": "/activation/state/pending"
                          }
                        }
                      },
                      "message": "UNSETTLED_CONSENT"
                    }
                  },
                  {
                    "$failIf": {
                      "cond": {
                        "$not": {
                          "$and": [
                            {
                              "$eq": [
                                {
                                  "$document": "/activation/state/signals/A"
                                },
                                "APPROVED"
                              ]
                            },
                            {
                              "$eq": [
                                {
                                  "$document": "/activation/state/signals/B"
                                },
                                "APPROVED"
                              ]
                            }
                          ]
                        }
                      },
                      "message": "TWO_APPROVALS_REQUIRED"
                    }
                  },
                  {
                    "$failIf": {
                      "cond": {
                        "$not": {
                          "$eq": [
                            {
                              "$document": "/activation/state/consent/termsId"
                            },
                            {
                              "$document": "/activation/state/targetId"
                            }
                          ]
                        }
                      },
                      "message": "CONSENT_TERMS_MISMATCH"
                    }
                  },
                  {
                    "$failIf": {
                      "cond": {
                        "$not": {
                          "$eq": [
                            {
                              "$document": "/activation/state/consent/round"
                            },
                            {
                              "$document": "/activation/state/round"
                            }
                          ]
                        }
                      },
                      "message": "CONSENT_ROUND_MISMATCH"
                    }
                  },
                  {
                    "$failIf": {
                      "cond": {
                        "$not": {
                          "$eq": [
                            {
                              "$nodeBlueId": {
                                "$document": "/activation/state/target"
                              }
                            },
                            {
                              "$nodeBlueId": {
                                "$document": "/activation/state/settled"
                              }
                            }
                          ]
                        }
                      },
                      "message": "CONSENT_NOT_SETTLED"
                    }
                  },
                  {
                    "$appendChange": {
                      "op": "add",
                      "path": "/acceptedRevision",
                      "val": {
                        "$document": "/activation/state/consent"
                      }
                    }
                  },
                  {
                    "$if": {
                      "cond": {
                        "$ne": [
                          {
                            "$var": "priorPhase"
                          },
                          "ACTIVE"
                        ]
                      },
                      "then": [
                        {
                          "$appendEvent": {
                            "type": "Agreements/Agreement Activated",
                            "kind": "Agreement Activated",
                            "agreementId": {
                              "$document": "/agreementId"
                            },
                            "termsId": {
                              "$document": "/activation/state/targetId"
                            },
                            "round": {
                              "$document": "/activation/state/round"
                            }
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "$if": {
                "cond": {
                  "$and": [
                    {
                      "$eq": [
                        {
                          "$document": "/activation/state/phase"
                        },
                        "DECLINED"
                      ]
                    },
                    {
                      "$ne": [
                        {
                          "$var": "priorPhase"
                        },
                        "DECLINED"
                      ]
                    }
                  ]
                },
                "then": [
                  {
                    "$appendEvent": {
                      "type": "Agreements/Agreement Declined",
                      "kind": "Agreement Declined",
                      "agreementId": {
                        "$document": "/agreementId"
                      },
                      "message": {
                        "$document": "/activation/state/message"
                      }
                    }
                  }
                ]
              }
            },
            {
              "$appendEvent": {
                "type": "Agreements/Agreement Progressed",
                "kind": "Agreement Progressed",
                "agreementId": {
                  "$document": "/agreementId"
                },
                "phase": {
                  "$choose": {
                    "cond": {
                      "$eq": [
                        {
                          "$document": "/activation/state/phase"
                        },
                        "CONSENTED"
                      ]
                    },
                    "then": "ACTIVE",
                    "else": {
                      "$document": "/activation/state/phase"
                    }
                  }
                },
                "round": {
                  "$document": "/activation/state/round"
                }
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$nodeBlueId": {
                          "$document": "/activation/type"
                        }
                      },
                      {
                        "$document": "/type/activationType"
                      }
                    ]
                  }
                },
                "message": "UNSUPPORTED_ACTIVATION_CLAUSE_TYPE"
              }
            },
            {
              "$if": {
                "cond": {
                  "$and": [
                    {
                      "$eq": [
                        {
                          "$document": "/activation/state/phase"
                        },
                        "CONSENTED"
                      ]
                    },
                    {
                      "$hasKey": {
                        "object": {
                          "$document": "/activation/state/settled/clauses"
                        },
                        "key": "immediateTermination"
                      }
                    }
                  ]
                },
                "then": [
                  {
                    "$failIf": {
                      "cond": {
                        "$not": {
                          "$isKind": {
                            "val": {
                              "$document": "/activation/state/settled/clauses/immediateTermination"
                            },
                            "kind": "object"
                          }
                        }
                      },
                      "message": "INVALID_TERMINATION_TERMS"
                    }
                  },
                  {
                    "$failIf": {
                      "cond": {
                        "$not": {
                          "$eq": [
                            {
                              "$nodeBlueId": {
                                "$document": "/activation/state/settled/clauses/immediateTermination/type"
                              }
                            },
                            {
                              "$document": "/type/terminationTermsType"
                            }
                          ]
                        }
                      },
                      "message": "UNSUPPORTED_TERMINATION_TERMS_TYPE"
                    }
                  },
                  {
                    "$failIf": {
                      "cond": {
                        "$not": {
                          "$isEmpty": {
                            "$filter": {
                              "in": {
                                "$keys": {
                                  "$document": "/activation/state/settled/clauses/immediateTermination"
                                }
                              },
                              "item": "key",
                              "where": {
                                "$not": {
                                  "$includes": {
                                    "list": [
                                      "type",
                                      "name",
                                      "description",
                                      "allowedParty"
                                    ],
                                    "val": {
                                      "$var": "key"
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      },
                      "message": "UNSUPPORTED_TERMINATION_TERMS_FIELD"
                    }
                  },
                  {
                    "$failIf": {
                      "cond": {
                        "$not": {
                          "$includes": {
                            "list": [
                              "A",
                              "B",
                              "EITHER"
                            ],
                            "val": {
                              "$document": "/activation/state/settled/clauses/immediateTermination/allowedParty"
                            }
                          }
                        }
                      },
                      "message": "INVALID_TERMINATION_PARTY"
                    }
                  },
                  {
                    "$if": {
                      "cond": {
                        "$not": {
                          "$hasKey": {
                            "object": {
                              "$document": "/clauses"
                            },
                            "key": "immediateTermination"
                          }
                        }
                      },
                      "then": [
                        {
                          "$appendChange": {
                            "op": "add",
                            "path": "/clauses/immediateTermination",
                            "val": {
                              "$objectSet": {
                                "object": {
                                  "agreementId": {
                                    "$document": "/agreementId"
                                  },
                                  "agreementType": {
                                    "$nodeBlueId": {
                                      "$document": "/type"
                                    }
                                  },
                                  "partyA": {
                                    "$document": "/partyA"
                                  },
                                  "partyB": {
                                    "$document": "/partyB"
                                  },
                                  "allowedParty": {
                                    "$document": "/activation/state/settled/clauses/immediateTermination/allowedParty"
                                  },
                                  "termsId": {
                                    "$document": "/activation/state/targetId"
                                  },
                                  "round": {
                                    "$document": "/activation/state/round"
                                  },
                                  "contracts": {
                                    "partyA": {
                                      "$document": "/contracts/partyA"
                                    },
                                    "partyB": {
                                      "$document": "/contracts/partyB"
                                    }
                                  }
                                },
                                "key": "type",
                                "val": {
                                  "$objectSet": {
                                    "object": {},
                                    "key": "blueId",
                                    "val": {
                                      "$document": "/type/terminationClauseType"
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    "lifecycle": {
      "type": "Contracts/Lifecycle Event Channel",
      "event": {
        "type": "Contracts/Document Processing Initiated"
      }
    },
    "initialize": {
      "type": "Contracts/Sequential Workflow",
      "channel": "lifecycle",
      "steps": [
        {
          "type": "Contracts/Compute",
          "do": [
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$isEmpty": {
                      "$filter": {
                        "in": {
                          "$keys": {
                            "$document": "/contracts"
                          }
                        },
                        "item": "key",
                        "where": {
                          "$not": {
                            "$includes": {
                              "list": {
                                "$listConcat": [
                                  {
                                    "$document": "/type/declaredContracts"
                                  },
                                  [
                                    "initialized",
                                    "checkpoint",
                                    "terminated"
                                  ]
                                ]
                              },
                              "val": {
                                "$var": "key"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "message": "UNAPPROVED_CONTRACT_DECLARATION"
              }
            },
            {
              "$forEach": {
                "in": {
                  "$document": "/type/declaredContracts"
                },
                "item": "guardContract",
                "do": [
                  {
                    "$if": {
                      "cond": {
                        "$not": {
                          "$includes": {
                            "list": [
                              "partyA",
                              "partyB"
                            ],
                            "val": {
                              "$var": "guardContract"
                            }
                          }
                        }
                      },
                      "then": [
                        {
                          "$failIf": {
                            "cond": {
                              "$not": {
                                "$eq": [
                                  {
                                    "$nodeBlueId": {
                                      "$document": {
                                        "$concat": [
                                          "/contracts/",
                                          {
                                            "$var": "guardContract"
                                          }
                                        ]
                                      }
                                    }
                                  },
                                  {
                                    "$nodeBlueId": {
                                      "$document": {
                                        "$concat": [
                                          "/type/contracts/",
                                          {
                                            "$var": "guardContract"
                                          }
                                        ]
                                      }
                                    }
                                  }
                                ]
                              }
                            },
                            "message": "EXECUTABLE_OVERRIDE_NOT_ALLOWED"
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$document": "/activation/agreementId"
                      },
                      {
                        "$document": "/agreementId"
                      }
                    ]
                  }
                },
                "message": "CLAUSE_AGREEMENT_MISMATCH"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$nodeBlueId": {
                          "$document": "/activation/partyA"
                        }
                      },
                      {
                        "$nodeBlueId": {
                          "$document": "/partyA"
                        }
                      }
                    ]
                  }
                },
                "message": "CLAUSE_PARTY_A_MISMATCH"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$nodeBlueId": {
                          "$document": "/activation/partyB"
                        }
                      },
                      {
                        "$nodeBlueId": {
                          "$document": "/partyB"
                        }
                      }
                    ]
                  }
                },
                "message": "CLAUSE_PARTY_B_MISMATCH"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$nodeBlueId": {
                          "$document": "/activation/type"
                        }
                      },
                      {
                        "$document": "/activationType"
                      }
                    ]
                  }
                },
                "message": "CLAUSE_TYPE_MISMATCH"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$document": "/activation/agreementType"
                      },
                      {
                        "$nodeBlueId": {
                          "$document": "/type"
                        }
                      }
                    ]
                  }
                },
                "message": "AGREEMENT_TYPE_MISMATCH"
              }
            },
            {
              "$appendChange": {
                "op": "add",
                "path": "/phase",
                "val": "NEGOTIATING"
              }
            },
            {
              "$appendChange": {
                "op": "add",
                "path": "/acceptedRevision",
                "val": {}
              }
            },
            {
              "$appendChange": {
                "op": "add",
                "path": "/terms",
                "val": {
                  "$document": "/activation/initialTerms"
                }
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$nodeBlueId": {
                          "$document": "/activation/type"
                        }
                      },
                      {
                        "$document": "/type/activationType"
                      }
                    ]
                  }
                },
                "message": "UNSUPPORTED_ACTIVATION_CLAUSE_TYPE"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$isKind": {
                      "val": {
                        "$document": "/activation/initialTerms/clauses"
                      },
                      "kind": "object"
                    }
                  }
                },
                "message": "INITIAL_TERMS_CLAUSES_REQUIRED"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$isEmpty": {
                      "$keys": {
                        "$document": "/clauses"
                      }
                    }
                  }
                },
                "message": "RUNTIME_CLAUSES_MUST_START_EMPTY"
              }
            },
            {
              "$appendChange": {
                "op": "add",
                "path": "/termination",
                "val": {}
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$nodeBlueId": {
                          "$document": "/contracts/partyA/actor"
                        }
                      },
                      {
                        "$nodeBlueId": {
                          "$document": "/partyA"
                        }
                      }
                    ]
                  }
                },
                "message": "PARTY_A_CHANNEL_MISMATCH"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$nodeBlueId": {
                          "$document": "/contracts/partyB/actor"
                        }
                      },
                      {
                        "$nodeBlueId": {
                          "$document": "/partyB"
                        }
                      }
                    ]
                  }
                },
                "message": "PARTY_B_CHANNEL_MISMATCH"
              }
            }
          ]
        }
      ]
    },
    "guardActivation": {
      "type": "Contracts/Sequential Workflow",
      "channel": "clauseProgress",
      "order": -1,
      "steps": [
        {
          "type": "Contracts/Compute",
          "do": [
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$ne": [
                      {
                        "$document": "/phase"
                      },
                      "TERMINATED"
                    ]
                  }
                },
                "message": "AGREEMENT_TERMINATED"
              }
            }
          ]
        }
      ]
    },
    "terminationProgress": {
      "type": "Contracts/Embedded Node Channel",
      "sourcePath": "/clauses/immediateTermination",
      "event": {
        "type": "ImmediateTermination/Termination Exercised"
      }
    },
    "applyTermination": {
      "type": "Contracts/Sequential Workflow",
      "channel": "terminationProgress",
      "steps": [
        {
          "type": "Contracts/Compute",
          "constants": {
            "terminatedType": {
              "type": "ImmediateTermination/Agreement Terminated"
            }
          },
          "do": [
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$isEmpty": {
                      "$filter": {
                        "in": {
                          "$keys": {
                            "$document": "/contracts"
                          }
                        },
                        "item": "key",
                        "where": {
                          "$not": {
                            "$includes": {
                              "list": {
                                "$listConcat": [
                                  {
                                    "$document": "/type/declaredContracts"
                                  },
                                  [
                                    "initialized",
                                    "checkpoint",
                                    "terminated"
                                  ]
                                ]
                              },
                              "val": {
                                "$var": "key"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "message": "UNAPPROVED_CONTRACT_DECLARATION"
              }
            },
            {
              "$forEach": {
                "in": {
                  "$document": "/type/declaredContracts"
                },
                "item": "guardContract",
                "do": [
                  {
                    "$if": {
                      "cond": {
                        "$not": {
                          "$includes": {
                            "list": [
                              "partyA",
                              "partyB"
                            ],
                            "val": {
                              "$var": "guardContract"
                            }
                          }
                        }
                      },
                      "then": [
                        {
                          "$failIf": {
                            "cond": {
                              "$not": {
                                "$eq": [
                                  {
                                    "$nodeBlueId": {
                                      "$document": {
                                        "$concat": [
                                          "/contracts/",
                                          {
                                            "$var": "guardContract"
                                          }
                                        ]
                                      }
                                    }
                                  },
                                  {
                                    "$nodeBlueId": {
                                      "$document": {
                                        "$concat": [
                                          "/type/contracts/",
                                          {
                                            "$var": "guardContract"
                                          }
                                        ]
                                      }
                                    }
                                  }
                                ]
                              }
                            },
                            "message": "EXECUTABLE_OVERRIDE_NOT_ALLOWED"
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$event": "/sourcePath"
                      },
                      "/clauses/immediateTermination"
                    ]
                  }
                },
                "message": "INVALID_TERMINATION_SOURCE"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$nodeBlueId": {
                          "$document": "/clauses/immediateTermination/type"
                        }
                      },
                      {
                        "$document": "/type/terminationClauseType"
                      }
                    ]
                  }
                },
                "message": "UNSUPPORTED_TERMINATION_CLAUSE_TYPE"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$document": "/clauses/immediateTermination/agreementId"
                      },
                      {
                        "$document": "/agreementId"
                      }
                    ]
                  }
                },
                "message": "CLAUSE_AGREEMENT_MISMATCH"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$document": "/clauses/immediateTermination/agreementType"
                      },
                      {
                        "$nodeBlueId": {
                          "$document": "/type"
                        }
                      }
                    ]
                  }
                },
                "message": "AGREEMENT_TYPE_MISMATCH"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$nodeBlueId": {
                          "$document": "/clauses/immediateTermination/partyA"
                        }
                      },
                      {
                        "$nodeBlueId": {
                          "$document": "/partyA"
                        }
                      }
                    ]
                  }
                },
                "message": "CLAUSE_PARTY_A_MISMATCH"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$nodeBlueId": {
                          "$document": "/clauses/immediateTermination/partyB"
                        }
                      },
                      {
                        "$nodeBlueId": {
                          "$document": "/partyB"
                        }
                      }
                    ]
                  }
                },
                "message": "CLAUSE_PARTY_B_MISMATCH"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$nodeBlueId": {
                          "$document": "/clauses/immediateTermination/contracts/partyA"
                        }
                      },
                      {
                        "$nodeBlueId": {
                          "$document": "/contracts/partyA"
                        }
                      }
                    ]
                  }
                },
                "message": "TERMINATION_CHANNEL_A_MISMATCH"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$nodeBlueId": {
                          "$document": "/clauses/immediateTermination/contracts/partyB"
                        }
                      },
                      {
                        "$nodeBlueId": {
                          "$document": "/contracts/partyB"
                        }
                      }
                    ]
                  }
                },
                "message": "TERMINATION_CHANNEL_B_MISMATCH"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$document": "/clauses/immediateTermination/allowedParty"
                      },
                      {
                        "$document": "/terms/clauses/immediateTermination/allowedParty"
                      }
                    ]
                  }
                },
                "message": "TERMINATION_POLICY_MISMATCH"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$document": "/clauses/immediateTermination/termsId"
                      },
                      {
                        "$document": "/acceptedRevision/termsId"
                      }
                    ]
                  }
                },
                "message": "TERMINATION_REVISION_MISMATCH"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$document": "/clauses/immediateTermination/round"
                      },
                      {
                        "$document": "/acceptedRevision/round"
                      }
                    ]
                  }
                },
                "message": "TERMINATION_ROUND_MISMATCH"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$document": "/clauses/immediateTermination/state/phase"
                      },
                      "TERMINATED"
                    ]
                  }
                },
                "message": "TERMINATION_NOT_COMPLETED"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$event": "/event/requestId"
                      },
                      {
                        "$get": {
                          "object": {
                            "$document": "/clauses/immediateTermination/state/termination"
                          },
                          "key": "requestId"
                        }
                      }
                    ]
                  }
                },
                "message": "TERMINATION_NOTICE_MISMATCH"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$event": "/event/termsId"
                      },
                      {
                        "$document": "/acceptedRevision/termsId"
                      }
                    ]
                  }
                },
                "message": "TERMINATION_NOTICE_MISMATCH"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$get": {
                          "object": {
                            "$document": "/clauses/immediateTermination/state/termination"
                          },
                          "key": "termsId"
                        }
                      },
                      {
                        "$document": "/acceptedRevision/termsId"
                      }
                    ]
                  }
                },
                "message": "TERMINATION_REVISION_MISMATCH"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$get": {
                          "object": {
                            "$document": "/clauses/immediateTermination/state/termination"
                          },
                          "key": "round"
                        }
                      },
                      {
                        "$document": "/acceptedRevision/round"
                      }
                    ]
                  }
                },
                "message": "TERMINATION_ROUND_MISMATCH"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$or": [
                      {
                        "$eq": [
                          {
                            "$document": "/terms/clauses/immediateTermination/allowedParty"
                          },
                          "EITHER"
                        ]
                      },
                      {
                        "$eq": [
                          {
                            "$document": "/terms/clauses/immediateTermination/allowedParty"
                          },
                          {
                            "$get": {
                              "object": {
                                "$document": "/clauses/immediateTermination/state/termination"
                              },
                              "key": "party"
                            }
                          }
                        ]
                      }
                    ]
                  }
                },
                "message": "TERMINATION_NOT_PERMITTED"
              }
            },
            {
              "$if": {
                "cond": {
                  "$eq": [
                    {
                      "$document": "/phase"
                    },
                    "TERMINATED"
                  ]
                },
                "then": [
                  {
                    "$failIf": {
                      "cond": {
                        "$not": {
                          "$eq": [
                            {
                              "$nodeBlueId": {
                                "$document": "/termination"
                              }
                            },
                            {
                              "$nodeBlueId": {
                                "$document": "/clauses/immediateTermination/state/termination"
                              }
                            }
                          ]
                        }
                      },
                      "message": "CONFLICTING_TERMINATION"
                    }
                  },
                  {
                    "$return": true
                  }
                ]
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$document": "/phase"
                      },
                      "ACTIVE"
                    ]
                  }
                },
                "message": "AGREEMENT_NOT_ACTIVE"
              }
            },
            {
              "$appendChange": {
                "op": "replace",
                "path": "/phase",
                "val": "TERMINATED"
              }
            },
            {
              "$appendChange": {
                "op": "replace",
                "path": "/termination",
                "val": {
                  "$document": "/clauses/immediateTermination/state/termination"
                }
              }
            },
            {
              "$appendEvent": {
                "$objectSet": {
                  "object": {
                    "$objectSet": {
                      "object": {
                        "$document": "/clauses/immediateTermination/state/termination"
                      },
                      "key": "kind",
                      "val": "Agreement Terminated"
                    }
                  },
                  "key": "type",
                  "val": {
                    "$const": {
                      "name": "terminatedType",
                      "path": "/type"
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "partyA": {
      "type": "Coordination/Timeline Channel"
    },
    "partyB": {
      "type": "Coordination/Timeline Channel"
    }
  }
}
