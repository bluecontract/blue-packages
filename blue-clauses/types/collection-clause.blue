name: Collection Clause
type: Clauses/Clause
description: Embeds a named collection using an existing actor channel, adds an append operation, and counts matching
  child events and document changes. Workflow code stays in the package rather than in clause parameters.
hookDefinition:
  type: Contracts/Compute Definition
  functions:
    validateConfiguration:
      args: {}
      do:
      - $return:
          $choose:
            cond:
              $and:
              - $and:
                - $isKind:
                    val:
                      $pointerGet:
                        object:
                          $pointerGet:
                            default: {}
                            object:
                              $document: /clauseRuntime/work/candidate
                            path:
                              $concat:
                              - /
                              - $const: clauseKey
                        path: /parameters/field
                    kind: text
                - $ne:
                  - $pointerGet:
                      object:
                        $pointerGet:
                          default: {}
                          object:
                            $document: /clauseRuntime/work/candidate
                          path:
                            $concat:
                            - /
                            - $const: clauseKey
                      path: /parameters/field
                  - ''
                - $eq:
                  - $size:
                      $split:
                        text:
                          $pointerGet:
                            object:
                              $pointerGet:
                                default: {}
                                object:
                                  $document: /clauseRuntime/work/candidate
                                path:
                                  $concat:
                                  - /
                                  - $const: clauseKey
                            path: /parameters/field
                        separator: /
                  - 1
                - $eq:
                  - $size:
                      $split:
                        text:
                          $pointerGet:
                            object:
                              $pointerGet:
                                default: {}
                                object:
                                  $document: /clauseRuntime/work/candidate
                                path:
                                  $concat:
                                  - /
                                  - $const: clauseKey
                            path: /parameters/field
                        separator: '~'
                  - 1
              - $and:
                - $isKind:
                    val:
                      $pointerGet:
                        object:
                          $pointerGet:
                            default: {}
                            object:
                              $document: /clauseRuntime/work/candidate
                            path:
                              $concat:
                              - /
                              - $const: clauseKey
                        path: /parameters/operation
                    kind: text
                - $ne:
                  - $pointerGet:
                      object:
                        $pointerGet:
                          default: {}
                          object:
                            $document: /clauseRuntime/work/candidate
                          path:
                            $concat:
                            - /
                            - $const: clauseKey
                      path: /parameters/operation
                  - ''
                - $eq:
                  - $size:
                      $split:
                        text:
                          $pointerGet:
                            object:
                              $pointerGet:
                                default: {}
                                object:
                                  $document: /clauseRuntime/work/candidate
                                path:
                                  $concat:
                                  - /
                                  - $const: clauseKey
                            path: /parameters/operation
                        separator: /
                  - 1
                - $eq:
                  - $size:
                      $split:
                        text:
                          $pointerGet:
                            object:
                              $pointerGet:
                                default: {}
                                object:
                                  $document: /clauseRuntime/work/candidate
                                path:
                                  $concat:
                                  - /
                                  - $const: clauseKey
                            path: /parameters/operation
                        separator: '~'
                  - 1
              - $and:
                - $isKind:
                    val:
                      $pointerGet:
                        object:
                          $pointerGet:
                            default: {}
                            object:
                              $document: /clauseRuntime/work/candidate
                            path:
                              $concat:
                              - /
                              - $const: clauseKey
                        path: /bindings/actor
                    kind: text
                - $ne:
                  - $pointerGet:
                      object:
                        $pointerGet:
                          default: {}
                          object:
                            $document: /clauseRuntime/work/candidate
                          path:
                            $concat:
                            - /
                            - $const: clauseKey
                      path: /bindings/actor
                  - ''
                - $eq:
                  - $size:
                      $split:
                        text:
                          $pointerGet:
                            object:
                              $pointerGet:
                                default: {}
                                object:
                                  $document: /clauseRuntime/work/candidate
                                path:
                                  $concat:
                                  - /
                                  - $const: clauseKey
                            path: /bindings/actor
                        separator: /
                  - 1
                - $eq:
                  - $size:
                      $split:
                        text:
                          $pointerGet:
                            object:
                              $pointerGet:
                                default: {}
                                object:
                                  $document: /clauseRuntime/work/candidate
                                path:
                                  $concat:
                                  - /
                                  - $const: clauseKey
                            path: /bindings/actor
                        separator: '~'
                  - 1
              - $isKind:
                  val:
                    $pointerGet:
                      object:
                        $pointerGet:
                          default: {}
                          object:
                            $document: /clauseRuntime/work/candidate
                          path:
                            $concat:
                            - /
                            - $const: clauseKey
                      path: /parameters/family
                  kind: text
            then:
              allowed: true
              code: ''
            else:
              allowed: false
              code: INVALID_COLLECTION_CONFIGURATION
    validateTransition:
      args: {}
      do:
      - $return:
          allowed: true
          code: ''
    plan:
      args: {}
      do:
      - $let:
          name: p
          expr:
            $pointerGet:
              object:
                $pointerGet:
                  default: {}
                  object:
                    $document: /clauseRuntime/work/candidate
                  path:
                    $concat:
                    - /
                    - $const: clauseKey
              path: /parameters
      - $let:
          name: field
          expr:
            $var:
              name: p
              path: /field
      - $let:
          name: path
          expr:
            $concat:
            - /
            - $var: field
      - $let:
          name: events
          expr:
            $concat:
            - $var: field
            - Events
      - $let:
          name: changes
          expr:
            $concat:
            - $var: field
            - Changes
      - $let:
          name: contributions
          expr: {}
      - $set:
          name: contributions
          expr:
            $objectSet:
              object:
                $var: contributions
              key:
                $var:
                  name: p
                  path: /operation
              val:
                kind: handler
                contract:
                  $merge:
                  - type: Contracts/Sequential Workflow Operation
                  - channel:
                      $pointerGet:
                        object:
                          $pointerGet:
                            default: {}
                            object:
                              $document: /clauseRuntime/work/candidate
                            path:
                              $concat:
                              - /
                              - $const: clauseKey
                        path: /bindings/actor
                    steps:
                    - $merge:
                      - type: Clauses/Append Collection Item Step
                      - constants:
                          path:
                            $var: path
      - $set:
          name: contributions
          expr:
            $objectSet:
              object:
                $var: contributions
              key: embedded
              val:
                kind: embedding
                contract:
                  $merge:
                  - type: Contracts/Process Embedded
                  - collectionPaths:
                    - $var: path
      - $set:
          name: contributions
          expr:
            $objectSet:
              object:
                $var: contributions
              key:
                $var: events
              val:
                kind: channel
                contract:
                  $merge:
                  - type: Contracts/Embedded Node Channel
                  - event:
                      family:
                        $var:
                          name: p
                          path: /family
      - $set:
          name: contributions
          expr:
            $objectSet:
              object:
                $var: contributions
              key:
                $concat:
                - $var: field
                - Report
              val:
                kind: handler
                contract:
                  $merge:
                  - type: Contracts/Sequential Workflow
                  - channel:
                      $var: events
                    steps:
                    - $merge:
                      - type: Clauses/Count Collection Event Step
                      - constants:
                          path:
                            $concat:
                            - /
                            - $var: events
                            - Count
      - $set:
          name: contributions
          expr:
            $objectSet:
              object:
                $var: contributions
              key:
                $var: changes
              val:
                kind: channel
                contract:
                  $merge:
                  - type: Contracts/Document Update Channel
                  - path:
                      $var: path
      - $set:
          name: contributions
          expr:
            $objectSet:
              object:
                $var: contributions
              key:
                $concat:
                - $var: field
                - OnChange
              val:
                kind: handler
                contract:
                  $merge:
                  - type: Contracts/Sequential Workflow
                  - channel:
                      $var: changes
                    steps:
                    - $merge:
                      - type: Clauses/Count Collection Event Step
                      - constants:
                          path:
                            $concat:
                            - /
                            - $var: changes
                            - Count
      - $return:
          contracts:
            $var: contributions
          states:
            collection:
              path:
                $var: path
              kind: object
              initial: {}
            events:
              path:
                $concat:
                - /
                - $var: events
                - Count
              kind: integer
              initial: 0
            changes:
              path:
                $concat:
                - /
                - $var: changes
                - Count
              kind: integer
              initial: 0
          reads: []
transitionUnconditional: true
hookAbi: document-context-1
