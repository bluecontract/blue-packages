name: Dispatch Clause Change Step
type: Contracts/Compute
constants: {}
do:
- $appendEvent:
    $merge:
    - $choose:
        cond:
          $hasKey:
            object:
              $binding: call/request
            key: changes
        then:
          type: Clauses/Amendment Requested
        else:
          type: Clauses/Clause Change Requested
    - actorChannel:
        $const: actorChannel
      request:
        $binding: call/request
