constants: {}
description: Reusable Clause Hook Step definition for the Clauses host profile.
do:
- $let:
    name: decision
    expr:
      $choose:
        cond:
          $eq:
          - $const: mode
          - configuration
        then:
          $choose:
            cond:
              $pointerGet:
                object:
                  $document:
                    $concat:
                    - $choose:
                        cond:
                          $eq:
                          - $const: mode
                          - configuration
                        then: /clauseRuntime/work/candidate/
                        else: /clauses/
                    - $const: clauseKey
                    - /type
                path: /configurationUnconditional
                default: false
            then:
              allowed: true
              code: ''
            else:
              $call:
                function: validateConfiguration
                args: {}
        else:
          $call:
            function: validateTransition
            args: {}
- $if:
    cond:
      $gt:
      - $add:
        - $size:
            $changeset: true
        - $size:
            $events: true
      - 0
    then:
    - $return:
        allowed: false
        code: CLAUSE_HOOK_EFFECTS_NOT_ALLOWED
        changeset: []
        events: []
- $if:
    cond:
      $not:
        $and:
        - $isKind:
            val:
              $var: decision
            kind: object
        - $isKind:
            val:
              $var:
                name: decision
                path: /allowed
            kind: boolean
        - $isKind:
            val:
              $var:
                name: decision
                path: /code
            kind: text
    then:
    - $return:
        allowed: false
        code: INVALID_CLAUSE_DECISION
- $if:
    cond:
      $not:
        $var:
          name: decision
          path: /allowed
    then:
    - $return:
        $var: decision
- $if:
    cond:
      $eq:
      - $const: mode
      - configuration
    then:
    - $let:
        name: plan
        expr:
          $call:
            function: plan
            args: {}
    - $if:
        cond:
          $gt:
          - $add:
            - $size:
                $changeset: true
            - $size:
                $events: true
          - 0
        then:
        - $return:
            allowed: false
            code: CLAUSE_HOOK_EFFECTS_NOT_ALLOWED
            changeset: []
            events: []
    - $if:
        cond:
          $not:
            $and:
            - $isKind:
                val:
                  $var:
                    name: plan
                    path: /states
                kind: object
            - $isKind:
                val:
                  $var:
                    name: plan
                    path: /contracts
                kind: object
            - $isKind:
                val:
                  $var:
                    name: plan
                    path: /reads
                kind: list
        then:
        - $return:
            allowed: false
            code: INVALID_CLAUSE_PLAN
    - $return:
        allowed: true
        code: ''
        plan:
          $var: plan
- $return:
    allowed: true
    code: ''
    governor:
      $pointerGet:
        object:
          $document:
            $concat:
            - $choose:
                cond:
                  $eq:
                  - $const: mode
                  - configuration
                then: /clauseRuntime/work/candidate/
                else: /clauses/
            - $const: clauseKey
            - /type
        path: /governsAmendments
        default: false
functions: {}
name: Clause Hook Step
type: Contracts/Compute
