description: Adopt existing business state of the required kind, or initialize a new root field. An approved update
  may copy an existing field using from.
initial:
  description: Any Blue value; its payload kind must equal kind.
kind:
  type: Text
name: State Claim
path:
  type: Text
from:
  type: Text
  description: Optional source field to copy when initializing or explicitly replacing the destination.
replace:
  type: Boolean
  description: Explicitly replace the destination when this clause configuration changes.
