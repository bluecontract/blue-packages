{
  "functions": {
    "lineTotal": {
      "args": {
        "fee": {
          "type": "Integer"
        },
        "quantity": {
          "type": "Integer"
        },
        "unitPrice": {
          "type": "Integer"
        }
      },
      "expr": {
        "$add": [
          {
            "$multiply": [
              {
                "$var": "unitPrice"
              },
              {
                "$var": "quantity"
              }
            ]
          },
          {
            "$var": "fee"
          }
        ]
      }
    }
  },
  "name": "Totals",
  "type": "contracts/Compute Definition"
}
