{
  "functions": {
    "doubleQuantity": {
      "args": {
        "quantity": {
          "type": "Integer"
        }
      },
      "expr": {
        "$multiply": [
          2,
          {
            "$var": "quantity"
          }
        ]
      }
    }
  },
  "name": "Double Quantity",
  "type": "contracts/Compute Definition"
}
