{
  "contractsSpecification": "8XFSqhtdE4ohsKjS1vJQ9PuDFoCcgiTbwrQVPuASxGT1",
  "coordinationPackage": "EAsWF2axBdjQvGzpEKXrtHQjofqM4boYjx9hFRncWyq2",
  "coordinationSpecification": "EbiCMTFL1SKHxpCsBbbiKLn85WCa1XPGiYMixbEPcTuD",
  "implementation": "owner-approved-operation-authority/1",
  "packageId": "Ey6gBkJ4iHbEKmNkkCf9i3yVEwDYFoZVhih9YYkTZY4V",
  "protocolId": "JCBYJPYZ9QcBqoEWmQcWyWbM5WbbJK1VhyYRmpTTV2r1",
  "rulesId": "EQPFwp1eTDfzsDxiStBraz1nEszdYyKhVFBCfuvgh5Nn",
  "sources": {
    "Mandates/Authority Protocol": {
      "description": "Native Mandates protocol support marker. A data import alone cannot enable delegated authority.",
      "name": "Authority Protocol",
      "type": "Contracts/Marker"
    },
    "Mandates/Document Validation": {
      "description": "Static pattern of the actual target and optional read-only BEX expression-root program. Both apply.",
      "document": {
        "description": "Optional exact static pattern or Mandates/Pattern type witness."
      },
      "function": {
        "description": "Optional read-only expression-root BEX predicate."
      },
      "name": "Document Validation"
    },
    "Mandates/Evidence Requested": {
      "document": {
        "description": "Exact immutable content reference; does not by itself establish history or authority.",
        "schema": {
          "required": true
        }
      },
      "name": "Evidence Requested",
      "operationId": {
        "schema": {
          "minLength": 1,
          "required": true
        },
        "type": "Text"
      },
      "operationRevision": {
        "schema": {
          "minimum": 1,
          "required": true
        },
        "type": "Integer"
      },
      "recipientChannel": {
        "schema": {
          "minLength": 1,
          "required": true
        },
        "type": "Text"
      },
      "requestId": {
        "schema": {
          "minLength": 1,
          "required": true
        },
        "type": "Text"
      },
      "responseOperation": {
        "schema": {
          "minLength": 1,
          "required": true
        },
        "type": "Text"
      },
      "type": "Coordination/Request"
    },
    "Mandates/Evidence Responded": {
      "executionId": {
        "schema": {
          "minLength": 1,
          "required": true
        },
        "type": "Text"
      },
      "executionStatus": {
        "schema": {
          "enum": [
            "Succeeded",
            "Failed",
            "Refused",
            "Unknown"
          ],
          "required": true
        },
        "type": "Text"
      },
      "inResponseTo": {
        "schema": {
          "required": true
        },
        "type": "Mandates/Evidence Requested"
      },
      "name": "Evidence Responded",
      "result": {
        "schema": {
          "required": true
        },
        "type": "Dictionary"
      },
      "type": "Coordination/Response"
    },
    "Mandates/Mandate": {
      "approvedAt": {
        "type": "Integer"
      },
      "contracts": {
        "applyMandateTermination": {
          "channel": "terminationRequests",
          "event": {
            "type": "Mandates/Mandate Termination Requested"
          },
          "steps": [
            {
              "do": [
                {
                  "$appendChange": {
                    "op": "replace",
                    "path": "/status",
                    "val": "Terminated"
                  }
                },
                {
                  "$appendChange": {
                    "op": "add",
                    "path": "/terminatedAt",
                    "val": {
                      "$binding": "timestamp"
                    }
                  }
                },
                {
                  "$appendEvent": {
                    "$objectSet": {
                      "key": "reason",
                      "object": {
                        "$objectSet": {
                          "key": "timestampUs",
                          "object": {
                            "$literal": {
                              "reason": "uninitialized",
                              "timestampUs": 0,
                              "type": "Mandates/Mandate Terminated"
                            }
                          },
                          "val": {
                            "$binding": "timestamp"
                          }
                        }
                      },
                      "val": {
                        "$event": "/reason"
                      }
                    }
                  }
                }
              ],
              "type": "Contracts/Compute"
            },
            {
              "cause": "mandate-terminated",
              "type": "Contracts/Terminate Processing"
            }
          ],
          "type": "Contracts/Sequential Workflow"
        },
        "approveMandate": {
          "channel": "authorityHolderChannel",
          "request": {},
          "steps": [
            {
              "do": [
                {
                  "$failIf": {
                    "cond": {
                      "$not": {
                        "$eq": [
                          {
                            "$document": "/status"
                          },
                          "Pending"
                        ]
                      }
                    },
                    "message": "MANDATE_NOT_PENDING"
                  }
                },
                {
                  "$failIf": {
                    "cond": {
                      "$not": {
                        "$eq": [
                          {
                            "$keys": {
                              "$binding": "call/request"
                            }
                          },
                          []
                        ]
                      }
                    },
                    "message": "EMPTY_REQUEST_REQUIRED"
                  }
                },
                {
                  "$failIf": {
                    "cond": {
                      "$not": {
                        "$eq": [
                          {
                            "$binding": "call/requireExactDocumentVersion"
                          },
                          true
                        ]
                      }
                    },
                    "message": "EXACT_REVIEW_REQUIRED"
                  }
                },
                {
                  "$appendChange": {
                    "op": "replace",
                    "path": "/status",
                    "val": "Active"
                  }
                },
                {
                  "$appendChange": {
                    "op": "add",
                    "path": "/approvedAt",
                    "val": {
                      "$binding": "timestamp"
                    }
                  }
                },
                {
                  "$appendEvent": {
                    "$objectSet": {
                      "key": "reviewedDocumentId",
                      "object": {
                        "$objectSet": {
                          "key": "timestampUs",
                          "object": {
                            "$literal": {
                              "reviewedDocumentId": "uninitialized",
                              "timestampUs": 0,
                              "type": "Mandates/Mandate Approved"
                            }
                          },
                          "val": {
                            "$binding": "timestamp"
                          }
                        }
                      },
                      "val": {
                        "$nodeBlueId": {
                          "$binding": "call/document"
                        }
                      }
                    }
                  }
                }
              ],
              "type": "Contracts/Compute"
            }
          ],
          "type": "Contracts/Sequential Workflow Operation"
        },
        "authorityHolderChannel": {
          "schema": {
            "required": true
          },
          "type": "Coordination/Timeline Channel"
        },
        "authorizedActorChannel": {
          "schema": {
            "required": true
          },
          "type": "Coordination/Timeline Channel"
        },
        "initializeMandate": {
          "channel": "lifecycle",
          "event": {
            "type": "Contracts/Document Processing Initiated"
          },
          "steps": [
            {
              "do": [
                {
                  "$appendChange": {
                    "op": "add",
                    "path": "/status",
                    "val": "Pending"
                  }
                },
                {
                  "$if": {
                    "cond": {
                      "$exists": {
                        "$document": "/approvedAt"
                      }
                    },
                    "then": [
                      {
                        "$appendChange": {
                          "op": "remove",
                          "path": "/approvedAt"
                        }
                      }
                    ]
                  }
                },
                {
                  "$if": {
                    "cond": {
                      "$exists": {
                        "$document": "/terminatedAt"
                      }
                    },
                    "then": [
                      {
                        "$appendChange": {
                          "op": "remove",
                          "path": "/terminatedAt"
                        }
                      }
                    ]
                  }
                },
                {
                  "$appendEvent": {
                    "$literal": {
                      "type": "Mandates/Mandate Initialized"
                    }
                  }
                }
              ],
              "type": "Contracts/Compute"
            }
          ],
          "type": "Contracts/Sequential Workflow"
        },
        "lifecycle": {
          "type": "Contracts/Lifecycle Event Channel"
        },
        "mandateProtocol": {
          "type": "Mandates/Authority Protocol"
        },
        "terminateMandate": {
          "channel": "authorityHolderChannel",
          "request": {
            "reason": {
              "schema": {
                "minLength": 1,
                "required": true
              },
              "type": "Text"
            }
          },
          "steps": [
            {
              "do": [
                {
                  "$failIf": {
                    "cond": {
                      "$not": {
                        "$or": [
                          {
                            "$eq": [
                              {
                                "$document": "/status"
                              },
                              "Pending"
                            ]
                          },
                          {
                            "$eq": [
                              {
                                "$document": "/status"
                              },
                              "Active"
                            ]
                          }
                        ]
                      }
                    },
                    "message": "MANDATE_ENDED"
                  }
                },
                {
                  "$failIf": {
                    "cond": {
                      "$not": {
                        "$eq": [
                          {
                            "$keys": {
                              "$binding": "call/request"
                            }
                          },
                          [
                            "reason"
                          ]
                        ]
                      }
                    },
                    "message": "ONLY_REASON_REQUIRED"
                  }
                },
                {
                  "$appendEvent": {
                    "$objectSet": {
                      "key": "reason",
                      "object": {
                        "$literal": {
                          "reason": "uninitialized",
                          "type": "Mandates/Mandate Termination Requested"
                        }
                      },
                      "val": {
                        "$binding": "call/request/reason"
                      }
                    }
                  }
                }
              ],
              "type": "Contracts/Compute"
            }
          ],
          "type": "Contracts/Sequential Workflow Operation"
        },
        "terminationRequests": {
          "type": "Contracts/Triggered Event Channel"
        }
      },
      "description": "Two-role owner-approved authority program. No mandatory guarantor. The base alone grants no target operation.",
      "name": "Mandate",
      "status": {
        "type": "Mandates/Status"
      },
      "terminatedAt": {
        "type": "Integer"
      }
    },
    "Mandates/Mandate Approved": {
      "name": "Mandate Approved",
      "reviewedDocumentId": {
        "schema": {
          "minLength": 1,
          "required": true
        },
        "type": "Text"
      },
      "timestampUs": {
        "schema": {
          "minimum": 0,
          "required": true
        },
        "type": "Integer"
      },
      "type": "Coordination/Event"
    },
    "Mandates/Mandate Authority": {
      "description": "Entry-level authority claim referencing the original pre-initialization Mandate, not a selected newer snapshot.",
      "mandate": {
        "schema": {
          "required": true
        },
        "type": "Mandates/Mandate"
      },
      "name": "Mandate Authority",
      "type": "Coordination/Authority"
    },
    "Mandates/Mandate Initialized": {
      "description": "A fresh Pending lineage was initialized. It has no usable authority.",
      "name": "Mandate Initialized",
      "status": {
        "type": "Mandates/Status",
        "value": "Pending"
      },
      "type": "Coordination/Event"
    },
    "Mandates/Mandate Terminated": {
      "name": "Mandate Terminated",
      "reason": {
        "schema": {
          "minLength": 1,
          "required": true
        },
        "type": "Text"
      },
      "timestampUs": {
        "schema": {
          "minimum": 0,
          "required": true
        },
        "type": "Integer"
      },
      "type": "Coordination/Event"
    },
    "Mandates/Mandate Termination Requested": {
      "description": "Internal triggered lifecycle signal, not an external request to another participant.",
      "name": "Mandate Termination Requested",
      "reason": {
        "schema": {
          "minLength": 1,
          "required": true
        },
        "type": "Text"
      },
      "type": "Coordination/Event"
    },
    "Mandates/Operation Grant": {
      "description": "One complete alternative. Never combine conditions from different grants.",
      "name": "Operation Grant",
      "target": {
        "schema": {
          "required": true
        },
        "type": "Mandates/Operation Target"
      },
      "validation": {
        "type": "Mandates/Request Validation"
      }
    },
    "Mandates/Operation Mandate": {
      "contracts": {
        "clearOperationScope": {
          "channel": "terminationRequests",
          "event": {
            "type": "Mandates/Mandate Termination Requested"
          },
          "order": -10,
          "steps": [
            {
              "do": [
                {
                  "$appendChange": {
                    "op": "replace",
                    "path": "/scope",
                    "val": {
                      "$emptyObject": true
                    }
                  }
                },
                {
                  "$appendEvent": {
                    "$objectSet": {
                      "key": "scopeId",
                      "object": {
                        "$objectSet": {
                          "key": "timestampUs",
                          "object": {
                            "$literal": {
                              "scopeId": "uninitialized",
                              "timestampUs": 0,
                              "type": "Mandates/Scope Changed"
                            }
                          },
                          "val": {
                            "$binding": "timestamp"
                          }
                        }
                      },
                      "val": {
                        "$nodeBlueId": {
                          "$resultValue": "/scope"
                        }
                      }
                    }
                  }
                }
              ],
              "type": "Contracts/Compute"
            }
          ],
          "type": "Contracts/Sequential Workflow"
        },
        "initializeOperationScope": {
          "channel": "lifecycle",
          "event": {
            "type": "Contracts/Document Processing Initiated"
          },
          "order": 10,
          "steps": [
            {
              "do": [
                {
                  "$appendChange": {
                    "op": "add",
                    "path": "/scope",
                    "val": {
                      "$coalesce": [
                        {
                          "$document": "/scope"
                        },
                        {
                          "$emptyObject": true
                        }
                      ]
                    }
                  }
                }
              ],
              "type": "Contracts/Compute"
            }
          ],
          "type": "Contracts/Sequential Workflow"
        },
        "notifyScopeChanged": {
          "channel": "scopeUpdates",
          "event": {
            "type": "Contracts/Document Update"
          },
          "steps": [
            {
              "do": [
                {
                  "$if": {
                    "cond": {
                      "$eq": [
                        {
                          "$document": "/status"
                        },
                        "Active"
                      ]
                    },
                    "then": [
                      {
                        "$appendEvent": {
                          "$objectSet": {
                            "key": "scopeId",
                            "object": {
                              "$objectSet": {
                                "key": "timestampUs",
                                "object": {
                                  "$literal": {
                                    "scopeId": "uninitialized",
                                    "timestampUs": 0,
                                    "type": "Mandates/Scope Changed"
                                  }
                                },
                                "val": {
                                  "$binding": "timestamp"
                                }
                              }
                            },
                            "val": {
                              "$nodeBlueId": {
                                "$resultValue": "/scope"
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              ],
              "type": "Contracts/Compute"
            }
          ],
          "type": "Contracts/Sequential Workflow"
        },
        "scopeUpdates": {
          "path": "/scope",
          "type": "Contracts/Document Update Channel"
        }
      },
      "description": "One holder and one delegate, any number of complete operation grants and targets.",
      "grantTemplates": {
        "type": "Mandates/Scope"
      },
      "name": "Operation Mandate",
      "scope": {
        "type": "Mandates/Scope"
      },
      "type": "Mandates/Mandate"
    },
    "Mandates/Operation Target": {
      "channel": {
        "schema": {
          "minLength": 1,
          "required": true
        },
        "type": "Text"
      },
      "documentValidation": {
        "type": "Mandates/Document Validation"
      },
      "initialDocument": {
        "description": "Optional exact initial target identity."
      },
      "name": "Operation Target",
      "operation": {
        "schema": {
          "minLength": 1,
          "required": true
        },
        "type": "Text"
      }
    },
    "Mandates/Pattern": {
      "description": "An empty dictionary type witness. Its valueType is the exact static Blue pattern definition, validated in definition role rather than as a completed message.",
      "name": "Pattern",
      "schema": {
        "maxFields": 0
      },
      "type": "Dictionary"
    },
    "Mandates/Qualification Mandate": {
      "contracts": {
        "evidenceProviderChannel": {
          "schema": {
            "required": true
          },
          "type": "Coordination/Timeline Channel"
        },
        "initializeQualification": {
          "channel": "lifecycle",
          "event": {
            "type": "Contracts/Document Processing Initiated"
          },
          "order": 20,
          "steps": [
            {
              "do": [
                {
                  "$appendChange": {
                    "op": "add",
                    "path": "/stage",
                    "val": "AwaitingEvidence"
                  }
                },
                {
                  "$appendChange": {
                    "op": "add",
                    "path": "/scope",
                    "val": {
                      "$emptyObject": true
                    }
                  }
                },
                {
                  "$appendChange": {
                    "op": "add",
                    "path": "/pendingEvidence",
                    "val": {
                      "$emptyObject": true
                    }
                  }
                },
                {
                  "$appendChange": {
                    "op": "add",
                    "path": "/evidenceResponse",
                    "val": {
                      "$emptyObject": true
                    }
                  }
                }
              ],
              "type": "Contracts/Compute"
            }
          ],
          "type": "Contracts/Sequential Workflow"
        },
        "provideEvidence": {
          "channel": "evidenceProviderChannel",
          "request": {
            "type": "Mandates/Evidence Responded"
          },
          "steps": [
            {
              "do": [
                {
                  "$let": {
                    "expr": {
                      "$binding": "call/request"
                    },
                    "name": "reply"
                  }
                },
                {
                  "$if": {
                    "cond": {
                      "$exists": {
                        "$document": "/evidenceResponse/executionId"
                      }
                    },
                    "then": [
                      {
                        "$if": {
                          "cond": {
                            "$eq": [
                              {
                                "$nodeBlueId": {
                                  "$document": "/evidenceResponse"
                                }
                              },
                              {
                                "$nodeBlueId": {
                                  "$var": "reply"
                                }
                              }
                            ]
                          },
                          "then": [
                            {
                              "$return": true
                            }
                          ]
                        }
                      },
                      {
                        "$failIf": {
                          "cond": {
                            "$not": {
                              "$eq": [
                                {
                                  "$document": "/evidenceResponse/executionId"
                                },
                                {
                                  "$var": {
                                    "name": "reply",
                                    "path": "/executionId"
                                  }
                                }
                              ]
                            }
                          },
                          "message": "EXECUTION_MISMATCH"
                        }
                      }
                    ]
                  }
                },
                {
                  "$failIf": {
                    "cond": {
                      "$not": {
                        "$eq": [
                          {
                            "$document": "/status"
                          },
                          "Active"
                        ]
                      }
                    },
                    "message": "MANDATE_NOT_ACTIVE"
                  }
                },
                {
                  "$failIf": {
                    "cond": {
                      "$not": {
                        "$eq": [
                          {
                            "$document": "/stage"
                          },
                          "EvidencePending"
                        ]
                      }
                    },
                    "message": "NO_PENDING_EVIDENCE"
                  }
                },
                {
                  "$if": {
                    "cond": {
                      "$eq": [
                        {
                          "$var": {
                            "name": "reply",
                            "path": "/executionStatus"
                          }
                        },
                        "Succeeded"
                      ]
                    },
                    "else": [
                      {
                        "$failIf": {
                          "cond": {
                            "$not": {
                              "$eq": [
                                {
                                  "$keys": {
                                    "$var": {
                                      "name": "reply",
                                      "path": "/result"
                                    }
                                  }
                                },
                                []
                              ]
                            }
                          },
                          "message": "NON_SUCCESS_RESULT_MUST_BE_EMPTY"
                        }
                      }
                    ],
                    "then": [
                      {
                        "$failIf": {
                          "cond": {
                            "$not": {
                              "$eq": [
                                {
                                  "$keys": {
                                    "$var": {
                                      "name": "reply",
                                      "path": "/result"
                                    }
                                  }
                                },
                                [
                                  "qualified"
                                ]
                              ]
                            }
                          },
                          "message": "QUALIFIED_RESULT_REQUIRED"
                        }
                      },
                      {
                        "$failIf": {
                          "cond": {
                            "$not": {
                              "$isKind": {
                                "kind": "boolean",
                                "val": {
                                  "$var": {
                                    "name": "reply",
                                    "path": "/result/qualified"
                                  }
                                }
                              }
                            }
                          },
                          "message": "QUALIFIED_BOOLEAN_REQUIRED"
                        }
                      }
                    ]
                  }
                },
                {
                  "$let": {
                    "expr": {
                      "$objectSet": {
                        "key": "result",
                        "object": {
                          "$objectSet": {
                            "key": "executionStatus",
                            "object": {
                              "$objectSet": {
                                "key": "executionId",
                                "object": {
                                  "$objectSet": {
                                    "key": "inResponseTo",
                                    "object": {
                                      "$literal": {
                                        "executionId": "uninitialized",
                                        "executionStatus": "Unknown",
                                        "inResponseTo": {
                                          "document": {
                                            "subject": "placeholder"
                                          },
                                          "operationId": "uninitialized",
                                          "operationRevision": 1,
                                          "recipientChannel": "evidenceProviderChannel",
                                          "requestId": "uninitialized",
                                          "responseOperation": "provideEvidence",
                                          "type": "Mandates/Evidence Requested"
                                        },
                                        "result": {},
                                        "type": "Mandates/Evidence Responded"
                                      }
                                    },
                                    "val": {
                                      "$document": "/pendingEvidence"
                                    }
                                  }
                                },
                                "val": {
                                  "$var": {
                                    "name": "reply",
                                    "path": "/executionId"
                                  }
                                }
                              }
                            },
                            "val": {
                              "$var": {
                                "name": "reply",
                                "path": "/executionStatus"
                              }
                            }
                          }
                        },
                        "val": {
                          "$choose": {
                            "cond": {
                              "$eq": [
                                {
                                  "$var": {
                                    "name": "reply",
                                    "path": "/executionStatus"
                                  }
                                },
                                "Succeeded"
                              ]
                            },
                            "else": {
                              "$emptyObject": true
                            },
                            "then": {
                              "qualified": {
                                "$var": {
                                  "name": "reply",
                                  "path": "/result/qualified"
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "name": "expected"
                  }
                },
                {
                  "$failIf": {
                    "cond": {
                      "$not": {
                        "$eq": [
                          {
                            "$nodeBlueId": {
                              "$var": "expected"
                            }
                          },
                          {
                            "$nodeBlueId": {
                              "$var": "reply"
                            }
                          }
                        ]
                      }
                    },
                    "message": "RESPONSE_REQUEST_MISMATCH"
                  }
                },
                {
                  "$appendChange": {
                    "op": "add",
