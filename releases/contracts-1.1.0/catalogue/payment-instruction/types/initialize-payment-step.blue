name: Initialize Payment Step
type: Contracts/Compute
definition:
  type: PaymentInstruction/Payment Protocol Functions
do:
- $if:
    cond:
      $and:
      - $not:
          $exists:
            $document: /payment/accepted
      - $or:
        - $not:
            $exists:
              $document: /clauses/activation
        - $eq:
          - $document: /activation/active
          - true
    then:
    - $call:
        function: initialize
constants:
  sourceMode: initialized
