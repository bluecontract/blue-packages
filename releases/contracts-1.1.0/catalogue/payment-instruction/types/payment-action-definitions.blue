name: Payment Action Definitions
type: Clauses/Clause
description: Internal reusable request actions. Guarantor operations belong to Payment
  Instruction, never to this action library.
actionDefinition:
  type: PaymentInstruction/Payment Protocol Functions
actions:
  type: Dictionary
  valueType:
    type: Connections/Action Declaration
  approveRecipient:
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: approveRecipient
    - $set:
        name: actionResult
        expr:
          $merge:
          - $var: actionResult
          - outcome:
              $choose:
                cond:
                  $or:
                  - $eq:
                    - $var:
                        name: actionResult
                        path: /created
                    - true
                  - $eq:
                    - $var:
                        name: actionResult
                        path: /changed
                    - true
                then: acceptedNew
                else: duplicate
    resultContract: outcome-v1
  requestCapture:
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: request
            args:
              action: capture
              input:
                $var: params
    - $set:
        name: actionResult
        expr:
          $merge:
          - $var: actionResult
          - outcome:
              $choose:
                cond:
                  $or:
                  - $eq:
                    - $var:
                        name: actionResult
                        path: /created
                    - true
                  - $eq:
                    - $var:
                        name: actionResult
                        path: /changed
                    - true
                then: acceptedNew
                else: duplicate
    resultContract: outcome-v1
