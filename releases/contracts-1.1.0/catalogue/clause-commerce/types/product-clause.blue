name: Product Clause
type: Connections/Connected Clause
description: Update a document-owned product quote with bounded integer price and quantity.
bindingTypes:
  product: pointer
actions:
  quote:
    do:
    - $let:
        name: quoteResult
        expr:
          $call:
            function: quote
            args:
              input:
                $var: params
actionDefinition:
  type: Commerce/Product Functions
