name: Shipment Process Clause
type: Shipping/Shipping Request Actions
description: Native shipment requests with shared action conditions and explicit named-source readiness. Only the carrier confirms shipment outcomes.
actions:
  requestShipment:
    require:
      when:
        $or:
        - $not:
            $exists:
              $document: /clauses/documentSources
        - $eq:
          - $document: /sourceLinks/ready
          - true
      message: SHIPMENT_SOURCES_NOT_READY
