name: Shipping Request Actions
type: Connections/Connected Clause
actionDefinition:
  type: Shipping/Shipping Functions
actions:
  requestShipment:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: requestShipment
            args:
              input:
                $var: params
  requestCancellation:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: requestCancellation
            args:
              input:
                $var: params
  requestAddressChange:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: requestAddressChange
            args:
              input:
                $var: params
