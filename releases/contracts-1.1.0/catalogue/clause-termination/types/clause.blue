name: Termination Clause
type: Connections/Connected Clause
bindingTypes:
  state: pointer
  ready: pointer
actionDefinition:
  type: Termination/Termination Functions
actions:
  request:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: request
            args:
              input:
                $var: params
  finish:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: finish
            args:
              input:
                $var: params
defaultBindings:
  state: /lifecycle
  ready: /canTerminate
