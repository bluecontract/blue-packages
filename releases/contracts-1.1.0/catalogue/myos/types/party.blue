name: MyOS Party
type: Parties/Party
description: A Party whose representatives use MyOS accounts. myosAccountId and email are shortcuts for the lead representative; when both are supplied they must identify the same account.
myosAccountId:
  type: Text
email:
  type: Text
lead:
  type: MyOS/MyOS Representative
representatives:
  type: Dictionary
  valueType: MyOS/MyOS Representative
