name: Document Base
type: Clauses/Clause
hookAbi: document-context-1
hookDefinition:
  type: Documents/Preparation Plan
actionDefinition:
  type: Documents/Preparation Functions
cardinality:
  type: Text
destinationBinding:
  type: Text
readParametersFromDocument: true
bindingTypes:
  parties: object
  sources: object
  template: pointer
defaultBindings:
  parties: {}
  sources: {}
actions:
  prepare:
    resultContract: outcome-v1
    defaults:
      fields: {}
      values: {}
    preflight:
    - $set:
        name: actionResult
        expr:
          $call:
            function: checkPreparation
            args:
              input:
                $var: params
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: sharedPrepare
            args:
              input:
                $var: params
              checked:
                $var: actionResult
  provide:
    resultContract: outcome-v1
    defaults:
      key:
        $pointerGet:
          object:
            $pointerSet:
              object:
                $object:
                  $var: trigger
              path: /type
              op: remove
          path: /key
          default: single
      inResponseTo:
        $pointerGet:
          object:
            $pointerSet:
              object:
                $object:
                  $var: trigger
              path: /type
              op: remove
          path: /inResponseTo
          default: ''
      requirementRef:
        $pointerGet:
          object:
            $pointerSet:
              object:
                $object:
                  $var: trigger
              path: /type
              op: remove
          path: /requirementRef
          default: ''
      document:
        $pointerGet:
          object:
            $pointerSet:
              object:
                $object:
                  $var: trigger
              path: /type
              op: remove
          path: /document
          default: ''
    preflight:
    - $set:
        name: actionResult
        expr:
          $call:
            function: checkProvision
            args:
              input:
                $var: params
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: sharedProvide
            args:
              checked:
                $var: actionResult
  resume:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: sharedRefresh
            args: {}
  cancel:
    resultContract: outcome-v1
    defaults:
      key:
        $pointerGet:
          object:
            $var: trigger
          path: /key
          default: single
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: sharedCancel
            args:
              input:
                $var: params
    preflight:
    - $set:
        name: actionResult
        expr:
          $call:
            function: checkCancellation
            args:
              input:
                $var: params
optionalBindings:
- template
snapshotBindings:
- template
