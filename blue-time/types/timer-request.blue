{
  "name": "Timer Request",
  "description": "A committed effect requests one firing at an explicit Unix timestamp in microseconds. No clock read or relative delay is implied.",
  "channel": {
    "type": "Text",
    "schema": {
      "required": true,
      "minLength": 1
    }
  },
  "timestamp": {
    "type": "Integer",
    "schema": {
      "required": true,
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "key": {
    "type": "Text",
    "schema": {
      "minLength": 1
    }
  },
  "context": {}
}
