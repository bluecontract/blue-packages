#!/bin/sh
set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
case "${1:-verify}" in
  verify) exec "${BLUE_PYTHON:-python3}" "$HERE/../tools/release.py" check ;;
  inspect) cat "$HERE/dist/package.json" ;;
  example) cat "$HERE/examples/two-timers.blue" ;;
  *) echo 'This frozen native publication supports verify, inspect and example. Prepare a new protocol revision before rebuilding.' >&2; exit 2 ;;
esac
