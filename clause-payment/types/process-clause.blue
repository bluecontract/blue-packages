name: Payment Process Clause
type: Payment/Conditional Payment Clause
description: PI-local request actions and a statically validated conditional capture
  policy. Every capture path uses the native instruction gate; only the guarantor
  confirms money.
hookDefinition:
  type: Payment/Payment Process Plan
readParametersFromDocument: true
actions:
  requestAuthorize:
    defaults:
      amountMinor:
        $document: /paymentTerms/amountMinor
  requestCapture:
    defaults:
      amountMinor:
        $document: /paymentTerms/amountMinor
hookAbi: document-context-1
paymentPolicyAction: capture
