name: Payment Process Clause
type: Payment/Conditional Payment Clause
description: PI-local request actions, conditional capture and optional adjustments
  to the selected original payment. The guarantor confirms money.
hookDefinition:
  type: Payment/Payment Process Plan
actionDefinition:
  type: Payment/Payment Process Functions
readParametersFromDocument: true
actions:
  adjust:
    defaults:
      adjustment: ''
    args:
      adjustment: {type: Text}
    resultContract: outcome-v1
    do:
    - $let:
        name: configuration
        expr: {$document: {$pointerJoin: [clauses, {$const: clauseKey}, parameters]}}
    - $set:
        name: actionResult
        expr:
          $call:
            function: applyAdjustments
            args:
              adjustment: {$var: {name: params, path: /adjustment}}
              adjustments:
                $call:
                  function: withSharedSelection
                  args:
                    adjustments: {$pointerGet: {object: {$var: configuration}, path: /adjustments, default: {}}}
                    sharedSelection: {$pointerGet: {object: {$var: configuration}, path: /selectedPayment, default: {}}}
  requestAuthorize:
    defaults:
      amountMinor:
        $document: /paymentTerms/amountMinor
  requestCapture:
    defaults:
      amountMinor:
        $document: /paymentTerms/amountMinor
hookAbi: document-context-1
paymentPolicyAction: capture
