name: State Machine Clause
type: Connections/Connected Clause
bindingTypes:
  state: pointer
actionDefinition:
  type: State/State Machine Functions
actions:
  transition:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: transition
            args:
              input:
                $var: params
defaultBindings:
  state: /status
