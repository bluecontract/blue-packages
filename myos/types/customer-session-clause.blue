name: Customer Session Clause
type: Connections/Connected Clause
actionDefinition:
  type: MyOS/Customer Session Functions
actions:
  initialize:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: initialize
            args:
              input:
                $var: params
    automatic:
      'on': initialized
      once: true
  provideSession:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: provideSession
            args:
              input:
                $var: params
  confirmFunding:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: confirmFunding
            args:
              input:
                $var: params
