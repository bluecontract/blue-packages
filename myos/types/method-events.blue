name: Payment Method Events
type: Connections/Connected Clause
actions:
  announce:
    automatic:
      'on': initialized
      once: true
    do:
    - $if:
        cond:
          $ne:
          - $document: /paymentDetails/method
          - myos-customer
        then:
        - $appendEvent:
            $merge:
            - type: PaymentInstruction/Payment Event
            - kind: Account Payment Instruction Created
              details:
                $document: /paymentDetails
  request:
    automatic:
      'on': event
      event:
        type: Events/Event
        kind: Payment Requested
    do:
    - $appendEvent:
        $merge:
        - type: PaymentInstruction/Payment Event
        - kind: MyOS Execution Requested
          method:
            $document: /paymentDetails/method
          request:
            $var: trigger
          details:
            $document: /paymentDetails
