name: Payment Method Events
type: Connections/Connected Clause
actionDefinition:
  type: MyOS/Account Settlement Functions
actions:
  announce:
    automatic:
      'on': initialized
      once: true
    do:
    - $appendEvent:
        $merge:
        - type: PaymentInstruction/Payment Event
        - kind:
            $choose:
              cond:
                $eq:
                - $document: /paymentDetails/method
                - myos-customer
              then: Customer Payment Session Requested
              else: Account Payment Instruction Created
          details:
            $document: /paymentDetails
  validateAccountTransfer:
    do:
    - $call: {function: validateFixedTransfer, args: {}}
  confirmAccountSettlement:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr: {$call: {function: confirmAccountSettlement, args: {input: {$var: params}}}}
  request:
    automatic:
      'on': event
      event:
        type: Events/Event
        kind: Payment Requested
    do:
    - $appendEvent:
        $merge:
        - type: PaymentInstruction/Payment Event
        - kind: MyOS Execution Requested
          method:
            $document: /paymentDetails/method
          request:
            $var: trigger
          details:
            $document: /paymentDetails
