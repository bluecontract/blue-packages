name: Stripe Payout Failure Input
type: Dictionary
description: Late payout correction evidence. Required fields are declared by the
  correction operation.
keyType:
  type: Text
  schema:
    enum:
    - requestId
    - reference
    - failureCode
    - failureBalanceTransaction
schema:
  maxFields: 4
failureBalanceTransaction:
  type: Text
  description: Optional Stripe balance transaction proving return of failed payout
    funds.
  schema:
    minLength: 1
    maxLength: 256
