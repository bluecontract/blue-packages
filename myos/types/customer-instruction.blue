name: MyOS Customer Payment Instruction
type: PaymentInstruction/Payment Instruction with Clauses
description: Standalone or embedded customer payment with correlated session preparation. Only the configured
  guarantor begins the financial request; session readiness is not authorization or capture.
paymentDetails:
  customerPaymentTerms:
    provider:
      type: Text
    recipientPaymentAccountId:
      type: Text
clauses:
  customerSessionState:
    type:
      name: Customer Session State
      type: Connections/Connected Clause
      bindingTypes:
        state: pointer
      defaultBindings:
        state: /customerSession
      initialState:
        state:
          requestId: ''
          id: ''
          status: idle
          expiresAt: 0
          paymentDueAt: 0
          paymentAttemptId: ''
          failureReason: ''
contracts:
  __customerAccepted:
    type: Contracts/Triggered Event Channel
    event:
      type: PaymentInstruction/Payment Instruction Accepted
  __customerPrepareSession:
    type: Contracts/Sequential Workflow
    channel: __customerAccepted
    steps:
    - type: Contracts/Compute
      definition:
        type: MyOS/Customer Session Functions
      constants:
        sourceMode: event
      do:
      - $call:
          function: prepareSession
          args: {}
  provideSession:
    type: Contracts/Sequential Workflow Operation
    channel: guarantor
    steps:
    - type: Parties/Require Active Parties
      constants:
        workflow: true
    - type: Contracts/Compute
      definition:
        type: MyOS/Customer Session Functions
      constants:
        sourceMode: workflow
      do:
      - $call:
          function: provideSession
          args:
            input:
              $binding: call/request
    $blue:requestFrom:
      definition:
        type: MyOS/Customer Session Functions
      function: provideSession
      argument: input
  failSessionPreparation:
    type: Contracts/Sequential Workflow Operation
    channel: guarantor
    steps:
    - type: Parties/Require Active Parties
      constants:
        workflow: true
    - type: Contracts/Compute
      definition:
        type: MyOS/Customer Session Functions
      constants:
        sourceMode: workflow
      do:
      - $call:
          function: failSessionPreparation
          args:
            input:
              $binding: call/request
    $blue:requestFrom:
      definition:
        type: MyOS/Customer Session Functions
      function: failSessionPreparation
      argument: input
  requestCustomerPayment:
    type: Contracts/Sequential Workflow Operation
    channel: guarantor
    steps:
    - type: Parties/Require Active Parties
      constants:
        workflow: true
    - type: Contracts/Compute
      definition:
        type: MyOS/Customer Session Functions
      constants:
        sourceMode: workflow
      do:
      - $call:
          function: requestCustomerPayment
          args:
            input:
              $binding: call/request
    $blue:requestFrom:
      definition:
        type: MyOS/Customer Session Functions
      function: requestCustomerPayment
      argument: input
