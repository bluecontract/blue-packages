name: Manual Payment Instruction
type: PaymentInstruction/Payment Instruction with Clauses
contracts:
  reportTransfer:
    type: Contracts/Sequential Workflow Operation
    channel: customer
    steps:
    - type: Parties/Require Active Parties
    - type: Contracts/Compute
      definition:
        type: ManualPayments/Manual Transfer Functions
      constants: {}
      do:
      - $call:
          function: reportTransfer
          args:
            input:
              $object:
                $binding: call/request
    $blue:requestFrom:
      definition:
        type: ManualPayments/Manual Transfer Functions
      function: reportTransfer
      argument: input
