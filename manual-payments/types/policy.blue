name: Manual Transfer Policy
type: Connections/Connected Clause
actionDefinition:
  type: ManualPayments/Manual Transfer Functions
actions:
  initialize:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: initialize
            args:
              input:
                $var: params
    automatic:
      'on': initialized
      once: true
  accept:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: accept
            args:
              input:
                $var: params
  reportTransfer:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: reportTransfer
            args:
              input:
                $var: params
  confirmReceipt:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: confirmReceipt
            args:
              input:
                $var: params
  requestRefund:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: requestRefund
            args:
              input:
                $var: params
  confirmRefund:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: confirmRefund
            args:
              input:
                $var: params
