name: Bank Payment Setup
type: Payment/Conditional Payment Setup
functions:
  build:
    args: {}
    do:
    - $return:
        $call:
          function: buildInstruction
          args:
            configOverride: {}
            details:
              method: acme-bank
              confirmation: bank
            methodClauses:
              bank:
                type: ACME/Bank Method Events
            termsOverride: {}
