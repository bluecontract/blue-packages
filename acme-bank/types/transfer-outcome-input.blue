name: Bank Transfer Outcome Input
type: Dictionary
description: Optional bank outcome details. A native value explicitly identifies this input type; required
  requestId and reference are declared by each public entry.
keyType:
  type: Text
  schema:
    enum:
    - requestId
    - reference
    - amountMinor
    - currency
schema:
  maxFields: 4
amountMinor:
  type: Integer
  description: Optional amount associated with the unknown or declined transfer.
currency:
  type: Text
  description: Optional currency associated with the unknown or declined transfer.
