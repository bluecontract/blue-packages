name: Bank Transfer Contract
type: PaymentInstruction/Payment Instruction with Clauses
description: One payer-requested transfer with separate bank confirmation. Unknown outcomes reconcile
  against the same request. There is no synthetic card authorization or capture; a refund is a separate
  transfer instruction.
paymentTerms:
  method: bank-transfer
  evidence: bankConfirmation
contracts:
  requestTransfer:
    type: Contracts/Sequential Workflow Operation
    channel: payer
    steps:
    - type: Parties/Require Active Parties
      constants:
        workflow: true
    - type: Contracts/Compute
      definition:
        type: ACME/Bank Transfer Functions
      constants:
        sourceMode: workflow
      do:
      - $call:
          function: request
          args:
            input:
              $object:
                $binding: call/request
    requestFrom:
      definition:
        type: ACME/Bank Transfer Functions
      function: request
      argument: input
  confirmTransfer:
    type: Contracts/Sequential Workflow Operation
    channel: guarantor
    steps:
    - type: Parties/Require Active Parties
      constants:
        workflow: true
    - type: Contracts/Compute
      definition:
        type: ACME/Bank Transfer Functions
      constants:
        sourceMode: workflow
      do:
      - $call:
          function: confirmPublic
          args:
            input:
              $object:
                $binding: call/request
    requestFrom:
      definition:
        type: ACME/Bank Transfer Functions
      function: confirmPublic
      argument: input
  reportTransferUnknown:
    type: Contracts/Sequential Workflow Operation
    channel: guarantor
    steps:
    - type: Parties/Require Active Parties
      constants:
        workflow: true
    - type: Contracts/Compute
      definition:
        type: ACME/Bank Transfer Functions
      constants:
        sourceMode: workflow
      do:
      - $call:
          function: unknownPublic
          args:
            input:
              $binding: call/request
    requestFrom:
      definition:
        type: ACME/Bank Transfer Functions
      function: unknownPublic
      argument: input
  declineTransfer:
    type: Contracts/Sequential Workflow Operation
    channel: guarantor
    steps:
    - type: Parties/Require Active Parties
      constants:
        workflow: true
    - type: Contracts/Compute
      definition:
        type: ACME/Bank Transfer Functions
      constants:
        sourceMode: workflow
      do:
      - $call:
          function: declinePublic
          args:
            input:
              $binding: call/request
    requestFrom:
      definition:
        type: ACME/Bank Transfer Functions
      function: declinePublic
      argument: input
