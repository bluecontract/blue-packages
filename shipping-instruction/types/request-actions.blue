name: Shipping Request Actions
type: Connections/Connected Clause
actionDefinition:
  type: Shipping/Shipping Functions
actions:
  requestShipment:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: request
            args:
              action: book
              input:
                $var: params
  requestCancellation:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: request
            args:
              action: cancel
              input:
                $var: params
  requestAddressChange:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: request
            args:
              action: address
              input:
                $var: params
