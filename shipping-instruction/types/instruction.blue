name: Shipping Instruction
description: One correlated shipment. Only the carrier records delivery outcomes; a request is never a
  delivery confirmation.
instanceKey:
  type: Text
shipment: {}
contracts:
  confirmShipment:
    type: Contracts/Sequential Workflow Operation
    channel: carrier
    steps:
    - type: Contracts/Compute
      definition:
        type: Shipping/Shipping Functions
      do:
      - $call:
          function: respondPublic
          args:
            outcome: accepted
            input:
              $binding: call/request
    requestFrom:
      definition:
        type: Shipping/Shipping Functions
      function: respondPublic
      argument: input
  rejectShipment:
    type: Contracts/Sequential Workflow Operation
    channel: carrier
    steps:
    - type: Contracts/Compute
      definition:
        type: Shipping/Shipping Functions
      do:
      - $call:
          function: respondPublic
          args:
            outcome: rejected
            input:
              $binding: call/request
    requestFrom:
      definition:
        type: Shipping/Shipping Functions
      function: respondPublic
      argument: input
  recordDispatched:
    type: Contracts/Sequential Workflow Operation
    channel: carrier
    steps:
    - type: Contracts/Compute
      definition:
        type: Shipping/Shipping Functions
      do:
      - $call:
          function: respondPublic
          args:
            outcome: dispatched
            input:
              $binding: call/request
    requestFrom:
      definition:
        type: Shipping/Shipping Functions
      function: respondPublic
      argument: input
  confirmDelivery:
    type: Contracts/Sequential Workflow Operation
    channel: carrier
    steps:
    - type: Contracts/Compute
      definition:
        type: Shipping/Shipping Functions
      do:
      - $call:
          function: respondPublic
          args:
            outcome: delivered
            input:
              $binding: call/request
    requestFrom:
      definition:
        type: Shipping/Shipping Functions
      function: respondPublic
      argument: input
  failShipment:
    type: Contracts/Sequential Workflow Operation
    channel: carrier
    steps:
    - type: Contracts/Compute
      definition:
        type: Shipping/Shipping Functions
      do:
      - $call:
          function: respondPublic
          args:
            outcome: failed
            input:
              $binding: call/request
    requestFrom:
      definition:
        type: Shipping/Shipping Functions
      function: respondPublic
      argument: input
  confirmCancellation:
    type: Contracts/Sequential Workflow Operation
    channel: carrier
    steps:
    - type: Contracts/Compute
      definition:
        type: Shipping/Shipping Functions
      do:
      - $call:
          function: respondPublic
          args:
            outcome: cancelled
            input:
              $binding: call/request
    requestFrom:
      definition:
        type: Shipping/Shipping Functions
      function: respondPublic
      argument: input
  rejectCancellation:
    type: Contracts/Sequential Workflow Operation
    channel: carrier
    steps:
    - type: Contracts/Compute
      definition:
        type: Shipping/Shipping Functions
      do:
      - $call:
          function: respondPublic
          args:
            outcome: cancellationRejected
            input:
              $binding: call/request
    requestFrom:
      definition:
        type: Shipping/Shipping Functions
      function: respondPublic
      argument: input
  confirmAddressChange:
    type: Contracts/Sequential Workflow Operation
    channel: carrier
    steps:
    - type: Contracts/Compute
      definition:
        type: Shipping/Shipping Functions
      do:
      - $call:
          function: respondPublic
          args:
            outcome: addressChanged
            input:
              $binding: call/request
    requestFrom:
      definition:
        type: Shipping/Shipping Functions
      function: respondPublic
      argument: input
  rejectAddressChange:
    type: Contracts/Sequential Workflow Operation
    channel: carrier
    steps:
    - type: Contracts/Compute
      definition:
        type: Shipping/Shipping Functions
      do:
      - $call:
          function: respondPublic
          args:
            outcome: addressRejected
            input:
              $binding: call/request
    requestFrom:
      definition:
        type: Shipping/Shipping Functions
      function: respondPublic
      argument: input
  __shippingLife:
    type: Contracts/Lifecycle Event Channel
    event:
      type: Contracts/Document Processing Initiated
  __shippingInitialize:
    type: Contracts/Sequential Workflow
    channel: __shippingLife
    order: -1000
    steps:
    - type: Contracts/Compute
      do:
      - $appendChange:
          op: add
          path: /shipment
          val:
            status: new
            requests: {}
            trackingId: ''
