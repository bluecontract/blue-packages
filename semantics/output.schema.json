{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["blueId", "semanticText", "metadata"],
  "properties": {
    "blueId": {"$ref": "#/$defs/blueId"},
    "semanticText": {"type": "string", "minLength": 200, "maxLength": 20000},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayLabel", "parameterRefs", "covers", "dependencies", "stateFacts", "limitations"],
      "properties": {
        "displayLabel": {"type": "string", "minLength": 1, "maxLength": 200},
        "parameterRefs": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "covers": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/blueId"}},
        "dependencies": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/blueId"}},
        "stateFacts": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/fact"}},
        "limitations": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 400}}
      }
    }
  },
  "$defs": {
    "blueId": {"type": "string", "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,64}$"},
    "pointer": {"type": ["string", "null"], "pattern": "^/[^\\s]*$", "maxLength": 256},
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "path", "binding", "defaultPath", "suffix", "type", "absent", "meaning", "evidence", "aggregate"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-zA-Z0-9]{0,47}$"},
        "scope": {"type": "string", "enum": ["binding", "document"]},
        "path": {"$ref": "#/$defs/pointer"},
        "binding": {"type": ["string", "null"], "minLength": 1, "maxLength": 64},
        "defaultPath": {"$ref": "#/$defs/pointer"},
        "suffix": {"type": "string", "maxLength": 256},
        "type": {"type": "string", "enum": ["boolean", "number", "string", "money-minor", "currency", "date", "count"]},
        "absent": {"type": "string", "minLength": 1, "maxLength": 300},
        "meaning": {"type": "string", "minLength": 1, "maxLength": 400},
        "evidence": {"type": "string", "minLength": 1, "maxLength": 400},
        "aggregate": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["over", "operation", "unit"],
              "properties": {
                "over": {"type": "string", "minLength": 1, "maxLength": 400},
                "operation": {"type": "string", "enum": ["count", "sum", "balance"]},
                "unit": {"type": "string", "minLength": 1, "maxLength": 300}
              }
            }
          ]
        }
      }
    }
  }
}
