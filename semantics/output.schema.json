{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["blueId", "semanticText"],
  "properties": {
    "blueId": {"type": "string", "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,64}$"},
    "semanticText": {"type": "string", "minLength": 1, "maxLength": 20000}
  }
}
