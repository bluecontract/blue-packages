name: Mandate with Clauses
type: Mandates/Operation Mandate
description: >-
  Installs ordinary reusable clauses during the first native initialization.
  The owner reviews and approves the complete installed program. Clause
  definitions, parameters and bindings cannot change afterward. Mutable
  qualification, scope and usage state belongs outside clauses.
clauses: {}
contracts:
  __clausesInit:
    channel: __clausesLife
    steps:
    - type: Clauses/Initialize Clauses Step
    - type: Clauses/Prepare Amendment Step
    type: Contracts/Sequential Workflow
  __clausesLife:
    event:
      type: Contracts/Document Processing Initiated
    type: Contracts/Lifecycle Event Channel
  __clausesRun:
    event:
      type: Clauses/Run Amendment
    type: Contracts/Triggered Event Channel
