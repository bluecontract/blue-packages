name: Manual payment created from the agreed instruction
type: Agreements/Agreement with Clauses
x: 0
clauses:
  activation:
    type: Activation/Activation Clause
    parameters:
      parties:
        customer:
          type: Parties/Party
          displayName: Customer
        seller:
          type: Parties/Party
          displayName: Merchant
        reviewer:
          type: Parties/Party
          displayName: Reviewer
        guarantor:
          type: Parties/Party
          displayName: Payment institution
      required: []
      allowNewParties: true
  status:
    type: Features/Feature Clause
    parameters:
      actions:
        setReady:
          do:
          - $appendChange:
              op: replace
              path: /x
              val: 1
    bindings:
      setReady:
        setReady:
          'on': workflow
          party: customer
          request:
            description: Set the configured ready state. No request fields are required.
  instruction:
    type: Attachments/Manual Payment Clause
    parameters:
      authority: guarantor
      payer: customer
      payee: seller
      template:
        name: Payment Instruction
        type: PaymentInstruction/Payment Instruction with Clauses
        clauses: {}
        sources: {}
        paymentTerms:
          currency: EUR
          amountMinor: 200
          limitMinor: 200
          payerChannel: customer
          payeeChannel: seller
          guarantorChannel: guarantor
          allowedPayees:
          - seller
          recipientApprovalRequired: false
      hooks:
        requestCapture:
          confirm:
            'on': workflow
            party: customer
            params:
              $pointerSet:
                object:
                  $object:
                    $var: trigger
                path: /type
                op: remove
            request:
              type: PaymentInstruction/Payment Request Input
              description: Input for this configured financial request. Amount may be supplied by the configured
                action defaults.
              requestId:
                type: Text
                description: Unique identifier for this requested financial action.
        requestAuthorize:
          authorize:
            'on': workflow
            party: customer
            params:
              $pointerSet:
                object:
                  $object:
                    $var: trigger
                path: /type
                op: remove
            request:
              type: PaymentInstruction/Payment Request Input
              description: Input for this configured financial request. Amount may be supplied by the configured
                action defaults.
              requestId:
                type: Text
                description: Unique identifier for this requested financial action.
    bindings:
      request: /instructionRequest
      instruction: /instruction
