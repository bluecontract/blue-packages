name: Adventures in Paradise × Manatee Bay Inn — reseller agreement
type: Agreements/Agreement with Clauses
template:
  id: reseller-catalog-preview
  version: 0.1.0-preview.2
terms:
  commissionBps: 1000
  currency: USD
  exclusive: false
orders: {}
payouts: {}
clauses:
  activation:
    type: Activation/Activation Clause
    parameters:
      parties:
        seller:
          type:
            blueId: 8enHPJFVRpaR4TbBT6PVY6bg49L4Vuj9hZSgGUB4seid
          displayName: Supplier
          business:
            type: Parties/Business
            displayName: Adventures in Paradise
        partner:
          type:
            blueId: 8enHPJFVRpaR4TbBT6PVY6bg49L4Vuj9hZSgGUB4seid
          displayName: Partner
          business:
            type: Parties/Business
            displayName: Manatee Bay Inn
      required:
      - seller
      - partner
      preActivationOperations:
      - proposeTerms_seller
      - proposeTerms_partner
      preActivationChannels:
      - cx.termsValidation.validate._automatic_source
  termsValidation:
    type: Reseller/Commercial Terms Validation Clause
    bindings:
      terms: /terms
  orders:
    type: Reseller/Customer Orders Clause
    bindings:
      template: /orderTemplate
      collection: /orders
      fulfilment: /clauses/fulfilment/parameters
      prepareOrder:
        prepareOrder:
          'on': workflow
          party: partner
          request:
            type: Documents/Preparation Input
          params:
            $pointerSet:
              object:
                $var: trigger
              path: /type
              op: remove
      provideOrder:
        provideOrder:
          'on': workflow
          party: partner
      catalog: /products
  payouts:
    type: Reseller/Commission Payouts Clause
    bindings:
      template: /payoutTemplate
      collection: /payouts
      commission: /commission
      parties:
        seller: seller
        partner: partner
      preparePayout:
        startPayout:
          'on': workflow
          party: seller
  commission:
    type: Reseller/Commission Clause
    bindings:
      state: /commission
      orders: /orders
      payouts: /payouts
      rate: /terms/commissionBps
  negotiation:
    type: Reseller/Commercial Terms Negotiation Clause
    bindings:
      terms: /terms
      propose:
        proposeTerms_seller:
          'on': workflow
          party: seller
        proposeTerms_partner:
          'on': workflow
          party: partner
  catalog:
    type: Reseller/Catalog Clause
    parameters:
      offer:
        title: Afternoon Dolphin & Wildlife Cruise
        text: This afternoon cruise around Fort Myers Beach and Sanibel Island lasts about 1.5 hours. A
          naturalist or marine biologist talks about dolphins and local wildlife. Dolphin sightings are
          not guaranteed.
        sections:
        - title: What’s included
          bullets:
          - Cruise with commentary from a naturalist or marine biologist.
          - Bottled water and soft drinks.
        - title: Good to know
          text: The cruise lasts about 1.5 hours. The fulfilment clause sets out the schedule and booking
            requirements.
          bullets:
          - Children aged 3 and under ride free and must be included in the passenger count.
          - Tips are optional and are not included in the price.
        - title: Meeting point
          text: Snug Harbor Marina, 645 Old San Carlos Blvd, Fort Myers Beach, FL 33931. The marina and ticket
            office are under Sky Bridge, next to Nervous Nellie’s.
        - title: Cancellation terms listed in the offer
          text: The offer lists cutoffs of 24 hours for regular cruises, 14 days for holiday cruises, and 48
            hours for groups of six or more. A 6% booking fee is deducted from refunds. Changes and
            cancellations within 24 hours of departure incur a 100% charge. Cancellations by email or
            voicemail are not accepted.
    bindings:
      state: /products
  fulfilment:
    type: Reseller/Fulfilment Terms Clause
    parameters:
      terms:
        fulfilmentText: The order requires a proposed time and confirmation from Adventures in Paradise. The
          customer proposes the time when placing the order. If the supplier proposes a
          different time, the customer must accept it.
        confirmationMode: supplier
        dateRequired: true
      schedule: Tuesdays, Thursdays, and Saturdays from 1:00 to 2:30 p.m. Seats are subject to availability.
      template:
        name: Order booking confirmation
        description: The order includes this clause only if the agreement contains a fulfilment clause. The
          order records the requirements and the proposed time.
        type: Orders/Order with Clauses
        clauses:
          confirmation:
            type: Reseller/Confirmation Clause
            bindings:
              confirm:
                confirmReservation:
                  'on': workflow
                  party: seller
                  params:
                    $var: trigger
              alternative:
                proposeAlternative:
                  'on': workflow
                  party: seller
                  params:
                    $var: trigger
              accept:
                acceptProposal:
                  'on': workflow
                  party: customer
                  params:
                    $var: trigger
orderTemplate:
  name: Guest booking
  type: Orders/Order with Clauses
  description: Customer order under the reseller agreement, with selected products and a price calculated from
    the catalog.
  currency: USD
  clauses:
    activation:
      type: Activation/Activation Clause
      parameters:
        parties:
          seller:
            type: Parties/Party
          partner:
            type: Parties/Party
          customer:
            type: Parties/Party
        required: []
        preActivationChannels:
        - cx.payment.prepare.onOrderCreated_source
        preActivationOperations:
        - providePayment
    payment:
      type: Payment/Payment Clause
      parameters:
        obtain: provide
        prepareFor: bootstrap
        template:
          name: Card payment for the guest booking
          type: PaymentInstruction/Payment Instruction with Clauses
          clauses:
            activation:
              type: Activation/Activation Clause
              parameters:
                parties:
                  payer:
                    type: Parties/Party
                  payee:
                    type: Parties/Party
                  guarantor:
                    type: MyOS/MyOS Party
                    email: payments@example.test
                  observer:
                    type: Parties/Party
                required: []
            payment:
              type: Payment/Payment Process Clause
              parameters:
                method: card
                capture:
                  mode: workflow
              bindings:
                requestAuthorize:
                  authorize:
                    'on': workflow
                    party: payer
                    params:
                      $object:
                        $var: trigger
                requestCapture:
                  pay:
                    'on': workflow
                    party: payer
                    params:
                      $object:
                        $var: trigger
                requestRefund:
                  refund:
                    'on': workflow
                    party: payee
                    params:
                      $object:
                        $var: trigger
                requestVoid:
                  cancel:
                    'on': workflow
                    party: payer
                    params:
                      $object:
                        $var: trigger
          paymentTerms:
            amountMinor:
              type: Integer
            limitMinor:
              type: Integer
            currency:
              type: Text
            payerChannel: payer
            payeeChannel: payee
            guarantorChannel: guarantor
            allowedPayees:
            - payee
            recipientApprovalRequired: false
          businessContext:
            description: Card payment for the booked cruise.
        suppliedBy: seller
        fieldPaths:
          amountMinor: /paymentTerms/amountMinor
          limitMinor: /paymentTerms/limitMinor
          currency: /paymentTerms/currency
        suppliedParties:
        - guarantor
      bindings:
        instruction: /payment
        parties:
          payer: customer
          payee: seller
          observer: partner
        prepare:
          onOrderCreated:
            'on': initialized
            params:
              values:
                amountMinor:
                  $document: /amountMinor
                limitMinor:
                  $document: /amountMinor
                currency:
                  $document: /currency
        provide:
          providePayment:
            'on': workflow
            party: seller
    paymentEvents:
      type: Reseller/Payment Observation Clause
      bindings:
        instruction: /payment
payoutTemplate:
  name: Partner commission payout
  type: Agreements/Agreement with Clauses
  amountMinor: 1000
  currency: USD
  clauses:
    activation:
      type: Activation/Activation Clause
      parameters:
        parties:
          seller:
            type: Parties/Party
          partner:
            type: Parties/Party
        required: []
    payment:
      type: Reseller/Commission Payout Payment Clause
      parameters:
        payer: seller
        payee: partner
        currency: USD
      bindings:
        amount: /amountMinor
        instruction: /payment
        start:
          startPayment:
            'on': workflow
            party: seller
        requestAuthorize:
          authorize:
            'on': workflow
            party: seller
            params:
              $object:
                $var: trigger
        requestCapture:
          capture:
            'on': workflow
            party: seller
            params:
              $object:
                $var: trigger
        requestRefund:
          refund:
            'on': workflow
            party: partner
            params:
              $object:
                $var: trigger
        requestVoid:
          cancel:
            'on': workflow
            party: seller
            params:
              $object:
                $var: trigger
description: Reseller agreement for the Afternoon Dolphin & Wildlife Cruise. Adventures in Paradise operates
  the cruises, and Manatee Bay Inn recommends them to guests and earns a commission on confirmed
  net order receipts.
products:
  revision: 1
  supplierId: seller
  currency: USD
  entries:
    dolphin-cruise-child:
      label: Child aged 4–12
      description: Child ticket for a cruise lasting about 1.5 hours.
      pricingUnit: per_unit
      dateRequired: false
      maxQuantity: 20
      unitAmountMinor: 4900
      guestDiscountPercent: 5
    dolphin-cruise-under-4:
      label: Child aged 3 or under
      description: Free ticket. Include the child in the passenger count.
      pricingUnit: per_unit
      dateRequired: false
      maxQuantity: 20
      unitAmountMinor: 0
      guestDiscountPercent: 5
