          "orders": {
            "type": "Reseller/Customer Orders Clause",
            "bindings": {
              "template": "/orderTemplate",
              "collection": "/orders",
              "quotes": "/quotes",
              "fulfilment": "/clauses/bookingPolicy/parameters",
              "startOrder": {
                "newOrder": {
                  "on": "workflow",
                  "party": "partner"
                }
              }
            }
          },
          "payouts": {
            "type": "Reseller/Commission Payouts Clause",
            "bindings": {
              "template": "/payoutTemplate",
              "collection": "/payouts",
              "commission": "/commission",
              "parties": {
                "seller": "seller",
                "partner": "partner"
              },
              "preparePayout": {
                "startPayout": {
                  "on": "workflow",
                  "party": "seller"
                }
              }
            }
          },
          "commission": {
            "type": "Reseller/Commission Clause",
            "bindings": {
              "state": "/commission",
              "orders": "/orders",
              "payouts": "/payouts",
              "rate": "/terms/commissionBps"
            }
          },
          "negotiation": {
            "type": "Reseller/Commercial Terms Negotiation Clause",
            "bindings": {
              "terms": "/terms",
              "propose": {
                "proposeTerms_seller": {
                  "on": "workflow",
                  "party": "seller"
                },
                "proposeTerms_partner": {
                  "on": "workflow",
                  "party": "partner"
                }
              }
            }
          },
          "catalog": {
            "type": "Reseller/Catalog Clause",
            "parameters": {
              "offer": {
                "title": "Afternoon Dolphin & Wildlife Cruise",
                "text": "This afternoon cruise around Fort Myers Beach and Sanibel Island lasts about 1.5 hours. A naturalist or marine biologist talks about dolphins and local wildlife. Dolphin sightings are not guaranteed.",
                "sections": [
                  {
                    "title": "What’s included",
                    "bullets": [
                      "Cruise with commentary from a naturalist or marine biologist.",
                      "Bottled water and soft drinks."
                    ]
                  },
                  {
                    "title": "Good to know",
                    "text": "The cruise lasts about 1.5 hours. The fulfilment clause sets out the schedule and booking requirements.",
                    "bullets": [
                      "Children aged 3 and under ride free and must be included in the passenger count.",
                      "Tips are optional and are not included in the price."
                    ]
                  },
                  {
                    "title": "Meeting point",
                    "text": "Snug Harbor Marina, 645 Old San Carlos Blvd, Fort Myers Beach, FL 33931. The marina and ticket office are under Sky Bridge, next to Nervous Nellie’s."
                  },
                  {
                    "title": "Cancellation terms listed in the offer",
                    "text": "The offer lists cutoffs of 24 hours for regular cruises, 14 days for holiday cruises, and 48 hours for groups of six or more. A 6% booking fee is deducted from refunds. Changes and cancellations within 24 hours of departure incur a 100% charge. Cancellations by email or voicemail are not accepted."
                  }
                ]
              }
            },
            "bindings": {
              "state": "/products",
              "quotes": "/quotes",
              "quote": {
                "createQuote": {
                  "on": "workflow",
                  "party": "partner",
                  "params": {
                    "$var": "trigger"
                  }
                }
              }
            }
          },
          "bookingPolicy": {
            "type": "Reseller/Fulfilment Terms Clause",
            "parameters": {
              "terms": {
                "fulfilmentText": "The order requires a proposed time and confirmation from Adventures in Paradise. The customer accepts the proposed time when accepting the order. If the supplier proposes a different time, the customer must accept it.",
                "confirmationMode": "supplier",
                "dateRequired": true
              },
              "schedule": "Tuesdays, Thursdays, and Saturdays from 1:00 to 2:30 p.m. Seats are subject to availability.",
              "template": {
                "name": "Order booking confirmation",
                "description": "The order includes this clause only if the agreement contains a fulfilment clause. The order records the requirements and the proposed time.",
                "type": "Orders/Order with Clauses",
                "clauses": {
                  "confirmation": {
                    "type": "Reseller/Confirmation Clause",
                    "bindings": {
                      "confirm": {
                        "confirmReservation": {
                          "on": "workflow",
                          "party": "seller",
                          "params": {
                            "$var": "trigger"
                          }
                        }
                      },
                      "alternative": {
                        "proposeAlternative": {
                          "on": "workflow",
                          "party": "seller",
                          "params": {
                            "$var": "trigger"
                          }
                        }
                      },
                      "accept": {
                        "acceptProposal": {
                          "on": "workflow",
                          "party": "customer",
                          "params": {
                            "$var": "trigger"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
