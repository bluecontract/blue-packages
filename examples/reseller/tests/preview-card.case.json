          "termsValidation": {
            "type": "Reseller/Commercial Terms Validation Clause",
            "bindings": {
              "terms": "/terms"
            }
          },
          "orders": {
            "type": "Reseller/Customer Orders Clause",
            "bindings": {
              "template": "/orderTemplate",
              "collection": "/orders",
              "quotes": "/quotes",
              "fulfilment": "/clauses/bookingPolicy/parameters",
              "startOrder": {
                "newOrder": {
                  "on": "workflow",
                  "party": "partner"
                }
              }
            }
          },
          "payouts": {
            "type": "Reseller/Commission Payouts Clause",
            "bindings": {
              "template": "/payoutTemplate",
              "collection": "/payouts",
              "commission": "/commission",
              "parties": {
                "seller": "seller",
                "partner": "partner"
              },
              "preparePayout": {
                "startPayout": {
                  "on": "workflow",
                  "party": "seller"
                }
              }
            }
          },
          "commission": {
            "type": "Reseller/Commission Clause",
            "bindings": {
              "state": "/commission",
              "orders": "/orders",
              "payouts": "/payouts",
              "rate": "/terms/commissionBps"
            }
          },
          "negotiation": {
            "type": "Reseller/Commercial Terms Negotiation Clause",
            "bindings": {
              "terms": "/terms",
              "propose": {
                "proposeTerms_seller": {
                  "on": "workflow",
                  "party": "seller"
                },
                "proposeTerms_partner": {
                  "on": "workflow",
                  "party": "partner"
                }
              }
            }
          },
          "catalog": {
            "type": "Reseller/Catalog Clause",
            "parameters": {
              "offer": {
                "title": "Afternoon Dolphin & Wildlife Cruise",
                "text": "Popołudniowy rejs po wodach Fort Myers Beach i wyspy Sanibel trwa około 1,5 godziny. Przyrodnik lub biolog morski opowiada o delfinach i lokalnej przyrodzie. Obserwacja delfinów nie jest gwarantowana.",
                "sections": [
                  {
                    "title": "W cenie",
                    "bullets": [
                      "Rejs z komentarzem przyrodnika lub biologa morskiego.",
                      "Woda butelkowana i napoje bezalkoholowe."
                    ]
                  },
                  {
                    "title": "Warto wiedzieć",
                    "text": "Rejs trwa około 1,5 godziny. Harmonogram i wymagania dotyczące terminu są określone w klauzuli realizacji zamówienia.",
                    "bullets": [
                      "Dzieci do 3 lat płyną bezpłatnie, ale trzeba je uwzględnić w liczbie pasażerów.",
                      "Napiwki są dobrowolne i nie są wliczone w cenę."
                    ]
                  },
                  {
                    "title": "Miejsce zbiórki",
                    "text": "Snug Harbor Marina, 645 Old San Carlos Blvd, Fort Myers Beach, FL 33931. Przystań i kasa znajdują się pod Sky Bridge, obok Nervous Nellie’s."
                  },
                  {
                    "title": "Warunki anulowania podane w ofercie",
                    "text": "Oferta podaje terminy 24 godzin dla zwykłych rejsów, 14 dni dla rejsów świątecznych i 48 godzin dla grup od 6 osób. Zwrot jest pomniejszany o 6% opłaty rezerwacyjnej. Zmiany i anulowania w ciągu 24 godzin przed rejsem podlegają opłacie 100%. Anulowania przez e-mail lub pocztę głosową nie są przyjmowane."
                  }
                ]
              }
            },
            "bindings": {
              "state": "/products",
              "quotes": "/quotes",
              "quote": {
                "createQuote": {
                  "on": "workflow",
                  "party": "partner",
                  "params": {
                    "$var": "trigger"
                  }
                }
              }
            }
          },
          "bookingPolicy": {
            "type": "Reseller/Fulfilment Terms Clause",
            "parameters": {
              "terms": {
                "fulfilmentText": "Zamówienie wymaga wskazania proponowanego terminu i potwierdzenia przez Adventures in Paradise. Akceptacja zamówienia przez klienta obejmuje proponowany termin. Jeżeli dostawca zaproponuje inny termin, klient musi go zaakceptować.",
                "confirmationMode": "supplier",
                "dateRequired": true
              },
              "schedule": "Wtorki, czwartki i soboty, od 13:00 do 14:30. Podane godziny nie gwarantują dostępności miejsc.",
              "template": {
                "name": "Potwierdzenie terminu zamówienia",
                "description": "Ta klauzula jest dołączana do zamówienia tylko wtedy, gdy umowa zawiera klauzulę fulfilment. Wymagania i proponowany termin są zapisywane w zamówieniu.",
                "type": "Orders/Order with Clauses",
                "clauses": {
                  "confirmation": {
                    "type": "Reseller/Confirmation Clause",
                    "bindings": {
                      "confirm": {
                        "confirmReservation": {
                          "on": "workflow",
                          "party": "seller",
                          "params": {
                            "$var": "trigger"
                          }
                        }
                      },
                      "alternative": {
                        "proposeAlternative": {
                          "on": "workflow",
                          "party": "seller",
                          "params": {
                            "$var": "trigger"
                          }
                        }
                      },
                      "accept": {
                        "acceptProposal": {
                          "on": "workflow",
                          "party": "customer",
                          "params": {
                            "$var": "trigger"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
