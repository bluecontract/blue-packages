          "readerKeys": [
            "reader-guarantor"
          ]
        }
      },
      "steps": [
        {
          "operation": "approve_seller",
          "channel": "seller",
          "request": {},
          "requireExactDocumentVersion": true,
          "requestFromState": {
            "revision": "/activation/revision"
          },
          "timestampMicros": 1793743200000000
        },
        {
          "operation": "approve_partner",
          "channel": "partner",
          "request": {},
