name: Reseller catalog regression
description: One catalog clause. Static item prices and guest discounts; date hints are descriptive only. Explicit
  component External Channels. No availability, order execution, tax, commission or payment behavior.
type: Agreements/Agreement with Clauses
template:
  id: catalog-pricing-prototype
  version: 0.2.0
catalog:
  revision: 1
  supplierId: leisure-center
  currency: PLN
  entries:
    museum-admission--regular-weekday:
      label: Museum adult — weekday
      pricingUnit: per_unit
      dateRequired: true
      maxQuantity: 100
      unitAmountMinor: 4000
      guestDiscountPercent: 5
      dateSelectionHint: Choose a weekday.
      description: Adult admission on a weekday.
    museum-admission--regular-weekend:
      label: Museum adult — weekend
      pricingUnit: per_unit
      dateRequired: true
      maxQuantity: 100
      unitAmountMinor: 5000
      guestDiscountPercent: 5
      dateSelectionHint: Choose a Saturday or Sunday.
      description: Adult weekend admission.
    museum-admission--child-weekend:
      label: Museum child — weekend
      pricingUnit: per_unit
      dateRequired: true
      maxQuantity: 100
      unitAmountMinor: 2500
      guestDiscountPercent: 10
      dateSelectionHint: Choose a Saturday or Sunday.
      description: Child weekend admission.
    museum-admission--child-holiday:
      label: Museum child — holiday
      pricingUnit: per_unit
      dateRequired: true
      maxQuantity: 100
      unitAmountMinor: 3000
      guestDiscountPercent: 10
      dateSelectionHint: Choose an agreed holiday date.
      description: Child holiday admission.
    lunch-set--standard:
      label: Lunch set
      pricingUnit: per_unit
      dateRequired: false
      maxQuantity: 100
      unitAmountMinor: 4000
    city-bike--standard:
      label: City bicycle rental
      pricingUnit: per_selected_hour
      dateRequired: true
      maxQuantity: 4
      unitAmountMinor: 1500
      guestDiscountPercent: 5
      dateSelectionHint: Preferred rental date; supplier confirmation is required.
      allowedDurationHours:
      - 1
      - 2
      - 3
    kayak-rental--single:
      label: Kayak rental — single
      pricingUnit: per_unit
      dateRequired: true
      maxQuantity: 100
      unitAmountMinor: 5500
      guestDiscountPercent: 5
    kayak-rental--double:
      label: Kayak rental — double
      pricingUnit: per_unit
      dateRequired: true
      maxQuantity: 100
      unitAmountMinor: 6500
      guestDiscountPercent: 5
    boat-rental--half-day:
      label: Boat rental — half day (fictional fixture)
      pricingUnit: per_unit
      dateRequired: true
      maxQuantity: 100
      unitAmountMinor: 46330
      guestDiscountPercent: 5
      description: One boat for the chosen date; fulfilment requires confirmation.
quotes: {}
contracts:
  seller:
    type: Contracts/External Channel
    event:
      source: seller
  partner:
    type: Contracts/External Channel
    event:
      source: partner
clauses:
  activation:
    type: Activation/Activation Clause
    parameters:
      parties:
        seller:
          type: Parties/Party
          displayName: Supplier
          lead:
            channel:
              type: Contracts/External Channel
              event:
                source: seller
          readerKeys:
          - reader-seller
        partner:
          type: Parties/Party
          displayName: Hotel partner
          lead:
            channel:
              type: Contracts/External Channel
              event:
                source: partner
          readerKeys:
          - reader-partner
      required: []
      preActivationChannels:
      - cx.catalog.validate._automatic_source
  catalog:
    type: Reseller/Catalog Clause
    bindings:
      state: /catalog
      quotes: /quotes
      publish:
        publishCatalog:
          'on': workflow
          party: seller
          params:
            $var: trigger
      quote:
        createQuote:
          'on': workflow
          party: partner
          params:
            $var: trigger
