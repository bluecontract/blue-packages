name: Local reseller partnership
description: The supplier sells and fulfils the listed services. The hotel refers customers. Each accepted order
  preserves its catalogue price, guest discount and fulfilment terms. Supplier deposit handling remains outside
  MyOS. Demonstration cancellation profile; partnership remuneration is not configured.
type: Agreements/Agreement with Clauses
template:
  id: catalog-pricing-prototype
  version: 0.2.0
catalog:
  revision: 1
  supplierId: seller
  currency: PLN
  entries:
    museum-admission--regular-weekday:
      label: "Museum adult \u2014 weekday"
      pricingUnit: per_unit
      dateRequired: true
      maxQuantity: 100
      unitAmountMinor: 4000
      guestDiscountPercent: 5
      dateSelectionHint: Choose a weekday.
      description: Adult admission on a weekday.
    museum-admission--regular-weekend:
      label: "Museum adult \u2014 weekend"
      pricingUnit: per_unit
      dateRequired: true
      maxQuantity: 100
      unitAmountMinor: 5000
      guestDiscountPercent: 5
      dateSelectionHint: Choose a Saturday or Sunday.
      description: Adult weekend admission.
    museum-admission--child-weekend:
      label: "Museum child \u2014 weekend"
      pricingUnit: per_unit
      dateRequired: true
      maxQuantity: 100
      unitAmountMinor: 2500
      guestDiscountPercent: 10
      dateSelectionHint: Choose a Saturday or Sunday.
      description: Child weekend admission.
    museum-admission--child-holiday:
      label: "Museum child \u2014 holiday"
      pricingUnit: per_unit
      dateRequired: true
      maxQuantity: 100
      unitAmountMinor: 3000
      guestDiscountPercent: 10
      dateSelectionHint: Choose an agreed holiday date.
      description: Child holiday admission.
    lunch-set--standard:
      label: Lunch set
      pricingUnit: per_unit
      dateRequired: false
      maxQuantity: 100
      unitAmountMinor: 4000
    city-bike--standard:
      label: City bicycle rental
      pricingUnit: per_selected_hour
      dateRequired: true
      maxQuantity: 4
      unitAmountMinor: 1500
      guestDiscountPercent: 5
      dateSelectionHint: Preferred rental date; supplier confirmation is required.
      allowedDurationHours:
      - 1
      - 2
      - 3
    kayak-rental--single:
      label: "Kayak rental \u2014 single"
      pricingUnit: per_unit
      dateRequired: true
      maxQuantity: 100
      unitAmountMinor: 5500
      guestDiscountPercent: 5
    kayak-rental--double:
      label: "Kayak rental \u2014 double"
      pricingUnit: per_unit
      dateRequired: true
      maxQuantity: 100
      unitAmountMinor: 6500
      guestDiscountPercent: 5
    boat-rental--half-day:
      label: "Boat rental \u2014 half day (fictional fixture)"
      pricingUnit: per_unit
      dateRequired: true
      maxQuantity: 100
      unitAmountMinor: 46330
      guestDiscountPercent: 5
      description: One boat for the chosen date; fulfilment requires confirmation.
quotes: {}
contracts:
  seller:
    type: Contracts/External Channel
    event:
      source: seller
  partner:
    type: Contracts/External Channel
    event:
      source: partner
  customer:
    type: Contracts/External Channel
    event:
      source: customer
clauses:
  activation:
    type: Activation/Activation Clause
    parameters:
      parties:
        seller:
          type: Parties/Party
          displayName: Supplier
          lead:
            channel:
              type: Contracts/External Channel
              event:
                source: seller
          readerKeys:
          - reader-seller
        partner:
          type: Parties/Party
          displayName: Hotel partner
          lead:
            channel:
              type: Contracts/External Channel
              event:
                source: partner
          readerKeys:
          - reader-partner
        customer:
          type: Parties/Party
          displayName: Customer
          lead:
            channel:
              type: Contracts/External Channel
              event:
                source: customer
          readerKeys:
          - reader-customer
      required: []
      preActivationChannels:
      - cx.catalog.validate._automatic_source
  catalog:
    type: Reseller/Catalog Clause
    bindings:
      state: /catalog
      quotes: /quotes
      publish:
        publishApprovedCatalog:
          'on': event
          event:
            type: Commerce/Domain Event
            kind: Amendment Applied
            clause: catalogAmendments
          params:
            $document: /catalogUpdate
      quote:
        createQuote:
          'on': workflow
          party: partner
          params:
            $var: trigger
        quoteForCustomer:
          'on': workflow
          party: customer
          params:
            $var: trigger
  fulfilment:
    type: Reseller/Fulfilment Terms Clause
    bindings:
      place:
        placeOrder:
          'on': workflow
          party: customer
          params:
            $var: trigger
      approveAvailability:
        approveAvailability:
          'on': workflow
          party: seller
          params:
            $var: trigger
  orders:
    type: Documents/Documents Clause
    parameters:
      allowedFields:
      - orderSnapshot
      template:
        name: Reseller service order
        type: Orders/Order with Clauses
        orderSnapshot: {}
        reservations: {}
        reservationRequests: {}
        clauses:
          activation:
            type: Activation/Activation Clause
            parameters:
              parties:
                seller:
                  type: Parties/Party
                customer:
                  type: Parties/Party
                partner:
                  type: Parties/Party
              required: []
              preActivationChannels:
              - cx.confirmation.initialize._automatic_source
          confirmation:
            type: Reseller/Confirmation Clause
            bindings:
              confirm:
                confirmReservation:
                  'on': workflow
                  party: seller
                  params:
                    $var: trigger
              alternative:
                proposeAlternative:
                  'on': workflow
                  party: seller
                  params:
                    $var: trigger
              accept:
                acceptProposal:
                  'on': workflow
                  party: customer
                  params:
                    $var: trigger
              deadline:
                setResponseDeadline:
                  'on': workflow
                  party: seller
                  params:
                    $var: trigger
              fulfil:
                fulfilGroup:
                  'on': workflow
                  party: seller
                  params:
                    $var: trigger
          cancellation:
            type: Reseller/Cancellation Clause
            bindings:
              cancel:
                cancelReservation:
                  'on': workflow
                  party: customer
                  params:
                    $var: trigger
              supplierCancel:
                cancelBySupplier:
                  'on': workflow
                  party: seller
                  params:
                    $var: trigger
              noShow:
                reportNoShow:
                  'on': workflow
                  party: seller
                  params:
                    $var: trigger
              decline:
                declineReservation:
                  'on': workflow
                  party: seller
                  params:
                    $var: trigger
              expire:
                expireReservation:
                  'on': workflow
                  party: customer
                  params:
                    $var: trigger
    bindings:
      collection: /orders
      start:
        fromSnapshot:
          'on': event
          event:
            type: Commerce/Domain Event
            kind: Reseller Order Prepared
            clause: fulfilment
          params:
            key:
              $event: /key
            fields:
              orderSnapshot:
                $event: /snapshot
      parties:
        seller: seller
        customer: customer
        partner: partner
      template: /clauses/orders/parameters/template
  amendments:
    type: Amendments/Amendments Clause
    parameters:
      approvers:
      - seller
      - partner
      paths:
      - /resellerTerms
    bindings:
      propose:
        proposeTerms:
          'on': workflow
          party: seller
          params:
            $object:
              $var: trigger
          request:
            description: Reviewed public input for this configured operation.
            proposalId:
              type: Text
              description: Identifier of the proposal selected by the user.
            type: Amendments/Amendment Input
            expectedRevision:
              type: Integer
              description: Current amendment revision from authorized state.
            path:
              type: Text
              description: Configured path of the terms being amended.
            replacement:
              description: User-selected replacement value for those terms.
      approve:
        sellerApprove:
          'on': workflow
          party: seller
          params:
            $object:
              $var: trigger
          request:
            description: Reviewed public input for this configured operation.
            proposalId:
              type: Text
              description: Identifier of the proposal selected by the user.
        partnerApprove:
          'on': workflow
          party: partner
          params:
            $object:
              $var: trigger
          request:
            description: Reviewed public input for this configured operation.
            proposalId:
              type: Text
              description: Identifier of the proposal selected by the user.
  catalogAmendments:
    type: Amendments/Amendments Clause
    parameters:
      approvers:
      - seller
      - partner
      paths:
      - /catalogUpdate
    bindings:
      propose:
        proposeCatalog:
          'on': workflow
          party: seller
          params:
            $object:
              $var: trigger
          request:
            description: Reviewed public input for this configured operation.
            proposalId:
              type: Text
              description: Identifier of the proposal selected by the user.
            type: Amendments/Amendment Input
            expectedRevision:
              type: Integer
              description: Current amendment revision from authorized state.
            path:
              type: Text
              description: Configured path of the terms being amended.
            replacement:
              description: User-selected replacement value for those terms.
      approve:
        sellerApproveCatalog:
          'on': workflow
          party: seller
          params:
            $object:
              $var: trigger
          request:
            description: Reviewed public input for this configured operation.
            proposalId:
              type: Text
              description: Identifier of the proposal selected by the user.
        partnerApproveCatalog:
          'on': workflow
          party: partner
          params:
            $object:
              $var: trigger
          request:
            description: Reviewed public input for this configured operation.
            proposalId:
              type: Text
              description: Identifier of the proposal selected by the user.
      state: /catalogAmendments
orderIntents: {}
orders: {}
supplierReadiness: {}
resellerTerms:
  fulfilmentText: '## Fulfilment

    Meet at Pier A, 15 minutes before your agreed start. The supplier provides the booked service. Fuel inclusion
    has not been specified.


    ## Supplier deposit

    The operator may hold USD 500 on arrival under its separately confirmed conditions. MyOS does not collect this
    deposit.'
  confirmationMode: supplier
  cancellationPolicy:
    freeCancellationHoursBeforeStart: 24
    lateCancellationChargePercent: 100
termsEditable: true
catalogUpdate: {}
