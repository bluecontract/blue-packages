name: Service Order
type: Orders/Order with Clauses
amountMinor: 10000
status: Open
acceptance: Pending
instructions: Use the main entrance
financial:
  captured: 0
  refunded: 0
  net: 0
delivery:
  name: Provider delivery evidence
  type: DocumentsDomain/Document with Clauses
  status: Open
  clauses:
    progress:
      type: State/State Machine Clause
      parameters:
        subject: Delivery
        transitions:
          Open:
          - Delivered
          - Failed
          Delivered:
          - Failed
      bindings:
        state: /status
        transition:
          deliver:
            'on': workflow
            channel: carrier
            params:
              to: Delivered
          failDelivery:
            'on': workflow
            channel: carrier
            params:
              to: Failed
              reason:
                $var:
                  name: trigger
                  path: /reason
  contracts:
    carrier:
      type: Contracts/External Channel
      event:
        source: carrier
paymentTemplate:
  name: Conditional Payment Instruction
  type: PaymentInstruction/Payment Instruction
  clauses:
    payment:
      type: PaymentInstruction/Payment Lifecycle Clause
      parameters:
        currency: EUR
        amountMinor: 10000
        limitMinor: 10000
        payerChannel: customer
        payeeChannel: seller
        guarantorChannel: guarantor
        allowedPayees:
        - seller
        recipientApprovalRequired: false
        required:
        - delivered
        - accepted
        captureGate: /policy/eligible
        autoCapture: false
        windowMs: 604800000
      bindings:
        state: /payment
        approveRecipient:
          approveRecipient:
            'on': workflow
            channel: seller
        requestCapture:
          capture:
            'on': workflow
            channel: customer
            params:
              requestId:
                $var:
                  name: trigger
                  path: /requestId
              amountMinor:
                $var:
                  name: trigger
                  path: /amountMinor
        requestRefund:
          refund:
            'on': workflow
            channel: seller
            params:
              requestId:
                $var:
                  name: trigger
                  path: /requestId
              amountMinor:
                $var:
                  name: trigger
                  path: /amountMinor
        acceptPaymentInstruction:
          acceptPaymentInstruction:
            'on': workflow
            channel: guarantor
        rejectPaymentInstruction:
          rejectPaymentInstruction:
            'on': workflow
            channel: guarantor
        recordTransactionInitiated:
          recordTransactionInitiated:
            'on': workflow
            channel: guarantor
            params:
              transactionId:
                $var:
                  name: trigger
                  path: /transactionId
        recordTransactionInitiationFailed:
          recordTransactionInitiationFailed:
            'on': workflow
            channel: guarantor
            params:
              $object:
                $var: trigger
        secureFunds:
          secureFunds:
            'on': workflow
            channel: guarantor
            params:
              $object:
                $var: trigger
        declineSecureFunds:
          declineSecureFunds:
            'on': workflow
            channel: guarantor
            params:
              $object:
                $var: trigger
        failSecureFunds:
          failSecureFunds:
            'on': workflow
            channel: guarantor
            params:
              $object:
                $var: trigger
        recordFundsSecuringUnknown:
          recordFundsSecuringUnknown:
            'on': workflow
            channel: guarantor
            params:
              $object:
                $var: trigger
        completePayment:
          completePayment:
            'on': workflow
            channel: guarantor
            params:
              $object:
                $var: trigger
        declineCompletePayment:
          declineCompletePayment:
            'on': workflow
            channel: guarantor
            params:
              $object:
                $var: trigger
        failCompletePayment:
          failCompletePayment:
            'on': workflow
            channel: guarantor
            params:
              $object:
                $var: trigger
        recordPaymentCompletionUnknown:
          recordPaymentCompletionUnknown:
            'on': workflow
            channel: guarantor
            params:
              $object:
                $var: trigger
        cancelBeforeCompletion:
          cancelBeforeCompletion:
            'on': workflow
            channel: guarantor
            params:
              $object:
                $var: trigger
        declineCancelBeforeCompletion:
          declineCancelBeforeCompletion:
            'on': workflow
            channel: guarantor
            params:
              $object:
                $var: trigger
        failCancelBeforeCompletion:
          failCancelBeforeCompletion:
            'on': workflow
            channel: guarantor
            params:
              $object:
                $var: trigger
        recordPaymentCancellationUnknown:
          recordPaymentCancellationUnknown:
            'on': workflow
            channel: guarantor
            params:
              $object:
                $var: trigger
        reverseAfterCompletion:
          reverseAfterCompletion:
            'on': workflow
            channel: guarantor
            params:
              $object:
                $var: trigger
        declineReverseAfterCompletion:
          declineReverseAfterCompletion:
            'on': workflow
            channel: guarantor
            params:
              $object:
                $var: trigger
        failReverseAfterCompletion:
          failReverseAfterCompletion:
            'on': workflow
            channel: guarantor
            params:
              $object:
                $var: trigger
        recordPaymentReversalUnknown:
          recordPaymentReversalUnknown:
            'on': workflow
            channel: guarantor
            params:
              $object:
                $var: trigger
        confirmPayeeAssignment:
          confirmPayeeAssignment:
            'on': workflow
            channel: guarantor
            params:
              $object:
                $var: trigger
        rejectPayeeAssignment:
          rejectPayeeAssignment:
            'on': workflow
            channel: guarantor
            params:
              $object:
                $var: trigger
        confirmTransactionDetailsUpdated:
          confirmTransactionDetailsUpdated:
            'on': workflow
            channel: guarantor
            params:
              $object:
                $var: trigger
        rejectTransactionDetailsUpdate:
          rejectTransactionDetailsUpdate:
            'on': workflow
            channel: guarantor
            params:
              $object:
                $var: trigger
        failTransactionDetailsUpdate:
          failTransactionDetailsUpdate:
            'on': workflow
            channel: guarantor
            params:
              $object:
                $var: trigger
        resolveFinalAmount:
          resolveFinalAmount:
            'on': workflow
            channel: guarantor
            params:
              $object:
                $var: trigger
        rejectFinalAmountResolution:
          rejectFinalAmountResolution:
            'on': workflow
            channel: guarantor
            params:
              $object:
                $var: trigger
        lockPaymentCompletion:
          lockPaymentCompletion:
            'on': workflow
            channel: guarantor
            params:
              $object:
                $var: trigger
        failPaymentCompletionLockChange:
          failPaymentCompletionLockChange:
            'on': workflow
            channel: guarantor
            params:
              $object:
                $var: trigger
        unlockPaymentCompletion:
          unlockPaymentCompletion:
            'on': workflow
            channel: guarantor
            params:
              $object:
                $var: trigger
        lockPaymentReversal:
          lockPaymentReversal:
            'on': workflow
            channel: guarantor
            params:
              $object:
                $var: trigger
        failPaymentReversalLockChange:
          failPaymentReversalLockChange:
            'on': workflow
            channel: guarantor
            params:
              $object:
                $var: trigger
        unlockPaymentReversal:
          unlockPaymentReversal:
            'on': workflow
            channel: guarantor
            params:
              $object:
                $var: trigger
        lockTransactionDetailsUpdate:
          lockTransactionDetailsUpdate:
            'on': workflow
            channel: guarantor
            params:
              $object:
                $var: trigger
        failTransactionDetailsUpdateLockChange:
          failTransactionDetailsUpdateLockChange:
            'on': workflow
            channel: guarantor
            params:
              $object:
                $var: trigger
        unlockTransactionDetailsUpdate:
          unlockTransactionDetailsUpdate:
            'on': workflow
            channel: guarantor
            params:
              $object:
                $var: trigger
    decision:
      type: PaymentInstruction/Conditional Policy
      parameters:
        currency: EUR
        amountMinor: 10000
        limitMinor: 10000
        payerChannel: customer
        payeeChannel: seller
        guarantorChannel: guarantor
        allowedPayees:
        - seller
        recipientApprovalRequired: false
        required:
        - delivered
        - accepted
        captureGate: /policy/eligible
        autoCapture: false
        windowMs: 604800000
      bindings:
        record:
          deliveredInitial:
            'on': initialized
            once: true
            params:
              fact: delivered
              confirmed:
                $eq:
                - $document: /sources/delivery/status
                - Delivered
          deliveredChanged:
            'on': embedded
            path: /sources/delivery
            params:
              fact: delivered
              confirmed:
                $eq:
                - $document: /sources/delivery/status
                - Delivered
          acceptedInitial:
            'on': initialized
            once: true
            params:
              fact: accepted
              confirmed:
                $eq:
                - $document: /sources/order/acceptance
                - Accepted
          acceptedChanged:
            'on': embedded
            path: /sources/order
            params:
              fact: accepted
              confirmed:
                $eq:
                - $document: /sources/order/acceptance
                - Accepted
        fail:
          failedOrder:
            'on': embedded
            path: /sources/order
            event:
              type: Commerce/Domain Event
              kind: Order Failed
              reason: abc
        retry:
          retryPayment:
            'on': workflow
            channel: guarantor
            params:
              requestId:
                $var:
                  name: trigger
                  path: /requestId
  contracts:
    customer:
      type: Contracts/External Channel
      event:
        source: customer
    seller:
      type: Contracts/External Channel
      event:
        source: seller
    guarantor:
      type: Contracts/External Channel
      event:
        source: guarantor
clauses:
  acceptance:
    type: State/State Machine Clause
    parameters:
      subject: Acceptance
      transitions:
        Pending:
        - Accepted
        - Declined
    bindings:
      state: /acceptance
      transition:
        acceptDelivery:
          'on': workflow
          channel: customer
          params:
            to: Accepted
        declineDelivery:
          'on': workflow
          channel: customer
          params:
            to: Declined
  lifecycle:
    type: State/State Machine Clause
    parameters:
      subject: Order
      transitions:
        Open:
        - Failed
        - Completed
        Completed:
        - Failed
    bindings:
      state: /status
      transition:
        reportOrderFailed:
          'on': workflow
          channel: seller
          params:
            to: Failed
            reason:
              $var:
                name: trigger
                path: /reason
        completeWhenEligible:
          'on': event
          event:
            type: Commerce/Domain Event
            kind: Order Completion Eligible
          params:
            to: Completed
  instructions:
    type: Features/Delivery Instructions Clause
    parameters:
      editableStates:
      - Open
    bindings:
      text: /instructions
      lifecycle: /delivery/status
      amend:
        changeInstructions:
          'on': workflow
          channel: customer
          params:
            text:
              $var:
                name: trigger
                path: /text
  payment:
    type: Payment/Payment Clause
    parameters:
      hostSource: order
      sourcePaths:
        delivery: /delivery
      amountPath: /amountMinor
    bindings:
      template: /paymentTemplate
      instruction: /payment
      initPayment:
        startPayment:
          'on': workflow
          channel: seller
  summary:
    type: Referrals/Order Summary Clause
    bindings:
      update:
        paymentChanged:
          'on': event
          event:
            type: Payment/Payment Event Received
        acceptanceChanged:
          'on': event
          event:
            type: Commerce/Domain Event
            kind: Acceptance Accepted
        deliveryChanged:
          'on': embedded
          path: /delivery
contracts:
  customer:
    type: Contracts/External Channel
    event:
      source: customer
  seller:
    type: Contracts/External Channel
    event:
      source: seller
  carrier:
    type: Contracts/External Channel
    event:
      source: carrier
  guarantor:
    type: Contracts/External Channel
    event:
      source: guarantor
