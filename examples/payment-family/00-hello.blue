name: Hello through an operation and an event
type: Agreements/Agreement with Clauses
message: ''
clauses:
  hello:
    type: Connections/Hello Clause
    bindings:
      text: /message
      say:
        greet:
          'on': workflow
          channel: owner
          params:
            text:
              $var:
                name: trigger
                path: /text
        initialGreeting:
          'on': initialized
          once: true
contracts:
  owner:
    type: Contracts/External Channel
    event:
      source: owner
