name: Commission ledger contract
type: Agreements/Agreement with Clauses
clauses:
  balance:
    type: Balance/Balance Clause
    parameters:
      currency: EUR
    bindings:
      setTarget:
        setCommission:
          'on': workflow
          channel: seller
          params:
            key:
              $var:
                name: trigger
                path: /key
            amountMinor:
              $var:
                name: trigger
                path: /amountMinor
      reserve:
        reserve:
          'on': workflow
          channel: seller
          params:
            key:
              $var:
                name: trigger
                path: /key
            amountMinor:
              $var:
                name: trigger
                path: /amountMinor
      settle:
        settle:
          'on': workflow
          channel: guarantor
          params:
            key:
              $var:
                name: trigger
                path: /key
contracts:
  seller:
    type: Contracts/External Channel
    event:
      source: seller
  guarantor:
    type: Contracts/External Channel
    event:
      source: guarantor
