name: Explicit payment protocol walkthrough
type: PaymentInstruction/Payment Instruction
instanceKey: protocol-demo
payment: {}
clauses:
  payment:
    type: PaymentInstruction/Payment Lifecycle Clause
    parameters:
      currency: EUR
      amountMinor: 10000
      limitMinor: 12000
      payerChannel: customer
      payeeChannel: seller
      guarantorChannel: guarantor
      allowedPayees:
      - seller
      - seller2
      recipientApprovalRequired: false
    bindings:
      state: /payment
      acceptPaymentInstruction:
        acceptPaymentInstruction:
          'on': workflow
          channel: guarantor
          params:
            $object:
              $var: trigger
      rejectPaymentInstruction:
