name: Account-to-account milestone payment
type: Orders/Order with Clauses
product:
  name: One English lesson
  currency: EUR
  unitPriceMinor: 10000
  quantity: 1
afterCount: 0
clauses:
  payment:
    type: MyOS/MyOS Account to Account Payment
    parameters:
      requireAll:
        confirmSatisfaction:
          'on': workflow
          channel: customer
          after:
          - $appendEvent:
              kind: Satisfaction Audit
      recipient:
        type: MyOS/MyOS Party
        partyId: bob
        displayName: Bob
        myosAccountId: bob
      payer: alice
  label:
    type:
      name: Party Label Clause
      type: Connections/Connected Clause
      actions:
        rename:
          do:
          - $appendChange:
              op: replace
              path: /parties/seller/displayName
              val: Updated seller label
    bindings:
      rename:
        renameSeller:
          'on': workflow
          channel: seller
contracts:
  customer:
    type: Contracts/External Channel
    event:
      source: customer
  seller:
    type: Contracts/External Channel
    event:
      source: seller
  guarantor:
    type: Contracts/External Channel
    event:
      source: guarantor
parties:
  customer:
    type: MyOS/MyOS Party
    partyId: alice
    displayName: Alice
    myosAccountId: alice
  seller:
    type: MyOS/MyOS Party
    partyId: bob
    displayName: Bob
    myosAccountId: bob
  guarantor:
    type: MyOS/MyOS Party
    partyId: payment-operator
    displayName: Payment-Operator
    myosAccountId: payment-operator
