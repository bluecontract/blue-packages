name: ACME Bank confirmed service payment
type: Orders/Order with Clauses
product:
  name: Service
  currency: EUR
  unitPriceMinor: 10000
  quantity: 1
afterCount: 0
clauses:
  payment:
    type: ACME/ACME Bank Payment
    parameters:
      requireAll:
        confirmSatisfaction:
          'on': workflow
          channel: customer
          after:
          - $appendEvent:
              kind: Satisfaction Audit
contracts:
  customer:
    type: Contracts/External Channel
    event:
      source: customer
  seller:
    type: Contracts/External Channel
    event:
      source: seller
  guarantor:
    type: Contracts/External Channel
    event:
      source: guarantor
