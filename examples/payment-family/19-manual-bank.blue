name: Manual invoice payment
type: Agreements/Agreement with Clauses
clauses:
  payment:
    type: ManualPayments/Manual Bank Payment
    parameters:
      amountMinor: 2500
      currency: EUR
contracts:
  customer:
    type: Contracts/External Channel
    event:
      source: customer
  seller:
    type: Contracts/External Channel
    event:
      source: seller
