# Authenticated bootstrap supplies participant timeline channels.
name: Customer payment for an English lesson
type: Orders/Order with Clauses
product:
  name: One English lesson
  currency: EUR
  unitPriceMinor: 10000
  quantity: 1
afterCount: 0
clauses:
  payment:
    type: MyOS/MyOS Customer Payment
    parameters:
      requireAll:
        confirmSatisfaction:
          'on': workflow
          channel: customer
          after:
          - $appendEvent:
              kind: Satisfaction Audit
      recipient: bob
parties:
  customer:
    type: MyOS/MyOS Party
    partyId: alice
    displayName: Alice
    myosAccountId: alice
  seller:
    type: MyOS/MyOS Party
    partyId: bob
    displayName: Bob
    myosAccountId: bob
  guarantor:
    type: MyOS/MyOS Party
    partyId: payment-operator
    displayName: Payment-Operator
    myosAccountId: payment-operator
