name: Carrier waits for release of the goods
type: Agreements/Agreement with Clauses
x: 0
clauses:
  activation:
    type: Activation/Activation Clause
    parameters:
      parties:
        customer:
          type: Parties/Party
          displayName: Customer
        seller:
          type: Parties/Party
          displayName: Merchant
        reviewer:
          type: Parties/Party
          displayName: Reviewer
        carrier:
          type: Parties/Party
          displayName: Carrier
      required: []
      allowNewParties: true
  status:
    type: Features/Feature Clause
    parameters:
      actions:
        setReady:
          do:
          - $appendChange:
              op: replace
              path: /x
              val: 1
    bindings:
      setReady:
        setReady:
          'on': workflow
          party: customer
          request:
            description: Set the configured ready state. No request fields are required.
  instruction:
    type: Attachments/Shipment Preparation Clause
    parameters:
      authority: carrier
      payer: customer
      payee: seller
      template:
        name: Shipment
        type: Shipping/Shipping Instruction with Clauses
        clauses: {}
        sources: {}
        destination: 2 Blue Street, Prague
      hooks:
        requestShipment:
          whenReady:
            'on': state
            in: parent
            path: /x
            equals: 1
            params:
              requestId: ship
              amountMinor: 200
      obtain: provide
      suppliedBy: seller
    bindings:
      request: /instructionRequest
      instruction: /instruction
      begin:
        prepareDocument:
          'on': workflow
          party: customer
          request:
            type: Attachments/Attachment Preparation Input
            requestId:
              type: Text
              schema:
                minLength: 1
              description: User-provided unique request key. Must satisfy configured party-key syntax.
          params:
            $pointerSet:
              object:
                $object:
                  $var: trigger
              path: /type
              op: remove
      provide:
        provideDocument:
          'on': workflow
          party: seller
          request:
            inResponseTo:
              type: Text
              description: Request identifier of the active preparation.
            requirementRef:
              type: Text
              description: Document Blue ID in the current preparation request.
            document:
              description: Existing initialized document publication supplied by Blue ID. Execution validates
                the prepared source, configured policy and parties.
              contracts:
                initialized:
                  document: {}
      resume:
        resumeDocument:
          'on': workflow
          party: seller
          request:
            description: Resume preparation from its current document state; no request fields are required.
