name: Deposit and final balance are separate obligations
type: Agreements/Agreement with Clauses
x: 0
clauses:
  activation:
    type: Activation/Activation Clause
    parameters:
      parties:
        customer:
          type: Parties/Party
          displayName: Customer
        seller:
          type: Parties/Party
          displayName: Merchant
        reviewer:
          type: Parties/Party
          displayName: Reviewer
        guarantor:
          type: Parties/Party
          displayName: Payment institution
      required: []
      allowNewParties: true
  status:
    type: Features/Feature Clause
    parameters:
      actions:
        setReady:
          do:
          - $appendChange:
              op: replace
              path: /x
              val: 1
    bindings:
      setReady:
        setReady:
          'on': workflow
          party: customer
          request:
            description: Set the configured ready state. No request fields are required.
  deposit:
    type: Attachments/Payment Preparation Clause
    parameters:
      authority: guarantor
      payer: customer
      payee: seller
      template:
        name: Payment Instruction
        type: PaymentInstruction/Payment Instruction with Clauses
        clauses: {}
        sources: {}
        paymentTerms:
          currency: EUR
          amountMinor: 50
          limitMinor: 50
          payerChannel: customer
          payeeChannel: seller
          guarantorChannel: guarantor
          allowedPayees:
          - seller
          recipientApprovalRequired: false
      hooks:
        requestCapture:
          confirm:
            'on': workflow
            party: customer
            params:
              $pointerSet:
                object:
                  $object:
                    $var: trigger
                path: /type
                op: remove
            request:
              type: PaymentInstruction/Payment Request Input
              description: Input for this configured financial request. Amount may be supplied by the
                configured action defaults.
              requestId:
                type: Text
                description: Unique identifier for this requested financial action.
        requestAuthorize:
          authorize:
            'on': workflow
            party: customer
            params:
              $pointerSet:
                object:
                  $object:
                    $var: trigger
                path: /type
                op: remove
            request:
              type: PaymentInstruction/Payment Request Input
              description: Input for this configured financial request. Amount may be supplied by the
                configured action defaults.
              requestId:
                type: Text
                description: Unique identifier for this requested financial action.
      obtain: create
      suppliedBy: customer
    bindings:
      request: /depositRequest
      instruction: /deposit
      begin:
        prepareDeposit:
          'on': workflow
          party: customer
          request:
            type: Attachments/Attachment Preparation Input
            requestId:
              type: Text
              schema:
                minLength: 1
              description: User-provided unique request key. Must satisfy configured party-key syntax.
          params:
            $pointerSet:
              object:
                $object:
                  $var: trigger
              path: /type
              op: remove
      resume:
        resumeDeposit:
          'on': workflow
          party: customer
          request:
            description: Resume preparation from its current document state; no request fields are required.
  balance:
    type: Attachments/Payment Preparation Clause
    parameters:
      authority: guarantor
      payer: customer
      payee: seller
      template:
        name: Payment Instruction
        type: PaymentInstruction/Payment Instruction with Clauses
        clauses: {}
        sources: {}
        paymentTerms:
          currency: EUR
          amountMinor: 150
          limitMinor: 150
          payerChannel: customer
          payeeChannel: seller
          guarantorChannel: guarantor
          allowedPayees:
          - seller
          recipientApprovalRequired: false
      hooks:
        requestCapture:
          confirm:
            'on': workflow
            party: customer
            params:
              $pointerSet:
                object:
                  $object:
                    $var: trigger
                path: /type
                op: remove
            request:
              type: PaymentInstruction/Payment Request Input
              description: Input for this configured financial request. Amount may be supplied by the
                configured action defaults.
              requestId:
                type: Text
                description: Unique identifier for this requested financial action.
        requestAuthorize:
          authorize:
            'on': workflow
            party: customer
            params:
              $pointerSet:
                object:
                  $object:
                    $var: trigger
                path: /type
                op: remove
            request:
              type: PaymentInstruction/Payment Request Input
              description: Input for this configured financial request. Amount may be supplied by the
                configured action defaults.
              requestId:
                type: Text
                description: Unique identifier for this requested financial action.
      obtain: create
      suppliedBy: customer
    bindings:
      request: /balanceRequest
      instruction: /balance
      begin:
        prepareBalance:
          'on': workflow
          party: customer
          request:
            type: Attachments/Attachment Preparation Input
            requestId:
              type: Text
              schema:
                minLength: 1
              description: User-provided unique request key. Must satisfy configured party-key syntax.
          params:
            $pointerSet:
              object:
                $object:
                  $var: trigger
              path: /type
              op: remove
      resume:
        resumeBalance:
          'on': workflow
          party: customer
          request:
            description: Resume preparation from its current document state; no request fields are required.
