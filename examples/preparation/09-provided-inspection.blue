name: Provider supplies the inspection work order
type: Agreements/Agreement with Clauses
x: 0
clauses:
  activation:
    type: Activation/Activation Clause
    parameters:
      parties:
        customer:
          type: Parties/Party
          displayName: Customer
        seller:
          type: Parties/Party
          displayName: Merchant
        reviewer:
          type: Parties/Party
          displayName: Reviewer
        guarantor:
          type: Parties/Party
          displayName: Payment institution
        provider:
          type: Parties/Party
          displayName: Service provider
      required: []
      allowNewParties: true
  status:
    type: Features/Feature Clause
    parameters:
      actions:
        setReady:
          do:
          - $appendChange:
              op: replace
              path: /x
              val: 1
    bindings:
      setReady:
        setReady:
          'on': workflow
          party: customer
          request:
            description: Set the configured ready state. No request fields are required.
  instruction:
    type: Attachments/Document Preparation Clause
    parameters:
      obtain: provide
      authority: provider
      suppliedBy: seller
      template:
        name: Inspection work order
        type: DocumentsDomain/Document with Clauses
        terms:
          task: Inspect the delivered equipment
        clauses: {}
    bindings:
      request: /instructionRequest
      instruction: /instruction
      begin:
        prepareDocument:
          'on': workflow
          party: customer
          request:
            type: Attachments/Attachment Preparation Input
            requestId:
              type: Text
              schema:
                minLength: 1
              description: User-provided unique request key. Must satisfy configured party-key syntax.
          params:
            $pointerSet:
              object:
                $object:
                  $var: trigger
              path: /type
              op: remove
      provide:
        provideDocument:
          'on': workflow
          party: seller
          request:
            inResponseTo:
              type: Text
              description: Request identifier of the active preparation.
            requirementRef:
              type: Text
              description: Document Blue ID in the current preparation request.
            document:
              description: Existing initialized document publication supplied by Blue ID. Execution validates
                the prepared source, configured policy and parties.
              contracts:
                initialized:
                  document: {}
      resume:
        resumeDocument:
          'on': workflow
          party: seller
          request:
            description: Resume preparation from its current document state; no request fields are required.
