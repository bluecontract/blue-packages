# Executable preparation candidate. Participant transports are supplied at bootstrap.
name: Course enrollment starts payment
type: Agreements/Agreement with Clauses
x: 0
clauses:
  activation:
    type: Activation/Activation Clause
    parameters:
      parties:
        customer:
          type: Parties/Party
          displayName: Customer
        seller:
          type: Parties/Party
          displayName: Merchant
        reviewer:
          type: Parties/Party
          displayName: Reviewer
        guarantor:
          type: Parties/Party
          displayName: Payment institution
      required: []
      allowNewParties: true
  status:
    type: Features/Feature Clause
    parameters:
      actions:
        setReady:
          do:
          - $appendChange:
              op: replace
              path: /x
              val: 1
    bindings:
      setReady:
        setReady:
          'on': workflow
          party: customer
  instruction:
    type: Attachments/Payment Preparation Clause
    parameters:
      authority: guarantor
      payer: customer
      payee: seller
      template:
        name: Payment Instruction
        type: PaymentInstruction/Payment Instruction with Clauses
        clauses: {}
        sources: {}
        paymentTerms:
          currency: EUR
          amountMinor: 200
          limitMinor: 200
          payerChannel: customer
          payeeChannel: seller
          guarantorChannel: guarantor
          allowedPayees:
          - seller
          recipientApprovalRequired: false
      hooks:
        requestCapture:
          confirm:
            'on': workflow
            party: customer
            params:
              $object:
                $var: trigger
        requestAuthorize:
          authorize:
            'on': workflow
            party: customer
            params:
              $object:
                $var: trigger
      obtain: create
      suppliedBy: customer
    bindings:
      request: /instructionRequest
      instruction: /instruction
      begin:
        purchaseConfirmed:
          'on': event
          event:
            type: Commerce/Domain Event
            kind: Purchase Confirmed
          params:
            requestId:
              $var:
                name: trigger
                path: /requestId
      provide:
        provideDocument:
          'on': workflow
          party: customer
      resume:
        resumeDocument:
          'on': workflow
          party: customer
  purchase:
    type: Features/Feature Clause
    parameters:
      actions:
        confirm:
          do:
          - $appendEvent:
              type: Commerce/Domain Event
              kind: Purchase Confirmed
              requestId:
                $var:
                  name: params
                  path: /requestId
    bindings:
      confirm:
        confirmPurchase:
          'on': workflow
          party: customer
          params:
            $object:
              $var: trigger
