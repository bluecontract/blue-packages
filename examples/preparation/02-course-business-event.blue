name: Course enrollment starts payment
type: Agreements/Agreement with Clauses
x: 0
clauses:
  activation:
    type: Activation/Activation Clause
    parameters:
      parties:
        customer:
          type: Parties/Party
          displayName: Customer
        seller:
          type: Parties/Party
          displayName: Merchant
        reviewer:
          type: Parties/Party
          displayName: Reviewer
        guarantor:
          type: Parties/Party
          displayName: Payment institution
      required: []
      allowNewParties: true
  status:
    type: Features/Feature Clause
    parameters:
      actions:
        setReady:
          do:
          - $appendChange:
              op: replace
              path: /x
              val: 1
    bindings:
      setReady:
        setReady:
          'on': workflow
          party: customer
          request:
            description: Set the configured ready state. No request fields are required.
  instruction:
    type: Attachments/Payment Preparation Clause
    parameters:
      authority: guarantor
      payer: customer
      payee: seller
      template:
        name: Payment Instruction
        type: PaymentInstruction/Payment Instruction with Clauses
        clauses: {}
        sources: {}
        paymentTerms:
          currency: EUR
          amountMinor: 200
          limitMinor: 200
          payerChannel: customer
          payeeChannel: seller
          guarantorChannel: guarantor
          allowedPayees:
          - seller
          recipientApprovalRequired: false
      hooks:
        requestCapture:
          confirm:
            'on': workflow
            party: customer
            params:
              $pointerSet:
                object:
                  $object:
                    $var: trigger
                path: /type
                op: remove
            request:
              type: PaymentInstruction/Payment Request Input
              description: Input for this configured financial request. Amount may be supplied by the configured
                action defaults.
              requestId:
                type: Text
                description: Unique identifier for this requested financial action.
        requestAuthorize:
          authorize:
            'on': workflow
            party: customer
            params:
              $pointerSet:
                object:
                  $object:
                    $var: trigger
                path: /type
                op: remove
            request:
              type: PaymentInstruction/Payment Request Input
              description: Input for this configured financial request. Amount may be supplied by the configured
                action defaults.
              requestId:
                type: Text
                description: Unique identifier for this requested financial action.
      obtain: create
      suppliedBy: customer
    bindings:
      request: /instructionRequest
      instruction: /instruction
      begin:
        purchaseConfirmed:
          'on': event
          event:
            type: Commerce/Domain Event
            kind: Purchase Confirmed
          params:
            requestId:
              $var:
                name: trigger
                path: /requestId
      provide:
        provideDocument:
          'on': workflow
          party: customer
          request:
            inResponseTo:
              type: Text
              description: Request identifier of the active preparation.
            requirementRef:
              type: Text
              description: Document Blue ID in the current preparation request.
            document:
              description: Existing initialized document publication supplied by Blue ID. Execution validates the
                prepared source, configured policy and parties.
              contracts:
                initialized:
                  document: {}
      resume:
        resumeDocument:
          'on': workflow
          party: customer
          request:
            description: Resume preparation from its current document state; no request fields are required.
  purchase:
    type: Features/Feature Clause
    parameters:
      actions:
        confirm:
          do:
          - $appendEvent:
              type: Commerce/Domain Event
              kind: Purchase Confirmed
              requestId:
                $var:
                  name: params
                  path: /requestId
    bindings:
      confirm:
        confirmPurchase:
          'on': workflow
          party: customer
          params:
            $object:
              $var: trigger
          request:
            requestId:
              type: Text
              schema:
                minLength: 1
              description: Unique purchase request key propagated to the preparation event.
