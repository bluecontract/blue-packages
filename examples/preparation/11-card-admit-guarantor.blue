name: Approve a new payment institution before connecting its PI
type: Agreements/Agreement with Clauses
x: 0
clauses:
  activation:
    type: Activation/Activation Clause
    parameters:
      parties:
        customer:
          type: Parties/Party
          displayName: Customer
        seller:
          type: Parties/Party
          displayName: Merchant
        reviewer:
          type: Parties/Party
          displayName: Reviewer
      required: []
      allowNewParties: true
  status:
    type: Features/Feature Clause
    parameters:
      actions:
        setReady:
          do:
          - $appendChange:
              op: replace
              path: /x
              val: 1
    bindings:
      setReady:
        setReady:
          'on': workflow
          party: customer
  instruction:
    type: Attachments/Payment Preparation Clause
    parameters:
      authority: guarantor
      payer: customer
      payee: seller
      template:
        name: Payment Instruction
        type: PaymentInstruction/Payment Instruction with Clauses
        clauses: {}
        sources: {}
        paymentTerms:
          currency: EUR
          amountMinor: 200
          limitMinor: 200
          payerChannel: customer
          payeeChannel: seller
          guarantorChannel: guarantor
          allowedPayees:
          - seller
          recipientApprovalRequired: false
      hooks:
        requestCapture:
          whenReady:
            'on': state
            in: parent
            path: /x
            equals: 1
            params:
              requestId: capture
              amountMinor: 200
            recheckOn:
            - /payment/secured
            when:
              $gte:
              - $document: /payment/secured
              - 200
        requestAuthorize:
          authorize:
            'on': workflow
            party: customer
            params:
              $object:
                $var: trigger
      obtain: provide
      suppliedBy: seller
      admissionClause: partyChanges
    bindings:
      request: /instructionRequest
      instruction: /instruction
      begin:
        prepareDocument:
          'on': workflow
          party: customer
      provide:
        provideDocument:
          'on': workflow
          party: seller
      resume:
        resumeDocument:
          'on': workflow
          party: seller
  partyChanges:
    type: Amendments/Amendments Clause
    parameters:
      approvers:
      - customer
      - seller
      paths:
      - /admission_instruction
    bindings:
      state: /amendments
      editable: /termsEditable
      approve:
        approveBuyer:
          'on': workflow
          party: customer
          params:
            $object:
              $var: trigger
        approveSeller:
          'on': workflow
          party: seller
          params:
            $object:
              $var: trigger
termsEditable: true
