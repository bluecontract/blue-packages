name: Approve a new payment institution before connecting its PI
type: Agreements/Agreement with Clauses
x: 0
clauses:
  activation:
    type: Activation/Activation Clause
    parameters:
      parties:
        customer:
          type: Parties/Party
          displayName: Customer
        seller:
          type: Parties/Party
          displayName: Merchant
        reviewer:
          type: Parties/Party
          displayName: Reviewer
      required: []
      allowNewParties: true
  status:
    type: Features/Feature Clause
    parameters:
      actions:
        setReady:
          do:
          - $appendChange:
              op: replace
              path: /x
              val: 1
    bindings:
      setReady:
        setReady:
          'on': workflow
          party: customer
          request:
            description: Set the configured ready state. No request fields are required.
  instruction:
    type: Attachments/Payment Preparation Clause
    parameters:
      authority: guarantor
      payer: customer
      payee: seller
      template:
        name: Payment Instruction
        type: PaymentInstruction/Payment Instruction with Clauses
        clauses: {}
        sources: {}
        paymentTerms:
          currency: EUR
          amountMinor: 200
          limitMinor: 200
          payerChannel: customer
          payeeChannel: seller
          guarantorChannel: guarantor
          allowedPayees:
          - seller
          recipientApprovalRequired: false
      hooks:
        requestCapture:
          whenReady:
            'on': state
            in: parent
            path: /x
            equals: 1
            params:
              requestId: capture
              amountMinor: 200
            recheckOn:
            - /payment/secured
            when:
              $gte:
              - $document: /payment/secured
              - 200
        requestAuthorize:
          authorize:
            'on': workflow
            party: customer
            params:
              $pointerSet:
                object:
                  $object:
                    $var: trigger
                path: /type
                op: remove
            request:
              type: PaymentInstruction/Payment Request Input
              description: Input for this configured financial request. Amount may be supplied by the
                configured action defaults.
              requestId:
                type: Text
                description: Unique identifier for this requested financial action.
      obtain: provide
      suppliedBy: seller
      admissionClause: partyChanges
    bindings:
      request: /instructionRequest
      instruction: /instruction
      begin:
        prepareDocument:
          'on': workflow
          party: customer
          request:
            type: Attachments/Attachment Preparation Input
            requestId:
              type: Text
              schema:
                minLength: 1
              description: User-provided unique request key. Must satisfy configured party-key syntax.
          params:
            $pointerSet:
              object:
                $object:
                  $var: trigger
              path: /type
              op: remove
      provide:
        provideDocument:
          'on': workflow
          party: seller
          request:
            inResponseTo:
              type: Text
              description: Request identifier of the active preparation.
            requirementRef:
              type: Text
              description: Document Blue ID in the current preparation request.
            document:
              description: Existing initialized document publication supplied by Blue ID. Execution validates
                the prepared source, configured policy and parties.
              contracts:
                initialized:
                  document: {}
      resume:
        resumeDocument:
          'on': workflow
          party: seller
          request:
            description: Resume preparation from its current document state; no request fields are required.
  partyChanges:
    type: Amendments/Amendments Clause
    parameters:
      approvers:
      - customer
      - seller
      paths:
      - /admission_instruction
    bindings:
      state: /amendments
      editable: /termsEditable
      approve:
        approveBuyer:
          'on': workflow
          party: customer
          params:
            $object:
              $var: trigger
          request:
            proposalId:
              type: Text
              description: Identifier of the pending amendment selected for approval.
        approveSeller:
          'on': workflow
          party: seller
          params:
            $object:
              $var: trigger
          request:
            proposalId:
              type: Text
              description: Identifier of the pending amendment selected for approval.
termsEditable: true
