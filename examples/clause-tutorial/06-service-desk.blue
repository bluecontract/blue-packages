name: 'Service desk: quotes, stock, copy and lifecycle'
type: Agreements/Agreement with Clauses
message: ''
status: Draft
milestone: Open
stock: 5
visits: 0
terms: Original terms
instructions: Front door
product: {}
materials: {}
clauses:
  status:
    type: Commerce/Status Clause
    parameters:
      subject: Offer
      transitions:
        Draft:
        - Published
        Published:
        - Archived
    bindings:
      state: /status
      transition:
        publish:
          'on': workflow
          channel: owner
          params:
            to: Published
        archive:
          'on': workflow
          channel: owner
          params:
            to: Archived
  milestone:
    type: State/State Machine Clause
    parameters:
      subject: Milestone
      transitions:
        Open:
        - Accepted
        - Rejected
    bindings:
      state: /milestone
      transition:
        approveMilestone:
          'on': workflow
          channel: owner
          params:
            to: Accepted
  stock:
    type: Commerce/Counter Clause
    parameters:
      minimum: 0
      maximum: 10
    bindings:
      count: /stock
      adjust:
        stockAdjust:
          'on': workflow
          channel: owner
          params:
            delta:
              $var:
                name: trigger
                path: /delta
  visits:
    type: Commerce/Counter Clause
    parameters:
      minimum: 0
      maximum: 100
    bindings:
      count: /visits
      adjust:
        visitsAdjust:
          'on': workflow
          channel: owner
          params:
            delta:
              $var:
                name: trigger
                path: /delta
  terms:
    type: Commerce/Text Clause
    bindings:
      text: /terms
      amend:
        termsAmend:
          'on': workflow
          channel: owner
          params:
            expected:
              $var:
                name: trigger
                path: /expected
            text:
              $var:
                name: trigger
                path: /text
  copy:
    type: Commerce/Text Clause
    bindings:
      text: /message
      amend:
        copyAmend:
          'on': workflow
          channel: owner
          params:
            expected:
              $var:
                name: trigger
                path: /expected
            text:
              $var:
                name: trigger
                path: /text
  serviceQuote:
    type: Commerce/Product Clause
    parameters:
      currency: EUR
    bindings:
      product: /product
      quote:
        serviceQuote:
          'on': workflow
          channel: owner
          params:
            unitPriceMinor:
              $var:
                name: trigger
                path: /price
            quantity:
              $var:
                name: trigger
                path: /quantity
  materialsQuote:
    type: Commerce/Product Clause
    parameters:
      currency: EUR
    bindings:
      product: /materials
      quote:
        materialsQuote:
          'on': workflow
          channel: owner
          params:
            unitPriceMinor:
              $var:
                name: trigger
                path: /price
            quantity:
              $var:
                name: trigger
                path: /quantity
  instructions:
    type: Features/Delivery Instructions Clause
    parameters:
      editableStates:
      - Draft
    bindings:
      text: /instructions
      lifecycle: /status
      amend:
        changeInstructions:
          'on': workflow
          channel: owner
          params:
            text:
              $var:
                name: trigger
                path: /text
  reminder:
    type: Schedule/Schedule Clause
    parameters:
      key: offer-follow-up
    bindings:
      fire:
        sendReminder:
          'on': workflow
          channel: owner
  archiveNotice:
    type: Schedule/Schedule Clause
    parameters:
      key: archive-review
    bindings:
      fire:
        afterArchive:
          'on': event
          event:
            type: Commerce/Domain Event
            kind: Offer Archived
contracts:
  owner:
    type: Contracts/External Channel
    event:
      source: owner
