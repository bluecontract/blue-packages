name: Hello with a native multi-step workflow
type: Agreements/Agreement with Clauses
message: ''
processed: false
clauses:
  hello:
    type: Connections/Hello Clause
    bindings:
      text: /message
      say:
        preparedGreeting:
          'on': event
          event:
            kind: Greeting Prepared
          params:
            text:
              $event: /text
          after:
          - $appendChange:
              op: replace
              path: /processed
              val: true
contracts:
  owner:
    type: Contracts/External Channel
    event:
      source: owner
  prepareGreeting:
    type: Contracts/Sequential Workflow Operation
    channel: owner
    steps:
    - name: validate
      type: Contracts/Compute
      do:
      - $failIf:
          cond:
            $not:
              $isKind:
                val:
                  $binding: call/request/person
                kind: text
          message: Person must be Text
      - $return:
          person:
            $binding: call/request/person
    - name: format
      type: Contracts/Compute
      do:
      - $return:
          text:
            $concat:
            - 'Hello, '
            - $steps:
                step: validate
                path: /person
            - '!'
    - type: Contracts/Trigger Event
      event:
        kind: Greeting Prepared
        text:
          $steps:
            step: format
            path: /text
