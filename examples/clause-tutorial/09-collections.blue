name: Evidence collections
type: Agreements/Agreement with Clauses
clauses:
  inspections:
    type: Clauses/Collection Clause
    parameters:
      field: inspections
      family: Inspection
      operation: addInspection
    bindings:
      actor: owner
  receipts:
    type: Clauses/Collection Clause
    parameters:
      field: receipts
      family: Receipt
      operation: addReceipt
    bindings:
      actor: owner
contracts:
  owner:
    type: Contracts/External Channel
    event:
      source: owner
