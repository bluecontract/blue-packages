name: 'English lesson: payment after customer satisfaction'
type: Orders/Order with Clauses
product:
  name: One English conversation lesson
  currency: EUR
  unitPriceMinor: 4000
  quantity: 1
afterCount: 0
clauses:
  payment:
    type: Payment/Conditional Payment
    parameters:
      requireAll:
        confirmSatisfaction:
          'on': workflow
          channel: customer
          after:
          - $appendEvent:
              kind: Satisfaction Audit
contracts:
  customer:
    type: Contracts/External Channel
    event:
      source: customer
  seller:
    type: Contracts/External Channel
    event:
      source: seller
  guarantor:
    type: Contracts/External Channel
    event:
      source: guarantor
