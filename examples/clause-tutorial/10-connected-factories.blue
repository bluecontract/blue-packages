name: Campaign jobs and support cases
type: Agreements/Agreement with Clauses
jobs: {}
cases: {}
jobTemplate:
  name: Work item
  type: DocumentsDomain/Document with Clauses
  itemId: template
  instanceKey: template
  message: ''
  clauses:
    hello:
      type: Connections/Hello Clause
      bindings:
        text: /message
        say:
          greet:
            'on': workflow
            channel: owner
            params:
              text:
                $var:
                  name: trigger
                  path: /text
  contracts:
    owner:
      type: Contracts/External Channel
      event:
        source: owner
caseTemplate:
  name: Work item
  type: DocumentsDomain/Document with Clauses
  itemId: template
  instanceKey: template
  message: ''
  clauses:
    hello:
      type: Connections/Hello Clause
      bindings:
        text: /message
        say:
          greet:
            'on': workflow
            channel: owner
            params:
              text:
                $var:
                  name: trigger
                  path: /text
  contracts:
    owner:
      type: Contracts/External Channel
      event:
        source: owner
clauses:
  jobs:
    type: Commerce/Document Factory Clause
    parameters:
      allowedFields:
      - message
      inheritChannels:
      - owner
    bindings:
      template: /jobTemplate
      collection: /jobs
      start:
        newJob:
          'on': workflow
          channel: owner
          params:
            key:
              $var:
                name: trigger
                path: /key
            fields:
              message:
                $var:
                  name: trigger
                  path: /message
  cases:
    type: Commerce/Document Factory Clause
    parameters:
      allowedFields:
      - message
      inheritChannels:
      - owner
    bindings:
      template: /caseTemplate
      collection: /cases
      start:
        newCase:
          'on': workflow
          channel: owner
          params:
            key:
              $var:
                name: trigger
                path: /key
            fields:
              message:
                $var:
                  name: trigger
                  path: /message
contracts:
  owner:
    type: Contracts/External Channel
    event:
      source: owner
