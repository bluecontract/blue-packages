# The native tutorial fixture supplies real channels, reader keys and signed access documents.
name: Access-aware service agreement
type: Agreements/Agreement with Clauses
count: 0
timelineAccess: {}
clauses:
  participants:
    type: AccessParticipants/Participants with Access Clause
    parameters:
      participants: {}
      accessPaths: [/timelineAccess/alice, /timelineAccess/bob]
    bindings:
      state: /accessStatus
  action:
    type: Clauses/Composable Clause
    parameters:
      contracts:
        bump:
          kind: handler
          contract:
            type: Contracts/Sequential Workflow Operation
            channel: alice
            steps:
              - type: AccessParticipants/Require Participant Access
                constants: {clauseKey: participants}
              - type: Contracts/Compute
                do:
                  - $appendChange:
                      op: replace
                      path: /count
                      val: {$add: [{$document: /count}, 1]}
      states: {}
      reads: []
