name: An English lesson paid when the customer is satisfied
type: Orders/Order with Clauses
product:
  name: One English lesson
  quantity: 1
  unitPriceMinor: 10000
  currency: EUR
satisfied: false
clauses:
  activation:
    type: Activation/Activation Clause
    parameters:
      parties:
        customer:
          type: Parties/Party
          displayName: Customer
        seller:
          type: Parties/Party
          displayName: Seller
        guarantor:
          type: Parties/Party
          displayName: Guarantor
      required:
      - customer
      - seller
      - guarantor
  payment:
    type: Payment/Payment Clause
    parameters:
      amountMinor: 10000
      currency: EUR
      instructionClauses:
        delivery:
          type: Features/Feature Clause
          parameters:
            actions:
              report:
                do:
                - $appendChange:
                    op: add
                    path: /deliveryReported
                    val: true
                - $appendEvent:
                    $merge:
                    - type: Events/Event
                    - kind: Delivery Reported
          bindings:
            report:
              reportDelivery:
                'on': workflow
                party: seller
    bindings:
      instruction: /payment
      start:
        startPayment:
          'on': workflow
          party: customer
      requestAuthorize:
        authorize:
          'on': workflow
          party: customer
          params:
            $object:
              $var: trigger
      requestCapture:
        confirmSatisfaction:
          'on': workflow
          party: customer
          params:
            requestId: capture-1
            amountMinor: 10000
          before:
          - $failIf:
              cond:
                $ne:
                - $document: /deliveryReported
                - true
              message: DELIVERY_REPORT_REQUIRED
          - $failIf:
              cond:
                $ne:
                - $var:
                    name: trigger
                    path: /satisfied
                - true
              message: SATISFACTION_REQUIRED
          after:
          - $appendEvent:
              $merge:
              - type: Events/Event
              - kind: Customer Satisfaction
                satisfied: true
      requestRefund:
        refund:
          'on': workflow
          party: seller
          params:
            $object:
              $var: trigger
  satisfaction:
    type: Features/Feature Clause
    parameters:
      actions:
        remember:
          do:
          - $appendChange:
              op: replace
              path: /satisfied
              val: true
    bindings:
      remember:
        satisfied:
          'on': event
          event:
            type: Payment/Payment Event Received
            kind: Customer Satisfaction
