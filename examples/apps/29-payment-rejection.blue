name: Payment protocol requests, outcomes and reconciliation
type: PaymentInstruction/Payment Instruction with Clauses
instanceKey: protocol-demo
paymentTerms:
  currency: EUR
  amountMinor: 10000
  limitMinor: 12000
  payerChannel: customer
  payeeChannel: seller
  guarantorChannel: guarantor
  allowedPayees:
  - seller
  - seller2
  recipientApprovalRequired: false
clauses:
  activation:
    type: Activation/Activation Clause
    parameters:
      parties:
        customer:
          type: Parties/Party
          displayName: Customer
        seller:
          type: Parties/Party
          displayName: Seller
        seller2:
          type: Parties/Party
          displayName: Seller2
        guarantor:
          type: Parties/Party
          displayName: Guarantor
      required:
      - customer
      - seller
      - seller2
      - guarantor
  requests:
    type: PaymentInstruction/Payment Request Actions
    bindings:
      requestAuthorize:
        requestSecureFunds:
          'on': workflow
          params:
            $object:
              $var: trigger
          party: customer
      requestCapture:
        requestCompletePayment:
          'on': workflow
          params:
            $object:
              $var: trigger
          party: customer
      requestRefund:
        requestReverseAfterCompletion:
          'on': workflow
          params:
            $object:
              $var: trigger
          party: customer
      requestVoid:
        requestCancelBeforeCompletion:
          'on': workflow
          params:
            $object:
              $var: trigger
          party: customer
      requestPayeeAssignment:
        requestPayeeAssignment:
          'on': workflow
          params:
            $object:
              $var: trigger
          party: customer
      requestTransactionDetailsUpdate:
        requestTransactionDetailsUpdate:
          'on': workflow
          params:
            $object:
              $var: trigger
          party: customer
      requestFinalAmountResolution:
        requestFinalAmountResolution:
          'on': workflow
          params:
            $object:
              $var: trigger
          party: customer
      requestPaymentCompletionLock:
        requestPaymentCompletionLock:
          'on': workflow
          params:
            $object:
              $var: trigger
          party: customer
      requestPaymentCompletionUnlock:
        requestPaymentCompletionUnlock:
          'on': workflow
          params:
            $object:
              $var: trigger
          party: customer
      requestPaymentReversalLock:
        requestPaymentReversalLock:
          'on': workflow
          params:
            $object:
              $var: trigger
          party: customer
      requestPaymentReversalUnlock:
        requestPaymentReversalUnlock:
          'on': workflow
          params:
            $object:
              $var: trigger
          party: customer
      requestTransactionDetailsUpdateLock:
        requestTransactionDetailsUpdateLock:
          'on': workflow
          params:
            $object:
              $var: trigger
          party: customer
      requestTransactionDetailsUpdateUnlock:
        requestTransactionDetailsUpdateUnlock:
          'on': workflow
          params:
            $object:
              $var: trigger
          party: customer
      approveRecipient:
        approveRecipient:
          'on': workflow
          party: seller
