name: Payment protocol requests, outcomes and reconciliation
type: PaymentInstruction/Payment Instruction with Clauses
instanceKey: protocol-demo
paymentTerms:
  currency: EUR
  amountMinor: 10000
  limitMinor: 12000
  payerChannel: customer
  payeeChannel: seller
  guarantorChannel: guarantor
  allowedPayees:
  - seller
  - seller2
  recipientApprovalRequired: false
clauses:
  activation:
    type: Activation/Activation Clause
    parameters:
      parties:
        customer:
          type: Parties/Party
          displayName: Customer
        seller:
          type: Parties/Party
          displayName: Seller
        seller2:
          type: Parties/Party
          displayName: Seller2
        guarantor:
          type: Parties/Party
          displayName: Guarantor
      required:
      - customer
      - seller
      - seller2
      - guarantor
  requests:
    type: PaymentInstruction/Payment Request Actions
    bindings:
      requestAuthorize:
        requestSecureFunds:
          'on': workflow
          params:
            $pointerSet:
              object:
                $object:
                  $var: trigger
              path: /type
              op: remove
          party: customer
          request:
            type: PaymentInstruction/Payment Request Input
            description: Parameters supplied by the user for this payment request.
            requestId:
              type: Text
              description: Unique identifier selected for this request.
      requestCapture:
        requestCompletePayment:
          'on': workflow
          params:
            $pointerSet:
              object:
                $object:
                  $var: trigger
              path: /type
              op: remove
          party: customer
          request:
            type: PaymentInstruction/Payment Request Input
            description: Parameters supplied by the user for this payment request.
            requestId:
              type: Text
              description: Unique identifier selected for this request.
      requestRefund:
        requestReverseAfterCompletion:
          'on': workflow
          params:
            $pointerSet:
              object:
                $object:
                  $var: trigger
              path: /type
              op: remove
          party: customer
          request:
            type: PaymentInstruction/Payment Request Input
            description: Parameters supplied by the user for this payment request.
            requestId:
              type: Text
              description: Unique identifier selected for this request.
      requestVoid:
        requestCancelBeforeCompletion:
          'on': workflow
          params:
            $pointerSet:
              object:
                $object:
                  $var: trigger
              path: /type
              op: remove
          party: customer
          request:
            type: PaymentInstruction/Payment Request Input
            description: Parameters supplied by the user for this payment request.
            requestId:
              type: Text
              description: Unique identifier selected for this request.
      requestPayeeAssignment:
        requestPayeeAssignment:
          'on': workflow
          params:
            $pointerSet:
              object:
                $object:
                  $var: trigger
              path: /type
              op: remove
          party: customer
          request:
            type: PaymentInstruction/Payment Request Input
            description: Parameters supplied by the user for this payment request.
            requestId:
              type: Text
              description: Unique identifier selected for this request.
            payeeRef:
              description: Required business value explicitly selected by the user.
              type: Text
      requestTransactionDetailsUpdate:
        requestTransactionDetailsUpdate:
          'on': workflow
          params:
            $pointerSet:
              object:
                $object:
                  $var: trigger
              path: /type
              op: remove
          party: customer
          request:
            type: PaymentInstruction/Payment Request Input
            description: Parameters supplied by the user for this payment request.
            requestId:
              type: Text
              description: Unique identifier selected for this request.
            transactionDetails:
              description: Required business value explicitly selected by the user.
      requestFinalAmountResolution:
        requestFinalAmountResolution:
          'on': workflow
          params:
            $pointerSet:
              object:
                $object:
                  $var: trigger
              path: /type
              op: remove
          party: customer
          request:
            type: PaymentInstruction/Payment Request Input
            description: Parameters supplied by the user for this payment request.
            requestId:
              type: Text
              description: Unique identifier selected for this request.
            finalAmount:
              description: Required business value explicitly selected by the user.
              type: Integer
      requestPaymentCompletionLock:
        requestPaymentCompletionLock:
          'on': workflow
          params:
            $pointerSet:
              object:
                $object:
                  $var: trigger
              path: /type
              op: remove
          party: customer
          request:
            type: PaymentInstruction/Payment Request Input
            description: Parameters supplied by the user for this payment request.
            requestId:
              type: Text
              description: Unique identifier selected for this request.
      requestPaymentCompletionUnlock:
        requestPaymentCompletionUnlock:
          'on': workflow
          params:
            $pointerSet:
              object:
                $object:
                  $var: trigger
              path: /type
              op: remove
          party: customer
          request:
            type: PaymentInstruction/Payment Request Input
            description: Parameters supplied by the user for this payment request.
            requestId:
              type: Text
              description: Unique identifier selected for this request.
      requestPaymentReversalLock:
        requestPaymentReversalLock:
          'on': workflow
          params:
            $pointerSet:
              object:
                $object:
                  $var: trigger
              path: /type
              op: remove
          party: customer
          request:
            type: PaymentInstruction/Payment Request Input
            description: Parameters supplied by the user for this payment request.
            requestId:
              type: Text
              description: Unique identifier selected for this request.
      requestPaymentReversalUnlock:
        requestPaymentReversalUnlock:
          'on': workflow
          params:
            $pointerSet:
              object:
                $object:
                  $var: trigger
              path: /type
              op: remove
          party: customer
          request:
            type: PaymentInstruction/Payment Request Input
            description: Parameters supplied by the user for this payment request.
            requestId:
              type: Text
              description: Unique identifier selected for this request.
      requestTransactionDetailsUpdateLock:
        requestTransactionDetailsUpdateLock:
          'on': workflow
          params:
            $pointerSet:
              object:
                $object:
                  $var: trigger
              path: /type
              op: remove
          party: customer
          request:
            type: PaymentInstruction/Payment Request Input
            description: Parameters supplied by the user for this payment request.
            requestId:
              type: Text
              description: Unique identifier selected for this request.
      requestTransactionDetailsUpdateUnlock:
        requestTransactionDetailsUpdateUnlock:
          'on': workflow
          params:
            $pointerSet:
              object:
                $object:
                  $var: trigger
              path: /type
              op: remove
          party: customer
          request:
            type: PaymentInstruction/Payment Request Input
            description: Parameters supplied by the user for this payment request.
            requestId:
              type: Text
              description: Unique identifier selected for this request.
      approveRecipient:
        approveRecipient:
          'on': workflow
          party: seller
          request:
            description: Approve the recipient recorded in this document; no input fields.
