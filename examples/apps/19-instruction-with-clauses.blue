name: Payment Instruction with a customer greeting
type: PaymentInstruction/Payment Instruction with Clauses
paymentTerms:
  amountMinor: 10000
  limitMinor: 10000
  currency: EUR
  payerChannel: customer
  payeeChannel: seller
  guarantorChannel: guarantor
  allowedPayees:
  - seller
  recipientApprovalRequired: false
message: ''
clauses:
  activation:
    type: Activation/Activation Clause
    parameters:
      parties:
        customer:
          type: Parties/Party
          displayName: Customer
        seller:
          type: Parties/Party
          displayName: Seller
        guarantor:
          type: Parties/Party
          displayName: Guarantor
      required:
      - customer
      - seller
      - guarantor
  hello:
    type: Connections/Hello Clause
    bindings:
      text: /message
      say:
        greet:
          'on': workflow
          party: customer
