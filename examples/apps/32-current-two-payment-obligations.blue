name: Prepare independent deposit and balance Payment Instructions
type: Agreements/Agreement with Clauses
clauses:
  activation:
    type: Activation/Activation Clause
    parameters:
      parties:
        customer:
          type: Parties/Party
          displayName: Customer
        seller:
          type: Parties/Party
          displayName: Merchant
        reviewer:
          type: Parties/Party
          displayName: Reviewer
        guarantor:
          type: Parties/Party
          displayName: Payment institution
      required: []
      allowNewParties: true
  deposit:
    type: Payment/Payment Clause
    parameters:
      obtain: create
      suppliedBy: customer
      template:
        name: Deposit instruction
        type: PaymentInstruction/Payment Instruction with Clauses
        clauses:
          activation:
            type: Activation/Activation Clause
            parameters:
              parties:
                customer:
                  type: Parties/Party
                  displayName: Customer
                seller:
                  type: Parties/Party
                  displayName: Merchant
                reviewer:
                  type: Parties/Party
                  displayName: Reviewer
                guarantor:
                  type: Parties/Party
                  displayName: Payment institution
              required: []
              allowNewParties: true
        sources: {}
        paymentTerms:
          currency: EUR
          amountMinor: 50
          limitMinor: 50
          payerChannel: customer
          payeeChannel: seller
          guarantorChannel: guarantor
          allowedPayees:
          - seller
          recipientApprovalRequired: false
    bindings:
      instruction: /deposit
      prepare:
        prepareDeposit:
          'on': workflow
          party: customer
          request:
            description: Prepare this singleton payment from explicitly configured fields and values.
              This binding maps no request fields.
      resume:
        resumeDeposit:
          'on': workflow
          party: customer
          request:
            description: Resume the existing payment preparation. No request fields are required.
      parties:
        customer: customer
        seller: seller
        reviewer: reviewer
        guarantor: guarantor
  balance:
    type: Payment/Payment Clause
    parameters:
      obtain: create
      suppliedBy: customer
      template:
        name: Balance instruction
        type: PaymentInstruction/Payment Instruction with Clauses
        clauses:
          activation:
            type: Activation/Activation Clause
            parameters:
              parties:
                customer:
                  type: Parties/Party
                  displayName: Customer
                seller:
                  type: Parties/Party
                  displayName: Merchant
                reviewer:
                  type: Parties/Party
                  displayName: Reviewer
                guarantor:
                  type: Parties/Party
                  displayName: Payment institution
              required: []
              allowNewParties: true
        sources: {}
        paymentTerms:
          currency: EUR
          amountMinor: 150
          limitMinor: 150
          payerChannel: customer
          payeeChannel: seller
          guarantorChannel: guarantor
          allowedPayees:
          - seller
          recipientApprovalRequired: false
    bindings:
      instruction: /balance
      prepare:
        prepareBalance:
          'on': workflow
          party: customer
          request:
            description: Prepare this singleton payment from explicitly configured fields and values.
              This binding maps no request fields.
      resume:
        resumeBalance:
          'on': workflow
          party: customer
          request:
            description: Resume the existing payment preparation. No request fields are required.
      parties:
        customer: customer
        seller: seller
        reviewer: reviewer
        guarantor: guarantor
