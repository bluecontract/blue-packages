name: Reseller commission from net confirmed order payments
type: Agreements/Agreement with Clauses
clauses:
  activation:
    type: Activation/Activation Clause
    parameters:
      parties:
        customer:
          type: Parties/Party
          displayName: Customer
        seller:
          type: Parties/Party
          displayName: Seller
        guarantor:
          type: Parties/Party
          displayName: Guarantor
        partner:
          type: Parties/Party
          displayName: Partner
      required:
      - customer
      - seller
      - guarantor
      - partner
  orders:
    type: Documents/Documents Clause
    parameters:
      allowedFields: []
      parties: []
    bindings:
      template: /orderTemplate
      collection: /orders
      start:
        newOrder:
          'on': workflow
          party: customer
          params:
            $object:
              $var: trigger
  commission:
    type: Ledger/Ledger Clause
    bindings:
      state: /commission
      setTarget:
        confirmed:
          'on': collection
          path: /orders
          event:
            type: Payment/Payment Event Received
            event:
              type: PaymentInstruction/Payment Completed
          before: []
          params:
            key:
              $sliceAfter:
              - $event: /sourcePath
              - /orders/
            amountMinor:
              $call:
                function: roundBps
                args:
                  basis:
                    $subtract:
                    - $document:
                        $concat:
                        - $event: /sourcePath
                        - /payment/payment/completed
                    - $document:
                        $concat:
                        - $event: /sourcePath
                        - /payment/payment/reversed
                  bps: 1000
        reversed:
          'on': collection
          path: /orders
          event:
            type: Payment/Payment Event Received
            event:
              type: PaymentInstruction/Payment Reversed After Completion
          before: []
          params:
            key:
              $sliceAfter:
              - $event: /sourcePath
              - /orders/
            amountMinor:
              $call:
                function: roundBps
                args:
                  basis:
                    $subtract:
                    - $document:
                        $concat:
                        - $event: /sourcePath
                        - /payment/payment/completed
                    - $document:
                        $concat:
                        - $event: /sourcePath
                        - /payment/payment/reversed
                  bps: 1000
      reserve:
        opened:
          'on': event
          event:
            type: Events/Event
            kind: Commission Payout Opened
          params:
            key: payout-1
            amountMinor:
              $document: /commission/accrued
      settle:
        paid:
          'on': event
          event:
            type: Payment/Payment Event Received
            clause: payout
            event:
              type: PaymentInstruction/Payment Completed
          when:
            $eq:
            - $document: /payout/payment/completed
            - $document: /payout/paymentTerms/amountMinor
          params:
            key: payout-1
  payout:
    type: Payment/Payment Clause
    parameters:
      payer: seller
      payee: partner
      guarantor: guarantor
      currency: EUR
    bindings:
      amount: /commission/accrued
      instruction: /payout
      start:
        startPayout:
          'on': workflow
          party: seller
          after:
          - $appendEvent:
              $merge:
              - type: Events/Event
              - kind: Commission Payout Opened
      requestAuthorize:
        authorizePayout:
          'on': workflow
          party: seller
          params:
            requestId: payout-auth
            amountMinor: 750
      requestCapture:
        capturePayout:
          'on': workflow
          party: seller
          params:
            requestId: payout-capture
            amountMinor: 750
orders: {}
orderTemplate:
  name: Service order
  type: Orders/Order with Clauses
  product:
    name: One English lesson
    quantity: 1
    unitPriceMinor: 10000
    currency: EUR
  clauses:
    activation:
      type: Activation/Activation Clause
      parameters:
        parties: {}
        required: []
    payment:
      type: Payment/Payment Clause
      parameters:
        amountMinor: 10000
        currency: EUR
      bindings:
        instruction: /payment
        start:
          startPayment:
            'on': workflow
            party: customer
        requestAuthorize:
          authorize:
            'on': workflow
            party: customer
            params:
              $object:
                $var: trigger
        requestCapture:
          confirmSatisfaction:
            'on': workflow
            party: customer
            params:
              requestId: capture-1
              amountMinor: 10000
            before:
            - $failIf:
                cond:
                  $ne:
                  - $var:
                      name: trigger
                      path: /satisfied
                  - true
                message: SATISFACTION_REQUIRED
            after:
            - $appendEvent:
                $merge:
                - type: Events/Event
                - kind: Delivery Accepted
        requestRefund:
          refund:
            'on': workflow
            party: seller
            params:
              $object:
                $var: trigger
