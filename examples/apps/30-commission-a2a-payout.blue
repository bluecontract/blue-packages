name: Reseller commission settled by a MyOS account-to-account payout
type: Agreements/Agreement with Clauses
terms:
  commissionBps: 1000
  currency: EUR
  payoutOperator: test
  payoutFeePolicy: myos-commission-fee-v1
clauses:
  activation:
    type: Activation/Activation Clause
    parameters:
      parties:
        seller:
          type: MyOS/MyOS Party
          displayName: Seller
          myosAccountId: test-seller
          lead:
            channel:
              type: Contracts/External Channel
              event:
                source: seller
        partner:
          type: MyOS/MyOS Party
          displayName: Partner
          myosAccountId: test-partner
          lead:
            channel:
              type: Contracts/External Channel
              event:
                source: partner
        guarantor:
          type: MyOS/MyOS Party
          displayName: MyOS payment operator
          myosAccountId: test-guarantor
          lead:
            channel:
              type: Contracts/External Channel
              event:
                source: guarantor
      required:
      - seller
      - partner
  commission:
    type: Reseller/Commission Clause
    bindings:
      state: /commission
      orders: /orders
      payouts: /payouts
      rate: /terms/commissionBps
  payouts:
    type: Reseller/Commission Payouts Clause
    bindings:
      template: /payoutTemplate
      collection: /payouts
      commission: /commission
      parties:
        seller: seller
        partner: partner
        guarantor: guarantor
      preparePayout:
        startPayout:
          'on': workflow
          party: seller
orders: {}
# Fixture: commission already accrued from one confirmed order (covered by the hosted Core order tests).
commission:
  targets:
    o1: 1000
    o2: 1000
  accrued: 2000
  paid: 0
  reserved: 0
  settlements: {}
payouts: {}
payoutTemplate:
  name: Partner commission payout
  type: Agreements/Agreement with Clauses
  amountMinor: 1
  payoutTerms: {}
  clauses:
    activation:
      type: Activation/Activation Clause
      parameters:
        parties:
          seller:
            type: MyOS/MyOS Party
          partner:
            type: MyOS/MyOS Party
          guarantor:
            type: MyOS/MyOS Party
        required: []
    payment:
      type: Reseller/Commission Payout Payment Clause
      parameters:
        payer: seller
        payee: partner
        currency: EUR
      bindings:
        amount: /amountMinor
        instruction: /payment
        start:
          startPayment:
            'on': workflow
            party: seller
        requestAuthorize:
          securePayout:
            'on': workflow
            party: guarantor
            params:
              requestId: payout-secure
              amountMinor:
                $document: /paymentTerms/amountMinor
            request:
              description: Secures the complete frozen partner transfer; no input fields.
        requestCapture:
          capturePayout:
            'on': workflow
            party: guarantor
            params:
              requestId: payout-capture
              amountMinor:
                $document: /paymentTerms/amountMinor
            request:
              description: Transfers the complete frozen partner amount; no input fields.
