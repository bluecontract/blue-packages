name: A validated product quote
type: Orders/Order with Clauses
product: {}
clauses:
  activation:
    type: Activation/Activation Clause
    parameters:
      parties:
        buyer:
          type: Parties/Party
          displayName: Buyer
        seller:
          type: Parties/Party
          displayName: Seller
      required:
      - buyer
      - seller
  product:
    type: Commerce/Product Clause
    parameters:
      currency: EUR
    bindings:
      product: /product
      quote:
        quote:
          'on': workflow
          party: seller
          params:
            $object:
              $var: trigger
