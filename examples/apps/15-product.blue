name: A validated product quote
type: Orders/Order with Clauses
product: {}
clauses:
  activation:
    type: Activation/Activation Clause
    parameters:
      parties:
        buyer:
          type: Parties/Party
          displayName: Buyer
        seller:
          type: Parties/Party
          displayName: Seller
      required:
      - buyer
      - seller
  product:
    type: Commerce/Product Clause
    parameters:
      currency: EUR
    bindings:
      product: /product
      quote:
        quote:
          'on': workflow
          party: seller
          params:
            $object:
              $var: trigger
          request:
            description: Reviewed public input for this configured operation.
            unitPriceMinor:
              type: Integer
              description: User-selected unit price in minor units.
              schema:
                minimum: 0
                maximum: 1000000000
            quantity:
              type: Integer
              description: User-selected item quantity.
              schema:
                minimum: 1
                maximum: 1000
