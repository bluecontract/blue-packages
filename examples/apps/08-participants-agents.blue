name: Party representatives have explicitly assigned actions
type: Agreements/Agreement with Clauses
clauses:
  activation:
    type: Activation/Activation Clause
    parameters:
      parties:
        buyer:
          type: Parties/Party
          displayName: Buyer
          representatives:
            assistant:
              type: Parties/Representative
              displayName: Purchasing assistant
        seller:
          type: Parties/Party
          displayName: Seller
      required:
      - buyer
      - seller
  hello:
    type: Connections/Hello Clause
    bindings:
      text: /message
      say:
        agentGreeting:
          'on': workflow
          party: buyer__assistant
          params:
            text: From the purchasing assistant
        leadGreeting:
          'on': workflow
          party: buyer
          params:
            text: From the buyer
message: ''
