name: Commission corrections and settlement
type: Agreements/Agreement with Clauses
clauses:
  activation:
    type: Activation/Activation Clause
    parameters:
      parties:
        seller:
          type: Parties/Party
          displayName: Seller
        partner:
          type: Parties/Party
          displayName: Partner
      required:
      - seller
      - partner
  ledger:
    type: Ledger/Ledger Clause
    bindings:
      setTarget:
        setTarget:
          'on': workflow
          party: seller
          params:
            $object:
              $var: trigger
          request:
            description: Reviewed public input for this configured operation.
            key:
              type: Text
              description: User-selected ledger obligation or reservation key.
              schema:
                minLength: 1
            amountMinor:
              type: Integer
              description: Exact amount in minor units.
              schema:
                minimum: 0
      reserve:
        reserve:
          'on': workflow
          party: seller
          params:
            $object:
              $var: trigger
          request:
            description: Reviewed public input for this configured operation.
            key:
              type: Text
              description: User-selected ledger obligation or reservation key.
              schema:
                minLength: 1
            amountMinor:
              type: Integer
              description: Exact amount in minor units.
              schema:
                minimum: 1
      settle:
        settle:
          'on': workflow
          party: seller
          params:
            $object:
              $var: trigger
          request:
            description: Reviewed public input for this configured operation.
            key:
              type: Text
              description: User-selected ledger obligation or reservation key.
              schema:
                minLength: 1
