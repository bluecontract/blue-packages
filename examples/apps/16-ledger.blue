name: Commission corrections and settlement
type: Agreements/Agreement with Clauses
clauses:
  activation:
    type: Activation/Activation Clause
    parameters:
      parties:
        seller:
          type: Parties/Party
          displayName: Seller
        partner:
          type: Parties/Party
          displayName: Partner
      required:
      - seller
      - partner
  ledger:
    type: Ledger/Ledger Clause
    bindings:
      setTarget:
        setTarget:
          'on': workflow
          party: seller
          params:
            $object:
              $var: trigger
      reserve:
        reserve:
          'on': workflow
          party: seller
          params:
            $object:
              $var: trigger
      settle:
        settle:
          'on': workflow
          party: seller
          params:
            $object:
              $var: trigger
