name: Two-party approval of a booking amendment
type: Agreements/Agreement with Clauses
termsEditable: true
booking:
  room: A
  priceMinor: 40000
clauses:
  activation:
    type: Activation/Activation Clause
    parameters:
      parties:
        guest:
          type: Parties/Party
          displayName: Guest
        host:
          type: Parties/Party
          displayName: Host
      required:
      - guest
      - host
  amendments:
    type: Amendments/Amendments Clause
    parameters:
      approvers:
      - guest
      - host
      paths:
      - /booking
    bindings:
      propose:
        proposeBooking:
          'on': workflow
          party: guest
          params:
            $object:
              $var: trigger
          request:
            description: Reviewed public input for this configured operation.
            proposalId:
              type: Text
              description: Identifier of the proposal selected by the user.
            type: Amendments/Amendment Input
            expectedRevision:
              type: Integer
              description: Current amendment revision from authorized state.
            path:
              type: Text
              description: Configured path of the terms being amended.
            replacement:
              description: User-selected replacement value for those terms.
      approve:
        guestApprove:
          'on': workflow
          party: guest
          params:
            $object:
              $var: trigger
          request:
            description: Reviewed public input for this configured operation.
            proposalId:
              type: Text
              description: Identifier of the proposal selected by the user.
        hostApprove:
          'on': workflow
          party: host
          params:
            $object:
              $var: trigger
          request:
            description: Reviewed public input for this configured operation.
            proposalId:
              type: Text
              description: Identifier of the proposal selected by the user.
