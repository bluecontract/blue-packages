name: Manual Bank Payment for a lesson
type: Orders/Order with Clauses
product:
  name: One English lesson
  quantity: 1
  unitPriceMinor: 10000
  currency: EUR
satisfied: false
clauses:
  activation:
    type: Activation/Activation Clause
    parameters:
      parties:
        customer:
          type: Parties/Party
          displayName: Customer
        seller:
          type: Parties/Party
          displayName: Seller
      required:
      - customer
      - seller
  payment:
    type: ManualPayments/Manual Bank Payment
    parameters:
      amountMinor: 10000
      currency: EUR
    bindings:
      instruction: /payment
      start:
        startPayment:
          'on': workflow
          party: customer
      requestAuthorize:
        authorize:
          'on': workflow
          party: customer
          params:
            $pointerSet:
              object:
                $object:
                  $var: trigger
              path: /type
              op: remove
          request:
            type: PaymentInstruction/Payment Request Input
            description: Input for this configured financial request. Amount may be supplied by the configured
              action defaults.
            requestId:
              type: Text
              description: Unique identifier for this requested financial action.
      requestCapture:
        confirmSatisfaction:
          'on': workflow
          party: customer
          params:
            requestId: capture-1
            amountMinor: 10000
          before:
          - $failIf:
              cond:
                $ne:
                - $var:
                    name: trigger
                    path: /satisfied
                - true
              message: SATISFACTION_REQUIRED
          after:
          - $appendEvent:
              $merge:
              - type: Events/Event
              - kind: Customer Satisfaction
                satisfied: true
          request:
            description: This configured operation uses its declared request identifier and amount; no
              input fields.
      requestRefund:
        refund:
          'on': workflow
          party: seller
          params:
            $pointerSet:
              object:
                $object:
                  $var: trigger
              path: /type
              op: remove
          request:
            type: PaymentInstruction/Payment Request Input
            description: Input for this configured financial request. Amount may be supplied by the configured
              action defaults.
            requestId:
              type: Text
              description: Unique identifier for this requested financial action.
  satisfaction:
    type: Features/Feature Clause
    parameters:
      actions:
        remember:
          do:
          - $appendChange:
              op: replace
              path: /satisfied
              val: true
    bindings:
      remember:
        satisfied:
          'on': event
          event:
            type: Payment/Payment Event Received
            kind: Customer Satisfaction
