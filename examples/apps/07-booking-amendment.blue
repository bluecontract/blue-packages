name: Booking changes require agreement and preserve the existing payment
type: Agreements/Agreement with Clauses
termsEditable: true
booking:
  room: A
  priceMinor: 40000
clauses:
  activation:
    type: Activation/Activation Clause
    parameters:
      parties:
        guest:
          type: Parties/Party
          displayName: Guest
        host:
          type: Parties/Party
          displayName: Host
        guarantor:
          type: Parties/Party
          displayName: Guarantor
      required:
      - guest
      - host
      - guarantor
  amendments:
    type: Amendments/Amendments Clause
    parameters:
      approvers:
      - guest
      - host
      paths:
      - /booking
    bindings:
      propose:
        proposeBooking:
          'on': workflow
          party: guest
          params:
            $object:
              $var: trigger
          request:
            description: Reviewed public input for this configured operation.
            proposalId:
              type: Text
              description: Identifier of the proposal selected by the user.
            type: Amendments/Amendment Input
            expectedRevision:
              type: Integer
              description: Current amendment revision from authorized state.
            path:
              type: Text
              description: Configured path of the terms being amended.
            replacement:
              description: User-selected replacement value for those terms.
      approve:
        guestApprove:
          'on': workflow
          party: guest
          params:
            $object:
              $var: trigger
          request:
            description: Reviewed public input for this configured operation.
            proposalId:
              type: Text
              description: Identifier of the proposal selected by the user.
        hostApprove:
          'on': workflow
          party: host
          params:
            $object:
              $var: trigger
          request:
            description: Reviewed public input for this configured operation.
            proposalId:
              type: Text
              description: Identifier of the proposal selected by the user.
  payment:
    type: Payment/Legacy Payment Clause
    parameters:
      payer: guest
      payee: host
      guarantor: guarantor
      currency: EUR
    bindings:
      amount: /booking/priceMinor
      instruction: /payment
      start:
        startPayment:
          'on': workflow
          party: guest
