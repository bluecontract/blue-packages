              "path": "/payment",
              "embed": false
            }
          },
          "parties": {
            "observer": "partner",
            "payee": "seller",
            "payer": "customer"
          },
          "prepare": {
            "preparePayment": {
              "on": "workflow",
              "party": "seller",
              "documentParams": {
                "/values/amountMinor": "/amountMinor",
                "/values/limitMinor": "/amountMinor",
                "/values/currency": "/currency",
                "/values/orderOrigin": "/contracts/initialized/document",
                "/values/orderRevision": "/activation/revision",
                "/values/orderTermsRef": "/activation/terms/ref"
              },
              "inputParams": {
