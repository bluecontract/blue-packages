                        "type": {
                          "blueId": "81xyv2z2JxycpEAb9bzdTv3S7kkpny6fvDTvYsDcf3o4"
                        }
                      }
                    },
                    "afterPaymentSelected": {
                      "on": "embedded",
                      "path": "/sources/order",
                      "embed": false,
                      "event": {
                        "type": {
                          "blueId": "3apzpYPbFPod5ipDZwiQA2pok9SfsoV4K6DnCm6xu8go"
                        },
                        "clauseId": "payment",
                        "itemKey": "single"
                      }
                    },
                    "afterOrderRejection": {
                      "on": "embedded",
                      "path": "/sources/order",
                      "embed": false,
                      "event": {
                        "type": {
                          "blueId": "HTAdHVkjPAbr15Mx8L6zcndb7hknyHrdtZoUVnpmAWbq"
