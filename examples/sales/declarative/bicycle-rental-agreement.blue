              }
            }
          },
          "provide": {
            "providePayment": {
              "on": "workflow",
              "party": "seller"
            }
          }
        },
        "parameters": {
          "fieldPaths": {
            "amountMinor": "/paymentTerms/amountMinor",
            "currency": "/paymentTerms/currency",
            "limitMinor": "/paymentTerms/limitMinor",
            "orderOrigin": "/businessContext/orderOrigin",
            "orderRevision": "/businessContext/orderRevision",
            "orderTermsRef": "/businessContext/orderTermsRef",
            "providerReference": "/paymentDetails/providerReference"
          },
          "obtain": "provide",
          "prepareFor": "bootstrap",
          "sourcePaths": {
            "order": ""
          },
          "suppliedBy": "seller",
          "suppliedParties": [
            "guarantor"
          ],
          "template": {
            "businessContext": {
              "orderOrigin": {
                "schema": {
                  "required": true
                }
              },
              "orderRevision": {
                "schema": {
                  "minimum": 1,
                  "required": true
                },
                "type": "Integer"
              },
              "orderTermsRef": {
                "schema": {
                  "required": true
                }
              }
            },
            "clauses": {
              "activation": {
                "parameters": {
                  "parties": {
                    "guarantor": {
                      "myosAccountId": {
                        "type": "Text"
                      },
                      "readerKeys": {
                        "itemType": "Text",
                        "items": [
                          {
                            "type": "Text"
                          }
                        ],
                        "schema": {
                          "maxItems": 1,
                          "minItems": 1,
                          "uniqueItems": true
                        },
                        "type": "List"
                      },
                      "type": {
                        "blueId": "BMz54jViTSnnyfhug3rnuD81or6AekswsVrwyV3ZXLid"
                      }
                    },
                    "observer": {
                      "type": {
                        "blueId": "BMz54jViTSnnyfhug3rnuD81or6AekswsVrwyV3ZXLid"
                      }
                    },
                    "payee": {
                      "type": {
                        "blueId": "BMz54jViTSnnyfhug3rnuD81or6AekswsVrwyV3ZXLid"
                      }
                    },
                    "payer": {
                      "type": {
                        "blueId": "BMz54jViTSnnyfhug3rnuD81or6AekswsVrwyV3ZXLid"
                      }
                    }
                  },
                  "required": []
                },
                "type": {
                  "blueId": "9QGLBqYRo7jsyf2ke13vgzpss1V8t2QrAumMwX8aUpmj"
                }
              },
              "method": {
                "type": {
                  "blueId": "E7LRiTh19QD6CpRT1auSpyCoc98xoqU9WLDP7hTHJdn"
                }
              },
              "payment": {
                "type": {
                  "blueId": "5rzupigxrqAKqdskbG12yJDW1v2mb4qBdDg7f8QgMaJ5"
                },
                "parameters": {
                  "capture": {
                    "type": {
                      "blueId": "EQcAFTiBMhve8nPSEaJeUHjCaY11oMZw6BSCF1RfiA1R"
                    },
                    "requestId": "order-accepted-capture"
                  },
                  "sources": {
                    "order": {}
                  },
                  "selectedPayment": {
                    "source": "/sources/order",
                    "expectedSourceOrigin": "/businessContext/orderOrigin",
                    "entries": "/sources/order/process_payment/entries",
                    "path": "/payment",
                    "key": "single"
                  },
                  "adjustments": {
                    "rejection": {
                      "decision": {
                        "path": "/sources/order/orderDecision",
                        "when": {
                          "field": "status",
                          "equals": "REJECTED"
                        },
                        "retainMinor": 0
                      },
                      "requestIds": {
                        "void": "order-rejected-void"
                      }
                    }
                  }
                },
                "bindings": {
                  "requestAuthorize": {
                    "authorize": {
                      "on": "workflow",
                      "party": "guarantor",
                      "input": true
                    }
                  },
                  "requestRefund": {
                    "refund": {
                      "on": "workflow",
                      "party": "payee",
                      "input": true
                    }
                  },
                  "requestVoid": {
                    "voidPayment": {
                      "on": "workflow",
                      "party": "guarantor",
                      "input": true
                    }
                  },
                  "adjust": {
                    "afterSelection": {
                      "on": "change",
                      "path": "/sources/order/process_payment/entries"
                    },
                    "afterPaymentAttached": {
                      "on": "embedded",
                      "path": "/sources/order",
                      "embed": false,
                      "event": {
                        "type": {
                          "blueId": "9BuYfpVDFybFkggpnobd1Xdju3QmpDvE9nVCgSedMWzx"
                        },
                        "clauseId": "payment"
                      }
                    },
                    "afterLink": {
                      "on": "change",
                      "path": "/sourceLinks"
                    },
                    "afterPaymentOutcome": {
                      "on": "event",
