{
  "name": "Root Activation Completion",
  "type": "Contracts/Compute Definition",
  "functions": {
    "complete": {
      "do": [
        {
          "$let": {
            "name": "s",
            "expr": {
              "$document": {
                "$const": {
                  "name": "bindings",
                  "path": "/state"
                }
              }
            }
          }
        },
        {
          "$if": {
            "cond": {
              "$eq": [
                {
                  "$var": {
                    "name": "s",
                    "path": "/phase"
                  }
                },
                "CONSENTED"
              ]
            },
            "then": [
              {
                "$failIf": {
                  "cond": {
                    "$eq": [
                      {
                        "$document": {
                          "$const": {
                            "name": "bindings",
                            "path": "/terminated"
                          }
                        }
                      },
                      true
                    ]
                  },
                  "message": "AGREEMENT_TERMINATED"
                }
              },
              {
                "$if": {
                  "cond": {
                    "$not": {
                      "$eq": [
                        {
                          "$document": {
                            "$const": {
                              "name": "bindings",
                              "path": "/activated"
                            }
                          }
                        },
                        true
                      ]
                    }
                  },
                  "then": [
                    {
                      "$appendChange": {
                        "op": "add",
                        "path": {
                          "$const": {
                            "name": "bindings",
                            "path": "/acceptedTerms"
                          }
                        },
                        "val": {
                          "$var": {
                            "name": "s",
                            "path": "/settled"
                          }
                        }
                      }
                    },
                    {
                      "$appendChange": {
                        "op": "add",
                        "path": {
                          "$const": {
                            "name": "bindings",
                            "path": "/acceptedRevision"
                          }
                        },
                        "val": {
                          "$var": {
                            "name": "s",
                            "path": "/consent"
                          }
                        }
                      }
                    },
                    {
                      "$appendChange": {
                        "op": "add",
                        "path": {
                          "$const": {
                            "name": "bindings",
                            "path": "/activated"
                          }
                        },
                        "val": true
                      }
                    },
                    {
                      "$appendEvent": {
                        "kind": "Agreement Activated",
                        "configurationId": {
                          "$document": "/clauseRuntime/configId"
                        },
                        "termsId": {
                          "$var": {
                            "name": "s",
                            "path": "/targetId"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "$if": {
            "cond": {
              "$eq": [
                {
                  "$var": {
                    "name": "s",
                    "path": "/phase"
                  }
                },
                "DECLINED"
              ]
            },
            "then": [
              {
                "$appendChange": {
                  "op": "add",
                  "path": {
                    "$const": {
                      "name": "bindings",
                      "path": "/closed"
                    }
                  },
                  "val": true
                }
              }
            ]
          }
        }
      ]
    }
  }
}
