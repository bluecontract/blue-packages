{
  "name": "Mutual Activation Clause",
  "type": {
    "blueId": "kfNJNHtFJd5pRCy9se5QTvvH2ZLBn7W3PAHuqsS5uPg"
  },
  "declaredContracts": [
    "partyA",
    "partyB",
    "lifecycle",
    "initialize",
    "actA",
    "actB",
    "logic"
  ],
  "description": "Bilateral pre-activation negotiation. All behavior is ordinary Contracts/BEX; readiness is non-binding.",
  "contracts": {
    "partyA": {
      "type": "Coordination/Timeline Channel"
    },
    "partyB": {
      "type": "Coordination/Timeline Channel"
    },
    "lifecycle": {
      "type": "Contracts/Lifecycle Event Channel",
      "event": {
        "type": "Contracts/Document Processing Initiated"
      }
    },
    "initialize": {
      "type": "Contracts/Sequential Workflow",
      "channel": "lifecycle",
      "steps": [
        {
          "type": "Contracts/Compute",
          "definition": "logic",
          "entry": "initialize"
        }
      ]
    },
    "actA": {
      "type": "Contracts/Sequential Workflow Operation",
      "channel": "partyA",
      "steps": [
        {
          "type": "Contracts/Compute",
          "definition": "logic",
          "do": [
            {
              "$call": {
                "function": "act",
                "args": {
                  "side": "A"
                }
              }
            }
          ]
        }
      ]
    },
    "actB": {
      "type": "Contracts/Sequential Workflow Operation",
      "channel": "partyB",
      "steps": [
        {
          "type": "Contracts/Compute",
          "definition": "logic",
          "do": [
            {
              "$call": {
                "function": "act",
                "args": {
                  "side": "B"
                }
              }
            }
          ]
        }
      ]
    },
    "logic": {
      "type": "Contracts/Compute Definition",
      "constants": {
        "messageTypes": {
          "proposal": {
            "type": "MutualActivation/Change Proposal"
          },
          "decision": {
            "type": "MutualActivation/Change Decision",
            "inResponseTo": {
              "type": "MutualActivation/Change Proposal"
            }
          },
          "progress": {
            "type": "Agreements/Clause Progress"
          },
          "transition": {
            "type": "MutualActivation/Activation Decision Recorded"
          },
          "succeeded": {
            "type": "MutualActivation/Activation Succeeded"
          },
          "declined": {
            "type": "MutualActivation/Activation Declined"
          }
        }
      },
      "functions": {
        "revision": {
          "args": {
            "terms": {}
          },
          "expr": {
            "$nodeBlueId": {
              "agreementId": {
                "$document": "/agreementId"
              },
              "agreementType": {
                "$document": "/agreementType"
              },
              "activationType": {
                "$nodeBlueId": {
                  "$document": "/type"
                }
              },
              "partyA": {
                "$document": "/partyA"
              },
              "partyB": {
                "$document": "/partyB"
              },
              "channelA": {
                "$document": "/contracts/partyA"
              },
              "channelB": {
                "$document": "/contracts/partyB"
              },
              "terms": {
                "$var": "terms"
              }
            }
          }
        },
        "initialize": {
          "do": [
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$isEmpty": {
                      "$filter": {
                        "in": {
                          "$keys": {
                            "$document": "/contracts"
                          }
                        },
                        "item": "key",
                        "where": {
                          "$not": {
                            "$includes": {
                              "list": {
                                "$listConcat": [
                                  {
                                    "$document": "/type/declaredContracts"
                                  },
                                  [
                                    "initialized",
                                    "checkpoint",
                                    "terminated"
                                  ]
                                ]
                              },
                              "val": {
                                "$var": "key"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "message": "UNAPPROVED_CONTRACT_DECLARATION"
              }
            },
            {
              "$forEach": {
                "in": {
                  "$document": "/type/declaredContracts"
                },
                "item": "guardContract",
                "do": [
                  {
                    "$if": {
                      "cond": {
                        "$not": {
                          "$includes": {
                            "list": [
                              "partyA",
                              "partyB"
                            ],
                            "val": {
                              "$var": "guardContract"
                            }
                          }
                        }
                      },
                      "then": [
                        {
                          "$failIf": {
                            "cond": {
                              "$not": {
                                "$eq": [
                                  {
                                    "$nodeBlueId": {
                                      "$document": {
                                        "$concat": [
                                          "/contracts/",
                                          {
                                            "$var": "guardContract"
                                          }
                                        ]
                                      }
                                    }
                                  },
                                  {
                                    "$nodeBlueId": {
                                      "$document": {
                                        "$concat": [
                                          "/type/contracts/",
                                          {
                                            "$var": "guardContract"
                                          }
                                        ]
                                      }
                                    }
                                  }
                                ]
                              }
                            },
                            "message": "EXECUTABLE_OVERRIDE_NOT_ALLOWED"
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$isKind": {
                      "val": {
                        "$document": "/agreementId"
                      },
                      "kind": "text"
                    }
                  }
                },
                "message": "AGREEMENT_ID_REQUIRED"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$ne": [
                      {
                        "$document": "/agreementId"
                      },
                      ""
                    ]
                  }
                },
                "message": "AGREEMENT_ID_REQUIRED"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$ne": [
                      {
                        "$nodeBlueId": {
                          "$document": "/partyA"
                        }
                      },
                      {
                        "$nodeBlueId": {
                          "$document": "/partyB"
                        }
                      }
                    ]
                  }
                },
                "message": "TWO_DISTINCT_PARTIES_REQUIRED"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$nodeBlueId": {
                          "$document": "/contracts/partyA/actor"
                        }
                      },
                      {
                        "$nodeBlueId": {
                          "$document": "/partyA"
                        }
                      }
                    ]
                  }
                },
                "message": "PARTY_A_CHANNEL_MISMATCH"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$nodeBlueId": {
                          "$document": "/contracts/partyB/actor"
                        }
                      },
                      {
                        "$nodeBlueId": {
                          "$document": "/partyB"
                        }
                      }
                    ]
                  }
                },
                "message": "PARTY_B_CHANNEL_MISMATCH"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$isKind": {
                      "val": {
                        "$document": "/initialTerms"
                      },
                      "kind": "object"
                    }
                  }
                },
                "message": "TERMS_MUST_BE_OBJECT"
              }
            },
            {
              "$appendChange": {
                "op": "add",
                "path": "/state",
                "val": {
                  "phase": "NEGOTIATING",
                  "round": 1,
                  "settled": {
                    "$document": "/initialTerms"
                  },
                  "target": {
                    "$document": "/initialTerms"
                  },
                  "targetId": {
                    "$call": {
                      "function": "revision",
                      "args": {
                        "terms": {
                          "$document": "/initialTerms"
                        }
                      }
                    }
                  },
                  "pending": false,
                  "proposal": {},
                  "proposer": "",
                  "signals": {
                    "A": "NONE",
                    "B": "NONE"
                  },
                  "records": {
                    "A": {},
                    "B": {}
                  },
                  "seen": {},
                  "consent": {},
                  "message": ""
                }
              }
            },
            {
              "$appendEvent": {
                "$objectSet": {
                  "object": {
                    "agreementId": {
                      "$document": "/agreementId"
                    },
                    "reason": "INITIALIZED"
                  },
                  "key": "type",
                  "val": {
                    "$const": {
                      "name": "messageTypes",
                      "path": "/progress/type"
                    }
                  }
                }
              }
            }
          ]
        },
        "act": {
          "args": {
            "side": {
              "type": "Text"
            }
          },
          "do": [
            {
              "$let": {
                "name": "req",
                "expr": {
                  "$binding": "call/request"
                }
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$isKind": {
                      "val": {
                        "$var": "req"
                      },
                      "kind": "object"
                    }
                  }
                },
                "message": "REQUEST_REQUIRED"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$isKind": {
                      "val": {
                        "$var": {
                          "name": "req",
                          "path": "/requestId"
                        }
                      },
                      "kind": "text"
                    }
                  }
                },
                "message": "REQUEST_ID_REQUIRED"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$ne": [
                      {
                        "$var": {
                          "name": "req",
                          "path": "/requestId"
                        }
                      },
                      ""
                    ]
                  }
                },
                "message": "REQUEST_ID_REQUIRED"
              }
            },
            {
              "$let": {
                "name": "s",
                "expr": {
                  "$document": "/state"
                }
              }
            },
            {
              "$let": {
                "name": "reqHash",
                "expr": {
                  "$nodeBlueId": {
                    "$var": "req"
                  }
                }
              }
            },
            {
              "$let": {
                "name": "seenKey",
                "expr": {
                  "$concat": [
                    {
                      "$var": "side"
                    },
                    ":",
                    {
                      "$var": {
                        "name": "req",
                        "path": "/requestId"
                      }
                    }
                  ]
                }
              }
            },
            {
              "$if": {
                "cond": {
                  "$hasKey": {
                    "object": {
                      "$var": {
                        "name": "s",
                        "path": "/seen"
                      }
                    },
                    "key": {
                      "$var": "seenKey"
                    }
                  }
                },
                "then": [
                  {
                    "$failIf": {
                      "cond": {
                        "$not": {
                          "$eq": [
                            {
                              "$get": {
                                "object": {
                                  "$var": {
                                    "name": "s",
                                    "path": "/seen"
                                  }
                                },
                                "key": {
                                  "$var": "seenKey"
                                }
                              }
                            },
                            {
                              "$var": "reqHash"
                            }
                          ]
                        }
                      },
                      "message": "REQUEST_ID_REUSE"
                    }
                  },
                  {
                    "$return": true
                  }
                ]
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$var": {
                          "name": "s",
                          "path": "/phase"
                        }
                      },
                      "NEGOTIATING"
                    ]
                  }
                },
                "message": "NEGOTIATION_CLOSED"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$var": {
                          "name": "req",
                          "path": "/round"
                        }
                      },
                      {
                        "$var": {
                          "name": "s",
                          "path": "/round"
                        }
                      }
                    ]
                  }
                },
                "message": "STALE_ROUND"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$eq": [
                      {
                        "$var": {
                          "name": "req",
                          "path": "/termsId"
                        }
                      },
                      {
                        "$var": {
                          "name": "s",
                          "path": "/targetId"
                        }
                      }
                    ]
                  }
                },
                "message": "STALE_TERMS"
              }
            },
            {
              "$let": {
                "name": "action",
                "expr": {
                  "$var": {
                    "name": "req",
                    "path": "/action"
                  }
                }
              }
            },
            {
              "$let": {
                "name": "other",
                "expr": {
                  "$choose": {
                    "cond": {
                      "$eq": [
                        {
                          "$var": "side"
                        },
                        "A"
                      ]
                    },
                    "then": "B",
                    "else": "A"
                  }
                }
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$includes": {
                      "list": [
                        "proposeChange",
                        "acceptChange",
                        "rejectChange",
                        "withdrawChange",
                        "ready",
                        "approve",
                        "withdrawApproval",
                        "rejectApproval",
                        "decline"
                      ],
                      "val": {
                        "$var": "action"
                      }
                    }
                  }
                },
                "message": "UNKNOWN_ACTION"
              }
            },
            {
              "$let": {
                "name": "intent",
                "expr": {
                  "$default": [
                    {
                      "$var": {
                        "name": "req",
                        "path": "/intention"
                      }
                    },
                    "NONE"
                  ]
                }
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$includes": {
                      "list": [
                        "NONE",
                        "READY",
                        "APPROVED"
                      ],
                      "val": {
                        "$var": "intent"
                      }
                    }
                  }
                },
                "message": "INVALID_INTENTION"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$or": [
                      {
                        "$includes": {
                          "list": [
                            "proposeChange",
                            "acceptChange"
                          ],
                          "val": {
                            "$var": "action"
                          }
                        }
                      },
                      {
                        "$eq": [
                          {
                            "$var": "intent"
                          },
                          "NONE"
                        ]
                      }
                    ]
                  }
                },
                "message": "INTENTION_ONLY_ON_EDIT_COMMANDS"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$isEmpty": {
                      "$filter": {
                        "in": {
                          "$keys": {
                            "$var": "req"
                          }
                        },
                        "item": "key",
                        "where": {
                          "$not": {
                            "$includes": {
                              "list": [
                                "type",
                                "action",
                                "requestId",
                                "round",
                                "termsId",
                                "message",
                                "intention",
                                "changes",
                                "proposalId"
                              ],
                              "val": {
                                "$var": "key"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "message": "UNKNOWN_REQUEST_FIELD"
              }
            },
            {
              "$failIf": {
                "cond": {
                  "$not": {
                    "$or": [
                      {
                        "$not": {
                          "$hasKey": {
                            "object": {
                              "$var": "req"
                            },
                            "key": "message"
                          }
                        }
                      },
                      {
                        "$isKind": {
                          "val": {
                            "$var": {
                              "name": "req",
                              "path": "/message"
                            }
                          },
                          "kind": "text"
                        }
                      }
                    ]
                  }
                },
                "message": "MESSAGE_MUST_BE_TEXT"
              }
            },
            {
              "$if": {
                "cond": {
                  "$eq": [
                    {
                      "$var": "action"
                    },
                    "proposeChange"
                  ]
                },
                "then": [
                  {
                    "$failIf": {
                      "cond": {
                        "$not": {
                          "$isKind": {
                            "val": {
                              "$var": {
                                "name": "req",
                                "path": "/message"
                              }
                            },
                            "kind": "text"
                          }
                        }
                      },
                      "message": "EXPLANATION_REQUIRED"
                    }
                  },
                  {
                    "$failIf": {
                      "cond": {
                        "$not": {
                          "$ne": [
                            {
                              "$var": {
                                "name": "req",
                                "path": "/message"
                              }
                            },
                            ""
                          ]
                        }
                      },
                      "message": "EXPLANATION_REQUIRED"
                    }
                  },
                  {
                    "$failIf": {
                      "cond": {
                        "$not": {
                          "$isKind": {
                            "val": {
                              "$var": {
                                "name": "req",
                                "path": "/changes"
                              }
                            },
                            "kind": "list"
                          }
                        }
                      },
                      "message": "CHANGES_REQUIRED"
                    }
                  },
                  {
                    "$failIf": {
                      "cond": {
                        "$not": {
                          "$gt": [
                            {
                              "$size": {
                                "$var": {
                                  "name": "req",
                                  "path": "/changes"
                                }
                              }
                            },
                            0
                          ]
                        }
                      },
                      "message": "CHANGES_REQUIRED"
                    }
                  },
                  {
                    "$let": {
                      "name": "candidate",
                      "expr": {
                        "$var": {
                          "name": "s",
                          "path": "/settled"
                        }
                      }
                    }
                  },
                  {
                    "$forEach": {
                      "in": {
                        "$var": {
                          "name": "req",
                          "path": "/changes"
                        }
                      },
                      "item": "change",
                      "do": [
                        {
                          "$failIf": {
                            "cond": {
                              "$not": {
                                "$isKind": {
                                  "val": {
                                    "$var": "change"
                                  },
                                  "kind": "object"
                                }
                              }
                            },
                            "message": "INVALID_PATCH"
                          }
                        },
                        {
                          "$failIf": {
                            "cond": {
                              "$not": {
                                "$includes": {
                                  "list": [
                                    "set",
                                    "remove"
                                  ],
                                  "val": {
                                    "$var": {
                                      "name": "change",
                                      "path": "/op"
                                    }
                                  }
                                }
                              }
                            },
                            "message": "INVALID_PATCH_OP"
                          }
                        },
                        {
                          "$failIf": {
                            "cond": {
                              "$not": {
                                "$isKind": {
                                  "val": {
                                    "$var": {
                                      "name": "change",
                                      "path": "/path"
                                    }
                                  },
                                  "kind": "text"
                                }
                              }
                            },
                            "message": "INVALID_PATCH_PATH"
                          }
                        },
                        {
                          "$failIf": {
                            "cond": {
                              "$not": {
                                "$or": [
                                  {
                                    "$eq": [
                                      {
                                        "$var": {
                                          "name": "change",
                                          "path": "/path"
                                        }
                                      },
                                      ""
                                    ]
                                  },
                                  {
                                    "$startsWith": [
                                      {
                                        "$var": {
                                          "name": "change",
                                          "path": "/path"
                                        }
                                      },
                                      "/"
                                    ]
                                  }
                                ]
                              }
                            },
                            "message": "INVALID_PATCH_PATH"
                          }
                        },
                        {
                          "$failIf": {
                            "cond": {
                              "$not": {
                                "$isEmpty": {
                                  "$filter": {
                                    "in": {
                                      "$keys": {
                                        "$var": "change"
                                      }
                                    },
                                    "item": "key",
                                    "where": {
                                      "$not": {
                                        "$includes": {
                                          "list": [
                                            "op",
                                            "path",
                                            "val"
                                          ],
                                          "val": {
                                            "$var": "key"
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            },
                            "message": "UNKNOWN_PATCH_FIELD"
                          }
                        },
                        {
                          "$failIf": {
                            "cond": {
                              "$not": {
                                "$eq": [
                                  {
                                    "$hasKey": {
                                      "object": {
                                        "$var": "change"
                                      },
                                      "key": "val"
                                    }
                                  },
                                  {
                                    "$ne": [
                                      {
                                        "$var": {
                                          "name": "change",
                                          "path": "/op"
                                        }
                                      },
                                      "remove"
                                    ]
                                  }
                                ]
                              }
                            },
                            "message": "PATCH_VALUE_MISMATCH"
                          }
                        },
                        {
                          "$failIf": {
                            "cond": {
                              "$not": {
                                "$eq": [
                                  {
                                    "$size": {
                                      "$split": {
                                        "text": {
                                          "$var": {
                                            "name": "change",
                                            "path": "/path"
                                          }
                                        },
                                        "separator": "~"
                                      }
                                    }
                                  },
                                  1
                                ]
                              }
                            },
                            "message": "ESCAPED_PATH_USE_ROOT_REPLACEMENT"
                          }
                        },
                        {
                          "$if": {
                            "cond": {
                              "$and": [
                                {
                                  "$ne": [
                                    {
                                      "$var": {
                                        "name": "change",
                                        "path": "/path"
                                      }
                                    },
                                    ""
                                  ]
                                },
                                {
                                  "$ne": [
                                    {
                                      "$var": {
                                        "name": "change",
                                        "path": "/path"
                                      }
                                    },
                                    "/"
                                  ]
                                }
                              ]
                            },
                            "then": [
                              {
                                "$let": {
                                  "name": "parts",
                                  "expr": {
                                    "$split": {
                                      "text": {
                                        "$var": {
                                          "name": "change",
                                          "path": "/path"
                                        }
                                      },
                                      "separator": "/"
                                    }
                                  }
                                }
                              },
                              {
                                "$let": {
                                  "name": "at",
                                  "expr": {
                                    "$var": "candidate"
                                  }
                                }
                              },
                              {
                                "$forEach": {
                                  "in": {
                                    "$var": "parts"
                                  },
                                  "item": "part",
                                  "index": "index",
                                  "do": [
