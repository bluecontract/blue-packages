                "then": [
                  {
                    "$set": {
                      "name": "s",
                      "expr": {
                        "$objectSet": {
                          "object": {
                            "$var": "s"
                          },
                          "key": "phase",
                          "val": "CONSENTED"
                        }
                      }
                    }
                  },
                  {
                    "$set": {
                      "name": "s",
                      "expr": {
                        "$objectSet": {
                          "object": {
                            "$var": "s"
                          },
                          "key": "consent",
                          "val": {
                            "termsId": {
                              "$var": {
                                "name": "s",
                                "path": "/targetId"
                              }
                            },
                            "round": {
                              "$var": {
                                "name": "s",
                                "path": "/round"
                              }
                            },
                            "approvals": {
                              "$var": {
                                "name": "s",
                                "path": "/records"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              }
            },
            {
              "$set": {
                "name": "s",
                "expr": {
                  "$objectSet": {
                    "object": {
                      "$var": "s"
                    },
                    "key": "seen",
                    "val": {
                      "$objectSet": {
                        "object": {
                          "$var": {
                            "name": "s",
                            "path": "/seen"
                          }
                        },
                        "key": {
                          "$var": "seenKey"
                        },
                        "val": {
                          "$var": "reqHash"
                        }
                      }
                    }
                  }
                }
              }
            },
            {
              "$appendChange": {
                "op": "replace",
                "path": "/state",
                "val": {
                  "$var": "s"
                }
              }
            },
            {
              "$appendEvent": {
                "$objectSet": {
                  "object": {
                    "agreementId": {
                      "$document": "/agreementId"
                    },
                    "reason": {
                      "$var": "action"
                    },
                    "requestId": {
                      "$var": {
                        "name": "req",
                        "path": "/requestId"
                      }
                    }
                  },
                  "key": "type",
                  "val": {
                    "$const": {
                      "name": "messageTypes",
                      "path": "/progress/type"
                    }
                  }
                }
              }
            },
            {
              "$appendEvent": {
                "$objectSet": {
                  "object": {
                    "agreementId": {
                      "$document": "/agreementId"
                    },
                    "action": {
                      "$var": "action"
                    },
                    "party": {
                      "$var": "side"
                    },
                    "round": {
                      "$var": {
                        "name": "s",
                        "path": "/round"
                      }
                    },
                    "termsId": {
                      "$var": {
                        "name": "s",
                        "path": "/targetId"
                      }
                    },
                    "requestId": {
                      "$var": {
                        "name": "req",
                        "path": "/requestId"
                      }
                    }
                  },
                  "key": "type",
                  "val": {
                    "$const": {
                      "name": "messageTypes",
                      "path": "/transition/type"
                    }
                  }
                }
              }
            },
            {
              "$if": {
                "cond": {
                  "$eq": [
                    {
                      "$var": {
                        "name": "s",
                        "path": "/phase"
                      }
                    },
                    "CONSENTED"
                  ]
                },
                "then": [
                  {
                    "$appendEvent": {
                      "$objectSet": {
                        "object": {
                          "agreementId": {
                            "$document": "/agreementId"
                          },
                          "round": {
                            "$var": {
                              "name": "s",
                              "path": "/round"
                            }
                          },
                          "termsId": {
                            "$var": {
                              "name": "s",
                              "path": "/targetId"
                            }
                          },
                          "requestId": {
                            "$var": {
                              "name": "req",
                              "path": "/requestId"
                            }
                          }
                        },
                        "key": "type",
                        "val": {
                          "$const": {
                            "name": "messageTypes",
                            "path": "/succeeded/type"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            },
            {
              "$if": {
                "cond": {
                  "$eq": [
                    {
                      "$var": {
                        "name": "s",
                        "path": "/phase"
                      }
                    },
                    "DECLINED"
                  ]
                },
                "then": [
                  {
                    "$appendEvent": {
                      "$objectSet": {
                        "object": {
                          "agreementId": {
                            "$document": "/agreementId"
                          },
                          "message": {
                            "$var": {
                              "name": "s",
                              "path": "/message"
                            }
                          },
                          "requestId": {
                            "$var": {
                              "name": "req",
                              "path": "/requestId"
                            }
                          }
                        },
                        "key": "type",
                        "val": {
                          "$const": {
                            "name": "messageTypes",
                            "path": "/declined/type"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    }
  }
}
