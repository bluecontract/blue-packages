specification:
  blueId: Bay6myCAwwEqz5VDJWAyqESE3bgZky1WgQqxiosrYyxR
name: Evidence Responded
type: coordination/Response
inResponseTo:
  type: Mandates/Evidence Requested
  schema:
    required: true
executionId:
  type: Text
  schema:
    required: true
    minLength: 1
executionStatus:
  type: Text
  schema:
    required: true
    enum:
    - Succeeded
    - Failed
    - Refused
    - Unknown
result:
  type: Dictionary
  schema:
    required: true
