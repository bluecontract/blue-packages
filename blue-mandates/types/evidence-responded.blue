specification:
  blueId: 5aLyxVDGR4ToKSMDoaXKFBWUPBcp3yCF8rdXfAoTT4nQ
name: Evidence Responded
type: coordination/Response
inResponseTo:
  type: Mandates/Evidence Requested
  schema:
    required: true
executionId:
  type: Text
  schema:
    required: true
    minLength: 1
executionStatus:
  type: Text
  schema:
    required: true
    enum:
    - Succeeded
    - Failed
    - Refused
    - Unknown
result:
  type: Dictionary
  schema:
    required: true
