#!/bin/sh
set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
case "${1:-verify}" in
  verify) exec "${BLUE_PYTHON:-python3}" "$HERE/../tools/release.py" check ;;
  inspect) cat "$HERE/dist/package.json" ;;
  build) exec "$HERE/../tools/build-payment-family.sh" Mandates ;;
  *) echo 'Use verify, inspect or build. Native qualification runs in Core Java.' >&2; exit 2 ;;
esac
