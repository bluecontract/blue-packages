#!/bin/sh
set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PY=${BLUE_PYTHON:-python3.13}
COMMAND=${1:-verify}
if [ "$#" -gt 0 ]; then shift; fi
case "$COMMAND" in
  verify|inspect) exec "$PY" "$HERE/../tools/inspect_package.py" --root "$HERE" "$COMMAND" "$@" ;;
  check-source) exec "$PY" "$HERE/../tools/build_mandates.py" check --root "$HERE" "$@" ;;
  build|candidate) exec "$PY" "$HERE/../tools/build_mandates.py" "$COMMAND" --root "$HERE" "$@" ;;
  *) echo 'Commands: verify, inspect, check-source, build, candidate' >&2; exit 2 ;;
esac
