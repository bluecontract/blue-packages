{
  "contracts": {
    "afterApproved": {
      "channel": "approvedEvents",
      "event": {},
      "steps": [
        {
          "do": [
            {
              "$if": {
                "cond": {
                  "$and": [
                    {
                      "$eq": [
                        {
                          "$document": "/status"
                        },
                        "Active"
                      ]
                    },
                    {
                      "$eq": [
                        {
                          "$document": "/stage"
                        },
                        "EvidencePassed"
                      ]
                    },
                    {
                      "$eq": [
                        {
                          "$document": "/target/phase"
                        },
                        "Approved"
                      ]
                    }
                  ]
                },
                "else": [
                  {
                    "$appendEvent": {
                      "$literal": {
                        "reason": "Order advanced outside this delegation stage.",
                        "type": {
                          "blueId": "C3xPiFWLeDGAK3uaBYT312rBK5UjSwqsdfveSNuFUsas"
                        }
                      }
                    }
                  }
                ],
                "then": [
                  {
                    "$appendChange": {
                      "op": "replace",
                      "path": "/scope",
                      "val": {
                        "release": {
                          "$document": "/grantTemplates/release"
                        }
                      }
                    }
                  },
                  {
                    "$appendChange": {
                      "op": "replace",
                      "path": "/stage",
                      "val": "ReleaseEnabled"
                    }
                  }
                ]
              }
            }
          ],
          "type": {
            "blueId": "92eWpSLhfvP2TDsSzZiVVh5ue4hdZTZHDm1Foft3SeLp"
          }
        }
      ],
      "type": {
        "blueId": "9GoyPopJiVkEygcM7Qm3GR92mrq3cvXvxsxcWYRJYkhY"
      }
    },
    "afterReleased": {
      "channel": "releasedEvents",
      "event": {},
      "steps": [
        {
          "do": [
            {
              "$appendChange": {
                "op": "replace",
                "path": "/stage",
                "val": "Finished"
              }
            },
            {
              "$appendEvent": {
                "$literal": {
                  "reason": "Order released; delegation complete.",
                  "type": {
                    "blueId": "C3xPiFWLeDGAK3uaBYT312rBK5UjSwqsdfveSNuFUsas"
                  }
                }
              }
            }
          ],
          "type": {
            "blueId": "92eWpSLhfvP2TDsSzZiVVh5ue4hdZTZHDm1Foft3SeLp"
          }
        }
      ],
      "type": {
        "blueId": "9GoyPopJiVkEygcM7Qm3GR92mrq3cvXvxsxcWYRJYkhY"
      }
    },
    "approvedEvents": {
