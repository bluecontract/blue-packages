name: Alice delegates one order operation to Bob
type: Mandates/Operation Mandate
# Bind concrete authenticated current Coordination channels before initialization.
contracts:
  authorityHolderChannel:
    type: Coordination/Timeline Channel
  authorizedActorChannel:
    type: Coordination/Timeline Channel
scope:
  acceptOrder:
    type: Mandates/Operation Grant
    target:
      channel: customer
      operation: acceptDelivery
      # Bind the target's initial document reference here for one-order scope.
      initialDocument: {}
