    "Mandates/Operation Mandate": {
      "contracts": {
        "clearOperationScope": {
          "channel": "terminationRequests",
          "event": {
            "type": "Mandates/Mandate Termination Requested"
          },
          "order": -10,
          "steps": [
            {
              "do": [
                {
                  "$appendChange": {
                    "op": "replace",
                    "path": "/scope",
                    "val": {
                      "$emptyObject": true
                    }
                  }
                },
                {
                  "$appendEvent": {
                    "$objectSet": {
                      "key": "scopeId",
                      "object": {
                        "$objectSet": {
                          "key": "timestampUs",
                          "object": {
                            "$literal": {
                              "scopeId": "uninitialized",
                              "timestampUs": 0,
                              "type": "Mandates/Scope Changed"
                            }
                          },
                          "val": {
                            "$binding": "timestamp"
                          }
                        }
                      },
                      "val": {
                        "$nodeBlueId": {
                          "$resultValue": "/scope"
                        }
                      }
                    }
                  }
                }
              ],
              "type": "Contracts/Compute"
            }
          ],
          "type": "Contracts/Sequential Workflow"
        },
        "initializeOperationScope": {
          "channel": "lifecycle",
          "event": {
            "type": "Contracts/Document Processing Initiated"
          },
          "order": 10,
          "steps": [
            {
              "do": [
                {
                  "$appendChange": {
                    "op": "add",
                    "path": "/scope",
                    "val": {
                      "$coalesce": [
                        {
                          "$document": "/scope"
                        },
                        {
                          "$emptyObject": true
                        }
                      ]
                    }
                  }
                }
              ],
              "type": "Contracts/Compute"
            }
          ],
          "type": "Contracts/Sequential Workflow"
        },
        "notifyScopeChanged": {
          "channel": "scopeUpdates",
          "event": {
            "type": "Contracts/Document Update"
          },
          "steps": [
            {
              "do": [
                {
                  "$if": {
                    "cond": {
                      "$eq": [
                        {
                          "$document": "/status"
                        },
                        "Active"
                      ]
                    },
                    "then": [
                      {
                        "$appendEvent": {
                          "$objectSet": {
                            "key": "scopeId",
                            "object": {
                              "$objectSet": {
                                "key": "timestampUs",
                                "object": {
                                  "$literal": {
                                    "scopeId": "uninitialized",
                                    "timestampUs": 0,
                                    "type": "Mandates/Scope Changed"
                                  }
                                },
                                "val": {
                                  "$binding": "timestamp"
                                }
                              }
                            },
                            "val": {
                              "$nodeBlueId": {
                                "$resultValue": "/scope"
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              ],
              "type": "Contracts/Compute"
            }
          ],
          "type": "Contracts/Sequential Workflow"
        },
        "scopeUpdates": {
          "path": "/scope",
          "type": "Contracts/Document Update Channel"
        }
      },
      "description": "One holder and one delegate, any number of complete operation grants and targets.",
      "grantTemplates": {
        "type": "Mandates/Scope"
      },
      "name": "Operation Mandate",
      "scope": {
        "type": "Mandates/Scope"
      },
      "type": "Mandates/Mandate",
      "specification": {
        "blueId": "7nTzS5jVoHeZC9xq9PWrvWAL3oxBcHGfPQjaf8A6FhhA"
      }
