name: Balance Functions
type: Money/Rounding
functions:
  $blue:membersFrom:
    definition: {type: Ledger/Target and Settlement Functions}
    field: functions
  usableCollectionEntry:
    $blue:functionFrom: {definition: {type: Documents/Source Functions}, function: usableCollectionEntry}
  accruePercent:
    args: {}
    do:
    - $let:
        vars:
          key: {$event: /key}
          receipts: {$const: {name: bindings, path: /receipts}}
    - $if:
        cond:
          $or:
          - {$not: {$exists: {$var: receipts}}}
          - {$ne: [{$event: /receiptState}, {$var: receipts}]}
          - {$not: {$isKind: {val: {$var: key}, kind: text}}}
          - {$eq: [{$var: key}, '']}
        then:
        - $return: {outcome: skipped}
    - $let:
        vars:
          linked:
            $call:
              function: usableCollectionEntry
              args:
                collection: {$const: {name: bindings, path: /orders}}
                entries: {$const: {name: bindings, path: /orderEntries}}
                key: {$var: key}
          net:
            $document: {$concat: [{$var: receipts}, {$pointerJoin: [targets, {$var: key}, netReceivedMinor]}]}
    - $let:
        name: bps
        expr:
          $pointerGet:
            object: {$var: {name: linked, path: /entry}}
            path: {$const: {name: bindings, path: /frozenRate}}
    - $if:
        cond: {$or: [{$not: {$exists: {$var: net}}}, {$not: {$exists: {$var: bps}}}]}
        then:
        - $return: {outcome: skipped}
    - $let:
        name: encoded
        expr: {$var: key}
    - $forEach:
        item: escape
        in: [{char: '%', code: '%25'}, {char: /, code: '%2F'}, {char: '~', code: '%7E'}]
        do:
        - $set:
            name: encoded
            expr:
              $join:
                list: {$split: {text: {$var: encoded}, separator: {$var: {name: escape, path: /char}}}}
                separator: {$var: {name: escape, path: /code}}
    - $return:
        $call:
          function: setTarget
          args:
            input:
              key: {$var: encoded}
              amountMinor: {$call: {function: roundBps, args: {basis: {$var: net}, bps: {$var: bps}}}}
  recordSettlement:
    args:
      key: {type: Text}
      result: {}
    do:
    - $if:
        cond: {$not: {$exists: {$var: {name: result, path: /paidMinor}}}}
        then:
        - $return: {outcome: skipped}
    - $let:
        name: settled
        expr:
          $call:
            function: closeReservation
            args: {input: {key: {$var: key}, paidMinor: {$var: {name: result, path: /paidMinor}}}}
    - $if:
        cond:
          $and:
          - {$eq: [{$var: {name: settled, path: /outcome}}, acceptedNew]}
          - {$exists: {$var: {name: result, path: /feeMinor}}}
        then:
        - $let:
            name: settlementPath
            expr: {$concat: [{$const: {name: bindings, path: /state}}, {$pointerJoin: [settlements, {$var: key}]}]}
        - $appendChange: {op: add, path: {$concat: [{$var: settlementPath}, /feeMinor]}, val: {$var: {name: result, path: /feeMinor}}}
        - $appendChange: {op: add, path: {$concat: [{$var: settlementPath}, /transferredMinor]}, val: {$var: {name: result, path: /transferredMinor}}}
    - $return: {$var: settled}
