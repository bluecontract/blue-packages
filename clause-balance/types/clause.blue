name: Ledger Clause
type: Connections/Connected Clause
bindingTypes:
  state: pointer
actionDefinition:
  type: Ledger/Balance Functions
actions:
  initialize:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: initialize
            args:
              input:
                $var: params
    automatic:
      'on': initialized
      once: true
  setTarget:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: setTarget
            args:
              input:
                $var: params
  reserve:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: reserve
            args:
              input:
                $var: params
  settle:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: settle
            args:
              input:
                $var: params
defaultBindings:
  state: /balance
