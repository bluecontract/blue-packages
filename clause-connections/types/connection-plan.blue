name: Connection Plan
type: Connections/Connection Planning Functions
functions:
  plan:
    args: {}
    do:
    - $return:
        $call:
          function: planConnections
          args: {}
  validateConfiguration:
    args: {}
    do:
    - $return:
        $call:
          function: validateConnectionsConfiguration
          args: {}
  validateTransition:
    args: {}
    do:
    - $return:
        $call:
          function: validateConnectionsTransition
          args: {}
