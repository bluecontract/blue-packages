name: Connected Clause
type: Clauses/Clause
description: Named connections lower to native Contracts channels and BEX workflows. Actions are declared by the
  exact clause type.
hookAbi: document-context-1
hookDefinition:
  type: Contracts/Compute Definition
  functions:
    validName:
      args:
        candidate:
          type: Text
      do:
      - $return:
          $and:
          - $isKind:
              val:
                $var: candidate
              kind: text
          - $ne:
            - $var: candidate
            - ''
          - $eq:
            - $size:
                $split:
                  text:
                    $var: candidate
                  separator: /
            - 1
          - $eq:
            - $size:
                $split:
                  text:
                    $var: candidate
                  separator: '~'
            - 1
          - $eq:
            - $size:
                $split:
                  text:
                    $var: candidate
                  separator: .
            - 1
    selector:
      args:
        s: {}
      do:
      - $let:
          name: mode
          expr:
            $var:
              name: s
              path: /on
      - $failIf:
          cond:
            $not:
              $includes:
                list:
                - event
                - embedded
                - collection
                - change
                - channel
                - initialized
                val:
                  $var: mode
          message: Unsupported connection source
      - $if:
          cond:
            $eq:
            - $var: mode
            - channel
          then:
          - $failIf:
              cond:
                $not:
                  $call:
                    function: validName
                    args:
                      candidate:
                        $var:
                          name: s
                          path: /channel
              message: A channel source requires an existing channel name
          - $return: {}
      - $if:
          cond:
            $exists:
              $var:
                name: s
                path: /embed
          then:
          - $failIf:
              cond:
                $not:
                  $isKind:
                    val:
                      $var:
                        name: s
                        path: /embed
                    kind: boolean
              message: Embed must be Boolean
      - $let:
          name: result
          expr:
            type: Contracts/Triggered Event Channel
      - $if:
          cond:
            $includes:
              list:
              - embedded
              - collection
              val:
                $var: mode
          then:
          - $set:
              name: result
              expr:
                type: Contracts/Embedded Node Channel
          - $failIf:
              cond:
                $not:
                  $and:
                  - $isKind:
                      val:
                        $var:
                          name: s
                          path: /path
                      kind: text
                  - $startsWith:
                    - $var:
                        name: s
                        path: /path
                    - /
                  - $ne:
                    - $var:
                        name: s
                        path: /path
                    - /
              message: An embedded source requires a non-root JSON Pointer
          - $if:
              cond:
                $eq:
                - $var: mode
                - embedded
              then:
              - $set:
                  name: result
                  expr:
                    $merge:
                    - $var: result
                    - sourcePath:
                        $var:
                          name: s
                          path: /path
      - $if:
          cond:
            $eq:
            - $var: mode
            - change
          then:
          - $failIf:
              cond:
                $not:
                  $and:
                  - $isKind:
                      val:
                        $var:
                          name: s
                          path: /path
                      kind: text
                  - $startsWith:
                    - $var:
                        name: s
                        path: /path
                    - /
                  - $ne:
                    - $var:
                        name: s
                        path: /path
                    - /
              message: A change source requires a non-root JSON Pointer
          - $set:
              name: result
              expr:
                type: Contracts/Document Update Channel
          - $set:
              name: result
              expr:
                $merge:
                - $var: result
                - path:
                    $var:
                      name: s
                      path: /path
      - $if:
          cond:
            $exists:
              $var:
                name: s
                path: /event
          then:
          - $set:
              name: result
              expr:
                $merge:
                - $var: result
                - event:
                    $var:
                      name: s
                      path: /event
      - $if:
          cond:
            $eq:
            - $var: mode
            - initialized
          then:
          - $set:
              name: result
              expr:
                $merge:
                - $var: result
                - event:
                    type: Clauses/Clauses Initialized
      - $return:
          $var: result
    validateConfiguration:
      args: {}
      do:
      - $return:
          allowed: true
          code: ''
    validateTransition:
      args: {}
      do:
      - $return:
          allowed:
            $eq:
            - $document:
                $concat:
                - /clauses/
                - $const: clauseKey
            - $document:
                $concat:
                - /clauseRuntime/work/candidate/
                - $const: clauseKey
          code: CONNECTIONS_REQUIRE_NEW_CLAUSE_KEY
    plan:
      args: {}
      do:
      - $let:
          name: clause
          expr:
            $document:
              $concat:
              - /clauseRuntime/work/candidate/
              - $const: clauseKey
      - $let:
          name: bindings
          expr:
            $merge:
            - $object:
                $document:
                  $concat:
                  - /clauseRuntime/work/candidate/
                  - $const: clauseKey
                  - /type/defaultBindings
            - $object:
                $var:
                  name: clause
                  path: /bindings
      - $let:
          name: actions
          expr:
            $document:
              $concat:
              - /clauseRuntime/work/candidate/
              - $const: clauseKey
              - /type/actions
      - $failIf:
          cond:
            $not:
              $call:
                function: validName
                args:
                  candidate:
                    $const: clauseKey
          message: Clause names must not contain dot, slash or tilde
      - $let:
          name: bindingTypes
          expr:
            $object:
              $document:
                $concat:
                - /clauseRuntime/work/candidate/
                - $const: clauseKey
                - /type/bindingTypes
      - $let:
          name: propertyBindings
          expr: {}
      - $forEach:
          item: binding
          key: bindingName
          in:
            $var: bindings
          do:
          - $if:
              cond:
                $not:
                  $hasKey:
                    object:
                      $var: actions
                    key:
                      $var: bindingName
              then:
              - $failIf:
                  cond:
                    $not:
                      $hasKey:
                        object:
                          $var: bindingTypes
                        key:
                          $var: bindingName
                  message:
                    $concat:
                    - 'Unknown property or action binding: '
                    - $var: bindingName
              - $set:
                  name: propertyBindings
                  expr:
                    $objectSet:
                      object:
                        $var: propertyBindings
                      key:
                        $var: bindingName
                      val:
                        $var: binding
      - $forEach:
          item: bindingType
          key: bindingName
          in:
            $var: bindingTypes
          do:
          - $let:
              name: binding
              expr:
                $get:
                  object:
                    $var: propertyBindings
                  key:
                    $var: bindingName
          - $failIf:
              cond:
                $not:
                  $choose:
                    cond:
                      $eq:
                      - $var: bindingType
                      - pointer
                    then:
                      $and:
                      - $isKind:
                          val:
                            $var: binding
                          kind: text
                      - $startsWith:
                        - $var: binding
                        - /
                      - $ne:
                        - $var: binding
                        - /
                    else:
                      $eq:
                      - $kind:
                          $var: binding
                      - $var: bindingType
              message:
                $concat:
                - 'Missing or invalid property binding: '
                - $var: bindingName
      - $let:
          name: contributions
          expr: {}
      - $let:
          name: paths
          expr: []
      - $let:
          name: collections
          expr: []
      - $forEach:
          item: bindingName
          in:
            $list:
              $document:
                $concat:
                - /clauseRuntime/work/candidate/
                - $const: clauseKey
                - /type/embeds
          do:
          - $failIf:
              cond:
                $ne:
                - $get:
                    object:
                      $var: bindingTypes
                    key:
                      $var: bindingName
                - pointer
              message: Embedded binding must be a declared pointer
          - $set:
              name: paths
              expr:
                $listConcat:
                - $var: paths
                - - $get:
                      object:
                        $var: propertyBindings
                      key:
                        $var: bindingName
      - $forEach:
          item: bindingName
          in:
            $list:
              $document:
                $concat:
                - /clauseRuntime/work/candidate/
                - $const: clauseKey
                - /type/embedsCollections
          do:
          - $failIf:
              cond:
                $ne:
                - $get:
                    object:
                      $var: bindingTypes
                    key:
                      $var: bindingName
                - pointer
              message: Embedded collection binding must be a declared pointer
          - $set:
              name: collections
              expr:
                $listConcat:
                - $var: collections
                - - $get:
                      object:
                        $var: propertyBindings
                      key:
                        $var: bindingName
      - $let:
          name: statePath
          expr:
            $concat:
            - /connectionState_
            - $const: clauseKey
      - $let:
          name: state
          expr: {}
      - $failIf:
          cond:
            $not:
              $isKind:
                val:
                  $var: actions
                kind: object
          message: Connected clause type must declare actions
      - $forEach:
          item: action
          key: actionName
          in:
            $var: actions
          do:
          - $let:
              name: connections
              expr:
                $object:
                  $get:
                    object:
                      $var: bindings
                    key:
                      $var: actionName
          - $failIf:
              cond:
                $and:
                - $exists:
                    $var: connections
                - $not:
                    $isKind:
                      val:
                        $var: connections
                      kind: object
              message: An action binding must be a dictionary of connections
          - $if:
              cond:
                $exists:
                  $var:
                    name: action
                    path: /automatic
              then:
              - $failIf:
                  cond:
                    $hasKey:
                      object:
                        $var: connections
                      key: _automatic
                  message: _automatic is reserved for the clause action
              - $let:
                  name: automatic
                  expr:
                    $var:
                      name: action
                      path: /automatic
              - $if:
                  cond:
                    $exists:
                      $var:
                        name: automatic
                        path: /pathBinding
                  then:
                  - $set:
                      name: automatic
                      expr:
                        $pointerSet:
                          object:
                            $objectSet:
                              object:
                                $var: automatic
                              key: path
                              val:
                                $get:
                                  object:
                                    $var: propertyBindings
                                  key:
                                    $var:
                                      name: automatic
                                      path: /pathBinding
                          path: /pathBinding
                          op: remove
              - $set:
                  name: connections
                  expr:
                    $objectSet:
                      object:
                        $var: connections
                      key: _automatic
                      val:
                        $var: automatic
          - $forEach:
              item: c
              key: connectionName
              in:
                $var: connections
              do:
              - $failIf:
                  cond:
                    $not:
                      $and:
                      - $call:
                          function: validName
                          args:
                            candidate:
                              $var: actionName
                      - $call:
                          function: validName
                          args:
                            candidate:
                              $var: connectionName
                      - $isKind:
                          val:
                            $var: c
                          kind: object
                  message: Invalid named connection
              - $let:
                  name: mode
                  expr:
                    $var:
                      name: c
                      path: /on
              - $let:
                  name: allowedFields
                  expr:
                  - 'on'
                  - params
                  - before
                  - after
                  - when
                  - once
              - $let:
                  name: sourceFields
                  expr:
                    $get:
                      object:
                        workflow:
                        - channel
                        - event
                        - request
                        event:
                        - event
                        embedded:
                        - path
                        - event
                        - embed
                        collection:
                        - path
                        - event
                        - embed
                        change:
                        - path
                        - event
                        channel:
                        - channel
                        - event
                        initialized: []
                        timer:
                        - timestamp
                        - afterEvent
                        - delayMs
                        - policy
                        - cancelOn
                      key:
                        $var: mode
              - $failIf:
                  cond:
                    $not:
                      $isKind:
                        val:
                          $var: sourceFields
                        kind: list
                  message: Unknown connection mode
              - $set:
                  name: allowedFields
                  expr:
                    $listConcat:
                    - $var: allowedFields
                    - $var: sourceFields
              - $forEach:
                  item: field
                  in:
                    $keys:
                      $var: c
                  do:
                  - $failIf:
                      cond:
                        $not:
                          $includes:
                            list:
                              $var: allowedFields
                            val:
                              $var: field
                      message:
                        $concat:
                        - 'Unsupported field for this connection: '
                        - $var: field
              - $if:
                  cond:
                    $exists:
                      $var:
                        name: c
                        path: /embed
                  then:
                  - $failIf:
                      cond:
                        $not:
                          $isKind:
                            val:
                              $var:
                                name: c
                                path: /embed
                            kind: boolean
                      message: Embed must be Boolean
              - $let:
                  name: timer
                  expr:
                    $eq:
                    - $var: mode
                    - timer
              - $let:
                  name: once
                  expr:
                    $pointerGet:
                      object:
                        $var: c
                      path: /once
                      default: false
              - $failIf:
                  cond:
                    $not:
                      $isKind:
                        val:
                          $var: once
                        kind: boolean
                  message: once must be Boolean
              - $let:
                  name: id
                  expr:
                    $concat:
                    - cx.
                    - $const: clauseKey
                    - .
                    - $var: actionName
                    - .
                    - $var: connectionName
              - $let:
                  name: slot
                  expr:
                    $concat:
                    - $var: actionName
                    - .
                    - $var: connectionName
              - $failIf:
                  cond:
                    $hasKey:
                      object:
                        $var: state
                      key:
                        $var: slot
                  message: Connection names collide after joining action and connection names
              - $set:
                  name: state
                  expr:
                    $objectSet:
                      object:
                        $var: state
                      key:
                        $var: slot
                      val:
                        fired: false
                        armed: false
              - $let:
                  name: connectionPath
                  expr:
                    $concat:
                    - $var: statePath
                    - /
                    - $var: slot
              - $let:
                  name: channel
                  expr:
                    $concat:
                    - $var: id
                    - _source
              - $let:
                  name: handler
                  expr:
                    type: Contracts/Sequential Workflow
              - $if:
                  cond:
                    $eq:
                    - $var: mode
                    - workflow
                  then:
                  - $set:
                      name: channel
                      expr:
                        $var:
                          name: c
                          path: /channel
                  - $failIf:
                      cond:
                        $not:
                          $call:
                            function: validName
                            args:
                              candidate:
                                $var: channel
                      message: A workflow requires an authenticated channel binding
                  - $set:
                      name: handler
                      expr:
                        type: Contracts/Sequential Workflow Operation
                  - $if:
                      cond:
                        $exists:
                          $var:
                            name: c
                            path: /request
                      then:
                      - $set:
                          name: handler
                          expr:
                            $merge:
                            - $var: handler
                            - request:
                                $var:
                                  name: c
                                  path: /request
                  - $if:
                      cond:
                        $exists:
                          $var:
                            name: c
                            path: /event
                      then:
                      - $set:
                          name: handler
                          expr:
                            $merge:
                            - $var: handler
                            - event:
                                $var:
                                  name: c
                                  path: /event
                  else:
                  - $if:
                      cond:
                        $var: timer
                      then:
                      - $set:
                          name: contributions
                          expr:
                            $objectSet:
                              object:
                                $var: contributions
                              key:
                                $var: channel
                              val:
                                kind: channel
                                contract:
                                  type: Time/Timer Channel
                      else:
                      - $let:
                          name: declaration
                          expr:
                            $call:
                              function: selector
                              args:
                                s:
                                  $var: c
                      - $if:
                          cond:
                            $eq:
                            - $var: mode
                            - channel
                          then:
                          - $set:
                              name: channel
                              expr:
                                $var:
                                  name: c
                                  path: /channel
                          - $if:
                              cond:
                                $exists:
                                  $var:
                                    name: c
                                    path: /event
                              then:
                              - $set:
                                  name: handler
                                  expr:
                                    $merge:
                                    - $var: handler
                                    - event:
                                        $var:
                                          name: c
                                          path: /event
                          else:
                          - $set:
                              name: contributions
                              expr:
                                $objectSet:
                                  object:
                                    $var: contributions
                                  key:
                                    $var: channel
                                  val:
                                    kind: channel
                                    contract:
                                      $var: declaration
              - $let:
                  name: constants
                  expr:
                    clauseKey:
                      $const: clauseKey
                    connectionKey:
                      $var: connectionName
                    parameters:
                      $choose:
                        cond:
                          $eq:
                          - $document:
                              $concat:
                              - /clauseRuntime/work/candidate/
                              - $const: clauseKey
                              - /type/readParametersFromDocument
                          - true
                        then: {}
                        else:
                          $var:
                            name: clause
                            path: /parameters
                    bindings:
                      $var: propertyBindings
                    statePath:
                      $var: connectionPath
                    sourceMode:
                      $var: mode
                    sourcePath:
                      $pointerGet:
                        object:
                          $var: c
                        path: /path
                        default: ''
                    once:
                      $var: once
                    timerChannel:
                      $var: channel
                    resultContract:
                      $pointerGet:
                        object:
                          $var: action
                        path: /resultContract
                        default: legacy
              - $let:
                  name: body
                  expr:
                    $listConcat:
                    - $literal:
                      - $if:
                          cond:
                            $and:
                            - $const: once
                            - $document:
                                $concat:
                                - $const: statePath
                                - /fired
                          then:
                          - $return: {}
                      - $if:
                          cond:
                            $and:
                            - $eq:
                              - $const: sourceMode
                              - collection
                            - $not:
                                $startsWith:
                                - $event: /sourcePath
                                - $concat:
                                  - $const: sourcePath
                                  - /
                          then:
                          - $return: {}
                      - $let:
                          name: trigger
                          expr:
                            $choose:
                              cond:
                                $eq:
                                - $const: sourceMode
                                - workflow
                              then:
                                $binding: call/request
                              else:
                                $choose:
                                  cond:
                                    $includes:
                                      list:
                                      - embedded
                                      - collection
                                      val:
                                        $const: sourceMode
                                  then:
                                    $event: /event
                                  else:
                                    $choose:
                                      cond:
                                        $eq:
                                        - $const: sourceMode
                                        - timer
                                      then:
                                        $event: /request/context/trigger
                                      else:
                                        $event: ''
                    - - $pointerSet:
                          object:
                            $literal:
                              $let:
                                name: params
                                expr: {}
                          path: /$let/expr
                          val:
                            $merge:
                            - $pointerGet:
                                object:
                                  $var: action
                                path: /defaults
                                default: {}
                            - $pointerGet:
                                object:
                                  $var: c
                                path: /params
                                default: {}
                    - - $pointerSet:
                          object:
                            $literal:
                              $if:
                                cond:
                                  $not: true
                                then:
                                - $return: {}
                          path: /$if/cond/$not
                          val:
                            $pointerGet:
                              object:
                                $var: c
                              path: /when
                              default: true
                    - $literal:
                      - $let:
                          name: actionResult
                          expr: {}
                    - $pointerGet:
                        object:
                          $var: c
                        path: /before
                        default: []
                    - $var:
                        name: action
                        path: /do
                    - $literal:
                      - $if:
                          cond:
                            $eq:
                            - $const: resultContract
                            - outcome-v1
                          then:
                          - $failIf:
                              cond:
                                $not:
                                  $includes:
                                    list:
                                    - acceptedNew
                                    - duplicate
                                    - rejected
                                    - skipped
                                    val:
                                      $var:
                                        name: actionResult
                                        path: /outcome
                              message: 'ACTION_RESULT_REQUIRED: outcome-v1 action must return an explicit outcome'
                          - $if:
                              cond:
                                $ne:
                                - $var:
                                    name: actionResult
                                    path: /outcome
                                - acceptedNew
                              then:
                              - $return: {}
                    - $pointerGet:
                        object:
                          $var: c
                        path: /after
                        default: []
                    - $literal:
                      - $if:
                          cond:
                            $const: once
                          then:
                          - $appendChange:
                              op: replace
                              path:
                                $concat:
                                - $const: statePath
                                - /fired
                              val: true
              - $let:
                  name: compute
                  expr:
                    type: Contracts/Compute
              - $set:
                  name: compute
                  expr:
                    $merge:
                    - $var: compute
                    - constants:
                        $var: constants
                      do:
                        $var: body
              - $if:
                  cond:
                    $exists:
                      $document:
                        $concat:
                        - /clauseRuntime/work/candidate/
                        - $const: clauseKey
                        - /type/actionDefinition
                  then:
                  - $set:
                      name: compute
                      expr:
                        $objectSet:
                          object:
                            $var: compute
                          key: definition
                          val:
                            $objectSet:
                              object: {}
                              key: blueId
                              val:
                                $nodeBlueId:
                                  $document:
                                    $concat:
                                    - /clauseRuntime/work/candidate/
                                    - $const: clauseKey
                                    - /type/actionDefinition/type
              - $set:
                  name: handler
                  expr:
                    $merge:
                    - $var: handler
                    - channel:
                        $var: channel
                      steps:
                      - $var: compute
              - $let:
                  name: handlerKey
                  expr:
                    $choose:
                      cond:
                        $eq:
                        - $var: mode
                        - workflow
                      then:
                        $var: connectionName
                      else:
                        $var: id
              - $failIf:
                  cond:
                    $hasKey:
                      object:
                        $var: contributions
                      key:
                        $var: handlerKey
                  message: Duplicate workflow name
              - $set:
                  name: contributions
                  expr:
                    $objectSet:
                      object:
                        $var: contributions
                      key:
                        $var: handlerKey
                      val:
                        kind: handler
                        contract:
                          $var: handler
              - $let:
                  name: selectors
                  expr:
                  - $var: c
              - $if:
                  cond:
                    $var: timer
                  then:
                  - $let:
                      name: absolute
                      expr:
                        $hasKey:
                          object:
                            $var: c
                          key: timestamp
                  - $failIf:
                      cond:
                        $eq:
                        - $var: absolute
                        - $hasKey:
                            object:
                              $var: c
                            key: afterEvent
                      message: Timer requires exactly one of timestamp and afterEvent
                  - $let:
                      name: policy
                      expr:
                        $pointerGet:
                          object:
                            $var: c
                          path: /policy
                          default: first
                  - $failIf:
                      cond:
                        $not:
                          $includes:
                            list:
                            - first
                            - latest
                            val:
                              $var: policy
                      message: Timer policy must be first or latest
                  - $if:
                      cond:
                        $var: absolute
                      then:
                      - $failIf:
                          cond:
                            $or:
                            - $hasKey:
                                object:
                                  $var: c
                                key: delayMs
                            - $hasKey:
                                object:
                                  $var: c
                                key: policy
                          message: An absolute timer has no delayMs or first/latest policy
                      - $failIf:
                          cond:
                            $not:
                              $and:
                              - $isKind:
                                  val:
                                    $var:
                                      name: c
                                      path: /timestamp
                                  kind: integer
                              - $gte:
                                - $var:
                                    name: c
                                    path: /timestamp
                                - 0
                              - $lte:
                                - $var:
                                    name: c
                                    path: /timestamp
                                - 9007199254740991
                          message: timestamp must be an integer Unix timestamp in microseconds
                      else:
                      - $failIf:
                          cond:
                            $not:
                              $and:
                              - $isKind:
                                  val:
                                    $var:
                                      name: c
                                      path: /delayMs
                                  kind: integer
                              - $gt:
                                - $var:
                                    name: c
                                    path: /delayMs
                                - 0
                              - $lte:
                                - $var:
                                    name: c
                                    path: /delayMs
                                - 9007199254740
                          message: delayMs must be a positive integer
                  - $let:
                      name: armSource
                      expr:
                        $choose:
                          cond:
                            $var: absolute
                          then:
                            'on': initialized
                          else:
                            $var:
                              name: c
                              path: /afterEvent
                  - $failIf:
                      cond:
                        $and:
                        - $not:
                            $var: absolute
                        - $eq:
                          - $var:
                              name: armSource
                              path: /on
                          - initialized
                      message: A relative timer requires a timestamped source, not initialization
                  - $let:
                      name: cancelSource
                      expr:
                        $pointerGet:
                          object:
                            $var: c
                          path: /cancelOn
                          default: {}
                  - $failIf:
                      cond:
                        $and:
                        - $hasKey:
                            object:
                              $var: c
                            key: cancelOn
                        - $eq:
                          - $size:
                              $var: cancelSource
                          - 0
                      message: cancelOn must name a source
                  - $set:
                      name: selectors
                      expr:
                      - $var: armSource
                      - $var: cancelSource
                  - $forEach:
                      item: source
                      key: task
                      in:
                        arm:
                          $var: armSource
                        cancel:
                          $var: cancelSource
                      do:
                      - $if:
                          cond:
                            $gt:
                            - $size:
                                $var: source
                            - 0
                          then:
                          - $let:
                              name: selectorFields
                              expr:
                                $get:
                                  object:
                                    event:
                                    - 'on'
                                    - event
                                    embedded:
                                    - 'on'
                                    - path
                                    - event
                                    - embed
                                    collection:
                                    - 'on'
                                    - path
                                    - event
                                    - embed
                                    change:
                                    - 'on'
                                    - path
                                    - event
                                    channel:
                                    - 'on'
                                    - channel
                                    - event
                                    initialized:
                                    - 'on'
                                  key:
                                    $var:
                                      name: source
                                      path: /on
                          - $forEach:
                              item: field
                              in:
                                $keys:
                                  $var: source
                              do:
                              - $failIf:
                                  cond:
                                    $not:
                                      $includes:
                                        list:
                                          $var: selectorFields
                                        val:
                                          $var: field
                                  message:
                                    $concat:
                                    - 'Unsupported timer source field: '
                                    - $var: field
                          - $let:
                              name: sourceChannel
                              expr:
                                $concat:
                                - $var: id
                                - _
                                - $var: task
                                - _source
                          - $let:
                              name: sourceDeclaration
                              expr:
                                $call:
                                  function: selector
                                  args:
                                    s:
                                      $var: source
                          - $if:
                              cond:
                                $eq:
                                - $var:
                                    name: source
                                    path: /on
                                - channel
                              then:
                              - $set:
                                  name: sourceChannel
                                  expr:
                                    $var:
                                      name: source
                                      path: /channel
                              else:
                              - $set:
                                  name: contributions
                                  expr:
                                    $objectSet:
                                      object:
                                        $var: contributions
                                      key:
                                        $var: sourceChannel
                                      val:
                                        kind: channel
                                        contract:
                                          $var: sourceDeclaration
                          - $let:
                              name: taskBody
                              expr:
                                $literal:
                                - $if:
                                    cond:
                                      $and:
                                      - $eq:
                                        - $const: sourceMode
                                        - collection
                                      - $not:
                                          $startsWith:
                                          - $event: /sourcePath
                                          - $concat:
                                            - $const: sourcePath
                                            - /
                                    then:
                                    - $return: {}
                          - $if:
                              cond:
                                $eq:
                                - $var: task
                                - cancel
                              then:
                              - $set:
                                  name: taskBody
                                  expr:
                                    $listConcat:
                                    - $var: taskBody
                                    - $literal:
                                      - $appendEvent:
                                          $merge:
                                          - type: Time/Cancel Timer Request
                                            channel: placeholder
                                            key: placeholder
                                          - channel:
                                              $const: timerChannel
                                            key: connection
                              else:
                              - $set:
                                  name: taskBody
                                  expr:
                                    $listConcat:
                                    - $var: taskBody
                                    - $literal:
                                      - $if:
                                          cond:
                                            $or:
                                            - $and:
                                              - $const: once
                                              - $document:
                                                  $concat:
                                                  - $const: statePath
                                                  - /fired
                                            - $and:
                                              - $eq:
                                                - $const: policy
                                                - first
                                              - $document:
                                                  $concat:
                                                  - $const: statePath
                                                  - /armed
                                          then:
                                          - $return: {}
                                      - $let:
                                          name: deadline
                                          expr:
                                            $choose:
                                              cond:
                                                $const: absolute
                                              then:
                                                $const: timestamp
                                              else:
                                                $add:
                                                - $binding: timestamp
                                                - $multiply:
                                                  - $const: delayMs
                                                  - 1000
                                      - $failIf:
                                          cond:
                                            $gt:
                                            - $var: deadline
                                            - 9007199254740991
                                          message: Timer deadline exceeds the portable timestamp range
                                      - $appendChange:
                                          op: replace
                                          path:
                                            $concat:
                                            - $const: statePath
                                            - /armed
                                          val: true
                                      - $appendEvent:
                                          $merge:
                                          - type: Time/Timer Request
                                            channel: placeholder
                                            timestamp: 0
                                          - channel:
                                              $const: timerChannel
                                            key: connection
                                            timestamp:
                                              $var: deadline
                                            context:
                                              trigger:
                                                $choose:
                                                  cond:
                                                    $includes:
                                                      list:
                                                      - embedded
                                                      - collection
                                                      val:
                                                        $const: sourceMode
                                                  then:
                                                    $event: /event
                                                  else:
                                                    $event: ''
                                              sourcePath:
                                                $pointerGet:
                                                  object:
                                                    $event: ''
                                                  path: /sourcePath
                                                  default: ''
                          - $let:
                              name: taskCompute
                              expr:
                                type: Contracts/Compute
                          - $set:
                              name: taskCompute
                              expr:
                                $merge:
                                - $var: taskCompute
                                - do:
                                    $var: taskBody
                                  constants:
                                    $merge:
                                    - $var: constants
                                    - absolute:
                                        $var: absolute
                                      timestamp:
                                        $pointerGet:
                                          object:
                                            $var: c
                                          path: /timestamp
                                          default: 0
                                      delayMs:
                                        $pointerGet:
                                          object:
                                            $var: c
                                          path: /delayMs
                                          default: 0
                                      policy:
                                        $var: policy
                                      sourceMode:
                                        $var:
                                          name: source
                                          path: /on
                                      sourcePath:
                                        $pointerGet:
                                          object:
                                            $var: source
                                          path: /path
                                          default: ''
                          - $let:
                              name: taskHandler
                              expr:
                                type: Contracts/Sequential Workflow
                          - $set:
                              name: taskHandler
                              expr:
                                $merge:
                                - $var: taskHandler
                                - channel:
                                    $var: sourceChannel
                                  steps:
                                  - $var: taskCompute
                          - $if:
                              cond:
                                $and:
                                - $eq:
                                  - $var:
                                      name: source
                                      path: /on
                                  - channel
                                - $exists:
                                    $var:
                                      name: source
                                      path: /event
                              then:
                              - $set:
                                  name: taskHandler
                                  expr:
                                    $merge:
                                    - $var: taskHandler
                                    - event:
                                        $var:
                                          name: source
                                          path: /event
                          - $set:
                              name: contributions
                              expr:
                                $objectSet:
                                  object:
                                    $var: contributions
                                  key:
                                    $concat:
                                    - $var: id
                                    - _
                                    - $var: task
                                  val:
                                    kind: handler
                                    contract:
                                      $var: taskHandler
              - $forEach:
                  item: source
                  in:
                    $var: selectors
                  do:
                  - $if:
                      cond:
                        $and:
                        - $eq:
                          - $var:
                              name: source
                              path: /on
                          - embedded
                        - $ne:
                          - $var:
                              name: source
                              path: /embed
                          - false
                      then:
                      - $set:
                          name: paths
                          expr:
                            $listConcat:
                            - $var: paths
                            - - $var:
                                  name: source
                                  path: /path
                  - $if:
                      cond:
                        $and:
                        - $eq:
                          - $var:
                              name: source
                              path: /on
                          - collection
                        - $ne:
                          - $var:
                              name: source
                              path: /embed
                          - false
                      then:
                      - $set:
                          name: collections
                          expr:
                            $listConcat:
                            - $var: collections
                            - - $var:
                                  name: source
                                  path: /path
      - $if:
          cond:
            $gt:
            - $add:
              - $size:
                  $var: paths
              - $size:
                  $var: collections
            - 0
          then:
          - $let:
              name: embedding
              expr:
                type: Contracts/Process Embedded
          - $set:
              name: embedding
              expr:
                $merge:
                - $var: embedding
                - paths:
                    $var: paths
                  collectionPaths:
                    $var: collections
          - $set:
              name: contributions
              expr:
                $objectSet:
                  object:
                    $var: contributions
                  key: embedded
                  val:
                    kind: embedding
                    contract:
                      $var: embedding
      - $return:
          contracts:
            $var: contributions
          states:
            connections:
              path:
                $var: statePath
              kind: object
              initial:
                $var: state
          reads: []
