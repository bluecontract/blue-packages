{
  "name": "Clause Amendment Step",
  "type": "Contracts/Compute",
  "do": [
    {
      "$let": {
        "name": "r",
        "expr": {
          "$binding": "call/request"
        }
      }
    },
    {
      "$failIf": {
        "cond": {
          "$not": {
            "$isKind": {
              "val": {
                "$var": "r"
              },
              "kind": "object"
            }
          }
        },
        "message": "REQUEST_REQUIRED"
      }
    },
    {
      "$failIf": {
        "cond": {
          "$not": {
            "$hasKey": {
              "object": {
                "$var": "r"
              },
              "key": "expectedRevision"
            }
          }
        },
        "message": "EXPECTED_REVISION_REQUIRED"
      }
    },
    {
      "$failIf": {
        "cond": {
          "$not": {
            "$isKind": {
              "val": {
                "$var": {
                  "name": "r",
                  "path": "/expectedRevision"
                }
              },
              "kind": "integer"
            }
          }
        },
        "message": "EXPECTED_REVISION_MUST_BE_INTEGER"
      }
    },
    {
      "$failIf": {
        "cond": {
          "$not": {
            "$eq": [
              {
                "$var": {
                  "name": "r",
                  "path": "/expectedRevision"
                }
              },
              {
                "$document": "/clauseRuntime/revision"
              }
            ]
          }
        },
        "message": "STALE_CLAUSE_REVISION"
      }
    },
    {
      "$forEach": {
        "in": {
          "$keys": {
            "$var": "r"
          }
        },
        "item": "requestKey",
        "do": [
          {
            "$failIf": {
              "cond": {
                "$not": {
                  "$includes": {
                    "list": {
                      "$literal": [
                        "expectedRevision",
                        "clauses",
                        "parameters",
                        "changes"
                      ]
                    },
                    "val": {
                      "$var": "requestKey"
                    }
                  }
                }
              },
              "message": "UNKNOWN_AMENDMENT_FIELD"
            }
          }
        ]
      }
    },
    {
      "$failIf": {
        "cond": {
          "$not": {
            "$or": [
              {
                "$hasKey": {
                  "object": {
                    "$var": "r"
                  },
                  "key": "clauses"
                }
              },
              {
                "$hasKey": {
                  "object": {
                    "$var": "r"
                  },
                  "key": "parameters"
                }
              },
              {
                "$hasKey": {
                  "object": {
                    "$var": "r"
                  },
                  "key": "changes"
                }
              }
            ]
          }
        },
        "message": "EMPTY_AMENDMENT"
      }
    },
    {
      "$failIf": {
        "cond": {
          "$not": {
            "$not": {
              "$and": [
                {
                  "$hasKey": {
                    "object": {
                      "$var": "r"
                    },
                    "key": "clauses"
                  }
                },
                {
                  "$hasKey": {
                    "object": {
                      "$var": "r"
                    },
                    "key": "changes"
                  }
                }
              ]
            }
          }
        },
        "message": "AMBIGUOUS_CLAUSE_AMENDMENT"
      }
    },
    {
      "$let": {
        "name": "nextClauses",
        "expr": {
          "$choose": {
            "cond": {
              "$hasKey": {
                "object": {
                  "$var": "r"
                },
                "key": "clauses"
              }
            },
            "then": {
              "$var": {
                "name": "r",
                "path": "/clauses"
              }
            },
            "else": {
              "$document": "/clauses"
            }
          }
        }
      }
    },
    {
      "$failIf": {
        "cond": {
          "$not": {
            "$isKind": {
              "val": {
                "$var": "nextClauses"
              },
              "kind": "object"
            }
          }
        },
        "message": "CLAUSES_MUST_BE_OBJECT"
      }
    },
    {
      "$if": {
        "cond": {
          "$hasKey": {
            "object": {
              "$var": "r"
            },
            "key": "changes"
          }
        },
        "then": [
          {
            "$failIf": {
              "cond": {
                "$not": {
                  "$isKind": {
                    "val": {
                      "$var": {
                        "name": "r",
                        "path": "/changes"
                      }
                    },
                    "kind": "list"
                  }
                }
              },
              "message": "CHANGES_MUST_BE_LIST"
            }
          },
          {
            "$let": {
              "name": "changedKeys",
              "expr": {
                "$emptyObject": true
              }
            }
          },
          {
            "$forEach": {
              "in": {
                "$var": {
                  "name": "r",
                  "path": "/changes"
                }
              },
              "item": "change",
              "do": [
                {
                  "$failIf": {
                    "cond": {
                      "$not": {
                        "$isKind": {
                          "val": {
                            "$var": "change"
                          },
                          "kind": "object"
                        }
                      }
                    },
                    "message": "CHANGE_MUST_BE_OBJECT"
                  }
                },
                {
                  "$failIf": {
                    "cond": {
                      "$not": {
                        "$and": [
                          {
                            "$isKind": {
                              "val": {
                                "$var": {
                                  "name": "change",
                                  "path": "/key"
                                }
                              },
                              "kind": "text"
                            }
                          },
                          {
                            "$ne": [
                              {
                                "$var": {
                                  "name": "change",
                                  "path": "/key"
                                }
                              },
                              ""
                            ]
                          },
                          {
                            "$eq": [
                              {
                                "$size": {
                                  "$split": {
                                    "text": {
                                      "$var": {
                                        "name": "change",
                                        "path": "/key"
                                      }
                                    },
                                    "separator": "/"
                                  }
                                }
                              },
                              1
                            ]
                          },
                          {
                            "$eq": [
                              {
                                "$size": {
                                  "$split": {
                                    "text": {
                                      "$var": {
                                        "name": "change",
                                        "path": "/key"
                                      }
                                    },
                                    "separator": "~"
                                  }
                                }
                              },
                              1
                            ]
                          }
                        ]
                      }
                    },
                    "message": "CLAUSE_KEY_MUST_BE_SIMPLE"
                  }
                },
                {
                  "$failIf": {
                    "cond": {
                      "$not": {
                        "$includes": {
                          "list": {
                            "$literal": [
                              "add",
                              "edit",
                              "remove"
                            ]
                          },
                          "val": {
                            "$var": {
                              "name": "change",
                              "path": "/op"
                            }
                          }
                        }
                      }
                    },
                    "message": "UNKNOWN_CLAUSE_OPERATION"
                  }
                },
                {
                  "$failIf": {
                    "cond": {
                      "$not": {
                        "$eq": [
                          {
                            "$keys": {
                              "$var": "change"
                            }
                          },
                          {
                            "$choose": {
                              "cond": {
                                "$eq": [
                                  {
                                    "$var": {
                                      "name": "change",
                                      "path": "/op"
                                    }
                                  },
                                  "remove"
                                ]
                              },
                              "then": {
                                "$literal": [
                                  "key",
                                  "op"
                                ]
                              },
                              "else": {
                                "$literal": [
                                  "clause",
                                  "key",
                                  "op"
                                ]
                              }
                            }
                          }
                        ]
                      }
                    },
                    "message": "INVALID_CLAUSE_CHANGE"
                  }
                },
                {
                  "$failIf": {
                    "cond": {
                      "$not": {
                        "$not": {
                          "$hasKey": {
                            "object": {
                              "$var": "changedKeys"
                            },
                            "key": {
                              "$var": {
                                "name": "change",
                                "path": "/key"
                              }
                            }
                          }
                        }
                      }
                    },
                    "message": "DUPLICATE_CLAUSE_CHANGE"
                  }
                },
                {
                  "$set": {
                    "name": "changedKeys",
                    "expr": {
                      "$objectSet": {
                        "object": {
                          "$var": "changedKeys"
                        },
                        "key": {
                          "$var": {
                            "name": "change",
                            "path": "/key"
                          }
                        },
                        "val": true
                      }
                    }
                  }
                },
                {
                  "$if": {
                    "cond": {
                      "$eq": [
                        {
                          "$var": {
                            "name": "change",
                            "path": "/op"
                          }
                        },
                        "add"
                      ]
                    },
                    "then": [
                      {
                        "$failIf": {
                          "cond": {
                            "$not": {
                              "$not": {
                                "$hasKey": {
                                  "object": {
                                    "$var": "nextClauses"
                                  },
                                  "key": {
                                    "$var": {
                                      "name": "change",
                                      "path": "/key"
                                    }
                                  }
                                }
                              }
                            }
                          },
                          "message": "CLAUSE_ALREADY_EXISTS"
                        }
                      }
                    ],
                    "else": [
                      {
                        "$failIf": {
                          "cond": {
                            "$not": {
                              "$hasKey": {
                                "object": {
                                  "$var": "nextClauses"
                                },
                                "key": {
                                  "$var": {
                                    "name": "change",
                                    "path": "/key"
                                  }
                                }
                              }
                            }
                          },
                          "message": "CLAUSE_NOT_FOUND"
                        }
                      }
                    ]
                  }
                },
                {
                  "$if": {
                    "cond": {
                      "$eq": [
                        {
                          "$var": {
                            "name": "change",
                            "path": "/op"
                          }
                        },
                        "remove"
                      ]
                    },
                    "then": [
                      {
                        "$set": {
                          "name": "nextClauses",
                          "expr": {
                            "$pointerSet": {
                              "object": {
                                "$var": "nextClauses"
                              },
                              "path": {
                                "$concat": [
                                  "/",
                                  {
                                    "$var": {
                                      "name": "change",
                                      "path": "/key"
                                    }
                                  }
                                ]
                              },
                              "op": "remove"
                            }
                          }
                        }
                      }
                    ],
                    "else": [
                      {
                        "$failIf": {
                          "cond": {
                            "$not": {
                              "$isKind": {
                                "val": {
                                  "$var": {
                                    "name": "change",
                                    "path": "/clause"
                                  }
                                },
                                "kind": "object"
                              }
                            }
                          },
                          "message": "CLAUSE_MUST_BE_OBJECT"
                        }
                      },
                      {
                        "$set": {
                          "name": "nextClauses",
                          "expr": {
                            "$objectSet": {
                              "object": {
                                "$var": "nextClauses"
                              },
                              "key": {
                                "$var": {
                                  "name": "change",
                                  "path": "/key"
                                }
                              },
                              "val": {
                                "$var": {
                                  "name": "change",
                                  "path": "/clause"
                                }
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "$appendChange": {
        "op": "add",
        "path": "/clauseRuntime/amending",
        "val": true
      }
    },
    {
      "$if": {
        "cond": {
          "$or": [
            {
              "$hasKey": {
                "object": {
                  "$var": "r"
                },
                "key": "changes"
              }
            },
            {
              "$hasKey": {
                "object": {
                  "$var": "r"
                },
                "key": "clauses"
              }
            }
          ]
        },
        "then": [
          {
            "$appendChange": {
              "op": "replace",
              "path": "/clauses",
              "val": {
                "$objectSet": {
                  "object": {
                    "$emptyObject": true
                  },
                  "key": "blueId",
                  "val": {
                    "$nodeBlueId": {
                      "$var": "nextClauses"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "$if": {
        "cond": {
          "$hasKey": {
            "object": {
              "$var": "r"
            },
            "key": "parameters"
          }
        },
        "then": [
          {
            "$failIf": {
              "cond": {
                "$not": {
                  "$isKind": {
                    "val": {
                      "$var": {
                        "name": "r",
                        "path": "/parameters"
                      }
                    },
                    "kind": "object"
                  }
                }
              },
              "message": "PARAMETERS_MUST_BE_OBJECT"
            }
          },
          {
            "$appendChange": {
              "op": "replace",
              "path": "/parameters",
              "val": {
                "$objectSet": {
                  "object": {
                    "$emptyObject": true
                  },
                  "key": "blueId",
                  "val": {
                    "$nodeBlueId": {
                      "$var": {
                        "name": "r",
                        "path": "/parameters"
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "$appendChange": {
        "op": "remove",
        "path": "/clauseRuntime/amending"
      }
    }
  ]
}
