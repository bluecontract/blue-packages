{
  "name": "Agreement",
  "description": "Root-local clause composition with deterministic initialization and source-change reconciliation. Clause code is data; no native business extension.",
  "agreementId": {
    "type": "Text"
  },
  "parameters": {},
  "clauses": {},
  "initialClauses": {},
  "channels": {},
  "clauseTypes": {
    "type": "List"
  },
  "amendTemplates": {
    "A": {
      "type": "Contracts/Sequential Workflow Operation",
      "channel": "partyA",
      "steps": [
        {
          "type": "Agreements/Clause Amendment Step"
        },
        {
          "type": "Agreements/Clause Install Step"
        }
      ]
    },
    "B": {
      "type": "Contracts/Sequential Workflow Operation",
      "channel": "partyB",
      "steps": [
        {
          "type": "Agreements/Clause Amendment Step"
        },
        {
          "type": "Agreements/Clause Install Step"
        }
      ]
    }
  },
  "contracts": {
    "_life": {
      "type": "Contracts/Lifecycle Event Channel",
      "event": {
        "type": "Contracts/Document Processing Initiated"
      }
    },
    "_initializeClauses": {
      "type": "Contracts/Sequential Workflow",
      "channel": "_life",
      "steps": [
        {
          "type": "Agreements/Clause Initializer Step"
        }
      ]
    },
    "_clauseChanges": {
      "type": "Contracts/Document Update Channel",
      "path": "/clauses"
    },
    "_parameterChanges": {
      "type": "Contracts/Document Update Channel",
      "path": "/parameters"
    },
    "_reconcileClauses": {
      "type": "Contracts/Sequential Workflow",
      "channel": "_clauseChanges",
      "steps": [
        {
          "type": "Agreements/Clause Install Step"
        }
      ]
    },
    "_reconcileParameters": {
      "type": "Contracts/Sequential Workflow",
      "channel": "_parameterChanges",
      "steps": [
        {
          "type": "Agreements/Clause Install Step"
        }
      ]
    },
    "_installation": {
      "type": "Contracts/Document Update Channel",
      "path": "/clauseRuntime/revision"
    }
  }
}
