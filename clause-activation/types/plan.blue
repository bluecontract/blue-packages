name: Activation Plan Functions
type: Activation/Activation Functions
constants:
  connectionPlannerDefinition:
    type: Connections/Connection Planning Functions
functions:
  validConnectionName:
    $blue:functionFrom: {definition: {type: Connections/Connection Planning Functions}, function: validName}
  connectionConfiguration:
    $blue:functionFrom: {definition: {type: Connections/Connection Planning Functions}, function: connectionConfiguration}
  connectionId:
    $blue:functionFrom: {definition: {type: Connections/Connection Planning Functions}, function: connectionId}
  connectionSourceChannel:
    $blue:functionFrom: {definition: {type: Connections/Connection Planning Functions}, function: connectionSourceChannel}
  resolveConnectionChannels:
    $blue:functionFrom: {definition: {type: Connections/Connection Planning Functions}, function: resolveConnectionChannels}
  resolveObservationChannels:
    args:
      clauseKey: {type: Text}
      actionName: {type: Text}
    do:
    - $let:
        name: config
        expr: {$call: {function: connectionConfiguration, args: {clauseKey: {$var: clauseKey}}}}
    - $let:
        name: action
        expr: {$get: {object: {$var: {name: config, path: /actions}}, key: {$var: actionName}}}
    - $if:
        cond: {$not: {$isKind: {val: {$var: action}, kind: object}}}
        then:
        - $return: {allowed: false, code: PRE_ACTIVATION_CONNECTION_UNKNOWN_ACTION}
    - $if:
        cond: {$ne: [{$var: {name: action, path: /observation}}, true]}
        then:
        - $return: {allowed: false, code: PRE_ACTIVATION_CONNECTION_ACTION_NOT_OBSERVATIONAL}
    - $let:
        name: connections
        expr: {$object: {$get: {object: {$var: {name: config, path: /bindings}}, key: {$var: actionName}}}}
    - $if:
        cond: {$exists: {$var: {name: action, path: /automatic}}}
        then:
        - $set:
            name: connections
            expr: {$objectSet: {object: {$var: connections}, key: _automatic, val: {$var: {name: action, path: /automatic}}}}
    # Use the same names as the stock planner, only for dedicated internal sources.
    - $return:
        allowed: true
        channels:
          $map:
            in:
              $filter:
                in: {$var: connections}
                item: connection
                where:
                  $includes:
                    list: [event, embedded, collection, change, initialized, activated]
                    val: {$var: {name: connection, path: /on}}
            key: connectionName
            item: connection
            expr:
              $call:
                function: connectionSourceChannel
                args:
                  id:
                    $call:
                      function: connectionId
                      args:
                        clauseKey: {$var: clauseKey}
                        actionName: {$var: actionName}
                        connectionName: {$var: connectionName}
  preActivationConnectionPlan:
    args:
      p: {}
    do:
    - $let:
        name: references
        expr: {$pointerGet: {object: {$var: p}, path: /preActivationConnections, default: []}}
    - $failIf:
        cond: {$not: {$isKind: {val: {$var: references}, kind: list}}}
        message: INVALID_PRE_ACTIVATION_CONNECTION_REFERENCE
    - $if:
        cond: {$eq: [{$size: {$var: references}}, 0]}
        then:
        - $return: {references: {}, channels: []}
    - $let:
        name: canonicalPlanner
        expr:
          $nodeBlueId:
            $document:
              $concat:
              - /clauseRuntime/work/candidate/
              - {$const: clauseKey}
              - /type/hookDefinition/type/constants/connectionPlannerDefinition/type/functions/planConnections
    - $let:
        vars:
          installing:
            $or:
            - {$document: /clauseRuntime/work/initializing}
            - {$not: {$exists: {$document: {$concat: [/clauses/, {$const: clauseKey}]}}}}
          previous: {$object: {$document: /contracts/activationDispatch/constants/preConnectionRefs}}
          retained: {}
          channels: []
    - $forEach:
        index: referenceIndex
        item: reference
        in: {$var: references}
        do:
        - $let:
            vars:
              clauseKey: {$var: {name: reference, path: /clause}}
              actionName: {$var: {name: reference, path: /action}}
              connectionName: {$var: {name: reference, path: /connection}}
              automatic: {$eq: [{$var: {name: reference, path: /automatic}}, true]}
              observations: {$eq: [{$var: {name: reference, path: /observations}}, true]}
        - $failIf:
            cond:
              $not:
                $or:
                - $and:
                  - {$var: automatic}
                  - {$eq: [{$keys: {$var: reference}}, [action, automatic, clause]]}
                - $and:
                  - {$var: observations}
                  - {$eq: [{$keys: {$var: reference}}, [action, clause, observations]]}
                - {$eq: [{$keys: {$var: reference}}, [action, clause, connection]]}
            message: INVALID_PRE_ACTIVATION_CONNECTION_REFERENCE
        - $forEach:
            item: referenceName
            in:
              $listConcat:
              - [{$var: clauseKey}, {$var: actionName}]
              - {$choose: {cond: {$or: [{$var: automatic}, {$var: observations}]}, then: [], else: [{$var: connectionName}]}}
            do:
            - $failIf:
                cond:
                  $not:
                    $and:
                    - {$isKind: {val: {$var: referenceName}, kind: text}}
                    - {$call: {function: validConnectionName, args: {candidate: {$var: referenceName}}}}
                    - {$eq: [{$size: {$split: {text: {$var: referenceName}, separator: '*'}}}, 1]}
                message: INVALID_PRE_ACTIVATION_CONNECTION_REFERENCE
        - $let:
            vars:
              refKey: {$text: {$var: referenceIndex}}
              target: {$document: {$concat: [/clauseRuntime/work/candidate/, {$var: clauseKey}]}}
        - $let:
            name: clauseId
            expr:
              $choose:
                cond: {$exists: {$var: target}}
                then: {$nodeBlueId: {$var: target}}
                else: ''
        - $if:
            cond:
              $or:
              - {$var: installing}
              - $and:
                - {$ne: [{$var: clauseId}, '']}
                - {$eq: [{$get: {object: {$var: previous}, key: {$var: refKey}}}, {$var: clauseId}]}
            then:
            - $failIf:
                cond: {$not: {$exists: {$var: target}}}
                message: PRE_ACTIVATION_CONNECTION_UNKNOWN_CLAUSE
            - $let:
                name: targetPlanner
                expr:
                  $document:
                    $concat: [/clauseRuntime/work/candidate/, {$var: clauseKey}, /type/hookDefinition/functions/planConnections]
            - $failIf:
                cond:
                  $or:
                  - {$not: {$exists: {$var: targetPlanner}}}
                  - {$ne: [{$nodeBlueId: {$var: targetPlanner}}, {$var: canonicalPlanner}]}
                message: PRE_ACTIVATION_CONNECTION_CLAUSE_NOT_CONNECTED
            - $let:
                name: route
                expr:
                  $choose:
                    cond: {$var: observations}
                    then:
                      $call:
                        function: resolveObservationChannels
                        args: {clauseKey: {$var: clauseKey}, actionName: {$var: actionName}}
                    else:
                      $call:
                        function: resolveConnectionChannels
                        args:
                          clauseKey: {$var: clauseKey}
                          actionName: {$var: actionName}
                          connectionName: {$pointerGet: {object: {$var: reference}, path: /connection, default: ''}}
                          automatic: {$var: automatic}
            - $failIf:
                cond: {$not: {$var: {name: route, path: /allowed}}}
                message: {$var: {name: route, path: /code}}
            - $set:
                name: retained
                expr: {$objectSet: {object: {$var: retained}, key: {$var: refKey}, val: {$var: clauseId}}}
            - $set:
                name: channels
                expr: {$listConcat: [{$var: channels}, {$var: {name: route, path: /channels}}]}
    - $return: {references: {$var: retained}, channels: {$var: channels}}
  configuration:
    args: {}
    do:
    - $return:
        $document:
          $concat:
          - /clauseRuntime/work/candidate/
          - $const: clauseKey
          - /parameters
  validateConfiguration:
    args: {}
    do:
    - $let:
        name: p
        expr:
          $call:
            function: configuration
            args: {}
    - $failIf:
        cond:
          $not:
            $isKind:
              val:
                $pointerGet:
                  object:
                    $var: p
                  path: /parties
              kind: object
        message: ACTIVATION_PARTIES_REQUIRED
    - $failIf:
        cond:
          $eq:
          - $size:
              $pointerGet:
                object:
                  $var: p
                path: /parties
                default: {}
          - 0
        message: ACTIVATION_PARTIES_REQUIRED
    - $forEach:
        item: party
        in:
          $pointerGet:
            object:
              $var: p
            path: /parties
            default: {}
        do:
        - $failIf:
            cond:
              $not:
                $call:
                  function: validPartyName
                  args:
                    candidate:
                      $var: role
            message: INVALID_PARTY_NAME
        - $failIf:
            cond:
              $not:
                $exists:
                  $pointerGet:
                    object:
                      $var: party
                    path: /lead/channel
            message: PARTY_LEAD_CHANNEL_REQUIRED
        - $forEach:
            item: rep
            in:
              $pointerGet:
                object:
                  $var: party
                path: /representatives
                default: {}
            do:
            - $failIf:
                cond:
                  $not:
                    $call:
                      function: validPartyName
                      args:
                        candidate:
                          $var: repId
                message: INVALID_REPRESENTATIVE_NAME
            key: repId
        key: role
    - $let:
        name: seenPaths
        expr: []
    - $forEach:
        item: path
        in:
          $pointerGet:
            object:
              $var: p
            path: /negotiation/allowedPaths
            default: []
        do:
        - $failIf:
            cond:
              $not:
                $isKind:
                  val:
                    $var: path
                  kind: text
            message: INVALID_NEGOTIATION_PATH
        - $failIf:
            cond:
              $includes:
                list:
                  $var: seenPaths
                val:
                  $var: path
            message: DUPLICATE_NEGOTIATION_PATH
        - $set:
            name: seenPaths
            expr:
              $listConcat:
              - $var: seenPaths
              - - $var: path
        - $let:
            name: parts
            expr:
              $split:
                text:
                  $var: path
                separator: /
        - $forEach:
            item: segment
            index: segmentIndex
            in:
              $var: parts
            do:
            - $failIf:
                cond:
                  $and:
                  - $gt:
                    - $var: segmentIndex
                    - 0
                  - $eq:
                    - $var: segment
                    - ''
                message: INVALID_NEGOTIATION_PATH
        - $failIf:
            cond:
              $or:
              - $lt:
                - $size:
                    $var: parts
                - 2
              - $ne:
                - $listGet:
                    list:
                      $var: parts
                    index: 0
                - ''
              - $gt:
                - $size:
                    $split:
                      text:
                        $var: path
                      separator: '~'
                - 1
            message: INVALID_NEGOTIATION_PATH
        - $failIf:
            cond:
              $includes:
                list:
                - clauses
                - contracts
                - activation
                - clauseRuntime
                - type
                - name
                - description
                val:
                  $listGet:
                    list:
                      $var: parts
                    index: 1
            message: EXECUTABLE_OR_CONTROL_TERMS_PATH
        - $forEach:
            item: accessPath
            in:
              $pointerGet:
                object:
                  $var: p
                path: /accessPaths
                default: []
            do:
            - $failIf:
                cond:
                  $or:
                  - $eq:
                    - $var: path
                    - $var: accessPath
                  - $startsWith:
                    - $var: path
                    - $concat:
                      - $var: accessPath
                      - /
                message: ACCESS_IS_NOT_COMMERCIAL_TERMS
    - $return:
        allowed: true
        code: ''
  validateTransition:
    args: {}
    do:
    - $if:
        cond:
          $and:
          - $gt:
            - $size:
                $pointerGet:
                  object:
                    $document: /clauses/activation/parameters
                  path: /negotiation/allowedPaths
                  default: []
            - 0
          - $ne:
            - $document: /activation/everActivated
            - true
          - $ne:
            - $document: /clauses
            - $document: /clauseRuntime/work/candidate
        then:
        - $return:
            allowed: false
            code: NEGOTIATION_POLICY_LOCKED
    - $return:
        allowed:
          $eq:
          - $document:
              $concat:
              - /clauses/
              - $const: clauseKey
          - $document:
              $concat:
              - /clauseRuntime/work/candidate/
              - $const: clauseKey
        code: USE_ACTIVATION_PARTY_OPERATIONS
  reviewedApprovalPlan:
    args:
      p: {}
      roster: {}
    do:
    - $let:
        vars:
          configured: {$pointerGet: {object: {$var: p}, path: /reviewedApprovals, default: {}}}
          reviewedContracts: {}
          approvalRoles: {}
          blocked: []
          selectors: []
    - $failIf:
        cond: {$not: {$isKind: {val: {$var: configured}, kind: object}}}
        message: INVALID_REVIEWED_APPROVALS
    - $forEach:
        key: role
        item: review
        in: {$var: configured}
        do:
        - $let:
            vars:
              event: {$var: {name: review, path: /event}}
              basis: {$var: {name: review, path: /basis}}
              source: {$var: {name: review, path: /source}}
              acceptanceBy: {$var: {name: review, path: /acceptanceBy}}
              channel: {$concat: [activation.reviewed.source., {$var: role}]}
        - $failIf:
            cond:
              $not:
                $and:
                - {$hasKey: {object: {$var: roster}, key: {$var: role}}}
                - {$includes: {list: {$pointerGet: {object: {$var: p}, path: /required, default: {$keys: {$var: roster}}}}, val: {$var: role}}}
                - {$isKind: {val: {$var: event}, kind: object}}
                - {$eq: [{$size: {$var: event}}, 3]}
                - {$exists: {$var: {name: event, path: /type}}}
                - {$is: {node: {$var: {name: event, path: /clause}}, pattern: {type: Text, schema: {minLength: 1}}}}
                - {$is: {node: {$var: {name: event, path: /subject}}, pattern: {type: Text, schema: {minLength: 1}}}}
                - {$isKind: {val: {$var: basis}, kind: text}}
                - {$startsWith: [{$var: basis}, /]}
                - {$ne: [{$var: basis}, /]}
                - {$isKind: {val: {$var: source}, kind: text}}
                - {$startsWith: [{$var: source}, /]}
                - {$ne: [{$var: source}, /]}
                - $or:
                  - {$not: {$exists: {$var: acceptanceBy}}}
                  - $and:
                    - {$isKind: {val: {$var: acceptanceBy}, kind: text}}
                    - {$ne: [{$var: acceptanceBy}, {$var: role}]}
                    - {$hasKey: {object: {$var: roster}, key: {$var: acceptanceBy}}}
            message: INVALID_REVIEWED_APPROVAL
        - $failIf:
            cond: {$includes: {list: {$var: selectors}, val: {$var: event}}}
            message: DUPLICATE_REVIEWED_APPROVAL_SOURCE
        - $set: {name: selectors, expr: {$listConcat: [{$var: selectors}, [{$var: event}]]}}
        - $set:
            name: approvalRoles
            expr: {$objectSet: {object: {$var: approvalRoles}, key: {$var: channel}, val: {$var: role}}}
        - $set:
            name: blocked
            expr:
              $listConcat:
              - {$var: blocked}
              - - {$concat: [approve_, {$var: role}]}
                - {$concat: [activate_, {$var: role}]}
                - {$concat: [proposeAndActivate_, {$var: role}]}
        - $set:
            name: reviewedContracts
            expr:
              $objectSet:
                object: {$var: reviewedContracts}
                key: {$var: channel}
                val:
                  kind: channel
                  contract:
                    $merge:
                    - {type: Contracts/Triggered Event Channel}
                    - event: {$var: event}
        - $set:
            name: reviewedContracts
            expr:
              $objectSet:
                object: {$var: reviewedContracts}
                key: {$concat: [activation.reviewed.workflow., {$var: role}]}
                val:
                  kind: handler
                  contract:
                    $merge:
                    - {type: Contracts/Sequential Workflow}
                    - channel: {$var: channel}
                      steps:
                      - type: Contracts/Compute
                        definition: {type: Activation/Activation Functions}
                        constants: {role: {$var: role}, review: {$var: review}}
                        do:
                        - $literal:
                            $call:
                              function: applyReviewedApproval
                              args: {role: {$const: role}, review: {$const: review}}
    - $return:
        contracts: {$var: reviewedContracts}
        channels: {$keys: {$var: approvalRoles}}
        blocked: {$var: blocked}
        approvalRoles:
          $choose:
            cond: {$gt: [{$size: {$var: approvalRoles}}, 0]}
            then: {$var: approvalRoles}
  plan:
    args: {}
    do:
    - $let:
        name: controlChannels
        expr: []
    - $let:
        name: p
        expr:
          $call:
            function: configuration
            args: {}
    - $let:
        name: roster
        expr:
          $pointerGet:
            object:
              $var: p
            path: /parties
            default: {}
    - $let:
        name: contributions
        expr:
          $call:
            function: rosterContracts
            args:
              parameters:
                $var: p
              roster:
                $var: roster
              runtimeDefinition:
                type: Activation/Activation Functions
    - $set:
        name: contributions
        expr:
          $merge:
          - $var: contributions
          - activationInitialized:
              kind: channel
              contract:
                type: Contracts/Triggered Event Channel
                event:
                  type: Clauses/Clauses Initialized
            activationPartyAddition:
              kind: channel
              contract:
                type: Contracts/Triggered Event Channel
                event:
                  type: Activation/Party Addition Requested
            activationPartyAdditionHandler:
              kind: handler
              contract:
                type: Contracts/Sequential Workflow
                channel: activationPartyAddition
                steps:
                - type: Contracts/Compute
                  definition:
                    type: Activation/Activation Functions
                  do:
                  - $literal:
                      $call:
                        function: requestPartyAddition
                        args: {}
                - type: Activation/Refresh Activation
            activationInitializedRefresh:
              kind: handler
              contract:
                type: Contracts/Sequential Workflow
                channel: activationInitialized
                steps:
                - type: Activation/Refresh Activation
    - $let:
        name: reviewed
        expr: {$call: {function: reviewedApprovalPlan, args: {p: {$var: p}, roster: {$var: roster}}}}
    - $set:
        name: contributions
        expr: {$merge: [{$var: contributions}, {$var: {name: reviewed, path: /contracts}}]}
    - $forEach:
        item: contribution
        in:
          $var: contributions
        do:
        - $if:
            cond:
              $and:
              - $eq:
                - $pointerGet:
                    object:
                      $var: contribution
                    path: /kind
                - channel
              - $exists:
                  $document:
                    $concat:
                    - /contracts/
                    - $var: key
              - $not:
                  $hasKey:
                    object:
                      $document: /clauseRuntime/contracts
                    key:
                      $var: key
            then:
            - $failIf:
                cond:
                  $ne:
                  - $document:
                      $concat:
                      - /contracts/
                      - $var: key
                  - $pointerGet:
                      object:
                        $var: contribution
                      path: /contract
                message: ACTIVATION_CHANNEL_CONFLICT
            - $set:
                name: contributions
                expr:
                  $pointerSet:
                    object:
                      $var: contributions
                    path:
                      $concat:
                      - /
                      - $var: key
                    op: remove
        key: key
    - $let:
        name: paths
        expr:
          $pointerGet:
            object:
              $var: p
            path: /accessPaths
            default: []
    - $set:
        name: contributions
        expr:
          $objectSet:
            object:
              $var: contributions
            key: embedded
            val:
              kind: embedding
              contract:
                $merge:
                - type: Contracts/Process Embedded
                - paths:
                    $var: paths
                  collectionPaths:
                  - /partyAccess
    - $let:
        name: index
        expr: 0
    - $forEach:
        item: path
        in:
          $var: paths
        do:
        - $let:
            name: key
            expr:
              $concat:
              - activationAccess
              - $text:
                  $var: index
        - $set:
            name: controlChannels
            expr:
              $listConcat:
              - $var: controlChannels
              - - $var: key
        - $set:
            name: contributions
            expr:
              $objectSet:
                object:
                  $var: contributions
                key:
                  $var: key
                val:
                  kind: channel
                  contract:
                    $merge:
                    - type: Contracts/Embedded Node Channel
                    - sourcePath:
                        $var: path
                      event:
                        type: Coordination/Timeline Access Updated
        - $set:
            name: contributions
            expr:
              $objectSet:
                object:
                  $var: contributions
                key:
                  $concat:
                  - $var: key
                  - Changed
                val:
                  kind: handler
                  contract:
                    $merge:
                    - type: Contracts/Sequential Workflow
                    - channel:
                        $var: key
                      steps:
                      - type: Activation/Refresh Activation
        - $set:
            name: index
            expr:
              $add:
              - $var: index
              - 1
    - $let:
        name: preOperations
        expr:
          $pointerGet:
            object:
              $var: p
            path: /preActivationOperations
            default: []
    - $forEach:
        item: party
        key: role
        in:
          $var: roster
        do:
        - $set:
            name: preOperations
            expr:
              $listConcat:
              - $var: preOperations
              - - $concat:
                  - approve_
                  - $var: role
                - $concat:
                  - updateParty_
                  - $var: role
    - $if:
        cond:
          $gt:
          - $size:
              $pointerGet:
                object:
                  $var: p
                path: /negotiation/allowedPaths
                default: []
          - 0
        then:
        - $let:
            name: negotiators
            expr:
              $pointerGet:
                object:
                  $var: p
                path: /required
                default:
                  $keys:
                    $var: roster
        - $failIf:
            cond:
              $eq:
              - $size:
                  $var: negotiators
              - 0
            message: NEGOTIATION_REQUIRES_APPROVERS
        - $failIf:
            cond:
              $not:
                $exists:
                  $document: /type
            message: NEGOTIATION_TARGET_TYPE_REQUIRED
        - $let:
            name: matcher
            expr:
              $literal:
                args:
                  candidate: {}
                do:
                - $return:
                    $is:
                      node:
                        $var: candidate
                      pattern: {}
        - $set:
            name: matcher
            expr:
              $pointerSet:
                object:
                  $var: matcher
                path: /do/0/$return/$is/pattern
                op: set
                val:
                  $objectSet:
                    object: {}
                    key: type
                    val:
                      $document: /type
        - $let:
            name: library
            expr:
              $pointerGet:
                object:
                  $document:
                    $concat:
                    - /clauseRuntime/work/candidate/
                    - $const: clauseKey
                path: /negotiationDefinition/functions
        - $failIf:
            cond:
              $not:
                $hasKey:
                  object:
                    $var: library
                  key: proposeChanges
            message: NEGOTIATION_FUNCTION_LIBRARY_REQUIRED
        - $let:
            name: definition
            expr:
              type: Contracts/Compute Definition
              functions:
                $objectSet:
                  object:
                    $var: library
                  key: validTermsCandidate
                  val:
                    $var: matcher
        - $set:
            name: contributions
            expr:
              $objectSet:
                object:
                  $var: contributions
                key: activationNegotiationDefinition
                val:
                  kind: definition
                  contract:
                    $var: definition
        - $forEach:
            item: role
            in:
              $var: negotiators
            do:
            - $forEach:
                item: operation
                in:
                - proposeChanges
                - proposeAndActivate
                - activate
                - withdrawProposal
                - rejectProposal
                - withdrawAcceptance
                do:
                - $let:
                    name: operationName
                    expr:
                      $concat:
                      - $var: operation
                      - _
                      - $var: role
                - $set:
                    name: preOperations
                    expr:
                      $listConcat:
                      - $var: preOperations
                      - - $var: operationName
                - $let:
                    name: step
                    expr:
                      type: Contracts/Compute
                - $set:
                    name: step
                    expr:
                      $merge:
                      - $var: step
                      - definition: /contracts/activationNegotiationDefinition
                        constants:
                          clauseKey: activationNegotiation
                          activationApprovalRole:
                            $choose:
                              cond: {$includes: {list: [proposeAndActivate, activate], val: {$var: operation}}}
                              then: {$var: role}
                          fieldPaths:
                            $pointerGet:
                              object:
                                $var: p
                              path: /negotiation/allowedPaths
                              default: []
                          parameters:
                            approvers:
                              $var: negotiators
                            paths:
                            - /activation/terms/fields
                          bindings:
                            state: /activation/negotiation
                            editable: /activation/negotiation/editable
                        do:
                        - $pointerSet:
                            object:
                              $literal:
                                $call:
                                  function: ''
                                  args:
                                    input:
                                      $binding: call/request
                            path: /$call/function
                            op: set
                            val:
                              $concat:
                              - $var: operation
                              - Public
                - $let:
                    name: operationContract
                    expr:
                      type: Contracts/Sequential Workflow Operation
                - $set:
                    name: operationContract
                    expr:
                      $merge:
                      - $var: operationContract
                      - channel:
                          $var: role
                        steps:
                        - $var: step
                      - $get:
                          object:
                            $literal:
                              proposeChanges:
                                $blue:requestFrom:
                                  definition:
                                    type: Activation/Negotiation Functions
                                  function: proposeChangesPublic
                                  argument: input
                              proposeAndActivate:
                                $blue:requestFrom:
                                  definition:
                                    type: Activation/Negotiation Functions
                                  function: proposeAndActivatePublic
                                  argument: input
                              activate:
                                $blue:requestFrom:
                                  definition:
                                    type: Activation/Negotiation Functions
                                  function: activatePublic
                                  argument: input
                              withdrawProposal:
                                $blue:requestFrom:
                                  definition:
                                    type: Activation/Negotiation Functions
                                  function: withdrawProposalPublic
                                  argument: input
                              rejectProposal:
                                $blue:requestFrom:
                                  definition:
                                    type: Activation/Negotiation Functions
                                  function: rejectProposalPublic
                                  argument: input
                              withdrawAcceptance:
                                $blue:requestFrom:
                                  definition:
                                    type: Activation/Negotiation Functions
                                  function: withdrawAcceptancePublic
                                  argument: input
                          key:
                            $var: operation
                - $set:
                    name: contributions
                    expr:
                      $objectSet:
                        object:
                          $var: contributions
                        key:
                          $var: operationName
                        val:
                          kind: handler
                          contract:
                            $var: operationContract
    - $let:
        name: connections
        expr:
          $call:
            function: preActivationConnectionPlan
            args:
              p: {$var: p}
    - $let:
        name: policy
        expr:
          type: Dispatch/Document Dispatch Policy
          definition:
            type: Parties/Party Access Functions
    - $set:
        name: policy
        expr:
          $merge:
          - $var: policy
          - constants:
              controlChannels:
                $var: controlChannels
              preOperations:
                $var: preOperations
              reviewedOperations: {$var: {name: reviewed, path: /blocked}}
              reviewedApprovalRoles: {$var: {name: reviewed, path: /approvalRoles}}
              preConnectionRefs: {$var: {name: connections, path: /references}}
              preChannels:
                $listConcat:
                - {$pointerGet: {object: {$var: p}, path: /preActivationChannels, default: []}}
                - {$var: {name: connections, path: /channels}}
                - {$var: {name: reviewed, path: /channels}}
            do:
              $literal:
              - $if:
                  cond:
                    $or:
                    - $and:
                      - $eq:
                        - $binding: dispatch/kind
                        - TRIGGERED
                      - $includes:
                          list:
                          - activationInitialized
                          val:
                            $binding: dispatch/channel
                    - $and:
                      - $eq:
                        - $binding: dispatch/kind
                        - EMBEDDED
                      - $includes:
                          list:
                            $listConcat:
                            - $const: controlChannels
                            - $pointerGet:
                                object:
                                  $document: /activation
                                path: /registeredAccessChannels
                                default: []
                          val:
                            $binding: dispatch/channel
                  then:
                  - $return:
                      allowed: true
              - $if:
                  cond:
                    $not:
                      $exists:
                        $document: /activation
                  then:
                  - $return:
                      allowed: false
                      reason: ACTIVATION_NOT_INITIALIZED
              - $let:
                  name: s
                  expr:
                    $document: /activation
              - $if:
                  cond:
                    $ne:
                    - $pointerGet:
                        object:
                          $var: s
                        path: /accessReady
                        default: false
                    - true
                  then:
                  - $return:
                      allowed: false
                      reason: DOCUMENT_ACCESS_UNAVAILABLE
              - $if:
                  cond:
                    $not:
                      $call:
                        function: accessValid
                        args:
                          roster:
                            $pointerGet:
                              object:
                                $var: s
                              path: /parties
                              default: {}
                          readers:
                            $pointerGet:
                              object:
                                $var: s
                              path: /readers
                              default: {}
                          accessPaths:
                            $pointerGet:
                              object:
                                $var: s
                              path: /accessPaths
                              default: []
                  then:
                  - $return:
                      allowed: false
                      reason: DOCUMENT_ACCESS_UNAVAILABLE
              - $if:
                  cond:
                    $eq:
                    - $pointerGet:
                        object:
                          $var: s
                        path: /closed
                        default: false
                    - true
                  then:
                  - $return:
                      allowed: false
                      reason: DOCUMENT_CLOSED
              - $if:
                  cond:
                    $and:
                    - {$eq: [{$binding: dispatch/kind}, EXTERNAL]}
                    - {$exists: {$binding: dispatch/operation}}
                    - {$eq: [{$kind: {$binding: dispatch/operation}}, text]}
                  then:
                  - $let:
                      name: consentRegistration
                      expr:
                        $get:
                          object: {$pointerGet: {object: {$var: s}, path: /admissionConsentOperations, default: {}}}
                          key: {$binding: dispatch/operation}
                  - $if:
                      cond: {$exists: {$var: consentRegistration}}
                      then:
                      - $let:
                          name: consentItem
                          expr: {$document: {$pointerGet: {object: {$var: consentRegistration}, path: /itemPath}}}
                      - $let:
                          name: consentParty
                          expr:
                            $get:
                              object: {$pointerGet: {object: {$var: consentItem}, path: /admissionToken/parties, default: {}}}
                              key: {$pointerGet: {object: {$var: consentRegistration}, path: /party}}
                      - $if:
                          cond:
                            $and:
                            - {$exists: {$var: consentItem}}
                            - {$exists: {$var: consentParty}}
                            - {$eq: [{$pointerGet: {object: {$var: consentItem}, path: /status}}, admission_pending]}
                            - {$eq: [{$pointerGet: {object: {$var: consentRegistration}, path: /admissionRef}}, {$pointerGet: {object: {$var: consentItem}, path: /admissionRef}}]}
                            - {$eq: [{$pointerGet: {object: {$var: consentRegistration}, path: /admissionRef}}, {$nodeBlueId: {$pointerGet: {object: {$var: consentItem}, path: /admissionToken}}}]}
                            - {$eq: [{$pointerGet: {object: {$var: consentRegistration}, path: /activationRevision}}, {$pointerGet: {object: {$var: s}, path: /revision}}]}
                            - {$eq: [{$pointerGet: {object: {$var: consentRegistration}, path: /activationRevision}}, {$pointerGet: {object: {$var: consentItem}, path: /admissionToken/activationRevision}}]}
                            - {$eq: [{$pointerGet: {object: {$var: consentRegistration}, path: /channel}}, {$binding: dispatch/channel}]}
                            - {$exists: {$document: {$concat: [/contracts/, {$binding: dispatch/operation}]}}}
                            - {$exists: {$document: {$concat: [/contracts/, {$binding: dispatch/channel}]}}}
                            - {$eq: [{$pointerGet: {object: {$var: consentRegistration}, path: /operationId}}, {$nodeBlueId: {$document: {$concat: [/contracts/, {$binding: dispatch/operation}]}}}]}
                            - {$eq: [{$pointerGet: {object: {$var: consentRegistration}, path: /channelId}}, {$nodeBlueId: {$document: {$concat: [/contracts/, {$binding: dispatch/channel}]}}}]}
                            - {$eq: [{$pointerGet: {object: {$var: consentRegistration}, path: /channelId}}, {$nodeBlueId: {$pointerGet: {object: {$var: consentParty}, path: /lead/channel}}}]}
                          then:
                          - $return: {allowed: true}
              - $if:
                  cond:
                    $and:
                    - {$eq: [{$binding: dispatch/kind}, EXTERNAL]}
                    - {$includes: {list: {$const: reviewedOperations}, val: {$binding: dispatch/operation}}}
                  then:
                  - $return: {allowed: false, reason: REVIEWED_APPROVAL_REQUIRED}
              - $if:
                  cond:
                    $or:
                    - $and:
                      - $eq:
                        - $binding: dispatch/kind
                        - EXTERNAL
                      - $includes:
                          list:
                            $const: preOperations
                          val:
                            $binding: dispatch/operation
                    - $and:
                      - $ne:
                        - $binding: dispatch/kind
                        - EXTERNAL
                      - $includes:
                          list:
                            $const: preChannels
                          val:
                            $binding: dispatch/channel
                  then:
                  - $return:
                      allowed: true
              - $return:
                  allowed:
                    $call:
                      function: businessReady
                      args: {}
                  reason: DOCUMENT_NOT_ACTIVE
    - $set:
        name: contributions
        expr:
          $objectSet:
            object:
              $var: contributions
            key: activationDispatch
            val:
              kind: policy
              contract:
                $var: policy
    - $let:
        name: initial
        expr:
          $call:
            function: computeState
            args:
              state:
                parties:
                  $var: roster
                readers:
                  $pointerGet:
                    object:
                      $var: p
                    path: /readers
                    default: {}
                accessPaths:
                  $var: paths
                required:
                  $pointerGet:
                    object:
                      $var: p
                    path: /required
                    default:
                      $keys:
                        $var: roster
                approved: {}
                accessRequests: {}
                revision:
                  $pointerGet:
                    object:
                      $var: p
                    path: /revision
                    default: 1
                frozen:
                  $or:
                  - $pointerGet:
                      object:
                        $var: p
                      path: /frozen
                      default: false
                  - $eq:
                    - $document: /partyRosterFrozen
                    - true
                allowNewParties:
                  $pointerGet:
                    object:
                      $var: p
                    path: /allowNewParties
                    default: false
    - $return:
        contracts:
          $var: contributions
        states:
          partyAccess:
            path: /partyAccess
            kind: object
            initial: {}
          activation:
            path: /activation
            kind: object
            initial:
              $var: initial
        reads: []
