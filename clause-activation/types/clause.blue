name: Activation Clause
type: Connections/Connected Clause
bindingTypes:
  state: pointer
actionDefinition:
  type: Activation/Activation Functions
actions:
  initialize:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: initialize
            args:
              input:
                $var: params
    automatic:
      'on': initialized
      once: true
  approve:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: approve
            args:
              input:
                $var: params
defaultBindings:
  state: /activation
