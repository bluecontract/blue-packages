name: Schedule Functions
type: Contracts/Compute Definition
functions:
  fire:
    args:
      input: {}
    do:
    - $appendEvent:
        $merge:
        - type: Commerce/Domain Event
        - kind: Schedule Fired
          clause:
            $const: clauseKey
          scheduleKey:
            $const:
              name: parameters
              path: /key
          at:
            $binding: timestamp
    - $return:
        outcome: acceptedNew
