{
  "description": "Optional generation-specific batch feed using an ordinary public timeline.",
  "generation": {
    "schema": {
      "minimum": 1,
      "required": true
    },
    "type": "Integer"
  },
  "name": "Timeline Update Stream",
  "provider": {
    "schema": {
      "required": true
    },
    "type": "Coordination/Timeline Provider"
  },
  "timeline": {
    "schema": {
      "required": true
    },
    "type": "Coordination/Signed Timeline"
  }
}
