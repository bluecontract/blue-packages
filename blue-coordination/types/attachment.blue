{
  "activationEntry": {
    "description": "Optional Coordination/Timeline Entry; validate exact type ancestry when supplied."
  },
  "activationInitialization": {},
  "description": "An exact consumer attachment lifetime, including frozen activation and source-history obligations. Removal does not discharge earlier frozen goals.",
  "generation": {
    "schema": {
      "minimum": 1,
      "required": true
    },
    "type": "Integer"
  },
  "name": "Attachment",
  "path": {
    "schema": {
      "minLength": 1,
      "required": true
    },
    "type": "Text"
  },
  "source": {
    "description": "Required exact content operand. Presence is checked by the protocol verifier; the addressed document may be an unvalued definition or a program with no business fields."
  },
  "sourcePosition": {
    "schema": {
      "required": true
    },
    "type": "Coordination/History Position"
  },
  "timeline": {
    "description": "Exact Timeline selected at attachment; required when the source has a Timeline."
  },
  "goal": {
    "description": "Exact finite History Position selected for this occurrence, never a moving latest-state pointer."
  }
}
