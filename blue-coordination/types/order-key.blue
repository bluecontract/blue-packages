{
  "description": "Canonical order across timelines; identifiers compare as ASCII bytes.",
  "entry": {
    "schema": {
      "required": true
    },
    "type": "Coordination/Timeline Entry"
  },
  "name": "Order Key",
  "timeline": {
    "schema": {
      "required": true
    },
    "type": "Coordination/Signed Timeline"
  },
  "timestamp": {
    "schema": {
      "maximum": 9007199254740990,
      "minimum": 0,
      "required": true
    },
    "type": "Integer"
  }
}
