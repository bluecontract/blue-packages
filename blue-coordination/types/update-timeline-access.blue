{"channel":"provider","description":"Provider-channel operation validating and atomically replacing both access sets, then emitting one Timeline Access Updated event, including unchanged-list updates. Invalid or rolled-back updates emit no committed event; consumed requests do not execute again. Distinct requests have distinct occurrences. The event is a notification; verified history and executed state remain the authority.","name":"Update Timeline Access","request":{"type":"Coordination/Timeline Access Update"},"specification":{"blueId":"nd2NG7qLpN8VrpSi8PByjcywdfeSmqQmXx5g6S2jPiX"},"steps":[{"do":[{"$failIf":{"cond":{"$some":{"in":{"$binding":"call/request/allowedTimelines"},"item":"candidate","where":{"$ne":[{"$pointerGet":{"object":{"$var":"candidate"},"path":"/provider"}},{"$document":"/contracts/provider/provider"}]}}},"message":"FOREIGN_TIMELINE"}},{"$failIf":{"cond":{"$some":{"in":{"$binding":"call/request/allowedTimelines"},"item":"candidate","where":{"$gt":[{"$size":{"$filter":{"in":{"$binding":"call/request/allowedTimelines"},"item":"other","where":{"$eq":[{"$var":"candidate"},{"$var":"other"}]}}}},1]}}},"message":"DUPLICATE_ACCESS_VALUE"}},{"$failIf":{"cond":{"$some":{"in":{"$binding":"call/request/allowedKeys"},"item":"candidate","where":{"$gt":[{"$size":{"$filter":{"in":{"$binding":"call/request/allowedKeys"},"item":"other","where":{"$eq":[{"$var":"candidate"},{"$var":"other"}]}}}},1]}}},"message":"DUPLICATE_ACCESS_VALUE"}}],"type":"Contracts/Compute"},{"changeset":[{"op":"replace","path":"/allowedTimelines","val":{"$binding":"call/request/allowedTimelines"}},{"op":"replace","path":"/allowedKeys","val":{"$binding":"call/request/allowedKeys"}}],"type":"Contracts/Update Document"},{"event":{"type":"Coordination/Timeline Access Updated"},"type":"Contracts/Trigger Event"}],"type":"Contracts/Sequential Workflow Operation"}
