{
  "code": {
    "schema": {
      "minLength": 1,
      "required": true
    },
    "type": "Text"
  },
  "description": "Typed error; never a proof of absent entries or revoked access.",
  "detail": {
    "description": "Text safe diagnostic. Optional; presence and exact type are checked by the protocol verifier."
  },
  "name": "Provider Failure",
  "retryable": {
    "schema": {
      "required": true
    },
    "type": "Boolean"
  },
  "type": "Coordination/Provider Response"
}
