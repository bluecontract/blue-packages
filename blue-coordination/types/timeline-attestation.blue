{
  "description": "Signature of the exact guarantee under the dedicated guarantee domain.",
  "guarantee": {
    "schema": {
      "required": true
    },
    "type": "Coordination/Timeline Completeness Guarantee"
  },
  "name": "Timeline Attestation",
  "signature": {
    "schema": {
      "required": true
    },
    "type": "Coordination/Ed25519 Signature"
  },
  "timeline": {
    "schema": {
      "required": true
    },
    "type": "Coordination/Signed Timeline"
  }
}
