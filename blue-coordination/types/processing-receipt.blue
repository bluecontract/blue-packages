{
  "after": {
    "description": "Required exact content operand. Presence is checked by the protocol verifier; the addressed document may be an unvalued definition or a program with no business fields."
  },
  "attachment": {},
  "before": {
    "description": "Required exact content operand. Presence is checked by the protocol verifier; the addressed document may be an unvalued definition or a program with no business fields."
  },
  "description": "Canonical completed computation claim, distinct from variable proof material or host commit. kind determines required cause fields under the specification. Source applications never re-execute the source operation.",
  "documentId": {
    "description": "Required exact content operand. Presence is checked by the protocol verifier; the addressed document may be an unvalued definition or a program with no business fields."
  },
  "emitted": {
    "itemType": "Coordination/Emitted Occurrence",
    "schema": {
      "required": true
    },
    "type": "List"
  },
  "event": {
    "description": "Optional Coordination/Timeline Entry; validate exact type ancestry when supplied."
  },
  "eventTimestamp": {
    "schema": {
      "maximum": 9007199254740990,
      "minimum": 0
    },
    "type": "Integer"
  },
  "gas": {
    "schema": {
      "minimum": 0,
      "required": true
    },
    "type": "Integer"
  },
  "kind": {
    "schema": {
      "enum": [
        "INITIALIZE",
        "PROCESS",
        "APPLY"
      ],
      "required": true
    },
    "type": "Text"
  },
  "members": {
    "itemType": "Coordination/Member Result",
    "schema": {
      "required": true
    },
    "type": "List"
  },
  "name": "Processing Receipt",
  "sourceReceipts": {
    "type": "List"
  },
  "runtimeReceipt": {
    "type": "Text",
    "description": "Required original Contracts receipt commitment; never a recomputed business-state digest.",
    "schema": {
      "required": true,
      "minLength": 1
    }
  }
}
