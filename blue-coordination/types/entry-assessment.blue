{
  "channel": {
    "schema": {
      "minLength": 1,
      "required": true
    },
    "type": "Text"
  },
  "channelGeneration": {
    "schema": {
      "minimum": 1,
      "required": true
    },
    "type": "Integer"
  },
  "description": "Feeder outcome for one exact entry and receiving channel/lifetime. It is evidence to verify, not a user-authored permission token.",
  "disposition": {
    "schema": {
      "enum": [
        "ELIGIBLE",
        "INAPPLICABLE",
        "DENIED"
      ],
      "required": true
    },
    "type": "Text"
  },
  "document": {
    "description": "Required exact content operand. Presence is checked by the protocol verifier; the addressed document may be an unvalued definition or a program with no business fields."
  },
  "entry": {
    "schema": {
      "required": true
    },
    "type": "Coordination/Timeline Entry"
  },
  "name": "Entry Assessment",
  "reason": {
    "schema": {
      "required": true
    },
    "type": "Text"
  },
  "authorityPositions": {
    "type": "List",
    "itemType": "Coordination/History Position"
  },
  "dispatchDecisions": {
    "type": "List",
    "description": "Ordered original Contracts decisions. A valid denial uses DISPATCH_REJECTED as disposition reason; authored reasons remain in these details."
  }
}
