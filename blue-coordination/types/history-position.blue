{
  "description": "One append-only processing or receiving-history position. position increments for retained transitions; epoch counts completed stable revisions. A catch-up position may retain the prior stable epoch.",
  "document": {
    "description": "Required exact content operand. Presence is checked by the protocol verifier; the addressed document may be an unvalued definition or a program with no business fields."
  },
  "documentId": {
    "description": "Required exact content operand. Presence is checked by the protocol verifier; the addressed document may be an unvalued definition or a program with no business fields."
  },
  "effectiveEntry": {
    "description": "Optional Coordination/Timeline Entry; validate exact type ancestry when supplied."
  },
  "epoch": {
    "schema": {
      "minimum": 0,
      "required": true
    },
    "type": "Integer"
  },
  "name": "History Position",
  "position": {
    "schema": {
      "minimum": 0,
      "required": true
    },
    "type": "Integer"
  },
  "previous": {},
  "processing": {
    "schema": {
      "required": true
    },
    "type": "Coordination/Processing Receipt"
  },
  "stable": {
    "schema": {
      "required": true
    },
    "type": "Boolean"
  }
}
