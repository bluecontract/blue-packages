{
  "description": "A stable document revision. Its history position is exact; epoch alone is not enough to select a history.",
  "document": {
    "description": "Required exact content operand. Presence is checked by the protocol verifier; the addressed document may be an unvalued definition or a program with no business fields."
  },
  "documentId": {
    "description": "Required exact content operand. Presence is checked by the protocol verifier; the addressed document may be an unvalued definition or a program with no business fields."
  },
  "epoch": {
    "schema": {
      "minimum": 0,
      "required": true
    },
    "type": "Integer"
  },
  "name": "Document Epoch",
  "position": {
    "schema": {
      "required": true
    },
    "type": "Coordination/History Position"
  },
  "previous": {}
}
