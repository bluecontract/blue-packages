{
  "description": "Read stream assignment for one timeline and timestamp.",
  "name": "Get Stream Binding Request",
  "timeline": {
    "schema": {
      "required": true
    },
    "type": "Coordination/Signed Timeline"
  },
  "timestamp": {
    "schema": {
      "maximum": 9007199254740990,
      "minimum": 0,
      "required": true
    },
    "type": "Integer"
  },
  "type": "Coordination/Provider Request"
}
