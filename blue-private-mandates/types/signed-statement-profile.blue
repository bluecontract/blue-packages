{
  "description": "Evidence profile under which the evidence for an operation is a statement signed by the document processor of the represented party. The receipt of a Proof Entry carries the statement and its Ed25519 signature in one fixed layout. The profile names the key the statement is verified with and the key of the mandate processor whose attestations the participant accepts, and nothing else.",
  "name": "Signed Statement Profile",
  "statementSignerKey": {
    "description": "Public key under which statements for this channel are verified: 64 characters 0-9a-f that encode, canonically, a point of edwards25519 that is not of small order. The schema fixes the length; the processor checks the rest.",
    "schema": {
      "required": true
    },
    "type": "Coordination/Ed25519 Public Key"
  },
  "mandateProcessorKey": {
    "description": "Public key whose signature on a Mandate State Attestation this participant accepts, in force in the document strictly before the operation: 64 characters 0-9a-f that encode, canonically, a point of edwards25519 that is not of small order. The schema fixes the length; the processor checks the rest.",
    "schema": {
      "required": true
    },
    "type": "Coordination/Ed25519 Public Key"
  },
  "specification": {
    "blueId": "6ydZG9j6ENCw82coeu3UeWsJsirZULCbbeKjnT4RZRdF"
  },
  "type": "CoordinationEvidence/Evidence Profile",
  "schema": {
    "maxFields": 2
  }
}
