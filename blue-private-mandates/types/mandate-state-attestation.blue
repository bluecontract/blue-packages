{
  "name": "Mandate State Attestation",
  "description": "Statement of a mandate processor about one state of a mandate, for the signer of statements under Private Mandates. The mandate processor signs the BlueId of this document: Ed25519 over UTF8(\"blue.private-mandates.mandate-state-attestation\\n\" + BlueId). The signature is outside the signed content. No verifying processor reads it: it is used by the signer and by a later inquiry. The field set is closed and is checked by whoever uses it. A mandate, a state, a listed document and a last entry are named by their final ids, plain or member ids; a timeline, a timer source, a timer entry, the preceding attestation and the package are plain ids.",
  "specification": {
    "blueId": "7wJyXWUoMaspNhHjHLm2LcKmbJmtNS6KDTPwpXXbEhF6"
  },
  "mandate": {
    "description": "Reference to the mandate before initialization, by its final id: a plain id, or a member id when the mandate is a member of a cyclic set.",
    "schema": {
      "required": true
    }
  },
  "state": {
    "description": "Reference to the attested mandate state S, the root document of the processor's snapshot, by its final id (plain or member id).",
    "schema": {
      "required": true
    }
  },
  "documents": {
    "description": "References to the further documents of the snapshot (embedded documents), by their final ids (plain or member ids), strictly ascending when the id texts are compared as ASCII byte strings; absent when there is none.",
    "type": "List",
    "schema": {
      "uniqueItems": true
    }
  },
  "authorityPackage": {
    "description": "BlueId of the Mandates package the mandate is established under, as text: a plain id, the base58 text of 32 bytes (32 to 44 characters).",
    "type": "Text",
    "schema": {
      "required": true,
      "minLength": 32,
      "maxLength": 44
    }
  },
  "position": {
    "description": "The history position: one row per timeline the state depends on, at least one, strictly ascending when the BlueId texts of the timelines are compared as ASCII byte strings. A row has the field timeline (reference to the Signed Timeline) and, unless no entry of that timeline is included, lastEntry (reference to the last included Timeline Entry, by its final id, plain or member id). Rows have no other field and no type.",
    "type": "List",
    "schema": {
      "required": true,
      "minItems": 1
    }
  },
  "lastTimerFiring": {
    "description": "Order key of the latest timer firing already applied in the state: timestamp, Timer Source id, Timer Entry id; absent when none has been applied.",
    "timestamp": {
      "description": "Timestamp of the Timer Entry.",
      "type": "Integer",
      "schema": {
        "required": true,
        "minimum": 0
      }
    },
    "source": {
      "description": "BlueId of the Timer Source, as text: a plain id.",
      "type": "Text",
      "schema": {
        "required": true,
        "minLength": 32,
        "maxLength": 44
      }
    },
    "entry": {
      "description": "BlueId of the Timer Entry, as text: a plain id.",
      "type": "Text",
      "schema": {
        "required": true,
        "minLength": 32,
        "maxLength": 44
      }
    }
  },
  "nextTimerFiring": {
    "description": "Order key of the earliest pending timer firing: timestamp, Timer Source id, Timer Entry id; absent when none is pending.",
    "timestamp": {
      "description": "Timestamp of the Timer Entry.",
      "type": "Integer",
      "schema": {
        "required": true,
        "minimum": 0
      }
    },
    "source": {
      "description": "BlueId of the Timer Source, as text: a plain id.",
      "type": "Text",
      "schema": {
        "required": true,
        "minLength": 32,
        "maxLength": 44
      }
    },
    "entry": {
      "description": "BlueId of the Timer Entry, as text: a plain id.",
      "type": "Text",
      "schema": {
        "required": true,
        "minLength": 32,
        "maxLength": 44
      }
    }
  },
  "sequence": {
    "description": "Number of this attestation in the mandate processor's chain of attestations for this mandate: 0 for the first, then the sequence of the previous attestation plus one.",
    "type": "Integer",
    "schema": {
      "required": true,
      "minimum": 0
    }
  },
  "previous": {
    "description": "Reference to the mandate processor's preceding attestation for this mandate, by its plain id; absent exactly in the first attestation (sequence 0)."
  }
}
