{
  "description": "Participant channel that also names its evidence timeline and the two Ed25519 keys under which statements and mandate state attestations for operations with a Mandate Commitment Authority on this channel are verified. The fields are read from the target state before the operation. The processor checks that they are well formed; an operation with a Mandate Commitment Authority on a channel whose fields are not well formed is rejected. A host that does not implement this exact protocol refuses a document that holds this channel.",
  "evidenceTimeline": {
    "description": "Evidence timeline of this channel: by ancestry a Signed Timeline, at the provider of the channel's timeline (the two provider BlueIds are equal). As the evidence timeline it is not an input source of the document. The processor checks both.",
    "schema": {
      "required": true
    },
    "type": "Coordination/Signed Timeline"
  },
  "mandateProcessorKey": {
    "description": "Public key whose signature on a Mandate State Attestation this participant accepts: 64 characters 0-9a-f that encode, canonically, a point of edwards25519 that is not of small order. The schema fixes the length; the processor checks the rest.",
    "schema": {
      "required": true
    },
    "type": "Coordination/Ed25519 Public Key"
  },
  "name": "Timeline Channel with Evidence",
  "specification": {
    "blueId": "GPnibLpDVQ42R8a5FiMVs4WsYuECxCpJn9keSiU5fyYb"
  },
  "statementSignerKey": {
    "description": "Public key under which statements for this channel are verified: 64 characters 0-9a-f that encode, canonically, a point of edwards25519 that is not of small order. The schema fixes the length; the processor checks the rest.",
    "schema": {
      "required": true
    },
    "type": "Coordination/Ed25519 Public Key"
  },
  "type": "Coordination/Timeline Channel"
}
