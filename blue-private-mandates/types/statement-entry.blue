{
  "description": "Message of a Timeline Entry on an evidence timeline that carries one statement and its Ed25519 signature. The schema is open: the processor checks that statement is the only field and is well formed, and skips an entry that is not.",
  "name": "Statement Entry",
  "specification": {
    "blueId": "GPnibLpDVQ42R8a5FiMVs4WsYuECxCpJn9keSiU5fyYb"
  },
  "statement": {
    "description": "The statement followed by its 64-byte signature, as canonical base64 text: RFC 4648 standard alphabet with padding, zero pad bits and no other characters. Decided on content: a value that is not a Text is not well formed, whether written in full or as a reference. Checked by the processor, not by this schema."
  }
}
