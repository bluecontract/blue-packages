{
  "description": "Entry-level authority claim that carries a salted commitment to the Mandate before initialization instead of a reference to it. The inherited actor is the represented holder. It has no other field; the processor checks the exact field set. An operation with this exact claim type is decided from the evidence timeline of its target channel, a Timeline Channel with Evidence.",
  "mandateCommitment": {
    "description": "Salted mandate commitment: 64 characters 0-9a-f encoding the 32 bytes SHA-256(salt || final id of the Mandate before initialization), the salt being 32 bytes. The schema fixes the length; the processor checks the characters.",
    "schema": {
      "maxLength": 64,
      "minLength": 64,
      "required": true
    },
    "type": "Text"
  },
  "name": "Mandate Commitment Authority",
  "specification": {
    "blueId": "KSLxgCzJ2qfw4JsUbSFuaJ1AzRe4bpCtKkkQREkk5Zf"
  },
  "type": "Mandates/Authority",
  "schema": {
    "maxFields": 2
  }
}
