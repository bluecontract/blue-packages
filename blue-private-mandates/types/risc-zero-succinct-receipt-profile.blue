{
  "description": "Proof profile whose evidence is a succinct RISC Zero receipt of one pinned proving program. The type fixes the receipt kind, the verifier, the comparison rules and the facts algorithm.",
  "factsRule": {
    "description": "Definition of the validation facts about the target state that a proof may reuse.",
    "schema": {
      "enum": [
        "FULL(D)"
      ],
      "required": true
    },
    "type": "Text"
  },
  "name": "RISC Zero Succinct Receipt Profile",
  "programImageId": {
    "description": "Image identifier of the proving program: canonical lowercase hex encoding of 32 bytes.",
    "schema": {
      "maxLength": 64,
      "minLength": 64,
      "required": true
    },
    "type": "Text"
  },
  "providerSetDigest": {
    "description": "Digest of the profile's allowed timeline provider set as the proving program publishes it: canonical lowercase hex encoding of 32 bytes.",
    "schema": {
      "maxLength": 64,
      "minLength": 64,
      "required": true
    },
    "type": "Text"
  },
  "specification": {
    "blueId": "7yF8gqaWAcRW9JiYdKpFF2DS7FCVzkmvLEqLocNwUxqr"
  },
  "type": "PrivateMandates/Evidence Profile"
}
