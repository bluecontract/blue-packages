{
  "description": "Proof profile whose evidence is a succinct RISC Zero receipt of one pinned proving program. The type fixes the receipt kind, the verifier, the comparison rules, the provider set digest function and the facts algorithm.",
  "factsRule": {
    "description": "Definition of the validation facts about the target state that a proof may reuse.",
    "schema": {
      "enum": [
        "FULL(D)"
      ],
      "required": true
    },
    "type": "Text"
  },
  "name": "RISC Zero Succinct Receipt Profile",
  "programImageId": {
    "description": "Image identifier of the proving program: 64 characters 0-9a-f encoding 32 bytes.",
    "schema": {
      "maxLength": 64,
      "minLength": 64,
      "required": true
    },
    "type": "Text"
  },
  "specification": {
    "blueId": "3PZprGbDbtCagSYTK8raSDdEMCftFgkfcLpvhGYap7t3"
  },
  "type": "Coordination/Evidence Profile",
  "allowedProviders": {
    "description": "Allowed timeline provider keys, strictly ascending as 32-byte values. The provider set digest is SHA-256 over the concatenated raw keys in list order.",
    "itemType": "Coordination/Ed25519 Public Key",
    "schema": {
      "required": true,
      "uniqueItems": true
    },
    "type": "List"
  },
  "schema": {
    "maxFields": 3
  }
}
