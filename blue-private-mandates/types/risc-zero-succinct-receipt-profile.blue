{
  "description": "Proof profile whose evidence is a succinct RISC Zero receipt of one pinned proving program, verified by one pinned receiver build. The type fixes the receipt kind, the comparison rules and the provider set digest function. The validity of the target state and of the operation entry are premises of a proof, not something the proof or its verification checks.",
  "name": "RISC Zero Succinct Receipt Profile",
  "programImageId": {
    "description": "Image identifier of the proving program: 64 characters 0-9a-f encoding 32 bytes.",
    "schema": {
      "maxLength": 64,
      "minLength": 64,
      "required": true
    },
    "type": "Text"
  },
  "specification": {
    "blueId": "6Qsn4DGUbgvJNQVwmHWmM1pjCoUzokjd9iNC4btUqnd8"
  },
  "type": "CoordinationEvidence/Evidence Profile",
  "allowedProviders": {
    "description": "Allowed timeline provider keys, strictly ascending as 32-byte values. Every key is 64 characters 0-9a-f that encode, canonically, a point of edwards25519 that is not of small order; the schema fixes the length and the processor checks the rest. The provider set digest is SHA-256 over the concatenated raw keys in list order.",
    "itemType": "Coordination/Ed25519 Public Key",
    "schema": {
      "required": true,
      "uniqueItems": true
    },
    "type": "List"
  },
  "schema": {
    "maxFields": 3
  },
  "receiverBuildSha256": {
    "description": "SHA-256 of the receiver build that performs the pinned verification for this profile: 64 characters 0-9a-f encoding 32 bytes. A processor whose installed build has another SHA-256 does not implement the declared profile.",
    "schema": {
      "maxLength": 64,
      "minLength": 64,
      "required": true
    },
    "type": "Text"
  }
}
