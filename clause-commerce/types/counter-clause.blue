name: Counter Clause
type: Connections/Connected Clause
description: Count or accumulate business values with explicit bounds.
bindingTypes:
  count: pointer
actions:
  adjust:
    defaults:
      delta: 1
    do:
    - $failIf:
        cond:
          $not:
            $isKind:
              val:
                $var:
                  name: params
                  path: /delta
              kind: integer
        message: Counter delta must be integral
    - $let:
        name: nextValue
        expr:
          $add:
          - $document:
              $const:
                name: bindings
                path: /count
          - $var:
              name: params
              path: /delta
    - $failIf:
        cond:
          $or:
          - $lt:
            - $var: nextValue
            - $const:
                name: parameters
                path: /minimum
          - $gt:
            - $var: nextValue
            - $const:
                name: parameters
                path: /maximum
        message: Counter bound exceeded
    - $appendChange:
        op: replace
        path:
          $const:
            name: bindings
            path: /count
        val:
          $var: nextValue
    - $appendEvent:
        $merge:
        - type: Commerce/Domain Event
        - kind: Counter Changed
          clause:
            $const: clauseKey
          count:
            $var: nextValue
          delta:
            $var:
              name: params
              path: /delta
