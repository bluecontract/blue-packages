{
  "name": "M0 composition probe",
  "type": "DocumentsDomain/Document with Clauses",
  "clauses": {
    "work": {
      "type": "TaskM0/Work Clause"
    },
    "initial": {
      "type": "TaskM0/Initialization Policy"
    },
    "manual": {
      "type": "TaskM0/Manual Policy",
      "bindings": {
        "request": {
          "requestAgain": {
            "on": "workflow",
            "channel": "owner"
          }
        }
      }
    }
  },
  "contracts": {
    "owner": {
      "type": "Coordination/Timeline Channel"
    },
    "performer": {
      "type": "Coordination/Timeline Channel"
    }
  }
}
