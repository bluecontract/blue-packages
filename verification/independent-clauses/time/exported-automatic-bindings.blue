bindings:
  result: /clockStartMicros
  unavailable: /clockStartUnavailable
  fallback: /monetarySource/securedTimestamp/timestampMicros
  ready: /activation/active
  sourceReady: /activation/accessReady
  startFromEntry:
    activation:
      'on': activated
  startFromFallback:
    authorizationEvent:
      'on': embedded
      path: /monetarySource
      event: {type: PaymentInstruction/Funds Secured}
    authorizationAttachment:
      'on': change
      path: /monetarySource
    authorizationAfterAccessRestored:
      'on': event
      event: {type: Parties/Document Access Restored}
    authorizedFallback:
      'on': change
      path: /clockStartUnavailable
