type: Contracts/Sequential Workflow Operation
channel: guarantor
steps:
- type: Contracts/Compute
  definition: {type: Payment/Payment Process Functions}
  constants: {sourceMode: workflow}
  do:
  - $appendChange:
      op: add
      path: /probeSelected
      val:
        $call:
          function: isSelectedPayment
          args:
            input: {$binding: call/request}
