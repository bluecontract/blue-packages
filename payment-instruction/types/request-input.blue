name: Payment Request Input
description: Explicit user input for a payment workflow. Financial amount or amountMinor
  is required except void, which can use the saved amount.
amount:
  description: User-selected financial amount. Alternative to amountMinor; required
    for secure, capture and refund.
  type: Integer
amountMinor:
  description: User-selected financial amount in minor units. Alternative to amount.
  type: Integer
reason:
  description: Optional user explanation.
  type: Text
payeeRef:
  description: Recipient selected from paymentTerms.allowedPayees.
  type: Text
transactionDetails:
  description: User-supplied transaction details object.
finalAmount:
  description: Final amount in minor units, bounded by paymentTerms.limitMinor.
  type: Integer
