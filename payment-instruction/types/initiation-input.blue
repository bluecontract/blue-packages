name: Transaction Initiation Input
railType:
  type: Text
  description: Optional transaction detail supplied by the guarantor.
attachmentPoint:
  type: Text
  description: Optional transaction detail supplied by the guarantor.
providerReference:
  type: Text
  description: Optional transaction detail supplied by the guarantor.
initiatedAmount:
  type: Integer
  description: Optional amount assertion; defaults during execution to paymentTerms.amountMinor.
