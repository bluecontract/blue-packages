name: Payment Functions
type: Contracts/Compute Definition
description: Native BEX ledger for one payment instruction. Requests reserve capacity; guarantor outcomes change
  confirmed amounts.
functions:
  key:
    args:
      candidate:
        type: Text
    do:
    - $failIf:
        cond:
          $not:
            $and:
            - $isKind:
                val:
                  $var: candidate
                kind: text
            - $ne:
              - $var: candidate
              - ''
            - $eq:
              - $size:
                  $split:
                    text:
                      $var: candidate
                    separator: /
              - 1
            - $eq:
              - $size:
                  $split:
                    text:
                      $var: candidate
                    separator: '~'
              - 1
        message: Invalid payment identifier
  guarantor:
    args: {}
    do:
    - $failIf:
        cond:
          $not:
            $and:
            - $eq:
              - $const: sourceMode
              - workflow
            - $eq:
              - $binding: call/channel
              - $document: /paymentTerms/guarantorChannel
        message: Guarantor workflow required
  emit:
    args:
      kind:
        type: Text
      detail: {}
    do:
    - $let:
        name: messageName
        expr:
          $get:
            object:
              Instruction Accepted: Payment Instruction Accepted
              Instruction Rejected: Payment Instruction Rejected
              Transaction Initiated: Transaction Initiated
              Payment Request: Payment Request
              Payment Response: Payment Response
              Payment Instruction Acceptance Requested: Payment Instruction Acceptance Requested
              Payee Assignment Requested: Payee Assignment Requested
              Transaction Details Update Requested: Transaction Details Update Requested
              Secure Funds Requested: Secure Funds Requested
              Complete Payment Requested: Complete Payment Requested
              Cancel Before Completion Requested: Cancel Before Completion Requested
              Reverse After Completion Requested: Reverse After Completion Requested
              Final Amount Resolution Requested: Final Amount Resolution Requested
              Payment Completion Lock Requested: Payment Completion Lock Requested
              Payment Completion Unlock Requested: Payment Completion Unlock Requested
              Payment Reversal Lock Requested: Payment Reversal Lock Requested
              Payment Reversal Unlock Requested: Payment Reversal Unlock Requested
              Transaction Details Update Lock Requested: Transaction Details Update Lock Requested
              Transaction Details Update Unlock Requested: Transaction Details Update Unlock Requested
              Payment Instruction Accepted: Payment Instruction Accepted
              Payment Instruction Rejected: Payment Instruction Rejected
              Payee Assignment Confirmed: Payee Assignment Confirmed
              Payee Assignment Rejected: Payee Assignment Rejected
              Transaction Details Updated: Transaction Details Updated
              Transaction Details Update Rejected: Transaction Details Update Rejected
              Transaction Details Update Failed: Transaction Details Update Failed
              Transaction Initiation Failed: Transaction Initiation Failed
              Funds Secured: Funds Secured
              Payment Completed: Payment Completed
              Payment Cancelled Before Completion: Payment Cancelled Before Completion
              Payment Reversed After Completion: Payment Reversed After Completion
              Final Amount Resolved: Final Amount Resolved
              Final Amount Resolution Rejected: Final Amount Resolution Rejected
              Funds Securing Declined: Funds Securing Declined
              Funds Securing Failed: Funds Securing Failed
              Funds Securing Unknown: Funds Securing Unknown
              Payment Completion Declined: Payment Completion Declined
              Payment Completion Failed: Payment Completion Failed
              Payment Completion Unknown: Payment Completion Unknown
              Payment Cancellation Declined: Payment Cancellation Declined
              Payment Cancellation Failed: Payment Cancellation Failed
              Payment Cancellation Unknown: Payment Cancellation Unknown
              Payment Reversal Declined: Payment Reversal Declined
              Payment Reversal Failed: Payment Reversal Failed
              Payment Reversal Unknown: Payment Reversal Unknown
              Payment Completion Locked: Payment Completion Locked
              Payment Completion Unlocked: Payment Completion Unlocked
              Payment Completion Lock Change Failed: Payment Completion Lock Change Failed
              Payment Reversal Locked: Payment Reversal Locked
              Payment Reversal Unlocked: Payment Reversal Unlocked
              Payment Reversal Lock Change Failed: Payment Reversal Lock Change Failed
              Transaction Details Update Locked: Transaction Details Update Locked
              Transaction Details Update Unlocked: Transaction Details Update Unlocked
              Transaction Details Update Lock Change Failed: Transaction Details Update Lock Change Failed
            key:
              $var: kind
    - $if:
        cond:
          $eq:
          - $var: kind
          - Payment Requested
        then:
        - $set:
            name: messageName
            expr:
              $get:
                object:
                  secure: Secure Funds Requested
                  capture: Complete Payment Requested
                  void: Cancel Before Completion Requested
                  refund: Reverse After Completion Requested
                key:
                  $var:
                    name: detail
                    path: /action
    - $if:
        cond:
          $eq:
          - $var: kind
          - Payment Outcome
        then:
        - $set:
            name: messageName
            expr:
              $get:
                object:
                  $get:
                    object:
                      secure:
                        succeeded: Funds Secured
                        declined: Funds Securing Declined
                        failed: Funds Securing Failed
                        unknown: Funds Securing Unknown
                      capture:
                        succeeded: Payment Completed
                        declined: Payment Completion Declined
                        failed: Payment Completion Failed
                        unknown: Payment Completion Unknown
                      void:
                        succeeded: Payment Cancelled Before Completion
                        declined: Payment Cancellation Declined
                        failed: Payment Cancellation Failed
                        unknown: Payment Cancellation Unknown
                      refund:
                        succeeded: Payment Reversed After Completion
                        declined: Payment Reversal Declined
                        failed: Payment Reversal Failed
                        unknown: Payment Reversal Unknown
                    key:
                      $var:
                        name: detail
                        path: /action
                key:
                  $var:
                    name: detail
                    path: /outcome
    - $appendEvent:
        $merge:
        - type: PaymentInstruction/Payment Event
        - $var: detail
        - kind:
            $var: kind
          paymentId:
            $document: /instanceKey
          currency:
            $document: /paymentTerms/currency
        - $choose:
            cond:
              $exists:
                $var: messageName
            then:
              $get:
                object:
                  Payment Request:
                    type: PaymentInstruction/Payment Request
                  Payment Response:
                    type: PaymentInstruction/Payment Response
                  Payment Instruction Acceptance Requested:
                    type: PaymentInstruction/Payment Instruction Acceptance Requested
                  Payee Assignment Requested:
                    type: PaymentInstruction/Payee Assignment Requested
                  Transaction Details Update Requested:
                    type: PaymentInstruction/Transaction Details Update Requested
                  Secure Funds Requested:
                    type: PaymentInstruction/Secure Funds Requested
                  Complete Payment Requested:
                    type: PaymentInstruction/Complete Payment Requested
                  Cancel Before Completion Requested:
                    type: PaymentInstruction/Cancel Before Completion Requested
                  Reverse After Completion Requested:
                    type: PaymentInstruction/Reverse After Completion Requested
                  Final Amount Resolution Requested:
                    type: PaymentInstruction/Final Amount Resolution Requested
                  Payment Completion Lock Requested:
                    type: PaymentInstruction/Payment Completion Lock Requested
                  Payment Completion Unlock Requested:
                    type: PaymentInstruction/Payment Completion Unlock Requested
                  Payment Reversal Lock Requested:
                    type: PaymentInstruction/Payment Reversal Lock Requested
                  Payment Reversal Unlock Requested:
                    type: PaymentInstruction/Payment Reversal Unlock Requested
                  Transaction Details Update Lock Requested:
                    type: PaymentInstruction/Transaction Details Update Lock Requested
                  Transaction Details Update Unlock Requested:
                    type: PaymentInstruction/Transaction Details Update Unlock Requested
                  Payment Instruction Accepted:
                    type: PaymentInstruction/Payment Instruction Accepted
                  Payment Instruction Rejected:
                    type: PaymentInstruction/Payment Instruction Rejected
                  Payee Assignment Confirmed:
                    type: PaymentInstruction/Payee Assignment Confirmed
                  Payee Assignment Rejected:
                    type: PaymentInstruction/Payee Assignment Rejected
                  Transaction Details Updated:
                    type: PaymentInstruction/Transaction Details Updated
                  Transaction Details Update Rejected:
                    type: PaymentInstruction/Transaction Details Update Rejected
                  Transaction Details Update Failed:
                    type: PaymentInstruction/Transaction Details Update Failed
                  Transaction Initiated:
                    type: PaymentInstruction/Transaction Initiated
                  Transaction Initiation Failed:
                    type: PaymentInstruction/Transaction Initiation Failed
                  Funds Secured:
                    type: PaymentInstruction/Funds Secured
                  Payment Completed:
                    type: PaymentInstruction/Payment Completed
                  Payment Cancelled Before Completion:
                    type: PaymentInstruction/Payment Cancelled Before Completion
                  Payment Reversed After Completion:
                    type: PaymentInstruction/Payment Reversed After Completion
                  Final Amount Resolved:
                    type: PaymentInstruction/Final Amount Resolved
                  Final Amount Resolution Rejected:
                    type: PaymentInstruction/Final Amount Resolution Rejected
                  Funds Securing Declined:
                    type: PaymentInstruction/Funds Securing Declined
                  Funds Securing Failed:
                    type: PaymentInstruction/Funds Securing Failed
                  Funds Securing Unknown:
                    type: PaymentInstruction/Funds Securing Unknown
                  Payment Completion Declined:
                    type: PaymentInstruction/Payment Completion Declined
                  Payment Completion Failed:
                    type: PaymentInstruction/Payment Completion Failed
                  Payment Completion Unknown:
                    type: PaymentInstruction/Payment Completion Unknown
                  Payment Cancellation Declined:
                    type: PaymentInstruction/Payment Cancellation Declined
                  Payment Cancellation Failed:
                    type: PaymentInstruction/Payment Cancellation Failed
                  Payment Cancellation Unknown:
                    type: PaymentInstruction/Payment Cancellation Unknown
                  Payment Reversal Declined:
                    type: PaymentInstruction/Payment Reversal Declined
                  Payment Reversal Failed:
                    type: PaymentInstruction/Payment Reversal Failed
                  Payment Reversal Unknown:
                    type: PaymentInstruction/Payment Reversal Unknown
                  Payment Completion Locked:
                    type: PaymentInstruction/Payment Completion Locked
                  Payment Completion Unlocked:
                    type: PaymentInstruction/Payment Completion Unlocked
                  Payment Completion Lock Change Failed:
                    type: PaymentInstruction/Payment Completion Lock Change Failed
                  Payment Reversal Locked:
                    type: PaymentInstruction/Payment Reversal Locked
                  Payment Reversal Unlocked:
                    type: PaymentInstruction/Payment Reversal Unlocked
                  Payment Reversal Lock Change Failed:
                    type: PaymentInstruction/Payment Reversal Lock Change Failed
                  Transaction Details Update Locked:
                    type: PaymentInstruction/Transaction Details Update Locked
                  Transaction Details Update Unlocked:
                    type: PaymentInstruction/Transaction Details Update Unlocked
                  Transaction Details Update Lock Change Failed:
                    type: PaymentInstruction/Transaction Details Update Lock Change Failed
                key:
                  $var: messageName
            else:
              type: PaymentInstruction/Payment Event
  initialize:
    args: {}
    do:
    - $let:
        name: terms
        expr:
          $document: /paymentTerms
    - $let:
        name: amount
        expr:
          $var:
            name: terms
            path: /amountMinor
    - $let:
        name: limit
        expr:
          $var:
            name: terms
            path: /limitMinor
    - $failIf:
        cond:
          $not:
            $and:
            - $isKind:
                val:
                  $var: amount
                kind: integer
            - $gt:
              - $var: amount
              - 0
            - $isKind:
                val:
                  $var: limit
                kind: integer
            - $gte:
              - $var: limit
              - $var: amount
            - $lte:
              - $var: limit
              - 1000000000000
            - $isKind:
                val:
                  $var:
                    name: terms
                    path: /currency
                kind: text
            - $ne:
              - $var:
                  name: terms
                  path: /currency
              - ''
            - $isKind:
                val:
                  $var:
                    name: terms
                    path: /recipientApprovalRequired
                kind: boolean
        message: Invalid immutable payment terms
    - $forEach:
        item: role
        in:
        - payerChannel
        - guarantorChannel
        do:
        - $let:
            name: channel
            expr:
              $get:
                object:
                  $var: terms
                key:
                  $var: role
        - $call:
            function: key
            args:
              candidate:
                $var: channel
        - $failIf:
            cond:
              $not:
                $exists:
                  $document:
                    $concat:
                    - /contracts/
                    - $var: channel
            message: Missing payment participant channel
    - $failIf:
        cond:
          $not:
            $isKind:
              val:
                $var:
                  name: terms
                  path: /allowedPayees
              kind: list
        message: Allowed recipients must be declared
    - $forEach:
        item: recipient
        in:
          $var:
            name: terms
            path: /allowedPayees
        do:
        - $call:
            function: key
            args:
              candidate:
                $var: recipient
        - $failIf:
            cond:
              $not:
                $exists:
                  $document:
                    $concat:
                    - /contracts/
                    - $var: recipient
            message: Missing recipient channel
    - $let:
        name: initialRecipient
        expr:
          $pointerGet:
            object:
              $var: terms
            path: /payeeChannel
            default: ''
    - $failIf:
        cond:
          $and:
          - $ne:
            - $var: initialRecipient
            - ''
          - $not:
              $includes:
                list:
                  $var:
                    name: terms
                    path: /allowedPayees
                val:
                  $var: initialRecipient
        message: Initial recipient is not allowed
    - $failIf:
        cond:
          $gt:
          - $size:
              $object:
                $document: /payment
          - 0
        message: Initial financial state must be empty
    - $appendChange:
        op: replace
        path: /payment
        val:
          accepted: false
          rejected: false
          recipientApproved: false
          transactionId: ''
          closed: false
          targetMinor:
            $var: amount
          finalResolved: false
          secured: 0
          completed: 0
          reversed: 0
          reserved:
            secure: 0
            capture: 0
            refund: 0
            void: 0
          locks:
            capture: false
            refund: false
            details: false
          requests: {}
          details: {}
          payeeChannel:
            $pointerGet:
              object:
                $var: terms
              path: /payeeChannel
              default: ''
          controlRequests: {}
          initiationFailures: {}
          cancellationPending: false
    - $call:
        function: emit
        args:
          kind: Payment Initialized
          detail: {}
    - $call:
        function: emit
        args:
          kind: Payment Instruction Acceptance Requested
          detail:
            requestId: acceptance
  accept:
    args:
      approved:
        type: Boolean
      input: {}
    do:
    - $call:
        function: guarantor
    - $let:
        name: decision
        expr:
          approved:
            $var: approved
          reason:
            $pointerGet:
              object:
                $var: input
              path: /reason
              default: ''
    - $if:
        cond:
          $not:
            $var: approved
        then:
        - $failIf:
            cond:
              $not:
                $and:
                - $isKind:
                    val:
                      $var:
                        name: input
                        path: /reason
                    kind: text
                - $ne:
                  - $var:
                      name: input
                      path: /reason
                  - ''
            message: Rejection requires a reason
    - $let:
        name: s
        expr:
          $document: /payment
    - $failIf:
        cond:
          $and:
          - $var:
              name: s
              path: /rejected
          - $var: approved
        message: Rejected instruction cannot be accepted
    - $failIf:
        cond:
          $and:
          - $var:
              name: s
              path: /accepted
          - $not:
              $var: approved
        message: Accepted instruction cannot be rejected
    - $if:
        cond:
          $or:
          - $var:
              name: s
              path: /accepted
          - $var:
              name: s
              path: /rejected
        then:
        - $failIf:
            cond:
              $ne:
              - $var:
                  name: s
                  path: /acceptanceResponse
              - $var: decision
            message: Conflicting acceptance response
        - $return:
            changed: false
    - $appendChange:
        op: replace
        path: /payment
        val:
          $merge:
          - $var: s
          - accepted:
              $var: approved
            rejected:
              $not:
                $var: approved
            acceptanceResponse:
              $var: decision
    - $call:
        function: emit
        args:
          kind:
            $choose:
              cond:
                $var: approved
              then: Instruction Accepted
              else: Instruction Rejected
          detail:
            requestId: acceptance
            reason:
              $pointerGet:
                object:
                  $var: input
                path: /reason
                default: ''
    - $return:
        changed: true
  approveRecipient:
    args: {}
    do:
    - $let:
        name: path
        expr: /payment
    - $let:
        name: s
        expr:
          $document:
            $var: path
    - $failIf:
        cond:
          $not:
            $and:
            - $eq:
              - $const: sourceMode
              - workflow
            - $ne:
              - $var:
                  name: s
                  path: /payeeChannel
              - ''
            - $eq:
              - $binding: call/channel
              - $var:
                  name: s
                  path: /payeeChannel
        message: Current recipient must approve
    - $if:
        cond:
          $var:
            name: s
            path: /recipientApproved
        then:
        - $return:
            changed: false
    - $appendChange:
        op: replace
        path:
          $concat:
          - $var: path
          - /recipientApproved
        val: true
    - $call:
        function: emit
        args:
          kind: Recipient Approved
          detail: {}
    - $return:
        changed: true
  initiate:
    args:
      transactionId:
        type: Text
      input: {}
    do:
    - $call:
        function: requireReservationMethod
        args: {}
    - $call:
        function: guarantor
    - $call:
        function: key
        args:
          candidate:
            $var: transactionId
    - $let:
        name: path
        expr: /payment
    - $let:
        name: s
        expr:
          $document:
            $var: path
    - $failIf:
        cond:
          $not:
            $var:
              name: s
              path: /accepted
        message: Accept instruction before initiating transaction
    - $let:
        name: attachment
        expr:
          transactionId:
            $var: transactionId
          railType:
            $pointerGet:
              object:
                $var: input
              path: /railType
              default: unspecified
          attachmentPoint:
            $pointerGet:
              object:
                $var: input
              path: /attachmentPoint
              default: unspecified
          providerReference:
            $pointerGet:
              object:
                $var: input
              path: /providerReference
              default:
                $var: transactionId
          initiatedAmount:
            $pointerGet:
              object:
                $var: input
              path: /initiatedAmount
              default:
                $document: /paymentTerms/amountMinor
    - $failIf:
        cond:
          $not:
            $and:
            - $isKind:
                val:
                  $var:
                    name: attachment
                    path: /initiatedAmount
                kind: integer
            - $gte:
              - $var:
                  name: attachment
                  path: /initiatedAmount
              - 0
            - $lte:
              - $var:
                  name: attachment
                  path: /initiatedAmount
              - $document: /paymentTerms/limitMinor
        message: Invalid initiated amount
    - $if:
        cond:
          $ne:
          - $var:
              name: s
              path: /transactionId
          - ''
        then:
        - $failIf:
            cond:
              $ne:
              - $var:
                  name: s
                  path: /attachment
              - $var: attachment
            message: Conflicting transaction attachment
        - $failIf:
            cond:
              $ne:
              - $var:
                  name: s
                  path: /transactionId
              - $var: transactionId
            message: One instruction represents one transaction
        - $return:
            changed: false
    - $let:
        name: initiationGate
        expr:
          $pointerGet:
            object:
              $document: /paymentTerms
            path: /initiationGate
            default: ''
    - $if:
        cond:
          $ne:
          - $var: initiationGate
          - ''
        then:
        - $failIf:
            cond:
              $ne:
              - $document:
                  $var: initiationGate
              - true
            message: PAYMENT_INITIATION_NOT_READY
    - $appendChange:
        op: replace
        path:
          $concat:
          - $var: path
          - /transactionId
        val:
          $var: transactionId
    - $appendChange:
        op: add
        path:
          $concat:
          - $var: path
          - /attachment
        val:
          $var: attachment
    - $call:
        function: emit
        args:
          kind: Transaction Initiated
          detail:
            $var: attachment
    - $return:
        changed: true
  request:
    args:
      action:
        type: Text
      input: {}
    do:
    - $call:
        function: requireReservationMethod
        args: {}
    - $let:
        name: path
        expr: /payment
    - $let:
        name: s
        expr:
          $document:
            $var: path
    - $let:
        name: id
        expr:
          $var:
            name: input
            path: /requestId
    - $let:
        name: amount
        expr:
          $pointerGet:
            object:
              $var: input
            path: /amount
            default:
              $pointerGet:
                object:
                  $var: input
                path: /amountMinor
                default:
                  $choose:
                    cond:
                      $eq:
                      - $var: action
                      - void
                    then:
                      $pointerGet:
                        object:
                          $get:
                            object:
                              $var:
                                name: s
                                path: /requests
                            key:
                              $var: id
                        path: /intent/amountMinor
                        default:
                          $var:
                            name: s
                            path: /secured
                    else: null
    - $call:
        function: key
        args:
          candidate:
            $var: id
    - $failIf:
        cond:
          $not:
            $and:
            - $includes:
                list:
                - secure
                - capture
                - refund
                - void
                val:
                  $var: action
            - $isKind:
                val:
                  $var: amount
                kind: integer
            - $or:
              - $gt:
                - $var: amount
                - 0
              - $and:
                - $eq:
                  - $var: action
                  - void
                - $eq:
                  - $var: amount
                  - 0
            - $lte:
              - $var: amount
              - 1000000000000
        message: Positive integral amount and supported action required
    - $let:
        name: intent
        expr:
          action:
            $var: action
          amountMinor:
            $var: amount
          reason:
            $pointerGet:
              object:
                $var: input
              path: /reason
              default: ''
    - $failIf:
        cond:
          $exists:
            $get:
              object:
                $var:
                  name: s
                  path: /controlRequests
              key:
                $var: id
        message: Request identifier already used by a control request
    - $let:
        name: previous
        expr:
          $get:
            object:
              $var:
                name: s
                path: /requests
            key:
              $var: id
    - $if:
        cond:
          $exists:
            $var: previous
        then:
        - $failIf:
            cond:
              $ne:
              - $var:
                  name: previous
                  path: /intent
              - $var: intent
            message: Conflicting payment request identifier
        - $return:
            created: false
            requestId:
              $var: id
    - $let:
        name: captureGate
        expr:
          $pointerGet:
            object:
              $document: /paymentTerms
            path: /captureGate
            default: ''
    - $failIf:
        cond:
          $and:
          - $eq:
            - $var: action
            - capture
          - $ne:
            - $var: captureGate
            - ''
          - $ne:
            - $document:
                $var: captureGate
            - true
        message: 'CAPTURE_CONDITIONS_NOT_MET: mandatory PI policy applies to every capture route'
    - $failIf:
        cond:
          $not:
            $and:
            - $var:
                name: s
                path: /accepted
            - $ne:
              - $var:
                  name: s
                  path: /transactionId
              - ''
        message: Accepted and initiated transaction required
    - $failIf:
        cond:
          $and:
          - $var:
              name: s
              path: /closed
          - $ne:
            - $var: action
            - refund
        message: Further charges are closed
    - $failIf:
        cond:
          $get:
            object:
              $var:
                name: s
                path: /locks
            key:
              $var: action
        message: Requested action is locked by guarantor
    - $let:
        name: reserved
        expr:
          $var:
            name: s
            path: /reserved
    - $failIf:
        cond:
          $and:
          - $includes:
              list:
              - secure
              - capture
              val:
                $var: action
          - $var:
              name: s
              path: /cancellationPending
        message: Resolve pending void before further charges
    - $let:
        name: available
        expr: 0
    - $if:
        cond:
          $eq:
          - $var: action
          - secure
        then:
        - $set:
            name: available
            expr:
              $subtract:
              - $var:
                  name: s
                  path: /targetMinor
              - $add:
                - $var:
                    name: s
                    path: /completed
                - $var:
                    name: s
                    path: /secured
                - $var:
                    name: reserved
                    path: /secure
    - $if:
        cond:
          $eq:
          - $var: action
          - capture
        then:
        - $failIf:
            cond:
              $or:
              - $eq:
                - $var:
                    name: s
                    path: /payeeChannel
                - ''
              - $and:
                - $document: /paymentTerms/recipientApprovalRequired
                - $not:
                    $var:
                      name: s
                      path: /recipientApproved
            message: Selected recipient approval required
        - $set:
            name: available
            expr:
              $subtract:
              - $var:
                  name: s
                  path: /secured
              - $add:
                - $var:
                    name: reserved
                    path: /capture
                - $var:
                    name: reserved
                    path: /void
        - $failIf:
            cond:
              $gt:
              - $add:
                - $var: amount
                - $var:
                    name: s
                    path: /completed
                - $var:
                    name: reserved
                    path: /capture
              - $var:
                  name: s
                  path: /targetMinor
            message: Capture exceeds target amount
    - $if:
        cond:
          $eq:
          - $var: action
          - refund
        then:
        - $set:
            name: available
            expr:
              $subtract:
              - $var:
                  name: s
                  path: /completed
              - $add:
                - $var:
                    name: s
                    path: /reversed
                - $var:
                    name: reserved
                    path: /refund
    - $if:
        cond:
          $eq:
          - $var: action
          - void
        then:
        - $failIf:
            cond:
              $var:
                name: s
                path: /cancellationPending
            message: Resolve pending cancellation before another cancellation
        - $failIf:
            cond:
              $ne:
              - $add:
                - $var:
                    name: reserved
                    path: /secure
                - $var:
                    name: reserved
                    path: /capture
                - $var:
                    name: reserved
                    path: /void
              - 0
            message: Resolve pending authorization and capture before void
        - $set:
            name: available
            expr:
              $var:
                name: s
                path: /secured
        - $failIf:
            cond:
              $ne:
              - $var: amount
              - $var: available
            message: Void releases the entire remaining authorization
    - $failIf:
        cond:
          $gt:
          - $var: amount
          - $var: available
        message: Insufficient unreserved payment capacity
    - $appendChange:
        op: add
        path:
          $concat:
          - $var: path
          - /requests/
          - $var: id
        val:
          intent:
            $var: intent
          status: pending
    - $appendChange:
        op: replace
        path:
          $concat:
          - $var: path
          - /reserved/
          - $var: action
        val:
          $add:
          - $get:
              object:
                $var: reserved
              key:
                $var: action
          - $var: amount
    - $if:
        cond:
          $eq:
          - $var: action
          - void
        then:
        - $appendChange:
            op: replace
            path:
              $concat:
              - $var: path
              - /cancellationPending
            val: true
    - $call:
        function: emit
        args:
          kind: Payment Requested
          detail:
            requestId:
              $var: id
            action:
              $var: action
            amountMinor:
              $var: amount
            amount:
              $var: amount
            reason:
              $pointerGet:
                object:
                  $var: input
                path: /reason
                default: ''
    - $return:
        created: true
        requestId:
          $var: id
  confirm:
    args:
      input: {}
    do:
    - $call:
        function: guarantor
    - $let:
        name: path
        expr: /payment
    - $let:
        name: s
        expr:
          $document:
            $var: path
    - $let:
        name: id
        expr:
          $var:
            name: input
            path: /requestId
    - $call:
        function: key
        args:
          candidate:
            $var: id
    - $let:
        name: outcome
        expr:
          $var:
            name: input
            path: /outcome
    - $failIf:
        cond:
          $not:
            $includes:
              list:
              - succeeded
              - declined
              - failed
              - unknown
              val:
                $var: outcome
        message: Unsupported guarantor outcome
    - $let:
        name: request
        expr:
          $get:
            object:
              $var:
                name: s
                path: /requests
            key:
              $var: id
    - $failIf:
        cond:
          $not:
            $exists:
              $var: request
        message: Unknown payment request
    - $let:
        name: response
        expr:
          outcome:
            $var: outcome
          reason:
            $pointerGet:
              object:
                $var: input
              path: /reason
              default: ''
    - $let:
        name: status
        expr:
          $var:
            name: request
            path: /status
    - $if:
        cond:
          $eq:
          - $var: status
          - $var: outcome
        then:
        - $failIf:
            cond:
              $ne:
              - $var:
                  name: request
                  path: /response
              - $var: response
            message: Conflicting duplicate payment response
        - $return:
            changed: false
    - $failIf:
        cond:
          $not:
            $includes:
              list:
              - pending
              - unknown
              val:
                $var: status
        message: Conflicting terminal payment outcome
    - $let:
        name: action
        expr:
          $var:
            name: request
            path: /intent/action
    - $let:
        name: amount
        expr:
          $var:
            name: request
            path: /intent/amountMinor
    - $appendChange:
        op: add
        path:
          $concat:
          - $var: path
          - /requests/
          - $var: id
          - /response
        val:
          $var: response
    - $appendChange:
        op: replace
        path:
          $concat:
          - $var: path
          - /requests/
          - $var: id
          - /status
        val:
          $var: outcome
    - $if:
        cond:
          $ne:
          - $var: outcome
          - unknown
        then:
        - $appendChange:
            op: replace
            path:
              $concat:
              - $var: path
              - /reserved/
              - $var: action
            val:
              $subtract:
              - $get:
                  object:
                    $var:
                      name: s
                      path: /reserved
                  key:
                    $var: action
              - $var: amount
    - $if:
        cond:
          $eq:
          - $var: outcome
          - succeeded
        then:
        - $if:
            cond:
              $eq:
              - $var: action
              - secure
            then:
            - $appendChange:
                op: replace
                path:
                  $concat:
                  - $var: path
                  - /secured
                val:
                  $add:
                  - $var:
                      name: s
                      path: /secured
                  - $var: amount
        - $if:
            cond:
              $eq:
              - $var: action
              - capture
            then:
            - $appendChange:
                op: replace
                path:
                  $concat:
                  - $var: path
                  - /secured
                val:
                  $subtract:
                  - $var:
                      name: s
                      path: /secured
                  - $var: amount
            - $appendChange:
                op: replace
                path:
                  $concat:
                  - $var: path
                  - /completed
                val:
                  $add:
                  - $var:
                      name: s
                      path: /completed
                  - $var: amount
        - $if:
            cond:
              $eq:
              - $var: action
              - refund
            then:
            - $appendChange:
                op: replace
                path:
                  $concat:
                  - $var: path
                  - /reversed
                val:
                  $add:
                  - $var:
                      name: s
                      path: /reversed
                  - $var: amount
        - $if:
            cond:
              $eq:
              - $var: action
              - void
            then:
            - $appendChange:
                op: replace
                path:
                  $concat:
                  - $var: path
                  - /secured
                val: 0
            - $appendChange:
                op: replace
                path:
                  $concat:
                  - $var: path
                  - /closed
                val: true
    - $if:
        cond:
          $and:
          - $eq:
            - $var: action
            - void
          - $ne:
            - $var: outcome
            - unknown
        then:
        - $appendChange:
            op: replace
            path:
              $concat:
              - $var: path
              - /cancellationPending
            val: false
    - $call:
        function: emit
        args:
          kind: Payment Outcome
          detail:
            $merge:
            - requestId:
                $var: id
              action:
                $var: action
              amountMinor:
                $var: amount
              outcome:
                $var: outcome
              reason:
                $pointerGet:
                  object:
                    $var: input
                  path: /reason
                  default: ''
            - $choose:
                cond:
                  $eq:
                  - $var: outcome
                  - succeeded
                then:
                  $objectSet:
                    object: {}
                    key:
                      $get:
                        object:
                          secure: amountSecured
                          capture: amountCompleted
                          refund: amountReversed
                          void: amountCancelled
                        key:
                          $var: action
                    val:
                      $var: amount
                else: {}
    - $return:
        changed: true
  configure:
    args:
      action:
        type: Text
      input: {}
    do:
    - $call:
        function: guarantor
    - $let:
        name: path
        expr: /payment
    - $let:
        name: s
        expr:
          $document:
            $var: path
    - $failIf:
        cond:
          $var:
            name: s
            path: /rejected
        message: Rejected instruction cannot be changed
    - $let:
        name: field
        expr: ''
    - $let:
        name: nextValue
        expr: {}
    - $if:
        cond:
          $eq:
          - $var: action
          - lock
        then:
        - $failIf:
            cond:
              $not:
                $and:
                - $includes:
                    list:
                    - capture
                    - refund
                    - details
                    val:
                      $var:
                        name: input
                        path: /action
                - $isKind:
                    val:
                      $var:
                        name: input
                        path: /locked
                    kind: boolean
            message: Unsupported payment lock
        - $set:
            name: field
            expr:
              $concat:
              - locks/
              - $var:
                  name: input
                  path: /action
        - $set:
            name: nextValue
            expr:
              $var:
                name: input
                path: /locked
    - $if:
        cond:
          $eq:
          - $var: action
          - finalAmount
        then:
        - $set:
            name: nextValue
            expr:
              $var:
                name: input
                path: /amountMinor
        - $failIf:
            cond:
              $not:
                $and:
                - $isKind:
                    val:
                      $var: nextValue
                    kind: integer
                - $gte:
                  - $var: nextValue
                  - $add:
                    - $var:
                        name: s
                        path: /completed
                    - $var:
                        name: s
                        path: /reserved/capture
                - $lte:
                  - $var: nextValue
                  - $document: /paymentTerms/limitMinor
            message: Final amount outside approved limits or pending capture
        - $failIf:
            cond:
              $and:
              - $var:
                  name: s
                  path: /finalResolved
              - $ne:
                - $var: nextValue
                - $var:
                    name: s
                    path: /targetMinor
            message: Final amount already resolved
        - $appendChange:
            op: replace
            path:
              $concat:
              - $var: path
              - /finalResolved
            val: true
        - $set:
            name: field
            expr: targetMinor
    - $if:
        cond:
          $eq:
          - $var: action
          - payee
        then:
        - $failIf:
            cond:
              $var:
                name: s
                path: /locks/details
            message: Payment details are locked
        - $set:
            name: nextValue
            expr:
              $var:
                name: input
                path: /channel
        - $call:
            function: key
            args:
              candidate:
                $var: nextValue
        - $failIf:
            cond:
              $not:
                $and:
                - $includes:
                    list:
                      $document: /paymentTerms/allowedPayees
                    val:
                      $var: nextValue
                - $exists:
                    $document:
                      $concat:
                      - /contracts/
                      - $var: nextValue
                - $eq:
                  - $add:
                    - $var:
                        name: s
                        path: /completed
                    - $var:
                        name: s
                        path: /reserved/capture
                  - 0
            message: Payee must be predeclared and selected before capture
        - $if:
            cond:
              $ne:
              - $var: nextValue
              - $var:
                  name: s
                  path: /payeeChannel
            then:
            - $appendChange:
                op: replace
                path:
                  $concat:
                  - $var: path
                  - /recipientApproved
                val: false
        - $set:
            name: field
            expr: payeeChannel
    - $if:
        cond:
          $eq:
          - $var: action
          - details
        then:
        - $failIf:
            cond:
              $var:
                name: s
                path: /locks/details
            message: Payment details are locked
        - $set:
            name: field
            expr: details
        - $set:
            name: nextValue
            expr:
              $var:
                name: input
                path: /details
        - $failIf:
            cond:
              $not:
                $isKind:
                  val:
                    $var: nextValue
                  kind: object
            message: Payment details must be an object
    - $failIf:
        cond:
          $eq:
          - $var: field
          - ''
        message: Unsupported payment configuration
    - $appendChange:
        op: replace
        path:
          $concat:
          - $var: path
          - /
          - $var: field
        val:
          $var: nextValue
    - $return:
        changed: true
  requireReservationMethod:
    args: {}
    do:
    - $failIf:
        cond:
          $not:
            $includes:
              list:
              - reservation
              - card
              - myos-customer
              val:
                $pointerGet:
                  object:
                    $document: /paymentTerms
                  path: /method
                  default: reservation
        message: PAYMENT_METHOD_UNSUPPORTED_ACTION
