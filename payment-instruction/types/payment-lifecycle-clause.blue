name: Payment Lifecycle Clause
type: Connections/Connected Clause
description: One payment with reusable request actions and explicit guarantor-confirmed outcomes.
bindingTypes:
  state: pointer
actionDefinition:
  type: PaymentInstruction/Payment Protocol Functions
actions:
  initialize:
    automatic:
      'on': initialized
      once: true
    do:
    - $call:
        function: initialize
  approveRecipient:
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: approveRecipient
    - $set:
        name: actionResult
        expr:
          $merge:
          - $var: actionResult
          - outcome:
              $choose:
                cond:
                  $or:
                  - $eq:
                    - $var:
                        name: actionResult
                        path: /created
                    - true
                  - $eq:
                    - $var:
                        name: actionResult
                        path: /changed
                    - true
                then: acceptedNew
                else: duplicate
    resultContract: outcome-v1
  requestSecure:
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: request
            args:
              action: secure
              input:
                $var: params
    - $set:
        name: actionResult
        expr:
          $merge:
          - $var: actionResult
          - outcome:
              $choose:
                cond:
                  $or:
                  - $eq:
                    - $var:
                        name: actionResult
                        path: /created
                    - true
                  - $eq:
                    - $var:
                        name: actionResult
                        path: /changed
                    - true
                then: acceptedNew
                else: duplicate
    resultContract: outcome-v1
  requestCapture:
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: request
            args:
              action: capture
              input:
                $var: params
    - $set:
        name: actionResult
        expr:
          $merge:
          - $var: actionResult
          - outcome:
              $choose:
                cond:
                  $or:
                  - $eq:
                    - $var:
                        name: actionResult
                        path: /created
                    - true
                  - $eq:
                    - $var:
                        name: actionResult
                        path: /changed
                    - true
                then: acceptedNew
                else: duplicate
    resultContract: outcome-v1
  requestRefund:
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: request
            args:
              action: refund
              input:
                $var: params
    - $set:
        name: actionResult
        expr:
          $merge:
          - $var: actionResult
          - outcome:
              $choose:
                cond:
                  $or:
                  - $eq:
                    - $var:
                        name: actionResult
                        path: /created
                    - true
                  - $eq:
                    - $var:
                        name: actionResult
                        path: /changed
                    - true
                then: acceptedNew
                else: duplicate
    resultContract: outcome-v1
  requestVoid:
