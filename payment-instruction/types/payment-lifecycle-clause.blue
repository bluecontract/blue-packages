          $call:
            function: request
            args:
              action: void
              input:
                $var: params
    - $set:
        name: actionResult
        expr:
          $merge:
          - $var: actionResult
          - outcome:
              $choose:
                cond:
                  $or:
                  - $eq:
                    - $var:
                        name: actionResult
                        path: /created
                    - true
                  - $eq:
                    - $var:
                        name: actionResult
                        path: /changed
                    - true
                then: acceptedNew
                else: duplicate
    resultContract: outcome-v1
  acceptPaymentInstruction:
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: accept
            args:
              approved: true
              input:
                $var: params
    - $set:
        name: actionResult
        expr:
          $merge:
          - $var: actionResult
          - outcome:
              $choose:
                cond:
                  $or:
                  - $eq:
                    - $var:
                        name: actionResult
                        path: /created
