name: Payment Instruction
description: One payment with typed requests and authorized guarantor responses. The domain owns its financial
  ledger and outcome operations; clauses are opt-in.
payment: {}
paymentTerms: {}
contracts:
  __paymentLife:
    type: Contracts/Lifecycle Event Channel
    event:
      type: Contracts/Document Processing Initiated
  __paymentInitialize:
    type: Contracts/Sequential Workflow
    channel: __paymentLife
    order: -1000
    steps:
    - type: Contracts/Compute
      do:
      - $if:
          cond:
            $not:
              $exists:
                $document: /clauses
          then:
          - $appendEvent:
              type: PaymentInstruction/Initialize Payment
  __paymentInitializeRequested:
    type: Contracts/Triggered Event Channel
    event:
      type: PaymentInstruction/Initialize Payment
  __paymentInitializeLedger:
    type: Contracts/Sequential Workflow
    channel: __paymentInitializeRequested
    order: -1000
    steps:
    - type: PaymentInstruction/Initialize Payment Step
  acceptPaymentInstruction:
    type: Contracts/Sequential Workflow Operation
    channel: guarantor
    steps:
    - type: Parties/Require Active Parties
      constants:
        workflow: true
    - type: Contracts/Compute
      definition:
        type: PaymentInstruction/Payment Protocol Functions
      constants:
        sourceMode: workflow
      do:
      - $let:
          name: actionResult
          expr: {}
      - $let:
          name: params
          expr:
            $object:
              $binding: call/request
      - $set:
          name: actionResult
          expr:
            $call:
              function: acceptPublic
              args:
                approved: true
                input:
                  $var: params
      - $set:
          name: actionResult
          expr:
            $merge:
            - $var: actionResult
            - outcome:
                $choose:
                  cond:
                    $or:
                    - $eq:
                      - $var:
                          name: actionResult
                          path: /created
                      - true
                    - $eq:
                      - $var:
                          name: actionResult
                          path: /changed
                      - true
                  then: acceptedNew
                  else: duplicate
    requestFrom:
      definition:
        type: PaymentInstruction/Payment Protocol Functions
      function: acceptPublic
      argument: input
  rejectPaymentInstruction:
    type: Contracts/Sequential Workflow Operation
    channel: guarantor
    steps:
    - type: Contracts/Compute
      definition:
        type: PaymentInstruction/Payment Protocol Functions
      constants:
        sourceMode: workflow
      do:
      - $let:
          name: actionResult
          expr: {}
      - $let:
          name: params
          expr:
            $object:
              $binding: call/request
      - $set:
          name: actionResult
          expr:
            $call:
              function: rejectPublic
              args:
                approved: false
                input:
                  $var: params
      - $set:
          name: actionResult
          expr:
            $merge:
            - $var: actionResult
            - outcome:
                $choose:
                  cond:
                    $or:
                    - $eq:
                      - $var:
                          name: actionResult
                          path: /created
                      - true
                    - $eq:
                      - $var:
                          name: actionResult
                          path: /changed
                      - true
                  then: acceptedNew
                  else: duplicate
    requestFrom:
      definition:
        type: PaymentInstruction/Payment Protocol Functions
      function: rejectPublic
      argument: input
  recordTransactionInitiated:
    type: Contracts/Sequential Workflow Operation
    channel: guarantor
    steps:
    - type: Parties/Require Active Parties
      constants:
        workflow: true
    - type: Contracts/Compute
      definition:
        type: PaymentInstruction/Payment Protocol Functions
      constants:
        sourceMode: workflow
      do:
      - $let:
          name: actionResult
          expr: {}
      - $let:
          name: params
          expr:
            $object:
              $binding: call/request
      - $set:
          name: actionResult
          expr:
            $call:
              function: initiatePublic
              args:
                transactionId:
                  $var:
                    name: params
                    path: /transactionId
                input:
                  $var: params
      - $set:
          name: actionResult
          expr:
            $merge:
            - $var: actionResult
            - outcome:
                $choose:
                  cond:
                    $or:
                    - $eq:
                      - $var:
                          name: actionResult
                          path: /created
                      - true
                    - $eq:
                      - $var:
                          name: actionResult
                          path: /changed
                      - true
                  then: acceptedNew
                  else: duplicate
    requestFrom:
      definition:
        type: PaymentInstruction/Payment Protocol Functions
      function: initiatePublic
      argument: input
  recordTransactionInitiationFailed:
    type: Contracts/Sequential Workflow Operation
    channel: guarantor
    steps:
    - type: Contracts/Compute
      definition:
