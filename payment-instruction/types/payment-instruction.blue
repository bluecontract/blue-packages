              $binding: call/request
      - $set:
          name: actionResult
          expr:
            $call:
              function: recordInitiationFailurePublic
              args:
                input:
                  $var: params
      - $set:
          name: actionResult
          expr:
            $merge:
            - $var: actionResult
            - outcome:
                $choose:
                  cond:
                    $or:
                    - $eq:
                      - $var:
                          name: actionResult
                          path: /created
                      - true
                    - $eq:
                      - $var:
                          name: actionResult
                          path: /changed
                      - true
                  then: acceptedNew
                  else: duplicate
    requestFrom:
      definition:
        type: PaymentInstruction/Payment Protocol Functions
      function: recordInitiationFailurePublic
      argument: input
