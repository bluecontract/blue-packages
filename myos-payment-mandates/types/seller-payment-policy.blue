{
  "name": "Seller Payment Policy",
  "description": "Owner-approved limits for each prepared payment, not a cumulative spending budget. No private Agreement origin is asserted.",
  "version": "seller-payment-policy/1",
  "sellerAccountId": {
    "type": "Text",
    "schema": {
      "required": true,
      "minLength": 1
    }
  },
  "sellerAgentId": {
    "type": "Text",
    "schema": {
      "required": true,
      "minLength": 1
    }
  },
  "orderProfile": {
    "type": "Text",
    "schema": {
      "required": true,
      "minLength": 1
    }
  },
  "provider": {
    "type": "Text",
    "schema": {
      "required": true,
      "enum": [
        "test",
        "stripe"
      ]
    }
  },
  "recipientPaymentAccountId": {
    "type": "Text",
    "schema": {
      "required": true,
      "minLength": 1
    }
  },
  "guarantorAccountId": {
    "type": "Text",
    "schema": {
      "required": true,
      "minLength": 1
    }
  },
  "currency": {
    "type": "Text",
    "schema": {
      "required": true,
      "enum": [
        "PLN",
        "USD"
      ]
    }
  },
  "minimumAmountMinor": {
    "type": "Integer",
    "schema": {
      "required": true,
      "minimum": 1,
      "maximum": 1000000000000
    }
  },
  "maximumAmountMinor": {
    "type": "Integer",
    "schema": {
      "required": true,
      "minimum": 1,
      "maximum": 1000000000000
    }
  },
  "preparedInstructionType": "JBYxwqs723PKm4vRvMKfdw2gkNKeuXNkLicjF4Hf1uRL",
  "bootstrapPreparedPayment": true,
  "schema": {
    "maxFields": 12
  }
}
