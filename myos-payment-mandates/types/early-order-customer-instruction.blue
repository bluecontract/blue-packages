name: MyOS Early Order Customer Payment Instruction
type: MyOSPaymentMandates/MyOS Correlated Customer Payment Instruction
description: Explicit early Order profile. Native preparation freezes the Order review while seller approval is outstanding. A qualified native source observer must verify the original Order, reciprocal PI binding and frozen terms before opening capture. Cancellation intent never reports a financial result.
clauses:
  earlyOrderState:
    type:
      name: Early Order Payment State
      type: Connections/Connected Clause
      bindingTypes:
        order: pointer
      defaultBindings:
        order: /customerOrderState
      initialState:
        order:
          captureAllowed: false
          status: WAITING
          cancellationRequested: false
customerOrderTerms:
  revision:
    type: Integer
    schema: {required: true, minimum: 1}
  termsRef:
    schema: {required: true}
