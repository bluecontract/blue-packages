name: Payment Preparation Correlation
description: Native preparation provenance for one Order obligation. Values identify the Order's initial
  document and its actual preparation clause, item and request; they are not evidence of an Agreement origin.
orderDocumentId:
  type: Text
  schema: {required: true, minLength: 1}
clauseId:
  type: Text
  schema: {required: true, minLength: 1}
itemKey:
  type: Text
  schema: {required: true, minLength: 1}
requestId:
  type: Text
  schema: {required: true, minLength: 1}
schema:
  maxFields: 4
