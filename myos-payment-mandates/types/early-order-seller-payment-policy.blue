{
  "name": "Early Order Seller Payment Policy",
  "description": "Explicit owner approval for preparing and bootstrapping a pending seller Order under the exact early profile. Per-payment limits retain all account, Agent, provider, amount, currency and guarantor scope; this policy does not authorize seller acceptance or rejection.",
  "version": "seller-payment-policy/3",
  "sellerAccountId": {
    "type": "Text",
    "schema": {
      "required": true,
      "minLength": 1
    }
  },
  "sellerAgentId": {
    "type": "Text",
    "schema": {
      "required": true,
      "minLength": 1
    }
  },
  "orderProfile": "myos-order-customer-payment/5",
  "provider": {
    "type": "Text",
    "schema": {
      "required": true,
      "enum": [
        "test",
        "stripe"
      ]
    }
  },
  "recipientPaymentAccountId": {
    "type": "Text",
    "schema": {
      "required": true,
      "minLength": 1
    }
  },
  "guarantorAccountId": {
    "type": "Text",
    "schema": {
      "required": true,
      "minLength": 1
    }
  },
  "currency": {
    "type": "Text",
    "schema": {
      "required": true,
      "enum": [
        "PLN",
        "USD"
      ]
    }
  },
  "minimumAmountMinor": {
    "type": "Integer",
    "schema": {
      "required": true,
      "minimum": 1,
      "maximum": 1000000000000
    }
  },
  "maximumAmountMinor": {
    "type": "Integer",
    "schema": {
      "required": true,
      "minimum": 1,
      "maximum": 1000000000000
    }
  },
  "preparedInstructionType": "C7ypHvyw5pKNPsZtgTDcEFGvZTDtiKxSrKpMatrCQGCH",
  "bootstrapPreparedPayment": true,
  "schema": {
    "maxFields": 12
  }
}
