                                              "object": {
                                                "$binding": "targetDocument"
                                              },
                                              "path": {
                                                "$var": {
                                                  "name": "patch",
                                                  "path": "/sourcePath"
                                                }
                                              }
                                            }
                                          }
                                        },
                                        "else": {
                                          "$choose": {
                                            "cond": {
                                              "$eq": [
                                                {
                                                  "$var": {
                                                    "name": "patch",
                                                    "path": "/kind"
                                                  }
                                                },
                                                "integer"
                                              ]
                                            },
                                            "then": {
                                              "$integer": {
                                                "$pointerGet": {
                                                  "object": {
                                                    "$binding": "targetDocument"
                                                  },
                                                  "path": {
                                                    "$var": {
                                                      "name": "patch",
                                                      "path": "/sourcePath"
                                                    }
                                                  }
                                                }
                                              }
                                            },
                                            "else": {
                                              "$pointerGet": {
                                                "object": {
                                                  "$binding": "targetDocument"
                                                },
                                                "path": {
                                                  "$var": {
                                                    "name": "patch",
                                                    "path": "/sourcePath"
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          },
