                                                    "$pointerGet": {
                                                      "object": {
                                                        "$binding": "targetDocument"
                                                      },
                                                      "path": {
                                                        "$var": {
                                                          "name": "patch",
                                                          "path": "/sourcePath"
                                                        }
                                                      }
                                                    }
                                                  }
                                                },
                                                "else": {
                                                  "$pointerGet": {
                                                    "object": {
                                                      "$binding": "targetDocument"
                                                    },
                                                    "path": {
                                                      "$var": {
                                                        "name": "patch",
                                                        "path": "/sourcePath"
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
