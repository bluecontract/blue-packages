                                  }
                                },
                                "expr": {
                                  "$pointerSet": {
                                    "object": {
                                      "$var": "expected"
                                    },
                                    "path": {
                                      "$var": {
                                        "name": "patch",
                                        "path": "/path"
                                      }
                                    },
                                    "val": {
                                      "$choose": {
