                                },
                                "expr": {
                                  "$pointerSet": {
                                    "object": {
                                      "$var": "expected"
                                    },
                                    "path": {
                                      "$var": {
                                        "name": "patch",
                                        "path": "/path"
                                      }
                                    },
                                    "val": {
                                      "$choose": {
                                        "cond": {
                                          "$eq": [
                                            {
                                              "$var": {
                                                "name": "patch",
                                                "path": "/kind"
                                              }
                                            },
                                            "section"
                                          ]
                                        },
                                        "then": {
                                          "$call": {
                                            "function": "expectedPaymentTemplate",
                                            "args": {}
