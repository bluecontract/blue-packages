                                        },
                                        "else": {
                                          "$choose": {
                                            "cond": {
                                              "$eq": [
                                                {
                                                  "$var": {
                                                    "name": "patch",
                                                    "path": "/kind"
                                                  }
                                                },
                                                "text"
