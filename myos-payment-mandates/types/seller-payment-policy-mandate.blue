{
  "name": "Seller Payment Policy Mandate",
  "type": "InitializableMandates/Operation Mandate",
  "description": "One seller approves a self-contained canonical Order policy. Its Agent may provide the matching prepared PI, with explicit host-validated bootstrap consent. This neither approves Orders nor permits customer preparation.",
  "policy": {
    "type": "MyOSPaymentMandates/Seller Payment Policy",
    "schema": {
      "required": true
    }
  },
  "expectedProgram": {
    "description": "Server-generated canonical profile blueprints and enumerated substitutions, reviewed by the holder and independently qualified by Core. No caller-supplied predicate.",
    "contracts": {
      "schema": {
        "required": true
      }
    },
    "clauses": {
      "schema": {
        "required": true
      }
    },
    "paymentTemplate": {
      "schema": {
        "required": true
      }
    },
    "schema": {
      "required": true,
      "maxFields": 6
    },
    "orderType": {
      "schema": {
        "required": true
      }
    },
    "rootKeys": {
      "type": "List",
      "itemType": "Text",
      "schema": {
        "required": true
      }
    },
    "timelineAccess": {
      "schema": {
        "required": true
      }
    }
  },
  "grantTemplates": {
    "schema": {
      "maxFields": 1
    }
  },
  "scope": {
    "schema": {
      "maxFields": 1
    }
  },
  "contracts": {
    "initializeSellerPaymentScope": {
      "type": "Contracts/Sequential Workflow",
      "channel": "lifecycle",
      "event": {
        "type": "Contracts/Document Processing Initiated"
      },
      "order": 20,
      "steps": [
        {
          "type": "Contracts/Compute",
          "do": [
            {
              "$appendChange": {
                "op": "replace",
                "path": "/grantTemplates",
                "val": {
                  "payment": {
                    "$pointerSet": {
                      "object": {
                        "$pointerSet": {
                          "object": {
                            "$call": {
                              "function": "fixedPaymentGrant",
                              "args": {}
                            }
                          },
                          "path": "/target/documentValidation/function/constants/policyIdentity",
                          "val": {
                            "$nodeBlueId": {
                              "$document": "/policy"
                            }
                          }
                        }
                      },
                      "path": "/target/documentValidation/function/constants/expectedProgramIdentity",
                      "val": {
                        "$nodeBlueId": {
                          "$document": "/expectedProgram"
                        }
                      }
                    }
                  }
                }
              }
            },
            {
              "$appendChange": {
                "op": "replace",
                "path": "/scope",
                "val": {
                  "payment": {
                    "$pointerSet": {
                      "object": {
                        "$pointerSet": {
                          "object": {
                            "$call": {
                              "function": "fixedPaymentGrant",
                              "args": {}
                            }
                          },
                          "path": "/target/documentValidation/function/constants/policyIdentity",
                          "val": {
                            "$nodeBlueId": {
                              "$document": "/policy"
                            }
                          }
                        }
                      },
                      "path": "/target/documentValidation/function/constants/expectedProgramIdentity",
                      "val": {
                        "$nodeBlueId": {
                          "$document": "/expectedProgram"
                        }
                      }
                    }
                  }
                }
              }
            }
          ],
          "functions": {
            "fixedPaymentGrant": {
              "args": {},
              "expr": {
                "$literal": {
                  "target": {
                    "channel": "seller",
                    "operation": "providePayment",
                    "documentValidation": {
                      "function": {
                        "functions": {
                          "validReplacement": {
                            "args": {
                              "patch": {},
                              "sectionName": {
                                "type": "Text"
                              }
                            },
                            "expr": {
                              "$or": [
                                {
                                  "$and": [
                                    {
                                      "$eq": [
                                        {
                                          "$var": {
                                            "name": "patch",
                                            "path": "/kind"
                                          }
                                        },
                                        "text"
                                      ]
                                    },
                                    {
                                      "$isKind": {
                                        "val": {
                                          "$pointerGet": {
                                            "object": {
                                              "$binding": "targetDocument"
                                            },
                                            "path": {
                                              "$var": {
                                                "name": "patch",
                                                "path": "/sourcePath"
                                              }
                                            }
                                          }
                                        },
                                        "kind": "text"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "$and": [
                                    {
                                      "$eq": [
                                        {
                                          "$var": {
                                            "name": "patch",
                                            "path": "/kind"
                                          }
                                        },
                                        "integer"
                                      ]
                                    },
                                    {
                                      "$isKind": {
                                        "val": {
                                          "$pointerGet": {
                                            "object": {
                                              "$binding": "targetDocument"
                                            },
                                            "path": {
                                              "$var": {
                                                "name": "patch",
                                                "path": "/sourcePath"
                                              }
                                            }
                                          }
                                        },
                                        "kind": "integer"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "$and": [
                                    {
                                      "$eq": [
                                        {
                                          "$var": {
                                            "name": "patch",
                                            "path": "/kind"
                                          }
                                        },
                                        "reference"
                                      ]
                                    },
                                    {
                                      "$eq": [
                                        {
                                          "$var": "sectionName"
                                        },
                                        "contracts"
                                      ]
                                    },
                                    {
                                      "$eq": [
                                        {
                                          "$var": {
                                            "name": "patch",
                                            "path": "/path"
                                          }
                                        },
                                        "/initialized/document"
                                      ]
                                    },
                                    {
                                      "$eq": [
                                        {
                                          "$var": {
                                            "name": "patch",
                                            "path": "/sourcePath"
                                          }
                                        },
                                        "/contracts/initialized/document"
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "$and": [
                                    {
                                      "$eq": [
                                        {
                                          "$var": {
                                            "name": "patch",
                                            "path": "/kind"
                                          }
                                        },
                                        "section"
                                      ]
                                    },
                                    {
                                      "$eq": [
                                        {
                                          "$var": "sectionName"
                                        },
                                        "contracts"
                                      ]
                                    },
                                    {
                                      "$eq": [
                                        {
                                          "$var": {
                                            "name": "patch",
                                            "path": "/section"
                                          }
                                        },
                                        "paymentTemplate"
                                      ]
                                    },
                                    {
                                      "$includes": {
                                        "list": [
                                          "/preparePayment/steps/0/functions/connectionSnapshots/expr/$literal/template",
                                          "/providePayment/steps/0/functions/connectionSnapshots/expr/$literal/template"
                                        ],
                                        "val": {
                                          "$var": {
                                            "name": "patch",
                                            "path": "/path"
                                          }
                                        }
                                      }
                                    }
                                  ]
                                },
                                {
                                  "$and": [
                                    {
                                      "$eq": [
                                        {
                                          "$var": {
                                            "name": "patch",
                                            "path": "/kind"
                                          }
                                        },
                                        "reference"
                                      ]
                                    },
                                    {
                                      "$eq": [
                                        {
                                          "$var": "sectionName"
                                        },
                                        "timelineAccess"
                                      ]
                                    },
                                    {
                                      "$eq": [
                                        {
                                          "$var": {
                                            "name": "patch",
                                            "path": "/sourcePath"
                                          }
                                        },
                                        {
                                          "$concat": [
                                            "/timelineAccess",
                                            {
                                              "$var": {
                                                "name": "patch",
                                                "path": "/path"
                                              }
                                            }
                                          ]
                                        }
                                      ]
                                    },
                                    {
                                      "$includes": {
                                        "list": [
                                          "/customer/contracts/initialized/document",
                                          "/customer/allowedTimelines/0",
                                          "/seller/contracts/initialized/document",
                                          "/seller/allowedTimelines/0",
                                          "/partner/contracts/initialized/document",
                                          "/partner/allowedTimelines/0",
                                          "/customer__myosAgent/contracts/initialized/document",
                                          "/customer__myosAgent/allowedTimelines/0",
                                          "/seller__myosAgent/contracts/initialized/document",
                                          "/seller__myosAgent/allowedTimelines/0",
                                          "/partner__myosAgent/contracts/initialized/document",
                                          "/partner__myosAgent/allowedTimelines/0"
                                        ],
                                        "val": {
                                          "$var": {
                                            "name": "patch",
                                            "path": "/path"
                                          }
                                        }
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          },
                          "expectedPaymentTemplate": {
                            "args": {},
                            "expr": {
                              "$reduce": {
                                "in": {
                                  "$pointerGet": {
                                    "object": {
                                      "$document": "/expectedProgram/paymentTemplate"
                                    },
                                    "path": "/replacements"
                                  }
                                },
                                "item": "patch",
                                "acc": "expected",
                                "init": {
                                  "$call": {
                                    "function": "decodeDefinition",
                                    "args": {
