{
  "$pointerSet": {
    "object": {
      "$pointerSet": {
        "object": {
          "$var": "trigger"
        },
        "path": "/type",
        "op": "remove"
      }
    },
    "path": "/values/paymentPreparation",
    "val": {
      "orderDocumentId": {
        "$nodeBlueId": {
          "$document": "/contracts/initialized/document"
        }
      },
      "clauseId": {
        "$const": "clauseKey"
      },
      "itemKey": {
        "$choose": {
          "cond": {
            "$isKind": {
              "val": {
                "$pointerGet": {
                  "object": {
                    "$var": "trigger"
                  },
                  "path": "/key"
                }
              },
              "kind": "text"
            }
          },
          "then": {
            "$text": {
              "$pointerGet": {
                "object": {
                  "$var": "trigger"
                },
                "path": "/key"
              }
            }
          },
          "else": "single"
        }
      },
      "requestId": {
        "$choose": {
          "cond": {
            "$isKind": {
              "val": {
                "$pointerGet": {
                  "object": {
                    "$var": "trigger"
                  },
                  "path": "/requestId"
                }
              },
              "kind": "text"
            }
          },
          "then": {
            "$text": {
              "$pointerGet": {
                "object": {
                  "$var": "trigger"
                },
                "path": "/requestId"
              }
            }
          },
          "else": {
            "$choose": {
              "cond": {
                "$isKind": {
                  "val": {
                    "$pointerGet": {
                      "object": {
                        "$var": "trigger"
                      },
                      "path": "/key"
                    }
                  },
                  "kind": "text"
                }
              },
              "then": {
                "$text": {
                  "$pointerGet": {
                    "object": {
                      "$var": "trigger"
                    },
                    "path": "/key"
                  }
                }
              },
              "else": "single"
            }
          }
        }
      }
    }
  }
}
