name: Amendments Clause
type: Connections/Connected Clause
bindingTypes:
  state: pointer
  editable: pointer
actionDefinition:
  type: Amendments/Amendments Functions
actions:
  initialize:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: initialize
            args:
              input:
                $var: params
    automatic:
      'on': initialized
      once: true
  propose:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: propose
            args:
              input:
                $var: params
  approve:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: approve
            args:
              input:
                $var: params
defaultBindings:
  state: /amendments
  editable: /termsEditable
