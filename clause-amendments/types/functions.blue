name: Amendments Functions
type: Amendments/Amendment Proposal Functions
functions:
  initialize:
    args:
      input: {}
    do:
    - $appendChange:
        op: add
        path:
          $const:
            name: bindings
            path: /state
        val:
          revision: 1
          proposal: {}
          history: {}
    - $return:
        outcome: acceptedNew
  propose:
    args:
      input: {}
    do:
    - $let:
        name: actor
        expr:
          $binding: call/channel
    - $failIf:
        cond:
          $not:
            $includes:
              list:
                $const:
                  name: parameters
                  path: /approvers
              val:
                $var: actor
        message: APPROVER_REQUIRED
    - $return:
        $call:
          function: recordProposal
          args:
            input:
              $var: input
  approve:
    args:
      input: {}
    do:
    - $return:
        $call:
          function: approveAmendmentProposal
          args:
            input:
              $var: input
            parameters:
              $const: parameters
            bindings:
              $const: bindings
            clauseKey:
              $const: clauseKey
            state:
              $document:
                $const:
                  name: bindings
                  path: /state
  recordProposal:
    args:
      input: {}
    do:
    - $return:
        $call:
          function: recordAmendmentProposal
          args:
            input:
              $var: input
            parameters:
              $const: parameters
            bindings:
              $const: bindings
            clauseKey:
              $const: clauseKey
            state:
              $document:
                $const:
                  name: bindings
                  path: /state
