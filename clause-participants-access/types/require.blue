name: Require Participant Access
description: Place first in each protected operation; a missing participant grant atomically rejects the attempt.
type: Contracts/Compute
constants: {}
do:
- $let:
    name: p
    expr:
      $document:
        $concat:
        - /clauses/
        - $const: clauseKey
        - /parameters
- $let:
    name: valid
    expr: true
- $forEach:
    item: role
    in:
      $keys:
        $var:
          name: p
          path: /participants
    do:
    - $let:
        name: party
        expr:
          $get:
            object:
              $var:
                name: p
                path: /participants
            key:
              $var: role
    - $let:
        name: matched
        expr: false
    - $forEach:
        item: path
        in:
          $var:
            name: p
            path: /accessPaths
        do:
        - $let:
            name: access
            expr:
              $document:
                $var: path
        - $let:
            name: timelineFound
            expr: false
        - $let:
            name: keysFound
            expr: true
        - $forEach:
            item: timeline
            in:
              $pointerGet:
                object:
                  $var: access
                path: /allowedTimelines
                default: []
            do:
            - $if:
                cond:
                  $eq:
                  - $nodeBlueId:
                      $objectFromEntries:
                        $entries:
                          $var: timeline
                  - $nodeBlueId:
                      $objectFromEntries:
                        $entries:
                          $var:
                            name: party
                            path: /channel/timeline
                then:
                - $set:
                    name: timelineFound
                    expr: true
        - $forEach:
            item: readerRole
            in:
              $keys:
                $var:
                  name: p
                  path: /participants
            do:
            - $let:
                name: reader
                expr:
                  $get:
                    object:
                      $var:
                        name: p
                        path: /participants
                    key:
                      $var: readerRole
            - $if:
                cond:
                  $hasKey:
                    object:
                      $var: reader
                    key: readerKey
                then:
                - $let:
                    name: keyFound
                    expr: false
                - $forEach:
                    item: key
                    in:
                      $pointerGet:
                        object:
                          $var: access
                        path: /allowedKeys
                        default: []
                    do:
                    - $if:
                        cond:
                          $eq:
                          - $var: key
                          - $var:
                              name: reader
                              path: /readerKey
                        then:
                        - $set:
                            name: keyFound
                            expr: true
                - $if:
                    cond:
                      $not:
                        $var: keyFound
                    then:
                    - $set:
                        name: keysFound
                        expr: false
        - $if:
            cond:
              $and:
              - $var: timelineFound
              - $var: keysFound
              - $eq:
                - $nodeBlueId:
                    $objectFromEntries:
                      $entries:
                        $var:
                          name: party
                          path: /channel/timeline/provider
                - $nodeBlueId:
                    $objectFromEntries:
                      $entries:
                        $pointerGet:
                          object:
                            $var: access
                          path: /contracts/provider/provider
                          default: {}
            then:
            - $set:
                name: matched
                expr: true
    - $if:
        cond:
          $not:
            $var: matched
        then:
        - $set:
            name: valid
            expr: false
- $failIf:
    cond:
      $not:
        $var: valid
    message: PARTICIPANT_ACCESS_MISSING
