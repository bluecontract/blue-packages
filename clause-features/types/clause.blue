name: Delivery Instructions Clause
type: Connections/Connected Clause
bindingTypes:
  text: pointer
  lifecycle: pointer
actionDefinition:
  type: Features/Delivery Instructions Functions
actions:
  amend:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: amend
            args:
              input:
                $var: params
defaultBindings:
  text: /instructions
  lifecycle: /status
