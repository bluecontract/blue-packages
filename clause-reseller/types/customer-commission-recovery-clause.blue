name: Customer Commission Recovery Clause
type: Features/Feature Clause
description: Optional guarantor confirmation of commission recovery for a commissioned customer payment only.
actionDefinition:
  type: Reseller/Customer Commission Recovery Functions
parameters:
  actions:
    confirm:
      do:
      - $call:
          function: requireActive
          args:
            channel: {$binding: call/channel}
            workflow: true
      - $call:
          function: confirmRecovery
          args:
            input: {$var: {name: params, path: /input}}
