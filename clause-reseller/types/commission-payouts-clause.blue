name: Commission Payouts Clause
type: Documents/Document Base
description: Prepare one MyOS account-to-account commission payout as an independent Payment Instruction. The settled
  commission G is reserved once; the instruction freezes the MyOS fee F and the partner transfer N = G - F with
  the Agreement operator. The seller bootstraps it with the MyOS operator as its supplied guarantor and provides
  it back; the operator debits the seller's and credits the partner's own payment accounts. Guard unresolved payouts.
actionDefinition:
  type:
    type: Documents/Preparation Functions
    functions:
      # Exact shared Money/Rounding.roundBps; the fee uses the same rounding as commission accrual.
      roundBps:
        blueId: 8iDeuRctE9WWrNAH7Zpuy3ET9fqYjS9PpGu6kCbYwksB
      resolvePayoutTerms:
        args:
          grossMinor:
            type: Integer
        do:
        - $failIf:
            cond:
              $ne:
              - $document: /terms/payoutFeePolicy
              - myos-commission-fee-v1
            message: PAYOUT_FEE_POLICY_UNSUPPORTED
        # The only definition of the current MyOS fee rate (20%).
        - $let:
            name: feeBps
            expr: 2000
        - $let:
            name: feeMinor
            expr:
              $call:
                function: roundBps
                args:
                  basis:
                    $var: grossMinor
                  bps:
                    $var: feeBps
        - $let:
            name: netMinor
            expr:
              $subtract:
              - $var: grossMinor
              - $var: feeMinor
        - $failIf:
            cond:
              $lt:
              - $var: netMinor
              - 1
            message: PAYOUT_NET_NOT_POSITIVE
        - $return:
            feePolicy: myos-commission-fee-v1
            feeBps:
              $var: feeBps
            grossMinor:
              $var: grossMinor
            feeMinor:
              $var: feeMinor
            netMinor:
              $var: netMinor
      domainPrepare:
        args:
          prepared: {}
        do:
        - $let:
            name: terms
            expr:
              $pointerGet:
                object:
                  $var: prepared
                path: /paymentTerms
        - $let:
            name: details
            expr:
              $pointerGet:
                object:
                  $var: prepared
                path: /paymentDetails
        - $let:
            name: split
            expr:
              $pointerGet:
                object:
                  $var: details
                path: /payoutTerms
        - $let:
            name: parties
            expr:
              $pointerGet:
                object:
                  $var: prepared
                path: /clauses/activation/parameters/parties
        - $failIf:
            cond:
              $not:
                $and:
                - $eq:
                  - $nodeBlueId:
                      $pointerGet:
                        object:
                          $var: prepared
                        path: /type
                  - $nodeBlueId:
                      $choose:
                        cond:
                          $eq:
                          - $document: /terms/payoutOperator
                          - test
                        then:
                          $get:
                            object:
                              type: MyOS/MyOS Test Account to Account Payment Instruction
                            key: type
                        else:
                          $get:
                            object:
                              type: MyOS/MyOS Stripe Account to Account Payment Instruction
                            key: type
                - $eq:
                  - $pointerGet:
                      object:
                        $var: details
                      path: /method
                  - myos-account-to-account
                - $eq:
                  - $pointerGet:
                      object:
                        $var: terms
                      path: /amountMinor
                  - $pointerGet:
                      object:
                        $var: split
                      path: /netMinor
                - $eq:
                  - $pointerGet:
                      object:
                        $var: terms
                      path: /limitMinor
                  - $pointerGet:
                      object:
                        $var: split
                      path: /netMinor
                - $eq:
                  - $pointerGet:
                      object:
                        $var: terms
                      path: /currency
                  - $document: /terms/currency
                - $eq:
                  - $pointerGet:
                      object:
                        $var: split
                      path: /currency
                  - $document: /terms/currency
                - $eq:
                  - $pointerGet:
                      object:
                        $var: split
                      path: /operator
                  - $document: /terms/payoutOperator
                - $hasKey:
                    object:
                      $var: parties
                    key:
                      $pointerGet:
                        object:
                          $var: terms
                        path: /payerChannel
                - $hasKey:
                    object:
                      $var: parties
                    key:
                      $pointerGet:
                        object:
                          $var: terms
                        path: /payeeChannel
                - $hasKey:
                    object:
                      $var: parties
                    key:
                      $pointerGet:
                        object:
                          $var: terms
                        path: /guarantorChannel
            message: PAYOUT_INSTRUCTION_INVALID
        - $return:
            paymentTerms:
              $var: terms
            paymentDetails:
              $var: details
      domainValidateCandidate:
        args:
          frozenTerms: {}
          candidate: {}
        do:
        - $failIf:
            cond:
              $or:
              - $ne:
                - $pointerGet:
                    object:
                      $var: frozenTerms
                    path: /paymentTerms
                - $pointerGet:
                    object:
                      $var: candidate
                    path: /paymentTerms
              - $ne:
                - $pointerGet:
                    object:
                      $var: frozenTerms
                    path: /paymentDetails
                - $pointerGet:
                    object:
                      $var: candidate
                    path: /paymentDetails
            message: PAYOUT_TERMS_MISMATCH
        - $return: true
      domainNextActions:
        args:
          documentRef: {}
        do:
        - $return: []
cardinality: keyed
destinationBinding: collection
parameters:
  prepareFor: bootstrap
  obtain: provide
  suppliedBy: seller
  suppliedParties:
  - guarantor
  allowedFields: []
  fieldPaths:
    amountMinor: /paymentTerms/amountMinor
    limitMinor: /paymentTerms/limitMinor
    payoutTerms: /paymentDetails/payoutTerms
bindingTypes:
  collection: pointer
  commission: pointer
defaultBindings:
  collection: /payouts
  commission: /commission
embedsCollections:
- collection
actions:
  preparePayout:
    resultContract: outcome-v1
    defaults:
      fields: {}
      values: {}
    preflight:
    - $forEach:
        item: field
        in:
          $keys:
            $var: trigger
        do:
        - $failIf:
            cond:
              $not:
                $includes:
                  list:
                  - key
                  - amountMinor
                  val:
                    $var: field
            message: UNKNOWN_INPUT_FIELD
    - $failIf:
        cond:
          $not:
            $and:
            - $isKind:
                val:
                  $var:
                    name: trigger
                    path: /amountMinor
                kind: integer
            - $gte:
              - $var:
                  name: trigger
                  path: /amountMinor
              - 1
            - $lte:
              - $var:
                  name: trigger
                  path: /amountMinor
              - 100000000
        message: INVALID_AMOUNT
    - $if:
        cond:
          $not:
            $exists:
              $document:
                $concat:
                - /process_
                - $const: clauseKey
                - /entries/
                - $nodeBlueId:
                    $var:
                      name: trigger
                      path: /key
        then:
        - $failIf:
            cond:
              $gte:
              - $size:
                  $keys:
                    $document:
                      $concat:
                      - /process_
                      - $const: clauseKey
                      - /entries
              - 20
            message: DOCUMENT_LIMIT_REACHED
        - $failIf:
            cond:
              $ne:
              - $document:
                  $concat:
                  - $const:
                      name: bindings
                      path: /commission
                  - /reserved
              - 0
            message: PAYOUT_ALREADY_UNRESOLVED
    - $failIf:
        cond:
          $not:
            $includes:
              list:
              - test
              - stripe
              val:
                $document: /terms/payoutOperator
        message: PAYOUT_OPERATOR_UNSUPPORTED
    - $let:
        name: split
        expr:
          $call:
            function: resolvePayoutTerms
            args:
              grossMinor:
                $var:
                  name: trigger
                  path: /amountMinor
    - $set:
        name: params
        expr:
          key:
            $var:
              name: trigger
              path: /key
          values:
            amountMinor:
              $var:
                name: split
                path: /netMinor
            limitMinor:
              $var:
                name: split
                path: /netMinor
            payoutTerms:
              $merge:
              - $var: split
              - payoutKey:
                  $var:
                    name: trigger
                    path: /key
                currency:
                  $document: /terms/currency
                operator:
                  $document: /terms/payoutOperator
    - $set:
        name: actionResult
        expr:
          $call:
            function: checkPreparation
            args:
              input:
                $var: params
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: sharedPrepare
            args:
              input:
                $var: params
              checked:
                $var: actionResult
    - $if:
        cond:
          $eq:
          - $var:
              name: actionResult
              path: /outcome
          - acceptedNew
        then:
        - $appendEvent:
            $merge:
            - type: Events/Event
            - kind: Commission Payout Opened
              key:
                $var:
                  name: trigger
                  path: /key
              amountMinor:
                $var:
                  name: trigger
                  path: /amountMinor
