      requireActive:
        blueId: FFUQRPa7UV6WYAJefccRC6KW9EV55Xzuaws52XHntCKE
      termsCurrent:
        blueId: 9XTKAvSrFK8cBd1vDQ4BEG8Dn77LbshNDcWbMYWcn5DB
      transports:
        blueId: ERUpqV1ukEE2eZWaDJP6Dxne1Z12WTkrXgDiKDGRgDjV
