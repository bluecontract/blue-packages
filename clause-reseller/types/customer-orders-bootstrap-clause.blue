      validateBootstrapAccessWithAdmission:
        blueId: CpRkLzKsHfryAa4cGj63YyP68kGbhAHffbcfbV1SfhBC
      validateProviderSlotsWithAdmission:
        blueId: 8hPfP6XP2MqcWR8EbUtkReGKvMt1huTkuHf92ppczFNQ
      accessRecordsValid:
        blueId: BWZxSpWmbP4QkHTnBXNHtVgmNNL8s5jy3DMkS6KbgBwb
