name: Customer Orders Bootstrap Clause
type: Clauses/Clause
description: 'Hosted customer Orders: preserve exact native quote and customer requirements, bootstrap the full
  participant roster through ordinary Core, then provide the initialized Order. Historical embedded Customer Orders
  remain a separate profile.'
actionDefinition:
  type:
    type: Contracts/Compute Definition
    functions:
      rootSourceReaderScope:
        blueId: 9UBgJm6Nrw3iMKAu9CpfS9mkZwqN6jLAwdDGusdaGdGa
      rootSourceReaderGroupsMatch:
        blueId: Eb5SaH46VJA3qZbLfQuzqDarhuhKkuE4smShvQoiCWPb
