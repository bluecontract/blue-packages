      rebaseAdmission:
        blueId: 5cfQnyCzcELBEw5bK7XnYP6Nh8teMjQHoHwU9kz5jUHi
      rebaseAdmissionPublic:
        blueId: 2c2Bn9AK7exPxBSdXfWtutFRf1YN1pRYr4SGZhSJYjFE
      retireAdmission:
        blueId: 7CYMqmVECevjyCcD9hQNnYG3Xb5Jd7aqd1RJCnhDkWZ4
      retireInvalidAdmission:
        blueId: AuCd4CneHodB6cXSmJBoxpLBAgH7EaqbXXjVYC64XV18
      cancelPublic:
        blueId: G87eccnBRVRxCybsx5oMjHcE1qBnP2JcAQ5hNXREgpgR
      candidateClausePolicy:
        blueId: Ba8eDf4pcBEe2gej2PGtRRoDPXgA4cn2RmhfJRzdSdSQ
      checkCancellation:
        blueId: Fy77uRiordK2JsVVxf15CNd4amDCBT3hj7TULh8oZ4Z1
      checkCandidateSources:
        blueId: GzD6cSR5VJ4HzKuAvxev3SeTJhmwQq3SZ9DzkxMUYpWT
      checkPreparation:
        blueId: DaQmWD2oXGcwtiUpMbrj33dT6UGkF1gcKzDDJBoegLuk
      checkProvision:
        blueId: Bs5fTU9Kf538SFqfb9C2nPpS4Z7NDvypLSndzHkhMoj4
      checkedDomainNextActions:
        blueId: ARzZgck3qEStHv5377YNq39fLf18XWYHqg9Lfy94iBeR
      checkedDomainPrepare:
        blueId: 3egFPLpJSMaeAHLvEsJr6EfGmBBafHZ2T4GJ3dezGLnu
      checkedDomainValidateCandidate:
        blueId: 3fbKM4irJEqr1vPyPxTTUCna5PZ3mGVJqbcC1z9xx4w9
      configuredConstraint:
        blueId: E5cs7YVkd5FBZztaj3Xc98Z2X7pLiygGmzJrnF958AqF
      domainNextActions:
        args:
          documentRef: {}
        do:
        - $return: []
      domainPrepare:
        args:
          prepared: {}
        do:
        - $return:
            $merge:
            - request:
                $var:
                  name: prepared
                  path: /orderRequest
              quote:
                $var:
                  name: prepared
                  path: /quote
              quoteBlueId:
                $var:
                  name: prepared
                  path: /quoteBlueId
              amountMinor:
                $var:
                  name: prepared
                  path: /amountMinor
              orderSnapshot:
                $pointerGet:
                  object:
                    $var: prepared
                  path: /orderSnapshot
                  default: {}
            - $choose:
                cond:
                  $exists:
                    $var:
                      name: prepared
                      path: /customerAccountId
                then:
                  customerAccountId:
                    $var:
                      name: prepared
                      path: /customerAccountId
                else: {}
      domainValidateCandidate:
        args:
          frozenTerms: {}
          candidate: {}
        do:
        - $failIf:
            cond:
              $not:
                $and:
                - $isKind:
                    val:
                      $var:
                        name: candidate
                        path: /customerAccountId
                    kind: text
                - $ne:
                  - $var:
                      name: candidate
                      path: /customerAccountId
                  - ''
            message: CUSTOMER_BINDING_REQUIRED
        - $failIf:
            cond:
              $eq:
              - $var:
                  name: candidate
                  path: /customerAccountId
              - $var:
                  name: candidate
                  path: /activation/parties/partner/myosAccountId
            message: CUSTOMER_MUST_BE_DISTINCT
        - $failIf:
            cond:
              $eq:
              - $var:
                  name: candidate
                  path: /customerAccountId
              - $var:
                  name: candidate
                  path: /activation/parties/seller/myosAccountId
            message: CUSTOMER_MUST_BE_DISTINCT
        - $failIf:
            cond:
              $and:
              - $exists:
                  $var:
                    name: frozenTerms
                    path: /customerAccountId
              - $ne:
                - $var:
                    name: candidate
                    path: /customerAccountId
                - $var:
                    name: frozenTerms
                    path: /customerAccountId
            message: CUSTOMER_ORDER_COMMERCIAL_TERMS_CHANGED
        - $failIf:
            cond:
              $ne:
              - $var:
                  name: candidate
                  path: /quote
              - $var:
                  name: frozenTerms
                  path: /quote
            message: CUSTOMER_ORDER_COMMERCIAL_TERMS_CHANGED
        - $failIf:
            cond:
              $ne:
              - $var:
                  name: candidate
                  path: /quoteBlueId
              - $var:
                  name: frozenTerms
                  path: /quoteBlueId
            message: CUSTOMER_ORDER_COMMERCIAL_TERMS_CHANGED
        - $failIf:
            cond:
              $ne:
              - $var:
                  name: candidate
                  path: /amountMinor
              - $var:
                  name: frozenTerms
                  path: /amountMinor
            message: CUSTOMER_ORDER_COMMERCIAL_TERMS_CHANGED
        - $failIf:
            cond:
              $ne:
              - $choose:
                  cond:
                    $and:
                    - $not:
                        $exists:
                          $var:
                            name: frozenTerms
                            path: /customerAccountId
                    - $exists:
                        $var:
                          name: frozenTerms
                          path: /orderSnapshot/customer
                  then:
                    $pointerSet:
                      object:
                        $pointerGet:
                          object:
                            $var: candidate
                          path: /orderSnapshot
                          default: {}
                      path: /customer
                      val:
                        $var:
                          name: frozenTerms
                          path: /orderSnapshot/customer
                  else:
                    $pointerGet:
                      object:
                        $var: candidate
                      path: /orderSnapshot
                      default: {}
              - $var:
                  name: frozenTerms
                  path: /orderSnapshot
            message: CUSTOMER_ORDER_FULFILMENT_CHANGED
        - $failIf:
            cond:
              $ne:
              - $var:
                  name: candidate
                  path: /activation/parties/customer/myosAccountId
              - $choose:
                  cond:
                    $exists:
                      $var:
                        name: frozenTerms
                        path: /customerAccountId
                  then:
                    $var:
                      name: frozenTerms
                      path: /customerAccountId
                  else:
                    $var:
                      name: candidate
                      path: /customerAccountId
            message: CUSTOMER_ORDER_IDENTITY_CHANGED
        - $failIf:
            cond:
              $ne:
              - $var:
                  name: candidate
                  path: /contracts/initialized/document/clauses/activation/parameters/parties/customer/myosAccountId
              - $choose:
                  cond:
                    $exists:
                      $var:
                        name: frozenTerms
                        path: /customerAccountId
                  then:
                    $var:
                      name: frozenTerms
                      path: /customerAccountId
                  else:
                    $var:
                      name: candidate
                      path: /customerAccountId
            message: CUSTOMER_ORDER_BOOTSTRAP_IDENTITY_CHANGED
        - $if:
            cond:
              $and:
              - $not:
                  $exists:
                    $var:
                      name: frozenTerms
                      path: /customerAccountId
              - $exists:
                  $var:
                    name: frozenTerms
                    path: /orderSnapshot/customer
            then:
            - $failIf:
                cond:
                  $ne:
                  - $nodeBlueId:
                      $var:
                        name: candidate
                        path: /orderSnapshot/customer
                  - $nodeBlueId:
                      $objectSet:
                        object:
                          $var:
                            name: frozenTerms
                            path: /orderSnapshot/customer
                        key: myosAccountId
                        val:
                          $var:
                            name: candidate
                            path: /customerAccountId
                message: CUSTOMER_ORDER_FULFILMENT_IDENTITY_CHANGED
        - $if:
            cond:
              $exists:
                $var:
                  name: frozenTerms
                  path: /orderSnapshot/seller
            then:
            - $failIf:
                cond:
                  $not:
                    $and:
                    - $eq:
                      - $var:
                          name: candidate
                          path: /orderSnapshot/seller/myosAccountId
                      - $var:
                          name: candidate
                          path: /activation/parties/seller/myosAccountId
                    - $eq:
                      - $var:
                          name: candidate
                          path: /orderSnapshot/seller/myosAccountId
                      - $var:
                          name: candidate
                          path: /contracts/initialized/document/clauses/activation/parameters/parties/seller/myosAccountId
                message: CUSTOMER_ORDER_FULFILMENT_IDENTITY_CHANGED
        - $return: true
      itemPath:
        blueId: 689Jn4o4XPk6tMK5SRQeicpXtZc7RH9tnzgCadNxauA1
      normalizeSlots:
        blueId: BN7uChhby6MQ8QTz16ComXuUbmvW7xNX8s79vatSkQgQ
      normalizedClausePolicy:
        blueId: FWDtktHquEf94E4Ddufwmd1DRw993N793WjrgDGS28Na
      prepareKeyedPublic:
        blueId: 8ga2mhmKwFziYyAnrJ7PC2S1rU7yqXqEnQmFCT6vCvSH
      preparePublic:
        blueId: 8nkcSe87zFqVxhiDuPcLPhgbwo3zZ7KTxxFFqyjr8VYW
      processContext:
        blueId: HMyYqWV2Z8dttN7mEgE4c43hxHtwqVszg3X8r2QcGqxy
      processStatePath:
        blueId: 6QXrUmZRXVy88TLUtc18x12cdMJDTntTnjhWTJkJc22j
      providePublic:
        blueId: 8MKw3zkU2zJFtbDGvcD52EnoZ4KQZX3NMPafr3jTvSts
      sharedCancel:
        blueId: gjjdFxGAguRJf83aqB3JEAjnasALwyEpaMyyLjFvCLo
      sharedPrepare:
        blueId: 4tq75TjxiAehN3DeHaN3Q9QKZcy3Np6eUtgWyq6nev4C
      sharedProvide:
        blueId: FZFj2x3kpHy8TBoRmdVuZtNU4P8pcvqd4LyWPzFTzaav
      sharedRefresh:
        blueId: AynC5EBRaeU35R5bVn12setevqkqGx8pZAe3K1bzwmye
      slotWitness:
        blueId: 3U4hCAhHJxSnEtMbb3dxtDpqojPFKKffPz8xjbXo479V
      specializationSlots:
        blueId: Go7j9vnxxEVuhiGfcMDcSDEwZMZ65xL4mxQ1LUtvbuSD
      validateProviderSlots:
        blueId: 7nnQ8G2LSrtC7fYrcid64Uf2b5DYH2fw2JJiG6tC2ujq
      validateFields:
        blueId: GByX6ruLZb6tSEPcRxMaRbd5fECsVsUSG3x6s5Dv6cTB
      validateInteger:
        blueId: 12iMBcxoxTPHtxKQcN8Dq59TSUcGbM9xQ9kZh5Vt5RGJ
      validateIdentifier:
        blueId: EQqobr2xgAJtjDXQdMYqX4Nz442Nsz8hrRp4DigwHNsY
      validateTerms:
        blueId: 9AxmRcd35ToficguVjW16mmfVmNBwWo6Tkto1DmrAbjA
      validateGroupSelections:
        blueId: 6Ud5Qi5RneB6Gso6sDDWFrbHXXfnpq3RmR5vzkbkRwiB
      makeProposal:
        blueId: HjmASuWBFrh9XeH7g24DsgnDHU7SJC73koFuCZiNsDEv
      initialGroups:
        blueId: Fqc3hnFEpfvCSJe1EZwZgR8EqPXuAFqVtZNHXcdDL4dq
      roundBps:
        blueId: 8iDeuRctE9WWrNAH7Zpuy3ET9fqYjS9PpGu6kCbYwksB
      # Exact quote-based helper owned by this separate bootstrap profile.
      prepareBooking:
        args:
          input: {}
        do:
        - $let:
            name: fields
            expr:
              $var:
                name: input
                path: /fields
        - $if:
            cond:
              $hasKey:
                object:
                  $var: input
                key: quoteKey
            then:
            - $call:
                function: validateIdentifier
                args:
                  candidate:
                    $var:
                      name: input
                      path: /quoteKey
                  error: INVALID_QUOTE_KEY
            - $let:
                name: quote
                expr:
                  $get:
                    object:
                      $document:
                        $const:
                          name: bindings
                          path: /quotes
                    key:
                      $var:
                        name: input
                        path: /quoteKey
            - $failIf:
                cond:
                  $not:
                    $exists:
                      $var: quote
                message: UNKNOWN_QUOTE
            - $set:
                name: fields
                expr:
                  $merge:
                  - $var: fields
                  - amountMinor:
                      $var:
                        name: quote
                        path: /totalMinor
                    quote:
                      $var: quote
                    quoteBlueId:
                      $nodeBlueId:
                        $var: quote
        - $if:
            cond:
              $exists:
                $document:
                  $const:
                    name: bindings
                    path: /fulfilment
            then:
            - $failIf:
                cond:
                  $not:
                    $hasKey:
                      object:
                        $var: input
                      key: quoteKey
                message: QUOTE_REQUIRED
            - $let:
                name: terms
                expr:
                  $merge:
                  - $document:
                      $concat:
                      - $const:
                          name: bindings
                          path: /fulfilment
                      - /terms
                  - agreementDescription:
                      $document: /description
            - $let:
                name: snapshot
                expr:
                  quote:
                    $var:
                      name: fields
                      path: /quote
                  quoteBlueId:
                    $var:
                      name: fields
                      path: /quoteBlueId
                  terms:
                    $var: terms
                  termsBlueId:
                    $nodeBlueId:
                      $var: terms
                  groups:
                    $var:
                      name: input
                      path: /groups
            - $call:
                function: initialGroups
                args:
                  snapshot:
                    $var: snapshot
            - $forEach:
                in:
                  $var:
                    name: input
                    path: /groups
                item: group
                do:
                - $if:
                    cond:
                      $var:
                        name: terms
                        path: /dateRequired
                    then:
                    - $failIf:
                        cond:
                          $not:
                            $gt:
                            - $var:
                                name: group
                                path: /proposedStartMicros
                            - $binding: timestamp
                        message: START_NOT_FUTURE
            - $set:
                name: fields
                expr:
                  $merge:
                  - $var: fields
                  - orderSnapshot:
                      $var: snapshot
            else:
            - $failIf:
                cond:
                  $hasKey:
                    object:
                      $var: input
                    key: groups
                message: BOOKING_CLAUSE_REQUIRED
        - $return:
            $merge:
            - $var: input
            - fields:
                $var: fields
      prepareCustomerOrder:
        args:
          input: {}
        do:
        - $call:
            function: validateFields
            args:
              candidate:
                $var: input
              allowed:
              - key
              - requestId
              - description
              - customer
              - quoteKey
              - groups
              required:
              - key
              - requestId
              - quoteKey
              error: UNKNOWN_ORDER_INPUT
        - $call:
            function: validateIdentifier
            args:
              candidate:
                $var:
                  name: input
                  path: /key
              error: INVALID_ORDER_KEY
        - $call:
            function: validateIdentifier
            args:
              candidate:
                $var:
                  name: input
                  path: /requestId
              error: INVALID_ORDER_REQUEST_ID
        - $if:
            cond:
              $exists:
                $var:
                  name: input
                  path: /customer
            then:
            - $failIf:
                cond:
                  $not:
                    $is:
                      node:
                        $var:
                          name: input
                          path: /customer
                      pattern:
                        type: Text
                        schema:
                          minLength: 1
                          maxLength: 256
                message: CUSTOMER_REQUIRED
        - $failIf:
            cond:
              $not:
                $is:
                  node:
                    $pointerGet:
                      object:
                        $var: input
                      path: /description
                      default: Order
                  pattern:
                    type: Text
                    schema:
                      minLength: 1
                      maxLength: 300
            message: INVALID_ORDER_DESCRIPTION
        - $let:
            name: existing
            expr:
              $document:
                $call:
                  function: itemPath
                  args:
                    key:
                      $var:
                        name: input
                        path: /key
        - $if:
            cond:
              $exists:
                $var: existing
            then:
            - $failIf:
                cond:
                  $ne:
                  - $pointerGet:
                      object:
                        $var: existing
                      path: /domainTerms/request
                  - $var: input
                message: PREPARATION_OBLIGATION_CONFLICT
            - $return:
                outcome: duplicate
                key:
                  $var:
                    name: existing
                    path: /key
                path:
                  $var:
                    name: existing
                    path: /path
        - $failIf:
            cond:
              $ne:
              - $call:
                  function: preparationMode
                  args: {}
              - bootstrap
            message: CUSTOMER_ORDER_BOOTSTRAP_REQUIRED
        - $call:
            function: suppliedCustomerOrderRoles
            args: {}
        - $failIf:
            cond:
              $eq:
              - $var:
                  name: input
                  path: /customer
              - $pointerGet:
                  object:
                    $document: /activation/parties/seller
                  path: /myosAccountId
                  default: ''
            message: CUSTOMER_MUST_BE_DISTINCT
        - $failIf:
            cond:
              $eq:
              - $var:
                  name: input
                  path: /customer
              - $pointerGet:
                  object:
                    $document: /activation/parties/partner
                  path: /myosAccountId
                  default: ''
            message: CUSTOMER_MUST_BE_DISTINCT
        - $let:
            name: booking
            expr:
              $call:
                function: prepareBooking
                args:
                  input:
                    $merge:
                    - key:
                        $var:
                          name: input
                          path: /key
                      quoteKey:
                        $var:
                          name: input
                          path: /quoteKey
                      fields:
                        $merge:
                        - amountMinor: 0
                          orderDescription:
                            $pointerGet:
                              object:
                                $var: input
                              path: /description
                              default: Order
                          orderRequest:
                            $var: input
                        - $choose:
                            cond:
                              $exists:
                                $var:
                                  name: input
                                  path: /customer
                            then:
                              customerAccountId:
                                $var:
                                  name: input
                                  path: /customer
                            else: {}
                    - $choose:
                        cond:
                          $hasKey:
                            object:
                              $var: input
                            key: groups
                        then:
                          groups:
                            $var:
                              name: input
                              path: /groups
                        else: {}
        - $let:
            name: preparedInput
            expr:
              key:
                $var:
                  name: input
                  path: /key
              requestId:
                $var:
                  name: input
                  path: /requestId
              fields:
                $var:
                  name: booking
                  path: /fields
              values: {}
        - $let:
            name: checked
            expr:
              $call:
                function: checkPreparation
                args:
                  input:
                    $var: preparedInput
        - $return:
            $call:
              function: sharedPrepare
              args:
                input:
                  $var: preparedInput
                checked:
                  $var: checked
cardinality: keyed
destinationBinding: collection
bindingTypes:
  parties: object
  sources: object
  template: pointer
  collection: pointer
  quotes: pointer
  fulfilment: pointer
embedsCollections:
- collection
actions:
  prepare:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: prepareCustomerOrder
            args:
              input:
                $var: trigger
  provide:
    resultContract: outcome-v1
    defaults:
      key:
        $pointerGet:
          object:
            $pointerSet:
              object:
                $object:
                  $var: trigger
              path: /type
              op: remove
          path: /key
          default: single
      inResponseTo:
        $pointerGet:
          object:
            $pointerSet:
              object:
                $object:
                  $var: trigger
              path: /type
              op: remove
          path: /inResponseTo
          default: ''
      requirementRef:
        $pointerGet:
          object:
            $pointerSet:
              object:
                $object:
                  $var: trigger
              path: /type
              op: remove
          path: /requirementRef
          default: ''
      document:
        $pointerGet:
          object:
            $pointerSet:
              object:
                $object:
                  $var: trigger
              path: /type
              op: remove
          path: /document
          default: ''
    preflight:
    - $set:
        name: actionResult
        expr:
          $call:
            function: checkProvision
            args:
              input:
                $var: params
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: sharedProvide
            args:
              checked:
                $var: actionResult
  resume:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: sharedRefresh
            args: {}
  cancel:
    resultContract: outcome-v1
    defaults:
      key:
        $pointerGet:
          object:
            $var: trigger
          path: /key
          default: single
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: sharedCancel
            args:
              input:
                $var: params
    preflight:
    - $set:
        name: actionResult
        expr:
          $call:
            function: checkCancellation
            args:
              input:
                $var: params
  startOrder:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: prepareCustomerOrder
            args:
              input:
                $var: trigger
parameters:
  prepareFor: bootstrap
  obtain: provide
  suppliedBy: partner
  suppliedParties:
  - customer
  allowedFields:
  - orderDescription
  - amountMinor
  - customerAccountId
  - quote
  - quoteBlueId
  - orderSnapshot
  - orderRequest
defaultBindings:
  quotes: /quotes
  fulfilment: /clauses/fulfilment/parameters
  parties:
    seller: seller
    partner: partner
  sources: {}
hookAbi: document-context-1
hookDefinition:
  type: Contracts/Compute Definition
  constants:
    admissionCanonicalDefinition:
      type: Documents/Admission Functions
    refreshFunctionNames:
    - accessRecordsValid
    - checkedDomainNextActions
    - configurationParameters
    - configuredSources
    - connectionConfiguration
    - domainNextActions
    - mappedBootstrapPartyCovered
    - namedSourcesReady
    - processOrigin
    - processStatePath
    - readerGroups
    - requireSameBootstrapParty
    - requireSameBootstrapPrimary
    - requireSameMainParty
    - rootSourceReaderGroupsMatch
    - rootSourceReaderPartyCovered
    - rootSourceReaderScope
    - rootSourceReadersReady
    - rosterCovers
    - sharedRefresh
    - sourceDeclarationMatches
    - transports
  functions:
    # Exact native planning helpers; Blue list inheritance cannot replace plan.do.
    admissionDefinition:
      blueId: EdhZTvT3y6NuYGey2T4yfNwt5sHLMQ3tkSgJjrN8nMV4
    assembleAdmissionDefinition:
      blueId: ASULsdYfJW3pQQj9UYYeYTcE7uYFP2CPUxKbMzFda5eh
    assembleAdmissionPlan:
      blueId: BA8iDtnANQmweL36cZkkZpw9jbn8dNk6J4cQquCdReZX
    planAdmission:
      blueId: 3wDYKekMcji3ctJZb5J5bQHWrQWQMfMs1m1VnMQqkueN
    planConnections:
      blueId: cYKrbtZvTnUHvpWBBgi3XYbZWhYysY8Rt48hjW48mAC
    planDocumentAccess:
      blueId: 7Mae12hDsTqKzMsP6oBFzibGeXci69LqW3PZCVGPytej
    planSourceValidators:
      blueId: 5RdDuEUgW6FXpk2XVJgDYekxZ7AEaZmvw3egggAgRB1Q
    selector:
      blueId: 3LazSQ1eisk6wbzi54nBzwaWu153K8exPAciyH7PCCw7
    validName:
      blueId: 8fmZg8oChQT88KfKzazPPyPMp7a3HHjyR7qG1FcTyezy
    validateConfiguration:
      blueId: GXvXb8FD5nDD7mWgs3XbiU8u38KNXTJufLH7DhsC4P77
    validateConnectionsConfiguration:
      blueId: 89Q9GYWLAKtPKtzjbhkPga6xuTZVzY7Ra1f6paLx7Ksv
    validateTransition:
      blueId: EWcQ9fxz6PwLGLGHZarggwPdcSAbLfYELWpJGQeR7e6p
    # Preserve the complete native plan; narrow only the repeated refresh library.
    basePreparationPlan:
      blueId: A22FanLXkarKe78sQj7mYZmweNRgtiRFsfkWbBXLQ18U
    plan:
      args: {}
      do:
      - $let:
          name: plan
          expr: {$call: {function: basePreparationPlan, args: {}}}
      - $let:
          name: definitionPath
          expr:
            $concat: [/clauseRuntime/work/candidate/, {$const: clauseKey}, /type/actionDefinition/type]
      - $let: {name: refreshFunctions, expr: {}}
      - $forEach:
          item: functionName
          in: {$const: refreshFunctionNames}
          do:
          - $set:
              name: refreshFunctions
              expr:
                $objectSet:
                  object: {$var: refreshFunctions}
                  key: {$var: functionName}
                  val:
                    $document:
                      $concat: [{$var: definitionPath}, /functions/, {$var: functionName}]
      - $let:
          name: refreshDefinition
          expr:
            constants:
              $choose:
                cond: {$exists: {$document: {$concat: [{$var: definitionPath}, /constants]}}}
                then: {$document: {$concat: [{$var: definitionPath}, /constants]}}
                else: {}
            functions: {$var: refreshFunctions}
      - $forEach:
          item: handlerPrefix
          in: [refreshProcesses_, refreshEmbeddedProcesses_]
          do:
          - $set:
              name: plan
              expr:
                $pointerSet:
                  object: {$var: plan}
                  path:
                    $concat: [/contracts/, {$var: handlerPrefix}, {$const: clauseKey}, /contract/steps/0/definition]
                  val: {$var: refreshDefinition}
      - $return: {$var: plan}
readParametersFromDocument: true
optionalBindings:
- template
snapshotBindings:
- template
