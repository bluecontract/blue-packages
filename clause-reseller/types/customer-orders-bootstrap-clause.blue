        blueId: Gz2t4B7tPpP58Rxqm5bz9KauBsJmKovQPSayaHroGwWS
      commitState:
        blueId: 3uKrE7SsoPch6FABDqgQ3QyHmFqKCT3thXTRBLJ5z6k8
      computeState:
        blueId: Gm2ceanSJJ6JbSgDbYmum2aYdS2fco9J3ZHHgaQcwzWU
      initializeTerms:
        blueId: 9WJQABaHfCswftWniEdyNurcz32xs2ypdhey6jLRcfJz
      reconcileInitialChannels:
        blueId: F3zDcHRLT9mjv7Cvuare6yN9t36nr58o2bX8HPhSCEjY
      refresh:
        blueId: 6bt1A2BcEiv16vTk3sGb7UXTb3fQux1fprEjzjptx9Qj
      refreshAccessRequests:
        blueId: GRRu18prggzsNfppgaAqK3vURZMJZM6hbZ41NVPifUbS
      requestPartyAddition:
        blueId: 2SqVY3PeSfV7N5KNbMbBDH9ZJ1jkiU73LwjRctTnJj8i
      rosterContracts:
        blueId: GhRxqZpCQJrHDEAev3xdkDHCZZZ8vvxX6SD5yrqv5dJx
      updateParty:
        blueId: HKS2C1nUbb8LcdmuRxeCXkBw2A4GBcEFPVBTCzNYApdg
      updatePartyPublic:
        blueId: JdYqZs3NB7L1qT58A55PQgvXgTuCGbnaqenDcygG15L
      activateChild:
        blueId: 7bV1m3P7mLkspsd84mvN3X8XM8TjQfsbVvmqsN5KqTHg
      bindChild:
        blueId: 22SDp7d66k45qbrYG8dWC4vAWZDk6WT18YPj4Lt8UyoN
      prepareChild:
        blueId: 9CsRDc5bUeMd4cbMTPBRZf4dE4wZ19CwxeCxrCMqdHP9
      registerDocumentAccess:
        blueId: 6ykQRx9dXXpqWdEb6L8SX25d1CYBpxHmxFfHDzTk7krd
      registerDocumentAccessPublic:
        blueId: GMe6m7eAt3DeRrth1xfQZgVMQp6oRC43hqu9R2R8hLEC
      bindSource:
        blueId: HCkLjMBFMi7KGtePWWn6UNFy2nCTAZ76AVeX4eXsAfmC
      bindSourcePublic:
        blueId: 6LR9mRur56XsgkZPwUw6cukGWbSmtaQ1bG8DwoMDi5ZP
      namedSourcesReady:
        blueId: EXZMLDv4TxmYaH7L8yrVKDahRDzM3AeKJv44D8P9WxFC
      processOrigin:
        blueId: 5UMRb3G6CPCKmkQKBLBhntAgaA5qjoJSLBbjS4kjS3VB
      refreshSourceReadiness:
        blueId: 9rpR9F4zy3yqS6VD63VhQptUbrPZk6QEqCgoi1AbSnQd
      requireRosterCoverage:
        blueId: EgBAsRJdHJKckJ3vsxgDjf3KMrxYM4PyBbuWPdRrUua5
      rosterCovers:
        blueId: 2VRjCVXah8NQpo69uGhaMJZobwh36J77t6rz4edzv1ii
      validateSource:
        blueId: DSvvKz1HQ2jgLKKY6HWhCdTRXXH6W31rbFVZA36wqYw7
      normalizeBootstrapSource:
        blueId: 4D3UKBgierZijZ5AR8AfqWuefPDNNDRMTAh3LUQ7S5b1
      normalizeProvisionSource:
        blueId: 3RabCaoyhrVwR38zybBc8dEXPj5XvxUqGiDTk8dunVZE
      preparationMode:
        blueId: 2vcjgv4XdYmmtKiUn6jtMs4wcyR9TEQ5S7YXPdVMk7B8
      prepareMappedChild:
        blueId: AyFVGr1gzP9po4VDJfbN1xxwPXhstYJxVwgwqvM1NcdA
      provisionClausePolicy:
        blueId: 4VxT11YhD3EVB1oYhw1ehAbvvV4u65xMhHSQbXxhsk17
      requireSameBootstrapParty:
        blueId: b3ueEPKpdb42HWsCzUYKgESSP16DpeYXemCUY545sZQ
      requireSameBootstrapPrimary:
        blueId: GsmtbmyMpRwJZkSc7xLBELSTp3sdGDiEwFDmK1Yn8Bba
      unboundParty:
        blueId: HPgf85FPuH9cvoXa254jT3L5uinHGHdLkgzHAtXyapFL
      validateBootstrapAccess:
        blueId: D8JssdHfsni1ahQKbcY6CYuLw2DvRBmS4P5F22CR78yR
      checkCreation:
        blueId: trmAi2aTL6hYxDrym5c9VdzrZMrogWANwXfX7ng3fJ2
      configurationParameters:
        blueId: 7WbS9JNjpW2d58txqa8cXbwrcsV5oqYsdhkqZ3oLiR1X
      configureDocumentAccess:
        blueId: 9c3h8ER4ZbHbmPR3YgBbqoCk2ycXcooJ96jmjnbaYsnk
      configureSources:
        blueId: CdzYinaqz3ZxdFhDJhXDDkT8a1Mc6gtR3PCDVLg6zQ9B
      configuredSources:
        blueId: 7dU4X5Ek1pQaz7wV44zTYYRRNwmy9dnPzWRE7NmG58iS
      configuredTemplate:
        blueId: 5FiY8Y6q6HwKFm1j2dUVe7KrU1DGU7pMUumNite9tCyA
      configuredTemplateValue:
        blueId: 2qQH6JPqxegYHpW2FZdbyRKhVbE7f3EWN3TGXjVrJvgZ
      connectionConfiguration:
        blueId: CiwKE8ejuxFQPydT4Cd1XGFHtZtpAd52pJdNWzTYDtQi
      connectionSnapshots:
        blueId: CiwKE8ejuxFQPydT4Cd1XGFHtZtpAd52pJdNWzTYDtQi
      suppliedCustomerOrderRoles:
        args: {}
        do:
        - $let:
            name: suppliedRoles
            expr:
              $pointerGet:
                object:
                  $call:
                    function: configurationParameters
                    args: {}
                path: /suppliedParties
                default:
                - customer
        - $failIf:
            cond:
              $not:
                $isKind:
                  val:
                    $var: suppliedRoles
                  kind: list
            message: CUSTOMER_ORDER_CUSTOMER_SLOT_REQUIRED
        - $failIf:
            cond:
              $not:
                $includes:
                  list:
                    $var: suppliedRoles
                  val: customer
            message: CUSTOMER_ORDER_CUSTOMER_SLOT_REQUIRED
        - $let:
            name: suppliedSeen
            expr: {}
        - $forEach:
            item: role
            in:
              $var: suppliedRoles
            do:
            - $failIf:
                cond:
                  $or:
                  - $not:
                      $call:
                        function: validPartyName
                        args:
                          candidate:
                            $var: role
                  - $hasKey:
                      object:
                        $var: suppliedSeen
                      key:
                        $var: role
                message: CUSTOMER_ORDER_INVALID_SUPPLIED_ROLE
            - $set:
                name: suppliedSeen
                expr:
                  $objectSet:
                    object:
                      $var: suppliedSeen
                    key:
                      $var: role
                    val: true
            - $if:
                cond:
                  $ne:
                  - $var: role
                  - customer
                then:
                - $let:
                    name: fixedAccount
                    expr:
                      $pointerGet:
                        object:
                          $call:
                            function: configuredTemplate
                            args: {}
                        path:
                          $concat:
                          - /clauses/activation/parameters/parties/
                          - $var: role
                          - /myosAccountId
                        default: ''
                - $failIf:
                    cond:
                      $or:
                      - $includes:
                          list:
                          - seller
                          - partner
                          val:
                            $var: role
                      - $not:
                          $isKind:
                            val:
                              $var: fixedAccount
                            kind: text
                      - $eq:
                        - $var: fixedAccount
                        - ''
                      - $hasKey:
                          object:
                            $pointerGet:
                              object:
                                $const: bindings
                              path: /parties
                              default: {}
                          key:
                            $var: role
                    message: CUSTOMER_ORDER_FIXED_SUPPLIED_ACCOUNT_REQUIRED
        - $return:
            $var: suppliedRoles
      constructDocument:
        args:
          input: {}
          checked: {}
        do:
        - $let:
            name: key
            expr:
              $var:
                name: checked
                path: /key
        - $let:
            name: path
            expr:
              $var:
                name: checked
                path: /path
        - $let:
            name: intent
            expr:
              $var:
                name: checked
                path: /intent
        - $let:
            name: child
            expr:
              $call:
                function: configuredTemplate
                args: {}
        - $set:
            name: child
            expr:
              $call:
                function: prepareMappedChild
                args:
                  child:
                    $var: child
                  mapping:
                    $pointerGet:
                      object:
                        $const: bindings
                      path: /parties
                      default: {}
                  suppliedRoles:
                    $call:
                      function: suppliedCustomerOrderRoles
                      args: {}
        - $if:
            cond:
              $not:
                $exists:
                  $var:
                    name: input
                    path: /fields/customerAccountId
            then:
            - $failIf:
                cond:
                  $exists:
                    $var:
                      name: child
                      path: /clauses/customerBinding
                message: CUSTOMER_BINDING_CLAUSE_CONFLICT
            - $set:
                name: child
                expr:
                  $pointerSet:
                    object:
                      $var: child
                    path: /clauses/customerBinding
                    val:
                      type:
                        type: Connections/Connected Clause
                        actions:
                          bind:
                            do:
                            - $failIf:
                                cond:
                                  $not:
                                    $and:
                                    - $isKind:
                                        val:
                                          $document: /activation/parties/customer/myosAccountId
                                        kind: text
                                    - $ne:
                                      - $document: /activation/parties/customer/myosAccountId
                                      - ''
                                message: CUSTOMER_BINDING_REQUIRED
                            - $failIf:
                                cond:
                                  $eq:
                                  - $document: /activation/parties/customer/myosAccountId
                                  - $document: /activation/parties/partner/myosAccountId
                                message: CUSTOMER_MUST_BE_DISTINCT
                            - $failIf:
                                cond:
                                  $eq:
                                  - $document: /activation/parties/customer/myosAccountId
                                  - $document: /activation/parties/seller/myosAccountId
                                message: CUSTOMER_MUST_BE_DISTINCT
                            - $appendChange:
                                op: add
                                path: /customerAccountId
                                val:
                                  $document: /activation/parties/customer/myosAccountId
                            - $if:
                                cond:
                                  $exists:
                                    $document: /orderSnapshot
                                then:
                                - $appendChange:
                                    op: add
                                    path: /orderSnapshot/customer
                                    val:
                                      $objectSet:
                                        object:
                                          $document: /orderSnapshot/customer
                                        key: myosAccountId
                                        val:
                                          $document: /activation/parties/customer/myosAccountId
                            automatic:
                              'on': initialized
                              once: true
            - $set:
                name: child
                expr:
                  $pointerSet:
                    object:
                      $var: child
                    path: /clauses/activation/parameters/preActivationChannels
                    val:
                      $listConcat:
                      - $pointerGet:
                          object:
                            $var: child
                          path: /clauses/activation/parameters/preActivationChannels
                          default: []
                      - - cx.customerBinding.bind._automatic_source
        - $if:
            cond:
              $exists:
                $document:
                  $const:
                    name: bindings
                    path: /fulfilment
            then:
            - $set:
                name: child
                expr:
                  $merge:
                  - $var: child
                  - clauses:
                      $merge:
                      - $var:
                          name: child
                          path: /clauses
                      - $document:
                          $concat:
                          - $const:
                              name: bindings
                              path: /fulfilment
                          - /template/clauses
                    reservations: {}
                    reservationRequests: {}
            - $set:
                name: child
                expr:
                  $pointerSet:
                    object:
                      $var: child
                    path: /clauses/activation/parameters/preActivationChannels
                    val:
                      $listConcat:
                      - $pointerGet:
                          object:
                            $var: child
                          path: /clauses/activation/parameters/preActivationChannels
                          default: []
                      - - cx.confirmation.initialize._automatic_source
            - $set:
                name: input
                expr:
                  $pointerSet:
                    object:
                      $var: input
                    path: /fields/orderSnapshot
                    val:
                      $merge:
                      - $var:
                          name: input
                          path: /fields/orderSnapshot
                      - seller:
                          myosAccountId:
                            $var:
                              name: child
                              path: /clauses/activation/parameters/parties/seller/myosAccountId
                        customer:
                          $choose:
                            cond:
                              $exists:
                                $var:
                                  name: input
                                  path: /fields/customerAccountId
                            then:
                              myosAccountId:
                                $var:
                                  name: input
                                  path: /fields/customerAccountId
                            else: {}
        - $if:
            cond:
              $eq:
              - $var:
                  name: input
                  path: /fields/amountMinor
              - 0
            then:
            - $set:
                name: child
                expr:
                  $pointerSet:
                    object:
                      $var: child
                    path: /clauses/payment
                    op: remove
        - $failIf:
            cond:
              $exists:
                $var:
                  name: child
                  path: /contracts/initialized
            message: Factory requires an uninitialized template
        - $forEach:
            item: nextValue
            key: field
            in:
              $pointerGet:
                object:
                  $var: input
                path: /fields
                default: {}
            do:
            - $failIf:
                cond:
                  $or:
                  - $not:
                      $includes:
                        list:
                          $pointerGet:
                            object:
                              $call:
                                function: configurationParameters
                                args: {}
                            path: /allowedFields
                        val:
                          $var: field
                  - $includes:
                      list:
                      - contracts
                      - clauses
                      - type
                      - itemType
                      - keyType
                      - valueType
                      - value
                      - items
                      - blueId
                      - blue
                      - schema
                      - constraints
                      - mergePolicy
                      - properties
                      - $previous
                      - $previousItems
                      - $pos
                      - $replace
                      - $empty
                      - instanceKey
                      val:
                        $var: field
                message: Field not allowed by document factory
            - $set:
                name: child
                expr:
                  $objectSet:
                    object:
                      $var: child
                    key:
                      $var: field
                    val:
                      $var: nextValue
        - $let:
            name: sources
            expr: {}
        - $forEach:
            key: sourceKey
            item: sourcePath
            in:
              $object:
                $pointerGet:
                  object:
                    $call:
                      function: configurationParameters
                      args: {}
                  path: /sourcePaths
            do:
            - $failIf:
                cond:
                  $not:
                    $exists:
                      $document:
                        $concat:
                        - $var: sourcePath
                        - /contracts/initialized
                message: SOURCE_NOT_INITIALIZED
            - $let:
                name: ref
                expr:
                  $objectSet:
                    object: {}
                    key: blueId
                    val:
                      $nodeBlueId:
                        $document:
                          $var: sourcePath
            - $set:
                name: sources
                expr:
                  $objectSet:
                    object:
                      $var: sources
                    key:
                      $var: sourceKey
                    val:
                      $var: ref
        - $set:
            name: child
            expr:
              $merge:
              - $var: child
              - sources:
                  $var: sources
                creationIntent:
                  $var: intent
        - $let:
            name: identity
            expr:
              $concat:
              - $nodeBlueId:
                  $document: /contracts/initialized/document
              - ':'
              - $const: clauseKey
              - ':'
              - $var: key
        - $set:
            name: child
            expr:
              $merge:
              - $var: child
              - instanceKey:
                  $var: identity
        - $forEach:
            item: identityPath
            in:
              $list:
                $pointerGet:
                  object:
                    $call:
                      function: configurationParameters
                      args: {}
                  path: /identityChildren
            do:
            - $failIf:
                cond:
                  $not:
                    $and:
                    - $exists:
                        $pointerGet:
                          object:
                            $var: child
                          path:
                            $var: identityPath
                    - $not:
                        $exists:
                          $pointerGet:
                            object:
                              $var: child
                            path:
                              $concat:
                              - $var: identityPath
                              - /contracts/initialized
                message: IDENTITY_CHILD_MUST_BE_UNINITIALIZED_TEMPLATE
            - $set:
                name: child
                expr:
                  $pointerSet:
                    object:
                      $var: child
                    path:
                      $concat:
                      - $var: identityPath
                      - /instanceKey
                    val:
                      $concat:
                      - $var: identity
                      - ':'
                      - $var: identityPath
        - $return:
            $var: child
      create:
        blueId: 448Nh3xCzLTQnLhUBg8oQyxUAyimbewXzfEVEderFQh3
      sourceDeclarationMatches:
        blueId: 6UieaF5Xk9n84qdN95v8XE2ZsRoQhwcDA1KVxAPJz5Zf
      admissionInstallRequest:
        blueId: EtAF1wPax4gDEdbT5wD7Mwq81bScNV1zK6cba3FLnzPa
      candidatePartyAccessDocuments:
        blueId: AEmEqhaeUQwHh1gAfvUR5YtE31deG7n7XhESKXKMZSaS
      mappedBootstrapPartyCovered:
        blueId: F4Rzri4cpxTEnByVF3KCNfhM6uWF8Pww7PqaWt28sFrc
      candidateStage:
        blueId: DJawggsLFB1peBWTV1GHiFKVR3uc72sziwMJqsWMENFE
      finishAdmission:
        blueId: FCxVdxygGen9hjdW3RyrK6wzdX955Ya5hcEgG7HpZNXo
      installAdmissionConsentOperations:
        blueId: 6cuExvPTUyNj1KeNifmpijqqAizL65b28rjoLZLL9GaJ
      nextAdmissionRequest:
