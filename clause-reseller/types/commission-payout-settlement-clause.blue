name: Commission Payout Settlement Clause
type: Features/Feature Clause
description: 'The MyOS operator reports the executed account-to-account split of one commission payout exactly once:
  the seller debit of G, the partner transfer of N and the retained MyOS fee F, all from the frozen payout terms.
  An identical report is idempotent; a different one is rejected.'
parameters:
  actions:
    confirm:
      do:
      - $let:
          name: terms
          expr:
            $document: /paymentDetails/payoutTerms
      - $failIf:
          cond:
            $not:
              $and:
              - $eq:
                - $document: /payment/accepted
                - true
              - $isKind:
                  val: {$document: /payment/transactionId}
                  kind: text
              - $ne:
                - {$document: /payment/transactionId}
                - ''
              - $isKind:
                  val:
                    $var:
                      name: params
                      path: /debitReference
                  kind: text
              - $ne:
                - $var:
                    name: params
                    path: /debitReference
                - ''
              - $isKind:
                  val:
                    $var:
                      name: params
                      path: /transferReference
                  kind: text
              - $ne:
                - $var:
                    name: params
                    path: /transferReference
                - ''
          message: ACCOUNT_SETTLEMENT_INVALID
      - $let:
          name: record
          expr:
            payoutKey:
              $pointerGet:
                object:
                  $var: terms
                path: /payoutKey
            grossMinor:
              $pointerGet:
                object:
                  $var: terms
                path: /grossMinor
            feeMinor:
              $pointerGet:
                object:
                  $var: terms
                path: /feeMinor
            netMinor:
              $pointerGet:
                object:
                  $var: terms
                path: /netMinor
            currency:
              $pointerGet:
                object:
                  $var: terms
                path: /currency
            transactionId:
              $document: /payment/transactionId
            debitReference:
              $var:
                name: params
                path: /debitReference
            transferReference:
              $var:
                name: params
                path: /transferReference
            payoutTerms:
              $var: terms
            instructionOrigin:
              $nodeBlueId:
                $document: /contracts/initialized/document
      - $if:
          cond:
            $exists:
              $document: /accountSettlement
          then:
          - $failIf:
              cond:
                $ne:
                - $document: /accountSettlement
                - $var: record
              message: ACCOUNT_SETTLEMENT_CONFLICT
          - $return: {}
      - $appendChange:
          op: add
          path: /accountSettlement
          val:
            $var: record
      - $appendEvent:
          $merge:
          - type: Events/Event
          - kind: Account Settlement Confirmed
            settlement:
              $var: record
    requestCancellation:
      do:
      - $failIf:
          cond:
            $not:
              $and:
              - $eq: [{$const: sourceMode}, workflow]
              - $eq: [{$binding: call/channel}, {$document: /paymentTerms/payerChannel}]
          message: ACCOUNT_CANCELLATION_PAYER_REQUIRED
      - $failIf:
          cond:
            $ne:
            - {$document: /paymentDetails/executionTerms/executionPolicy}
            - BLUE_ACCOUNT_PAYOUT_STOP_V1
          message: ACCOUNT_CANCELLATION_POLICY_REQUIRED
      - $let: {name: requestId, expr: {$var: {name: params, path: /requestId}}}
      - $failIf:
          cond:
            $not:
              $and:
              - $isKind: {val: {$var: requestId}, kind: text}
              - $ne: [{$var: requestId}, '']
          message: ACCOUNT_CANCELLATION_REQUEST_INVALID
      - $if:
          cond: {$exists: {$document: /accountCancellation}}
          then:
          - $failIf:
              cond:
                $ne:
                - {$document: /accountCancellation/requestId}
                - {$var: requestId}
              message: ACCOUNT_CANCELLATION_REQUEST_CONFLICT
          - $return: {}
      - $let:
          name: record
          expr: {requestId: {$var: requestId}, status: REQUESTED}
      - $appendChange: {op: add, path: /accountCancellation, val: {$var: record}}
      - $appendEvent:
          $merge:
          - type: Events/Event
          - kind: Account Payment Cancellation Requested
            cancellation: {$var: record}
    confirmStopped:
      do:
      - $failIf:
          cond:
            $not:
              $and:
              - $eq: [{$const: sourceMode}, workflow]
              - $eq: [{$binding: call/channel}, {$document: /paymentTerms/guarantorChannel}]
          message: ACCOUNT_STOP_GUARANTOR_REQUIRED
      - $failIf:
          cond:
            $not:
              $and:
              - $eq:
                - {$document: /paymentDetails/executionTerms/executionPolicy}
                - BLUE_ACCOUNT_PAYOUT_STOP_V1
              - $ne:
                - {$document: /paymentDetails/executionTerms/fundingModel}
                - LEGACY_ACCOUNT_DEBIT
          message: ACCOUNT_STOP_POLICY_UNSUPPORTED
      - $let: {name: requestId, expr: {$var: {name: params, path: /requestId}}}
      - $failIf:
          cond:
            $not:
              $and:
              - $isKind: {val: {$var: requestId}, kind: text}
              - $ne: [{$var: requestId}, '']
              - $exists: {$document: /accountCancellation}
              - $eq: [{$document: /accountCancellation/requestId}, {$var: requestId}]
          message: ACCOUNT_STOP_REQUEST_MISMATCH
      - $failIf:
          cond:
            $or:
            - $exists: {$document: /accountSettlement}
            - $gt:
              - $pointerGet: {object: {$document: /payment}, path: /completed, default: 0}
              - 0
          message: ACCOUNT_STOP_ALREADY_PAID
      - $let:
          name: record
          expr:
            requestId: {$var: requestId}
            status: STOPPED
            instructionOrigin:
              $nodeBlueId: {$document: /contracts/initialized/document}
            instanceKey: {$document: /instanceKey}
            executionPolicy: {$document: /paymentDetails/executionTerms/executionPolicy}
            payoutTerms: {$document: /paymentDetails/payoutTerms}
      - $if:
          cond: {$eq: [{$document: /accountCancellation/status}, STOPPED]}
          then:
          - $failIf:
              cond: {$ne: [{$document: /accountCancellation}, {$var: record}]}
              message: ACCOUNT_STOP_REPORT_CONFLICT
          - $return: {}
      - $failIf:
          cond: {$ne: [{$document: /accountCancellation/status}, REQUESTED]}
          message: ACCOUNT_STOP_REQUEST_REQUIRED
      - $appendChange: {op: replace, path: /accountCancellation, val: {$var: record}}
      - $appendEvent:
          $merge:
          - type: Events/Event
          - kind: Account Payment Stopped
            cancellation: {$var: record}
