                kind: text
            - $is:
                node:
                  $var:
                    name: input
                    path: /reason
                pattern:
                  type:
                    blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                  schema:
                    minLength: 1
                    maxLength: 1000
        message: REASON_REQUIRED
    - $let:
        name: charge
        expr: 0
    - $failIf:
        cond:
          $not:
            $or:
            - $includes:
