              path: /reason
          actor:
            $binding: call/channel
          timestampMicros:
            $binding: timestamp
          proposalBlueId:
            $var:
              name: group
              path: /proposalBlueId
          basisMinor:
            $var:
              name: group
              path: /proposal/amountMinor
          currency:
            $pointerGet:
              object:
                $document:
                  $const:
                    name: bindings
                    path: /snapshot
              path: /quote/currency
          policy:
            $var: policy
          chargeMinor:
            $var: charge
          releasedMinor:
            $subtract:
            - $var:
                name: group
                path: /proposal/amountMinor
            - $var: charge
          settlementStatus: payment_evidence_required
    - $set:
        name: group
        expr:
          $merge:
          - $var: group
          - status: cancelled
            decision:
              $var: decision
            decisionBlueId:
              $nodeBlueId:
                $var: decision
    - $return:
        $call:
          function: saveReservation
          args:
            input:
              $var: input
            action: cancel
            group:
              $var: group
