        expr:
          $merge:
          - $var: group
          - status: no_show
            decision:
              $var: decision
            decisionBlueId:
              $nodeBlueId:
                $var: decision
    - $return:
        $call:
          function: saveReservation
          args:
            input:
              $var: input
            action: noShow
            group:
              $var: group
  declineGroup:
    args:
      input: {}
    do:
    - $let:
        name: context
        expr:
          $call:
            function: reservationRequest
            args:
              input:
                $var: input
              action: decline
              allowed:
              - key
              - groupId
              - expectedProposalBlueId
              - reason
              required:
              - key
              - groupId
              - expectedProposalBlueId
              - reason
    - $if:
        cond:
          $var:
            name: context
            path: /duplicate
        then:
        - $return:
            outcome: duplicate
    - $let:
        name: group
        expr:
          $var:
            name: context
            path: /group
    - $let:
        name: policy
        expr:
          $pointerGet:
            object:
              $document:
                $const:
                  name: bindings
                  path: /snapshot
            path: /terms/cancellationPolicy
    - $failIf:
        cond:
          $not:
            $and:
            - $isKind:
                val:
                  $var:
                    name: input
                    path: /reason
                kind: text
            - $is:
                node:
                  $var:
                    name: input
                    path: /reason
                pattern:
                  type:
                    blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                  schema:
                    minLength: 1
                    maxLength: 1000
        message: REASON_REQUIRED
    - $let:
        name: charge
        expr: 0
    - $failIf:
        cond:
          $not:
            $includes:
              list:
              - pending_supplier
              - pending_customer
              val:
                $var:
                  name: group
                  path: /status
        message: NOT_PENDING
    - $let:
        name: decision
        expr:
          requestKey:
            $var:
              name: input
              path: /key
          groupId:
            $var:
              name: input
              path: /groupId
          kind: decline
          reason:
            $var:
              name: input
              path: /reason
          actor:
            $binding: call/channel
          timestampMicros:
            $binding: timestamp
          proposalBlueId:
            $var:
              name: group
              path: /proposalBlueId
          basisMinor:
            $var:
              name: group
              path: /proposal/amountMinor
          currency:
            $pointerGet:
              object:
                $document:
                  $const:
                    name: bindings
                    path: /snapshot
              path: /quote/currency
          policy:
            $var: policy
          chargeMinor:
            $var: charge
          releasedMinor:
            $subtract:
            - $var:
                name: group
                path: /proposal/amountMinor
            - $var: charge
          settlementStatus: payment_evidence_required
    - $set:
        name: group
        expr:
          $merge:
          - $var: group
          - status: declined
            decision:
              $var: decision
            decisionBlueId:
              $nodeBlueId:
                $var: decision
    - $return:
        $call:
          function: saveReservation
          args:
            input:
              $var: input
            action: decline
            group:
              $var: group
  expireGroup:
    args:
      input: {}
    do:
    - $let:
        name: context
        expr:
          $call:
            function: reservationRequest
            args:
              input:
                $var: input
              action: expire
              allowed:
              - key
              - groupId
              - expectedProposalBlueId
              - reason
              required:
              - key
              - groupId
              - expectedProposalBlueId
              - reason
    - $if:
        cond:
          $var:
            name: context
            path: /duplicate
        then:
        - $return:
            outcome: duplicate
    - $let:
        name: group
        expr:
          $var:
            name: context
            path: /group
    - $let:
        name: policy
        expr:
          $pointerGet:
            object:
              $document:
                $const:
                  name: bindings
                  path: /snapshot
            path: /terms/cancellationPolicy
    - $failIf:
        cond:
          $not:
            $and:
            - $isKind:
                val:
                  $var:
                    name: input
                    path: /reason
                kind: text
            - $is:
                node:
                  $var:
                    name: input
                    path: /reason
                pattern:
                  type:
                    blueId: GX7CFUmSDrE2MzptunLCCdZwnuwwrenRQqEnHL4x3uoC
                  schema:
                    minLength: 1
                    maxLength: 1000
        message: REASON_REQUIRED
    - $let:
        name: charge
        expr: 0
    - $failIf:
        cond:
          $not:
            $includes:
              list:
              - pending_supplier
              - pending_customer
              val:
                $var:
                  name: group
                  path: /status
        message: NOT_PENDING
    - $failIf:
        cond:
          $not:
            $hasKey:
              object:
                $var: group
              key: responseDeadlineMicros
        message: NO_DEADLINE
    - $failIf:
        cond:
          $not:
            $gte:
            - $binding: timestamp
            - $var:
                name: group
                path: /responseDeadlineMicros
        message: DEADLINE_NOT_REACHED
    - $let:
        name: decision
        expr:
          requestKey:
            $var:
              name: input
              path: /key
          groupId:
            $var:
              name: input
              path: /groupId
          kind: expire
          reason:
            $var:
              name: input
              path: /reason
          actor:
            $binding: call/channel
          timestampMicros:
            $binding: timestamp
          proposalBlueId:
            $var:
              name: group
              path: /proposalBlueId
          basisMinor:
            $var:
              name: group
              path: /proposal/amountMinor
          currency:
            $pointerGet:
              object:
                $document:
                  $const:
                    name: bindings
                    path: /snapshot
              path: /quote/currency
          policy:
            $var: policy
          chargeMinor:
            $var: charge
          releasedMinor:
            $subtract:
            - $var:
                name: group
                path: /proposal/amountMinor
            - $var: charge
          settlementStatus: payment_evidence_required
    - $set:
        name: group
        expr:
          $merge:
          - $var: group
          - status: expired
            decision:
              $var: decision
            decisionBlueId:
              $nodeBlueId:
                $var: decision
    - $return:
        $call:
          function: saveReservation
          args:
            input:
              $var: input
            action: expire
            group:
              $var: group
  initialGroups:
    args:
      snapshot: {}
    do:
    - $call:
        function: validateTerms
        args:
          terms:
            $var:
              name: snapshot
              path: /terms
    - $failIf:
        cond:
          $not:
            $eq:
            - $var:
                name: snapshot
                path: /quoteBlueId
            - $nodeBlueId:
                $var:
                  name: snapshot
                  path: /quote
        message: QUOTE_ID_MISMATCH
    - $failIf:
        cond:
          $not:
            $eq:
            - $var:
                name: snapshot
                path: /termsBlueId
            - $nodeBlueId:
                $var:
                  name: snapshot
                  path: /terms
        message: TERMS_ID_MISMATCH
    - $call:
        function: validateGroupSelections
        args:
          groups:
            $var:
              name: snapshot
              path: /groups
          quote:
            $var:
              name: snapshot
              path: /quote
    - $let:
        name: result
        expr: {}
    - $let:
        name: policy
        expr:
          $pointerGet:
            object:
              $var: snapshot
            path: /terms/cancellationPolicy
            default:
              freeCancellationHoursBeforeStart: 0
              lateCancellationChargePercent: 0
    - $forEach:
        in:
          $var:
            name: snapshot
            path: /groups
        item: spec
        do:
        - $if:
            cond:
              $pointerGet:
                object:
                  $var: snapshot
                path: /terms/dateRequired
                default: false
            then:
            - $call:
                function: validateInteger
                args:
                  candidate:
                    $var:
                      name: spec
                      path: /proposedStartMicros
                  minimum: 0
                  maximum: 9007199254740991
                  error: PROPOSED_DATE_REQUIRED
        - $let:
            name: proposal
            expr:
              $call:
                function: makeProposal
                args:
                  quote:
                    $var:
                      name: snapshot
                      path: /quote
                  indices:
                    $var:
                      name: spec
                      path: /lineIndices
                  number: 1
                  start:
                    $choose:
                      cond:
                        $hasKey:
                          object:
                            $var: spec
                          key: proposedStartMicros
                      then:
                        proposedStartMicros:
                          $get:
                            object:
                              $var: spec
                            key: proposedStartMicros
                      else: {}
        - $let:
            name: group
            expr:
              status: pending_supplier
              originalLineIndices:
                $var:
                  name: spec
                  path: /lineIndices
              proposal:
                $var: proposal
              proposalBlueId:
                $nodeBlueId:
                  $var: proposal
              history:
              - $var: proposal
        - $if:
            cond:
              $eq:
              - $var:
                  name: snapshot
                  path: /terms/confirmationMode
              - automatic
            then:
            - $failIf:
                cond:
                  $not:
                    $and:
                    - $eq:
                      - $var:
                          name: snapshot
                          path: /supplierReadiness/quoteBlueId
                      - $var:
                          name: snapshot
                          path: /quoteBlueId
                    - $eq:
                      - $var:
                          name: snapshot
                          path: /supplierReadiness/groups
                      - $var:
                          name: snapshot
                          path: /groups
                message: SUPPLIER_READINESS_REQUIRED
            - $call:
                function: validateInteger
                args:
                  candidate:
                    $var:
                      name: proposal
                      path: /proposedStartMicros
                  minimum: 0
                  maximum: 9007199254740991
                  error: EXACT_START_REQUIRED
            - $failIf:
                cond:
                  $not:
                    $gt:
                    - $var:
                        name: proposal
                        path: /proposedStartMicros
                    - $var:
                        name: snapshot
                        path: /acceptedAtMicros
                message: START_NOT_FUTURE
            - $if:
                cond:
                  $and:
                  - $gt:
                    - $var:
                        name: snapshot
                        path: /acceptedAtMicros
                    - $subtract:
                      - $var:
                          name: proposal
                          path: /proposedStartMicros
                      - $multiply:
                        - $var:
                            name: policy
                            path: /freeCancellationHoursBeforeStart
                        - 3600000000
                  - $gt:
                    - $call:
                        function: roundBps
                        args:
                          basis:
                            $var:
                              name: group
                              path: /proposal/amountMinor
                          bps:
                            $multiply:
                            - $var:
                                name: policy
                                path: /lateCancellationChargePercent
                            - 100
                    - 0
                then:
                - $failIf:
                    cond:
                      $not:
                        $eq:
                        - $var:
                            name: snapshot
                            path: /acceptImmediateCharge
                        - true
                    message: IMMEDIATE_CHARGE_CONSENT_REQUIRED
            - $set:
                name: group
                expr:
                  $merge:
                  - $var: group
                  - status: confirmed
                    confirmedStartMicros:
                      $var:
                        name: proposal
                        path: /proposedStartMicros
                    freeCancellationUntilMicros:
                      $subtract:
                      - $var:
                          name: proposal
                          path: /proposedStartMicros
                      - $multiply:
                        - $var:
                            name: policy
                            path: /freeCancellationHoursBeforeStart
                        - 3600000000
                    confirmedAtMicros:
                      $var:
                        name: snapshot
                        path: /acceptedAtMicros
        - $if:
            cond:
              $and:
              - $not:
                  $hasKey:
                    object:
                      $var:
                        name: snapshot
                        path: /terms
                    key: cancellationPolicy
              - $hasKey:
                  object:
                    $var: group
                  key: freeCancellationUntilMicros
            then:
            - $set:
                name: group
                expr:
                  $pointerSet:
                    object:
                      $var: group
                    path: /freeCancellationUntilMicros
                    op: remove
        - $set:
            name: result
            expr:
              $objectSet:
                object:
                  $var: result
                key:
                  $var:
                    name: spec
                    path: /id
                val:
                  $var: group
    - $return:
        $var: result
  reconcileSettlement:
    args:
      input: {}
    do:
    - $let:
        name: context
        expr:
          $call:
            function: reservationRequest
            args:
              input:
                $var: input
              action: reconcileSettlement
              allowed:
              - key
              - groupId
              - expectedProposalBlueId
              required:
              - key
              - groupId
              - expectedProposalBlueId
    - $if:
        cond:
          $var:
            name: context
            path: /duplicate
        then:
        - $return:
            outcome: duplicate
    - $let:
        name: group
        expr:
          $var:
            name: context
            path: /group
    - $failIf:
        cond:
          $not:
            $exists:
              $var:
                name: group
                path: /decisionBlueId
        message: CANCELLATION_DECISION_REQUIRED
    - $let:
        name: instruction
        expr:
          $document:
            $concat:
            - $const:
                name: bindings
                path: /payments
            - /
            - $var:
                name: input
                path: /groupId
    - $failIf:
        cond:
          $not:
            $is:
              node:
                $var: instruction
              pattern:
                type: PaymentInstruction/Payment Instruction
        message: NATIVE_PAYMENT_INSTRUCTION_REQUIRED
    - $let:
        name: payment
        expr:
          $var:
            name: instruction
            path: /payment
    - $let:
        name: decision
        expr:
          $var:
            name: group
            path: /decision
    - $failIf:
        cond:
          $not:
            $and:
            - $eq:
              - $var:
                  name: instruction
                  path: /paymentTerms/currency
              - $var:
                  name: decision
                  path: /currency
            - $eq:
              - $var:
                  name: instruction
                  path: /paymentTerms/amountMinor
              - $var:
                  name: decision
                  path: /basisMinor
            - $eq:
              - $var:
                  name: instruction
                  path: /paymentTerms/payerChannel
              - customer
            - $eq:
              - $var:
                  name: instruction
                  path: /paymentTerms/payeeChannel
              - seller
        message: PAYMENT_TERMS_MISMATCH
    - $let:
        name: netPaid
        expr:
          $subtract:
          - $var:
              name: payment
              path: /completed
          - $var:
              name: payment
              path: /reversed
    - $let:
        name: cashRefundDue
        expr:
          $choose:
            cond:
              $gt:
              - $var: netPaid
              - $var:
                  name: decision
                  path: /chargeMinor
            then:
              $subtract:
              - $var: netPaid
              - $var:
                  name: decision
                  path: /chargeMinor
            else: 0
    - $let:
        name: remainingCharge
        expr:
          $choose:
            cond:
              $gt:
              - $var:
                  name: decision
                  path: /chargeMinor
              - $var: netPaid
            then:
              $subtract:
              - $var:
                  name: decision
                  path: /chargeMinor
              - $var: netPaid
            else: 0
    - $let:
        name: request
        expr:
          $get:
            object:
              $var:
                name: payment
                path: /requests
            key:
              $var:
                name: group
                path: /decisionBlueId
    - $let:
        name: refundStatus
        expr:
          $choose:
            cond:
              $gt:
              - $var: cashRefundDue
              - 0
            then: not_requested
            else: not_required
    - $if:
        cond:
          $exists:
            $var: request
        then:
        - $failIf:
            cond:
              $not:
                $eq:
                - $var:
                    name: request
                    path: /intent/action
                - refund
            message: REFUND_REQUEST_REQUIRED
        - $failIf:
            cond:
              $not:
                $eq:
                - $var:
                    name: request
                    path: /intent/amountMinor
                - $add:
                  - $var: cashRefundDue
                  - $choose:
                      cond:
                        $eq:
                        - $var:
                            name: request
                            path: /status
                        - succeeded
                      then:
                        $var:
                          name: request
                          path: /intent/amountMinor
                      else: 0
            message: REFUND_AMOUNT_MISMATCH
        - $failIf:
            cond:
              $not:
                $lte:
                - $var:
                    name: request
                    path: /intent/amountMinor
                - $var:
                    name: decision
                    path: /releasedMinor
            message: REFUND_EXCEEDS_RELEASED_PRICE
        - $set:
            name: refundStatus
            expr:
              $get:
                object:
                  pending: requested
                  unknown: unknown
                  failed: failed
                  declined: failed
                  succeeded: completed
                key:
                  $var:
                    name: request
                    path: /status
    - $let:
        name: settlement
        expr:
          decisionBlueId:
            $var:
              name: group
              path: /decisionBlueId
          paymentInstructionBlueId:
            $nodeBlueId:
              $var: instruction
          paymentRequestId:
            $var:
              name: group
              path: /decisionBlueId
          currency:
            $var:
              name: decision
              path: /currency
          capturedMinor:
            $var:
              name: payment
              path: /completed
          refundedMinor:
            $var:
              name: payment
              path: /reversed
          cashRefundDueMinor:
            $var: cashRefundDue
          additionalChargeDueMinor:
            $var: remainingCharge
          authorizationReleaseDueMinor:
            $choose:
              cond:
                $gt:
                - $var:
                    name: payment
                    path: /secured
                - $var: remainingCharge
              then:
                $subtract:
                - $var:
                    name: payment
                    path: /secured
                - $var: remainingCharge
              else: 0
          refundStatus:
            $var: refundStatus
          cashRefundCompleted:
            $eq:
            - $var: refundStatus
            - completed
          observedAtMicros:
            $binding: timestamp
    - $return:
        $call:
          function: saveReservation
          args:
            input:
              $var: input
            action: reconcileSettlement
            group:
              $merge:
              - $var: group
              - settlement:
                  $var: settlement
