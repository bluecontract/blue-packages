name: Description Clause
description: Authored descriptive content, independent of catalog, prices, parties and workflows. The title,
  text and optional sections are content only. Each section has a title, optional text and optional
  bullets (a list of text). This clause declares no actions, guards, effects or mutable state.
type: Clauses/Clause
hookAbi: document-context-1
hookDefinition:
  type: Contracts/Compute Definition
  functions:
    validateConfiguration:
      args: {}
      do:
      - $return:
          allowed: true
          code: ''
    validateTransition:
      args: {}
      do:
      - $return:
          allowed: true
          code: ''
    plan:
      args: {}
      do:
      - $return:
          states: {}
          contracts: {}
          reads: []
parameters:
  title:
    type: Text
  text:
    type: Text
  sections:
    type: List
