name: Cancellation Clause
description: 'Proposed demonstration profile: whole-group withdrawal, one inclusive free-cancellation cutoff, half-up
  late charge, supplier cancellation and supplier-reported no-show. A decision is not a completed refund.'
type: Connections/Connected Clause
actionDefinition:
  type: Reseller/Order Functions
actions:
  cancel:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: cancelGroup
            args:
              input:
                $var: params
  supplierCancel:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: supplierCancelGroup
            args:
              input:
                $var: params
  noShow:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: noShowGroup
            args:
              input:
                $var: params
  decline:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: declineGroup
            args:
              input:
                $var: params
  expire:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: expireGroup
            args:
              input:
                $var: params
  reconcileSettlement:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: reconcileSettlement
            args:
              input:
                $var: params
bindingTypes:
  state: pointer
  snapshot: pointer
  requests: pointer
  payments: pointer
defaultBindings:
  state: /reservations
  snapshot: /orderSnapshot
  requests: /reservationRequests
  payments: /payments
