name: Commission Payout Payment Clause
type: Payment/Payment Base
actionDefinition:
  type:
    type: Payment/Payment Setup
    functions:
      build:
        args: {}
        do:
        - $let:
            name: terms
            expr:
              $document: /payoutTerms
        - $failIf:
            cond:
              $not:
                $and:
                - $isKind:
                    val:
                      $var: terms
                    kind: object
                - $eq:
                  - $document: /amountMinor
                  - $pointerGet:
                      object:
                        $var: terms
                      path: /netMinor
            message: PAYOUT_TERMS_REQUIRED
        - $let:
            name: operator
            expr:
              $pointerGet:
                object:
                  $var: terms
                path: /operator
        - $failIf:
            cond:
              $not:
                $includes:
                  list:
                  - test
                  - stripe
                  val:
                    $var: operator
            message: PAYOUT_OPERATOR_UNSUPPORTED
        - $let:
            name: result
            expr:
              $call:
                function: buildInstruction
                args:
                  configOverride: {}
                  details:
                    method: myos-account-to-account
                    payoutTerms:
                      $var: terms
                  methodClauses:
                    $literal:
                      method:
                        type: MyOS/Payment Method Events
                      accountSettlement:
                        type: Features/Feature Clause
                        parameters:
                          actions:
                            confirm:
                              do:
                              - $let:
                                  name: terms
                                  expr:
                                    $document: /paymentDetails/payoutTerms
                              - $failIf:
                                  cond:
                                    $not:
                                      $and:
                                      - $eq:
                                        - $document: /payment/accepted
                                        - true
                                      - $isKind:
                                          val:
                                            $var:
                                              name: params
                                              path: /debitReference
                                          kind: text
                                      - $ne:
                                        - $var:
                                            name: params
                                            path: /debitReference
                                        - ''
                                      - $isKind:
                                          val:
                                            $var:
                                              name: params
                                              path: /transferReference
                                          kind: text
                                      - $ne:
                                        - $var:
                                            name: params
                                            path: /transferReference
                                        - ''
                                  message: ACCOUNT_SETTLEMENT_INVALID
                              - $let:
                                  name: record
                                  expr:
                                    payoutKey:
                                      $pointerGet:
                                        object:
                                          $var: terms
                                        path: /payoutKey
                                    grossMinor:
                                      $pointerGet:
                                        object:
                                          $var: terms
                                        path: /grossMinor
                                    feeMinor:
                                      $pointerGet:
                                        object:
                                          $var: terms
                                        path: /feeMinor
                                    netMinor:
                                      $pointerGet:
                                        object:
                                          $var: terms
                                        path: /netMinor
                                    currency:
                                      $pointerGet:
                                        object:
                                          $var: terms
                                        path: /currency
                                    transactionId:
                                      $document: /payment/transactionId
                                    debitReference:
                                      $var:
                                        name: params
                                        path: /debitReference
                                    transferReference:
                                      $var:
                                        name: params
                                        path: /transferReference
                              - $if:
                                  cond:
                                    $exists:
                                      $document: /accountSettlement
                                  then:
                                  - $failIf:
                                      cond:
                                        $ne:
                                        - $document: /accountSettlement
                                        - $var: record
                                      message: ACCOUNT_SETTLEMENT_CONFLICT
                                  - $return: {}
                              - $appendChange:
                                  op: add
                                  path: /accountSettlement
                                  val:
                                    $var: record
                              - $appendEvent:
                                  $merge:
                                  - type: Events/Event
                                  - kind: Account Settlement Confirmed
                                    settlement:
                                      $var: record
                        bindings:
                          confirm:
                            confirmAccountSettlement:
                              'on': workflow
                              party: guarantor
                              params:
                                debitReference:
                                  $var:
                                    name: trigger
                                    path: /debitReference
                                transferReference:
                                  $var:
                                    name: trigger
                                    path: /transferReference
                  termsOverride: {}
                  instructionPatch:
                    rootType:
                      $choose:
                        cond:
                          $eq:
                          - $var: operator
                          - test
                        then:
                          $get:
                            object:
                              type: MyOS/MyOS Test Account to Account Payment Instruction
                            key: type
                        else:
                          $get:
                            object:
                              type: MyOS/MyOS Stripe Account to Account Payment Instruction
                            key: type
        - $return:
            $var: result
description: Commission payout paid by a MyOS account-to-account transfer of N from seller to partner. The
  operator secures and debits G from the seller, transfers N and retains the MyOS fee F, then reports the
  split once with confirmAccountSettlement.
