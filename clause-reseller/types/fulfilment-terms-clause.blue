name: Fulfilment Terms Clause
description: Snapshot one accepted Markdown text, exact quote, structured seller, confirmation mode and cancellation
  policy into a proposed Order. Security deposits remain supplier text.
type: Connections/Connected Clause
actionDefinition:
  type: Reseller/Order Functions
actions:
  place:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: placeOrder
            args:
              input:
                $var: params
  approveAvailability:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: approveAvailability
            args:
              input:
                $var: params
bindingTypes:
  quotes: pointer
  orders: pointer
  availability: pointer
  terms: pointer
defaultBindings:
  quotes: /quotes
  orders: /orderIntents
  availability: /supplierReadiness
  terms: /resellerTerms
