name: Fulfilment Terms Clause
description: Holds fulfilment terms and a confirmation template for catalog-priced orders. Can also record supplier
  availability for an explicitly configured quote workflow. Security deposits remain supplier text.
type: Connections/Connected Clause
actionDefinition:
  type: Reseller/Order Functions
actions:
  approveAvailability:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: approveAvailability
            args:
              input:
                $var: params
bindingTypes:
  quotes: pointer
  availability: pointer
  terms: pointer
defaultBindings:
  quotes: /quotes
  availability: /supplierReadiness
  terms: /resellerTerms
