name: Commission Clause
type: Ledger/Ledger Clause
actionDefinition:
  type:
    type: Ledger/Balance Functions
    functions:
      # Exact shared readiness helpers; maintained conformance rejects stale pins.
      namedSourcesReady:
        blueId: EXZMLDv4TxmYaH7L8yrVKDahRDzM3AeKJv44D8P9WxFC
      processOrigin:
        blueId: 5UMRb3G6CPCKmkQKBLBhntAgaA5qjoJSLBbjS4kjS3VB
      rosterCovers:
        blueId: 2VRjCVXah8NQpo69uGhaMJZobwh36J77t6rz4edzv1ii
      reconcile:
        args:
          input: {}
        do:
        - $let:
            name: key
            expr:
              $var:
                name: input
                path: /key
        - $let:
            name: payout
            expr:
              $document:
                $concat:
                - $concat:
                  - $const:
                      name: bindings
                      path: /payouts
                  - /
                - $var: key
        - $let:
            name: pi
            expr:
              $pointerGet:
                object:
                  $var: payout
                path: /payment
                default: {}
        - $let:
            name: s
            expr:
              $document:
                $const:
                  name: bindings
                  path: /state
        - $let:
            name: old
            expr:
              $pointerGet:
                object:
                  $var: s
                path:
                  $concat:
                  - /settlements/
                  - $var: key
        - $failIf:
            cond:
              $not:
                $exists:
                  $var: old
            message: UNKNOWN_SETTLEMENT
        - $if:
            cond:
              $ne:
              - $pointerGet:
                  object:
                    $var: old
                  path: /status
              - reserved
            then:
            - $return:
                outcome: duplicate
        - $let:
            name: terms
            expr:
              $pointerGet:
                object:
                  $var: payout
                path: /payoutTerms
        - $let:
            name: gross
            expr:
              $pointerGet:
                object:
                  $var: old
                path: /amountMinor
        # The frozen split must settle exactly the reserved commission.
        - $failIf:
            cond:
              $not:
                $and:
                - $eq:
                  - $pointerGet:
                      object:
                        $var: terms
                      path: /grossMinor
                  - $var: gross
                - $eq:
                  - $add:
                    - $pointerGet:
                        object:
                          $var: terms
                        path: /feeMinor
                    - $pointerGet:
                        object:
                          $var: terms
                        path: /netMinor
                  - $var: gross
            message: INVALID_PAYOUT_TERMS
        - $let:
            name: state
            expr:
              $pointerGet:
                object:
                  $var: pi
                path: /payment
                default: {}
        - $let:
            name: unresolved
            expr: false
        - $forEach:
            item: financialRequest
            in:
              $pointerGet:
                object:
                  $var: state
                path: /requests
                default: {}
            do:
            - $if:
                cond:
                  $includes:
                    list:
                    - pending
                    - unknown
                    val:
                      $var:
                        name: financialRequest
                        path: /status
                then:
                - $set:
                    name: unresolved
                    expr: true
        - $if:
            cond:
              $var: unresolved
            then:
            - $return:
                outcome: duplicate
        - $let:
            name: completed
            expr:
              $pointerGet:
                object:
                  $var: state
                path: /completed
                default: 0
        - $let:
            name: settlement
            expr:
              $pointerGet:
                object:
                  $var: pi
                path: /accountSettlement
                default: {}
        # Settlement needs both the operator split report and the ordinary completion of N, in either order.
        - $let:
            name: settled
            expr:
              $and:
              - $isKind:
                  val:
                    $var: settlement
                  kind: object
              - $eq:
                - $pointerGet:
                    object:
                      $var: settlement
                    path: /grossMinor
                    default: null
                - $var: gross
              - $eq:
                - $pointerGet:
                    object:
                      $var: settlement
                    path: /netMinor
                    default: null
                - $pointerGet:
                    object:
                      $var: terms
                    path: /netMinor
              - $eq:
                - $pointerGet:
                    object:
                      $var: settlement
                    path: /feeMinor
                    default: null
                - $pointerGet:
                    object:
                      $var: terms
                    path: /feeMinor
              - $eq:
                - $var: completed
                - $pointerGet:
                    object:
                      $var: terms
                    path: /netMinor
              - $eq:
                - $pointerGet:
                    object:
                      $var: state
                    path: /reversed
                    default: 0
                - 0
        # The operator rejected the instruction before any effect: no debit, no transfer, no fee.
        - $let:
            name: returned
            expr:
              $and:
              - $eq:
                - $pointerGet:
                    object:
                      $var: state
                    path: /rejected
                    default: false
                - true
              - $eq:
                - $var: completed
                - 0
              - $eq:
                - $pointerGet:
                    object:
                      $var: state
                    path: /secured
                    default: 0
                - 0
        - $if:
            cond:
              $not:
                $or:
                - $var: settled
                - $var: returned
            then:
            - $return:
                outcome: duplicate
        - $appendChange:
            op: replace
            path:
              $concat:
              - $const:
                  name: bindings
                  path: /state
              - /reserved
            val:
              $subtract:
              - $pointerGet:
                  object:
                    $var: s
                  path: /reserved
              - $var: gross
        - $if:
            cond:
              $var: settled
            then:
            - $appendChange:
                op: replace
                path:
                  $concat:
                  - $const:
                      name: bindings
                      path: /state
                  - /paid
                val:
                  $add:
                  - $pointerGet:
                      object:
                        $var: s
                      path: /paid
                  - $var: gross
        - $appendChange:
            op: replace
            path:
              $concat:
              - $concat:
                - $const:
                    name: bindings
                    path: /state
                - /settlements/
              - $var: key
            val:
              amountMinor:
                $var: gross
              paidMinor:
                $choose:
                  cond:
                    $var: settled
                  then:
                    $var: gross
                  else: 0
              transferredMinor:
                $choose:
                  cond:
                    $var: settled
                  then:
                    $var: completed
                  else: 0
              feeMinor:
                $choose:
                  cond:
                    $var: settled
                  then:
                    $pointerGet:
                      object:
                        $var: terms
                      path: /feeMinor
                  else: 0
              status: closed
        - $appendEvent:
            $merge:
            - type: Events/Event
            - kind: Payout Reconciled
              key:
                $var: key
              settled:
                $var: settled
        - $return:
            outcome: acceptedNew
actions:
  reconcile:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: reconcile
            args:
              input:
                $var: params
  confirmed:
    resultContract: outcome-v1
    automatic:
      'on': collection
      pathBinding: orders
      event:
        type: Payment/Payment Event Received
        event:
          type: PaymentInstruction/Payment Completed
    do:
    - $if:
        cond:
          $not:
            $is:
              node:
                $event: /event
              pattern:
                type: Payment/Payment Event Received
                event:
                  type: PaymentInstruction/Payment Completed
        then:
        - $return: {}
    - $set:
        name: actionResult
        expr:
          $call:
            function: setTarget
            args:
              input:
                key:
                  $sliceAfter:
                  - $event: /sourcePath
                  - $concat:
                    - $const:
                        name: bindings
                        path: /orders
                    - /
                amountMinor:
                  $call:
                    function: roundBps
                    args:
                      basis:
                        $subtract:
                        - $document:
                            $concat:
                            - $event: /sourcePath
                            - /payment/payment/completed
                        - $document:
                            $concat:
                            - $event: /sourcePath
                            - /payment/payment/reversed
                      bps:
                        $document:
                          $const:
                            name: bindings
                            path: /rate
  reversed:
    resultContract: outcome-v1
    automatic:
      'on': collection
      pathBinding: orders
      event:
        type: Payment/Payment Event Received
        event:
          type: PaymentInstruction/Payment Reversed After Completion
    do:
    - $if:
        cond:
          $not:
            $is:
              node:
                $event: /event
              pattern:
                type: Payment/Payment Event Received
                event:
                  type: PaymentInstruction/Payment Reversed After Completion
        then:
        - $return: {}
    - $set:
        name: actionResult
        expr:
          $call:
            function: setTarget
            args:
              input:
                key:
                  $sliceAfter:
                  - $event: /sourcePath
                  - $concat:
                    - $const:
                        name: bindings
                        path: /orders
                    - /
                amountMinor:
                  $call:
                    function: roundBps
                    args:
                      basis:
                        $subtract:
                        - $document:
                            $concat:
                            - $event: /sourcePath
                            - /payment/payment/completed
                        - $document:
                            $concat:
                            - $event: /sourcePath
                            - /payment/payment/reversed
                      bps:
                        $document:
                          $const:
                            name: bindings
                            path: /rate
  attached:
    resultContract: outcome-v1
    automatic:
      'on': event
      event:
        type: Documents/Document Attached
    do:
    - $if:
        cond:
          $not:
            $is:
              node: {$event: ''}
              pattern: {type: Documents/Document Attached}
        then:
        - $return: {}
    - $let: {name: key, expr: {$event: /itemKey}}
    - $let: {name: producer, expr: {$event: /clauseId}}
    - $forEach:
        item: part
        in: [{$var: key}, {$var: producer}]
        do:
        - $if:
            cond: {$not: {$isKind: {val: {$var: part}, kind: text}}}
            then:
            - $return: {}
        - $if:
            cond:
              $or:
              - {$eq: [{$var: part}, '']}
              - {$ne: [{$size: {$split: {text: {$var: part}, separator: /}}}, 1]}
              - {$ne: [{$size: {$split: {text: {$var: part}, separator: '~'}}}, 1]}
            then:
            - $return: {}
    - $let: {name: collection, expr: {$const: {name: bindings, path: /orders}}}
    - $if:
        cond:
          $ne:
          - {$document: {$concat: [/clauses/, {$var: producer}, /bindings/collection]}}
          - {$var: collection}
        then:
        - $return: {}
    - $let:
        name: itemPath
        expr: {$concat: [/process_, {$var: producer}, /entries/, {$nodeBlueId: {$var: key}}]}
    - $let: {name: item, expr: {$document: {$var: itemPath}}}
    - $let: {name: orderPath, expr: {$concat: [{$var: collection}, /, {$var: key}]}}
    - $if:
        cond:
          $not:
            $and:
            - {$eq: [{$var: {name: item, path: /key}}, {$var: key}]}
            - {$eq: [{$var: {name: item, path: /itemPath}}, {$var: itemPath}]}
            - {$eq: [{$var: {name: item, path: /path}}, {$var: orderPath}]}
            - {$eq: [{$var: {name: item, path: /status}}, usable]}
            - {$exists: {$var: {name: item, path: /requestId}}}
            - {$eq: [{$var: {name: item, path: /requestId}}, {$event: /inResponseTo}]}
            - {$exists: {$var: {name: item, path: /documentOrigin}}}
            - {$eq: [{$var: {name: item, path: /documentOrigin}}, {$event: /documentOrigin}]}
        then:
        - $return: {}
    - $let: {name: order, expr: {$document: {$var: orderPath}}}
    - $if:
        cond:
          $not:
            $and:
            - {$exists: {$var: {name: order, path: /contracts/initialized/document}}}
            - {$eq: [{$var: {name: order, path: /activation/active}}, true]}
        then:
        - $return: {}
    - $if:
        cond:
          $ne:
          - {$nodeBlueId: {$var: {name: order, path: /contracts/initialized/document}}}
          - {$var: {name: item, path: /documentOrigin}}
        then:
        - $return: {}
    - $if:
        cond:
          $not:
            $call:
              function: namedSourcesReady
              args: {document: {$var: order}}
        then:
        - $return: {}
    - $if:
        cond:
          $not:
            $exists:
              $var: {name: order, path: /payment}
        then:
        - $return: {}
    - $failIf:
        cond:
          $not:
            $and:
            - {$isKind: {val: {$var: {name: order, path: /payment/payment/completed}}, kind: integer}}
            - {$isKind: {val: {$var: {name: order, path: /payment/payment/reversed}}, kind: integer}}
            - {$gte: [{$var: {name: order, path: /payment/payment/completed}}, 0]}
            - {$gte: [{$var: {name: order, path: /payment/payment/reversed}}, 0]}
        message: INVALID_COMMISSION_INPUT
    - $set:
        name: actionResult
        expr:
          $call:
            function: setTarget
            args:
              input:
                key: {$var: key}
                amountMinor:
                  $call:
                    function: roundBps
                    args:
                      basis:
                        $subtract:
                        - {$var: {name: order, path: /payment/payment/completed}}
                        - {$var: {name: order, path: /payment/payment/reversed}}
                      bps: {$document: {$const: {name: bindings, path: /rate}}}
  opened:
    resultContract: outcome-v1
    automatic:
      'on': event
    do:
    - $if:
        cond:
          $not:
            $is:
              node:
                $event: ''
              pattern:
                type: Events/Event
                kind: Commission Payout Opened
        then:
        - $return: {}
    - $set:
        name: actionResult
        expr:
          $call:
            function: reserve
            args:
              input:
                key:
                  $event: /key
                amountMinor:
                  $event: /amountMinor
  observed:
    resultContract: outcome-v1
    automatic:
      'on': collection
      pathBinding: payouts
      event:
        type: Payment/Payment Event Received
    do:
    - $if:
        cond:
          $not:
            $is:
              node:
                $event: /event
              pattern:
                type: Payment/Payment Event Received
        then:
        - $return: {}
    - $set:
        name: actionResult
        expr:
          $call:
            function: reconcile
            args:
              input:
                key:
                  $sliceAfter:
                  - $event: /sourcePath
                  - $concat:
                    - $const:
                        name: bindings
                        path: /payouts
                    - /
description: Accrue the configured commission on confirmed net order receipts and reserve payouts. A payout
  settles its reserved commission G only after the operator reports the account-to-account split and the
  instruction completes the partner transfer N; MyOS retains F = G - N.
bindingTypes:
  orders: pointer
  payouts: pointer
  rate: pointer
defaultBindings:
  orders: /orders
  payouts: /payouts
  rate: /terms/commissionBps
