name: Commission Clause
type: Ledger/Ledger Clause
actionDefinition:
  type:
    type: Ledger/Balance Functions
    functions:
      # Exact shared readiness helpers; maintained conformance rejects stale pins.
      namedSourcesReady:
        blueId: EXZMLDv4TxmYaH7L8yrVKDahRDzM3AeKJv44D8P9WxFC
      processOrigin:
        blueId: 5UMRb3G6CPCKmkQKBLBhntAgaA5qjoJSLBbjS4kjS3VB
      rosterCovers:
        blueId: 2VRjCVXah8NQpo69uGhaMJZobwh36J77t6rz4edzv1ii
      reconcile:
        args:
          input: {}
        do:
        - $let:
            name: key
            expr:
              $var:
                name: input
                path: /key
        - $let:
            name: path
            expr:
              $concat:
              - $concat:
                - $const:
                    name: bindings
                    path: /payouts
                - /
              - $var: key
              - /payment
        - $let:
            name: pi
            expr:
              $document:
                $var: path
        - $let:
            name: s
            expr:
              $document:
                $const:
                  name: bindings
                  path: /state
        - $let:
            name: old
            expr:
              $pointerGet:
                object:
                  $var: s
                path:
                  $concat:
                  - /settlements/
                  - $var: key
        - $failIf:
            cond:
              $not:
                $exists:
                  $var: old
            message: UNKNOWN_SETTLEMENT
        - $let:
            name: state
            expr:
              $pointerGet:
                object:
                  $var: pi
                path: /payment
        - $let:
            name: net
            expr:
              $subtract:
              - $pointerGet:
                  object:
                    $var: state
                  path: /completed
              - $pointerGet:
                  object:
                    $var: state
                  path: /reversed
        - $failIf:
            cond:
              $not:
                $and:
                - $isKind:
                    val:
                      $var: net
                    kind: integer
                - $gte:
                  - $var: net
                  - 0
                - $lte:
                  - $var: net
                  - $pointerGet:
                      object:
                        $var: old
                      path: /amountMinor
            message: INVALID_CONFIRMED_PAYOUT
        - $let:
            name: terminal
            expr:
              $or:
              - $eq:
                - $pointerGet:
                    object:
                      $var: pi
                    path: /settlementOpen
                - false
              - $eq:
                - $pointerGet:
                    object:
                      $var: state
                    path: /rejected
                - true
              - $eq:
                - $pointerGet:
                    object:
                      $var: state
                    path: /closed
                - true
              - $eq:
                - $pointerGet:
                    object:
                      $var: state
                    path: /completed
                - $pointerGet:
                    object:
                      $var: old
                    path: /amountMinor
        - $if:
            cond:
              $not:
                $var: terminal
            then:
            - $return:
                outcome: duplicate
        - $if:
            cond:
              $ne:
              - $add:
                - $pointerGet:
                    object:
                      $var: state
                    path: /reserved/secure
                - $pointerGet:
                    object:
                      $var: state
                    path: /reserved/capture
                - $pointerGet:
                    object:
                      $var: state
                    path: /reserved/void
                - $pointerGet:
                    object:
                      $var: state
                    path: /reserved/refund
              - 0
            then:
            - $return:
                outcome: duplicate
        - $let:
            name: previousPaid
            expr:
              $pointerGet:
                object:
                  $var: old
                path: /paidMinor
                default: 0
        - $if:
            cond:
              $and:
              - $eq:
                - $pointerGet:
                    object:
                      $var: old
                    path: /status
                - closed
              - $eq:
                - $var: previousPaid
                - $var: net
            then:
            - $return:
                outcome: duplicate
        - $if:
            cond:
              $eq:
              - $pointerGet:
                  object:
                    $var: old
                  path: /status
              - reserved
            then:
            - $appendChange:
                op: replace
                path:
                  $concat:
                  - $const:
                      name: bindings
                      path: /state
                  - /reserved
                val:
                  $subtract:
                  - $pointerGet:
                      object:
                        $var: s
                      path: /reserved
                  - $pointerGet:
                      object:
                        $var: old
                      path: /amountMinor
        - $appendChange:
            op: replace
            path:
              $concat:
              - $const:
                  name: bindings
                  path: /state
              - /paid
            val:
              $add:
              - $pointerGet:
                  object:
                    $var: s
                  path: /paid
              - $subtract:
                - $var: net
                - $var: previousPaid
        - $appendChange:
            op: replace
            path:
              $concat:
              - $concat:
                - $const:
                    name: bindings
                    path: /state
                - /settlements/
              - $var: key
            val:
              amountMinor:
                $pointerGet:
                  object:
                    $var: old
                  path: /amountMinor
              paidMinor:
                $var: net
              status: closed
        - $appendEvent:
            $merge:
            - type: Events/Event
            - kind: Payout Reconciled
        - $return:
            outcome: acceptedNew
actions:
  reconcile:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: reconcile
            args:
              input:
                $var: params
  confirmed:
    resultContract: outcome-v1
    automatic:
      'on': collection
      pathBinding: orders
    do:
    - $if:
        cond:
          $not:
            $is:
              node:
                $event: /event
              pattern:
                type: Payment/Payment Event Received
                event:
                  type: PaymentInstruction/Payment Completed
        then:
        - $return: {}
    - $set:
        name: actionResult
        expr:
          $call:
            function: setTarget
            args:
              input:
                key:
                  $sliceAfter:
                  - $event: /sourcePath
                  - $concat:
                    - $const:
                        name: bindings
                        path: /orders
                    - /
                amountMinor:
                  $call:
                    function: roundBps
                    args:
                      basis:
                        $subtract:
                        - $document:
                            $concat:
                            - $event: /sourcePath
                            - /payment/payment/completed
                        - $document:
                            $concat:
                            - $event: /sourcePath
                            - /payment/payment/reversed
                      bps:
                        $document:
                          $const:
                            name: bindings
                            path: /rate
  reversed:
    resultContract: outcome-v1
    automatic:
      'on': collection
      pathBinding: orders
    do:
    - $if:
        cond:
          $not:
            $is:
              node:
                $event: /event
              pattern:
                type: Payment/Payment Event Received
                event:
                  type: PaymentInstruction/Payment Reversed After Completion
        then:
        - $return: {}
    - $set:
        name: actionResult
        expr:
          $call:
            function: setTarget
            args:
              input:
                key:
                  $sliceAfter:
                  - $event: /sourcePath
                  - $concat:
                    - $const:
                        name: bindings
                        path: /orders
                    - /
                amountMinor:
                  $call:
                    function: roundBps
                    args:
                      basis:
                        $subtract:
                        - $document:
                            $concat:
                            - $event: /sourcePath
                            - /payment/payment/completed
                        - $document:
                            $concat:
                            - $event: /sourcePath
                            - /payment/payment/reversed
                      bps:
                        $document:
                          $const:
                            name: bindings
                            path: /rate
  attached:
    resultContract: outcome-v1
    automatic:
      'on': event
      event:
        type: Documents/Document Attached
    do:
    - $if:
        cond:
          $not:
            $is:
              node: {$event: ''}
              pattern: {type: Documents/Document Attached}
        then:
        - $return: {}
    - $let: {name: key, expr: {$event: /itemKey}}
    - $let: {name: producer, expr: {$event: /clauseId}}
    - $forEach:
        item: part
        in: [{$var: key}, {$var: producer}]
        do:
        - $if:
            cond: {$not: {$isKind: {val: {$var: part}, kind: text}}}
            then:
            - $return: {}
        - $if:
            cond:
              $or:
              - {$eq: [{$var: part}, '']}
              - {$ne: [{$size: {$split: {text: {$var: part}, separator: /}}}, 1]}
              - {$ne: [{$size: {$split: {text: {$var: part}, separator: '~'}}}, 1]}
            then:
            - $return: {}
    - $let: {name: collection, expr: {$const: {name: bindings, path: /orders}}}
    - $if:
        cond:
          $ne:
          - {$document: {$concat: [/clauses/, {$var: producer}, /bindings/collection]}}
          - {$var: collection}
        then:
        - $return: {}
    - $let:
        name: itemPath
        expr: {$concat: [/process_, {$var: producer}, /entries/, {$nodeBlueId: {$var: key}}]}
    - $let: {name: item, expr: {$document: {$var: itemPath}}}
    - $let: {name: orderPath, expr: {$concat: [{$var: collection}, /, {$var: key}]}}
    - $if:
        cond:
          $not:
            $and:
            - {$eq: [{$var: {name: item, path: /key}}, {$var: key}]}
            - {$eq: [{$var: {name: item, path: /itemPath}}, {$var: itemPath}]}
            - {$eq: [{$var: {name: item, path: /path}}, {$var: orderPath}]}
            - {$eq: [{$var: {name: item, path: /status}}, usable]}
            - {$exists: {$var: {name: item, path: /requestId}}}
            - {$eq: [{$var: {name: item, path: /requestId}}, {$event: /inResponseTo}]}
            - {$exists: {$var: {name: item, path: /documentOrigin}}}
            - {$eq: [{$var: {name: item, path: /documentOrigin}}, {$event: /documentOrigin}]}
        then:
        - $return: {}
    - $let: {name: order, expr: {$document: {$var: orderPath}}}
    - $if:
        cond:
          $not:
            $and:
            - {$exists: {$var: {name: order, path: /contracts/initialized/document}}}
            - {$eq: [{$var: {name: order, path: /activation/active}}, true]}
        then:
        - $return: {}
    - $if:
        cond:
          $ne:
          - {$nodeBlueId: {$var: {name: order, path: /contracts/initialized/document}}}
          - {$var: {name: item, path: /documentOrigin}}
        then:
        - $return: {}
    - $if:
        cond:
          $not:
            $call:
              function: namedSourcesReady
              args: {document: {$var: order}}
        then:
        - $return: {}
    - $failIf:
        cond:
          $not:
            $and:
            - {$isKind: {val: {$var: {name: order, path: /payment/payment/completed}}, kind: integer}}
            - {$isKind: {val: {$var: {name: order, path: /payment/payment/reversed}}, kind: integer}}
            - {$gte: [{$var: {name: order, path: /payment/payment/completed}}, 0]}
            - {$gte: [{$var: {name: order, path: /payment/payment/reversed}}, 0]}
        message: INVALID_COMMISSION_INPUT
    - $set:
        name: actionResult
        expr:
          $call:
            function: setTarget
            args:
              input:
                key: {$var: key}
                amountMinor:
                  $call:
                    function: roundBps
                    args:
                      basis:
                        $subtract:
                        - {$var: {name: order, path: /payment/payment/completed}}
                        - {$var: {name: order, path: /payment/payment/reversed}}
                      bps: {$document: {$const: {name: bindings, path: /rate}}}
  opened:
    resultContract: outcome-v1
    automatic:
      'on': event
    do:
    - $if:
        cond:
          $not:
            $is:
              node:
                $event: ''
              pattern:
                type: Events/Event
                kind: Commission Payout Opened
        then:
        - $return: {}
    - $set:
        name: actionResult
        expr:
          $call:
            function: reserve
            args:
              input:
                key:
                  $event: /key
                amountMinor:
                  $event: /amountMinor
  observed:
    resultContract: outcome-v1
    automatic:
      'on': collection
      pathBinding: payouts
    do:
    - $if:
        cond:
          $not:
            $is:
              node:
                $event: /event
              pattern:
                type: Payment/Payment Event Received
        then:
        - $return: {}
    - $set:
        name: actionResult
        expr:
          $call:
            function: reconcile
            args:
              input:
                key:
                  $sliceAfter:
                  - $event: /sourcePath
                  - $concat:
                    - $const:
                        name: bindings
                        path: /payouts
                    - /
description: Accrue the configured commission on confirmed net order receipts, reserve payouts and reconcile
  their confirmed net results.
bindingTypes:
  orders: pointer
  payouts: pointer
  rate: pointer
defaultBindings:
  orders: /orders
  payouts: /payouts
  rate: /terms/commissionBps
