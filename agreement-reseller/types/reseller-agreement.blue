{
  "name": "Reseller Agreement",
  "type": "Agreements/Agreement",
  "description": "One Agreement, two root-local clauses, no embedded activation or termination processes. Supplier=A; Reseller=B.",
  "parameters": {},
  "initialClauses": {
    "activation": {
      "type": "MutualActivation/Mutual Activation Clause",
      "parameters": {
        "initialTerms": {
          "from": "/parameters"
        },
        "termSchema": {
          "literal": {
            "resellerDiscountBps": {
              "kind": "integer",
              "min": 0,
              "max": 10000
            },
            "terminationAllowedParty": {
              "kind": "text",
              "enum": [
                "A",
                "B",
                "EITHER"
              ]
            }
          }
        }
      },
      "bindings": {
        "state": "/activationState",
        "activated": "/activated",
        "terminated": "/terminated",
        "acceptedTerms": "/acceptedTerms",
        "acceptedRevision": "/acceptedRevision",
        "history": "/activationHistory",
        "closed": "/negotiationClosed",
        "channelA": "partyA",
        "channelB": "partyB",
        "initialize": "/contracts/initializeActivation",
        "actA": "/contracts/actA",
        "actB": "/contracts/actB",
        "stateUpdates": "/contracts/activationUpdates",
        "completeActivation": "/contracts/completeActivation"
      }
    },
    "termination": {
      "type": "ImmediateTermination/Immediate Termination Clause",
      "parameters": {
        "allowedParty": {
          "from": "/parameters/terminationAllowedParty"
        },
        "acceptedPolicyPointer": {
          "literal": "/terminationAllowedParty"
        }
      },
      "bindings": {
        "activated": "/activated",
        "terminated": "/terminated",
        "acceptedTerms": "/acceptedTerms",
        "acceptedRevision": "/acceptedRevision",
        "record": "/terminationRecord",
        "policy": "/terminationPolicy",
        "channelA": "partyA",
        "channelB": "partyB",
        "initialize": "/contracts/initializeTermination",
        "terminateA": "/contracts/terminateA",
        "terminateB": "/contracts/terminateB"
      }
    }
  },
  "channels": {},
  "clauseTypes": [
    "75nBVgJMtGeFVWQR45H5SYwscJJmu3TPUMbN5nxssi61",
    "2rTzppYhp24n3LmitoYNVRUV8JcDdrN1Jt1n6qyBFv9w"
  ]
}
