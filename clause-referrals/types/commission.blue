name: Commission Clause
type: Connections/Connected Clause
bindingTypes:
  agreements: pointer
  rate: pointer
actionDefinition:
  type: Referrals/Projection Functions
actions:
  update:
    resultContract: outcome-v1
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: commission
            args:
              input:
                $var: params
