{
  "description": "Message of a Timeline Entry on an evidence timeline that carries one whole proof. Every decision rests only on the proof's public output; document and operationEntry are an advisory lookup hint with no force and are compared with nothing. The schema is open: the processor checks that receipt, document and operationEntry are the only fields and are well formed, and skips an entry that is not.",
  "document": {
    "description": "Advisory hint: the document, named by its initial BlueId, normally written as the reference {blueId: ...} as an Operation Request writes its document. A free field: the processor requires its presence and compares it with nothing; this schema checks nothing."
  },
  "name": "Proof Entry",
  "operationEntry": {
    "description": "Advisory hint: the operation's Timeline Entry, named by its BlueId and normally written as the reference {blueId: ...}. A free field: the processor requires its presence and compares it with nothing; this schema checks nothing."
  },
  "receipt": {
    "description": "Complete proof in the single encoding admitted by the channel's evidence profile, as canonical base64 text: RFC 4648 standard alphabet with padding, zero pad bits and no other characters. Presence, text form and encoding are checked by the processor, not by this schema."
  },
  "specification": {
    "blueId": "E4c7rovuDCZ3rKubUDyabeDhrHXfoiVX2rdZFHCgwa8a"
  }
}
