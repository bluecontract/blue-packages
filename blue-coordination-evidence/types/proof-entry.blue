{
  "description": "Message of a Timeline Entry on an evidence timeline that carries one whole piece of evidence in the encoding of the channel's evidence profile. Every decision rests only on the values the evidence states. Only receipt is required; document and operationEntry are optional and are an advisory lookup hint with no force, compared with nothing. The schema is open: the processor checks that receipt is present and well formed and that no field beside these three is present, and skips an entry that is not.",
  "document": {
    "description": "Optional advisory hint: the document, named by the final id of its initial state, best written as that id's text, since a reference {blueId: ...} here is opened at admission like any reference. A free field: the processor compares it with nothing; this schema checks nothing."
  },
  "name": "Proof Entry",
  "operationEntry": {
    "description": "Optional advisory hint: the operation's Timeline Entry, named by its final id, best written as that id's text, since a reference {blueId: ...} here is opened at admission like any reference. A free field: the processor compares it with nothing; this schema checks nothing."
  },
  "receipt": {
    "description": "Required. The complete evidence in the encoding of the channel's evidence profile, as canonical base64 text (decided on content: a value that is not a Text is skipped, whether written in full or as a reference): RFC 4648 standard alphabet with padding, zero pad bits and no other characters. Presence, text form and encoding are checked by the processor, not by this schema."
  },
  "specification": {
    "blueId": "ErvK9PC58CpUcUzdJRfuTQhrYyQdvXFdBrrvzYh4T2Vn"
  }
}
