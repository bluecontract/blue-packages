{
  "description": "Message of a Timeline Entry on an evidence timeline that carries one whole proof. Every decision rests only on the proof's public output. Only receipt is required; document and operationEntry are optional and are an advisory lookup hint with no force, compared with nothing. The schema is open: the processor checks that receipt is present and well formed and that no field beside these three is present, and skips an entry that is not.",
  "document": {
    "description": "Optional advisory hint: the document, named by its initial BlueId, normally written as the reference {blueId: ...} as an Operation Request writes its document. A free field: the processor compares it with nothing; this schema checks nothing."
  },
  "name": "Proof Entry",
  "operationEntry": {
    "description": "Optional advisory hint: the operation's Timeline Entry, named by its BlueId and normally written as the reference {blueId: ...}. A free field: the processor compares it with nothing; this schema checks nothing."
  },
  "receipt": {
    "description": "Required. Complete proof in the single encoding admitted by the channel's evidence profile, as canonical base64 text: RFC 4648 standard alphabet with padding, zero pad bits and no other characters. Presence, text form and encoding are checked by the processor, not by this schema."
  },
  "specification": {
    "blueId": "QRsRSvNRCCthA3W3wDGzAvBayR7dNMNC4g9RGiuBQWU"
  }
}
