{
  "description": "Message of a Timeline Entry on an evidence timeline stating, with no evidence, that one operation entry is not to be processed in one document. The schema is open: the processor checks that document and operationEntry are present and are the only fields, and skips an entry that is not. Whether the entry names this document and the operation is a separate check.",
  "document": {
    "description": "The document, named by the final id of its initial state, the same for every participant, normally written as the reference {blueId: ...} as an Operation Request writes its document. A free field: the processor compares the final id of this field's node with the final id of the document's initial state; this schema checks nothing."
  },
  "name": "Rejection Entry",
  "operationEntry": {
    "description": "The operation's Timeline Entry, named by its final id and normally written as the reference {blueId: ...}. A free field: the processor compares the final id of this field's node with the final id of the operation entry (its member id when the entry is a member of a cyclic set); this schema checks nothing."
  },
  "specification": {
    "blueId": "5qMz44n8Pw2FntXMb15oSSJBu6NUKeWFv6ha57Sn8Cxw"
  }
}
