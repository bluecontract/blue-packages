{
  "description": "Participant channel that also names the proof timeline, the accepted mandate processor key and the evidence profile for operations decided by evidence. The three added fields are fixed for the life of the document. Implementation requires this exact protocol.",
  "evidenceProfile": {
    "description": "Published evidence profile under which evidence for this channel is checked. Its exact type is defined by the profile's package and selects the native support a host must implement.",
    "schema": {
      "required": true
    }
  },
  "mandateProcessorKey": {
    "description": "Public key whose signature on a private authority state this participant accepts.",
    "schema": {
      "required": true
    },
    "type": "Coordination/Ed25519 Public Key"
  },
  "name": "Timeline Channel with Evidence",
  "proofTimeline": {
    "description": "Proof timeline of this channel, at the provider of the channel's timeline. It is not an input source of the document.",
    "schema": {
      "required": true
    },
    "type": "Coordination/Signed Timeline"
  },
  "specification": {
    "blueId": "AHqtxXiezf147UqF31PkfBcuFzVQMsSFbaxeg7P1siic"
  },
  "type": "Coordination/Timeline Channel"
}
