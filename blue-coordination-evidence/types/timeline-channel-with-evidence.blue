{
  "description": "Participant channel that also names the evidence timeline, the accepted mandate processor key and the evidence profile for operations decided by evidence. An operation is decided with the fields of the state on which it is evaluated; an operation on a channel whose fields are not well formed is rejected. Implementation requires this exact protocol.",
  "evidenceProfile": {
    "description": "Published evidence profile under which evidence for this channel is checked. Its exact type must be a supported specialisation of Evidence Profile, defined by the profile's package; it selects the native support a host must implement. This schema does not enforce the exact type; the processor does.",
    "schema": {
      "required": true
    },
    "type": "CoordinationEvidence/Evidence Profile"
  },
  "evidenceTimeline": {
    "description": "Evidence timeline of this channel, at the provider of the channel's timeline. It is not an input source of the document.",
    "schema": {
      "required": true
    },
    "type": "Coordination/Signed Timeline"
  },
  "mandateProcessorKey": {
    "description": "Public key whose signature on a private authority state this participant accepts: 64 characters 0-9a-f that encode, canonically, a point of edwards25519 that is not of small order. The schema fixes the length; the processor checks the rest.",
    "schema": {
      "required": true
    },
    "type": "Coordination/Ed25519 Public Key"
  },
  "name": "Timeline Channel with Evidence",
  "specification": {
    "blueId": "ZVHP4CPfKkgaDaBZKKQwPxnvncBxXxmj3fYivJxhqSa"
  },
  "type": "Coordination/Timeline Channel"
}
