{
  "description": "Participant channel that also names the evidence timeline and the evidence profile for operations decided by evidence. An operation is decided with the fields of the state on which it is evaluated; an operation on a channel whose fields are not well formed is rejected. Implementation requires this exact protocol.",
  "evidenceProfile": {
    "description": "Published evidence profile under which evidence for this channel is checked. Its exact type must be a supported specialisation of Evidence Profile, defined by the profile's package; it selects the native support a host must implement. This schema does not enforce the exact type; the processor does.",
    "schema": {
      "required": true
    },
    "type": "CoordinationEvidence/Evidence Profile"
  },
  "evidenceTimeline": {
    "description": "Evidence timeline of this channel: by ancestry a Signed Timeline, at the provider of the channel's timeline (the two provider BlueIds are equal). As the evidence timeline it is not an input source of the document. The processor checks both.",
    "schema": {
      "required": true
    },
    "type": "Coordination/Signed Timeline"
  },
  "name": "Timeline Channel with Evidence",
  "specification": {
    "blueId": "ErvK9PC58CpUcUzdJRfuTQhrYyQdvXFdBrrvzYh4T2Vn"
  },
  "type": "Coordination/Timeline Channel"
}
