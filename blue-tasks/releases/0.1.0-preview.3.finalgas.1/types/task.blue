{
  "name": "Task",
  "description": "Plain Task domain type with instructions and owner/performer channels. Clause initialization and work issuance are opt-in behavior.",
  "type": "DocumentsDomain/Document",
  "instructions": {
    "type": "Text",
    "schema": {
      "required": true,
      "minLength": 1
    }
  },
  "contracts": {
    "owner": {
      "type": "Coordination/Timeline Channel"
    },
    "performer": {
      "type": "Coordination/Timeline Channel"
    }
  }
}
