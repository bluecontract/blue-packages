{
  "name": "Run On Initialization Clause",
  "type": "Tasks/Task Launch Policy",
  "actionDefinition": {
    "type": "Tasks/Task Work Functions"
  },
  "actions": {
    "request": {
      "resultContract": "outcome-v1",
      "do": [
        {
          "$set": {
            "name": "actionResult",
            "expr": {
              "$call": {
                "function": "request",
                "args": {
                  "params": {
                    "$var": "params"
                  }
                }
              }
            }
          }
        }
      ],
      "automatic": {
        "on": "initialized",
        "once": true
      }
    }
  }
}
