{
  "name": "Terminate After Final Report Clause",
  "type": "Clauses/Clause",
  "hookAbi": "document-context-1",
  "hookDefinition": {
    "type": "Contracts/Compute Definition",
    "functions": {
      "validateConfiguration": {
        "args": {},
        "do": [
          {
            "$return": {
              "allowed": true,
              "code": ""
            }
          }
        ]
      },
      "validateTransition": {
        "args": {},
        "do": [
          {
            "$return": {
              "allowed": false,
              "code": "TASK_CONFIGURATION_IMMUTABLE"
            }
          }
        ]
      },
      "plan": {
        "args": {},
        "do": [
          {
            "$return": {
              "$literal": {
                "states": {},
                "reads": [
                  {
                    "path": "/taskWork",
                    "kind": "object"
                  }
                ],
                "contracts": {
                  "taskFinalReport": {
                    "kind": "channel",
                    "contract": {
                      "type": "Contracts/Triggered Event Channel",
                      "event": {
                        "type": "Tasks/Task Report Accepted"
                      }
                    }
                  },
                  "taskTerminate": {
                    "kind": "handler",
                    "contract": {
                      "type": "Contracts/Sequential Workflow",
                      "channel": "taskFinalReport",
                      "steps": [
                        {
                          "type": "Contracts/Compute",
                          "do": [
                            {
                              "$failIf": {
                                "cond": {
                                  "$ne": [
                                    {
                                      "$document": {
                                        "$pointerJoin": [
                                          "taskWork",
                                          "requests",
                                          {
                                            "$event": "/requestId"
                                          },
                                          "report"
                                        ]
                                      }
                                    },
                                    {
                                      "$event": "/report"
                                    }
                                  ]
                                },
                                "message": "TASK_ACCEPTED_REPORT_REQUIRED"
                              }
                            }
                          ]
                        },
                        {
                          "type": "Contracts/Terminate Processing",
                          "cause": "Task accepted a final report"
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "governsAmendments": true
}
