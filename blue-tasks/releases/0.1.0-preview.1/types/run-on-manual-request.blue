{
  "name": "Run On Manual Request Clause",
  "type": "Tasks/Task Launch Policy",
  "actionDefinition": {
    "type": "Tasks/Task Work Functions"
  },
  "actions": {
    "request": {
      "resultContract": "outcome-v1",
      "do": [
        {
          "$set": {
            "name": "actionResult",
            "expr": {
              "$call": {
                "function": "request",
                "args": {
                  "params": {
                    "$var": "params"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
