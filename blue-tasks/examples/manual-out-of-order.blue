{
  "name": "Repeated manual Task",
  "type": "Tasks/Task",
  "instructions": "Return Integer 60.",
  "clauses": {
    "work": {
      "type": "Tasks/Task Work Clause",
      "parameters": {
        "reportRequest": {
          "name": "Successful Task report",
          "result": {
            "type": "Integer",
            "schema": {
              "required": true
            }
          },
          "requestId": {
            "type": "Text",
            "schema": {
              "required": true,
              "minLength": 1
            }
          },
          "status": {
            "type": "Text",
            "schema": {
              "required": true,
              "enum": [
                "succeeded"
              ]
            }
          }
        }
      }
    },
    "initial": {
      "type": "Tasks/Run On Initialization Clause"
    },
    "manual": {
      "type": "Tasks/Run On Manual Request Clause",
      "bindings": {
        "request": {
          "execute": {
            "on": "workflow",
            "channel": "owner"
          }
        }
      }
    },
    "ownerTermination": {
      "type": "Tasks/Terminate On Owner Request Clause"
    }
  }
}
