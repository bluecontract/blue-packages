name: Factory Functions
type: Activation/Child Activation Functions
functions:
  create:
    args:
      input: {}
    do:
    - $let:
        name: key
        expr:
          $var:
            name: input
            path: /key
    - $failIf:
        cond:
          $not:
            $and:
            - $isKind:
                val:
                  $var: key
                kind: text
            - $ne:
              - $var: key
              - ''
            - $eq:
              - $size:
                  $split:
                    text:
                      $var: key
                    separator: /
              - 1
            - $eq:
              - $size:
                  $split:
                    text:
                      $var: key
                    separator: '~'
              - 1
        message: Invalid document key
    - $let:
        name: path
        expr:
          $concat:
          - $const:
              name: bindings
              path: /collection
          - /
          - $var: key
    - $let:
        name: intent
        expr:
          fields:
            $pointerGet:
              object:
                $var: input
              path: /fields
              default: {}
          templateBlueId:
            $nodeBlueId:
              $document:
                $const:
                  name: bindings
                  path: /template
          sourcePaths:
            $pointerGet:
              object:
                $const: parameters
              path: /sourcePaths
              default: {}
          inheritChannels:
            $pointerGet:
              object:
                $const: parameters
              path: /inheritChannels
              default: []
    - $if:
        cond:
          $exists:
            $document:
              $var: path
        then:
        - $failIf:
            cond:
              $ne:
              - $document:
                  $concat:
                  - $var: path
                  - /creationIntent
              - $var: intent
            message: DOCUMENT_KEY_CONFLICT
        - $return:
            outcome: duplicate
            path:
              $var: path
            key:
              $var: key
    - $let:
        name: child
        expr:
          $document:
            $const:
              name: bindings
              path: /template
    - $set:
        name: child
        expr:
          $call:
            function: activateChild
            args:
              child:
                $var: child
              roles:
                $pointerGet:
                  object:
                    $const: parameters
                  path: /parties
                  default: []
              readerNames:
                $pointerGet:
                  object:
                    $const: parameters
                  path: /readers
                  default: []
              frozen: false
    - $failIf:
        cond:
          $exists:
            $var:
              name: child
              path: /contracts/initialized
        message: Factory requires an uninitialized template
    - $forEach:
        item: role
        in:
          $list:
            $const:
              name: parameters
              path: /inheritChannels
        do:
        - $failIf:
            cond:
              $not:
                $and:
                - $isKind:
                    val:
                      $var: role
                    kind: text
                - $ne:
                  - $var: role
                  - ''
                - $eq:
                  - $size:
                      $split:
                        text:
                          $var: role
                        separator: /
                  - 1
                - $eq:
                  - $size:
                      $split:
                        text:
                          $var: role
                        separator: '~'
                  - 1
            message: 'FACTORY_CHANNEL: invalid participant channel name'
        - $let:
            name: channelPath
            expr:
              $concat:
              - /contracts/
              - $var: role
        - $let:
            name: inherited
            expr:
              $document:
                $var: channelPath
        - $failIf:
            cond:
              $not:
                $or:
                - $is:
                    node:
                      $var: inherited
                    pattern:
                      type: Contracts/External Channel
                - $is:
                    node:
                      $var: inherited
                    pattern:
                      type: Coordination/Timeline Channel
                - $is:
                    node:
                      $var: inherited
                    pattern:
                      type: Coordination/Timeline Channel
            message: 'FACTORY_CHANNEL: only explicit participant channels may be inherited'
        - $failIf:
            cond:
              $and:
              - $exists:
                  $pointerGet:
                    object:
                      $var: child
                    path:
                      $var: channelPath
              - $ne:
                - $pointerGet:
                    object:
                      $var: child
                    path:
                      $var: channelPath
                - $var: inherited
            message: 'FACTORY_CHANNEL: template declares a different participant channel'
        - $set:
            name: child
            expr:
              $objectSet:
                object:
                  $var: child
                key: contracts
                val:
                  $objectSet:
                    object:
                      $object:
                        $var:
                          name: child
                          path: /contracts
                    key:
                      $var: role
                    val:
                      $var: inherited
    - $forEach:
        item: nextValue
        key: field
        in:
          $pointerGet:
            object:
              $var: input
            path: /fields
            default: {}
        do:
        - $failIf:
            cond:
              $or:
              - $not:
                  $includes:
                    list:
                      $const:
                        name: parameters
                        path: /allowedFields
                    val:
                      $var: field
              - $includes:
                  list:
                  - contracts
                  - clauses
                  - type
                  - itemType
                  - keyType
                  - valueType
                  - value
                  - items
                  - blueId
                  - blue
                  - schema
                  - constraints
                  - mergePolicy
                  - properties
                  - $previous
                  - $previousItems
                  - $pos
                  - $replace
                  - $empty
                  - instanceKey
                  val:
                    $var: field
            message: Field not allowed by document factory
        - $set:
            name: child
            expr:
              $objectSet:
                object:
                  $var: child
                key:
                  $var: field
                val:
                  $var: nextValue
    - $let:
        name: sources
        expr: {}
    - $forEach:
        key: sourceKey
        item: sourcePath
        in:
          $object:
            $const:
              name: parameters
              path: /sourcePaths
        do:
        - $failIf:
            cond:
              $not:
                $exists:
                  $document:
                    $concat:
                    - $var: sourcePath
                    - /contracts/initialized
            message: SOURCE_NOT_INITIALIZED
        - $let:
            name: ref
            expr:
              $objectSet:
                object: {}
                key: blueId
                val:
                  $nodeBlueId:
                    $document:
                      $var: sourcePath
        - $set:
            name: sources
            expr:
              $objectSet:
                object:
                  $var: sources
                key:
                  $var: sourceKey
                val:
                  $var: ref
    - $set:
        name: child
        expr:
          $merge:
          - $var: child
          - sources:
              $var: sources
            creationIntent:
              $var: intent
    - $let:
        name: identity
        expr:
          $concat:
          - $nodeBlueId:
              $document: /contracts/initialized/document
          - ':'
          - $const: clauseKey
          - ':'
          - $var: key
    - $set:
        name: child
        expr:
          $merge:
          - $var: child
          - instanceKey:
              $var: identity
    - $forEach:
        item: identityPath
        in:
          $list:
            $const:
              name: parameters
              path: /identityChildren
        do:
        - $failIf:
            cond:
              $not:
                $and:
                - $exists:
                    $pointerGet:
                      object:
                        $var: child
                      path:
                        $var: identityPath
                - $not:
                    $exists:
                      $pointerGet:
                        object:
                          $var: child
                        path:
                          $concat:
                          - $var: identityPath
                          - /contracts/initialized
            message: IDENTITY_CHILD_MUST_BE_UNINITIALIZED_TEMPLATE
        - $set:
            name: child
            expr:
              $pointerSet:
                object:
                  $var: child
                path:
                  $concat:
                  - $var: identityPath
                  - /instanceKey
                val:
                  $concat:
                  - $var: identity
                  - ':'
                  - $var: identityPath
    - $appendChange:
        op: add
        path:
          $var: path
        val:
          $var: child
    - $appendEvent:
        $merge:
        - type: Commerce/Domain Event
        - kind: Document Started
          clause:
            $const: clauseKey
          entityId:
            $var: key
          path:
            $var: path
    - $return:
        outcome: acceptedNew
        path:
          $var: path
        key:
          $var: key
