name: Documents Clause
type: Documents/Document Base
description: Keyed collection using the same preparation, provision and readiness lifecycle as Document
  Clause. start is the compatibility alias of prepare.
actionDefinition:
  type: Documents/Document Preparation Functions
cardinality: keyed
destinationBinding: collection
bindingTypes:
  collection: pointer
embedsCollections:
- collection
actions:
  start:
    resultContract: outcome-v1
    defaults:
      fields: {}
      values: {}
    preflight:
    - $set:
        name: actionResult
        expr:
          $call:
            function: checkPreparation
            args:
              input:
                $var: params
    do:
    - $set:
        name: actionResult
        expr:
          $call:
            function: sharedPrepare
            args:
              input:
                $var: params
              checked:
                $var: actionResult
