name: Preparation Plan
type: Connections/Connection Planning Functions
constants:
  refreshCanonicalFunctions:
    accessRecordsValid: BWZxSpWmbP4QkHTnBXNHtVgmNNL8s5jy3DMkS6KbgBwb
    checkedDomainNextActions: ARzZgck3qEStHv5377YNq39fLf18XWYHqg9Lfy94iBeR
    configurationParameters: 7WbS9JNjpW2d58txqa8cXbwrcsV5oqYsdhkqZ3oLiR1X
    configuredSources: 7dU4X5Ek1pQaz7wV44zTYYRRNwmy9dnPzWRE7NmG58iS
    domainNextActions: ETnUA4vaa8YtPsG1Bjp2evZCSsA31gjMcyNgTygjmasR
    mappedBootstrapPartyCovered: F4Rzri4cpxTEnByVF3KCNfhM6uWF8Pww7PqaWt28sFrc
    namedSourcesReady: EXZMLDv4TxmYaH7L8yrVKDahRDzM3AeKJv44D8P9WxFC
    processOrigin: 5UMRb3G6CPCKmkQKBLBhntAgaA5qjoJSLBbjS4kjS3VB
    processStatePath: 6QXrUmZRXVy88TLUtc18x12cdMJDTntTnjhWTJkJc22j
    readerGroups: DvDZ2osJuDV2CbtoLUfUt1xNNXffYxKYtTzBdaaSP3Gb
    requireSameBootstrapParty: b3ueEPKpdb42HWsCzUYKgESSP16DpeYXemCUY545sZQ
    requireSameBootstrapPrimary: GsmtbmyMpRwJZkSc7xLBELSTp3sdGDiEwFDmK1Yn8Bba
    requireSameMainParty: BeocmvaZ64mC5qeEFbBuxnJx3PPoyqwtKmuAJCutskdL
    rootSourceAccessLost: 5s74N3hwsX6nFSj9K4k23Gg52LpQRzK1T2hdshSCRqdK
    rootSourceReaderGroupsMatch: Eb5SaH46VJA3qZbLfQuzqDarhuhKkuE4smShvQoiCWPb
    rootSourceReaderPartyCovered: C13BnXMtSEzPFE8q9AyxewaeQ9orCYXwV3LEiFdT8knt
    rootSourceReaderScope: 9UBgJm6Nrw3iMKAu9CpfS9mkZwqN6jLAwdDGusdaGdGa
    rootSourceReadersReady: 3r1imQW6LZVbsV3cbe9FMzc379ad7KtWX2ja7RSP5xrR
    rosterCovers: 2VRjCVXah8NQpo69uGhaMJZobwh36J77t6rz4edzv1ii
    sharedRefresh: AynC5EBRaeU35R5bVn12setevqkqGx8pZAe3K1bzwmye
    sourceDeclarationMatches: 6UieaF5Xk9n84qdN95v8XE2ZsRoQhwcDA1KVxAPJz5Zf
    transports: ERUpqV1ukEE2eZWaDJP6Dxne1Z12WTkrXgDiKDGRgDjV
  admissionCanonicalDefinition:
    type: Documents/Admission Functions
functions:
  refreshDefinition:
    args:
      definition: {}
      definitionPath: {type: Text}
    do:
    - $let: {name: selected, expr: {}}
    - $forEach:
        item: canonical
        key: functionName
        in: {$const: refreshCanonicalFunctions}
        do:
        - $let:
            name: body
            expr:
              $document:
                $concat: [{$var: definitionPath}, /functions/, {$var: functionName}]
        # Preserve complete custom definitions when a reachable override introduces
        # other helpers. This is the permanent custom-library compatibility path.
        - $if:
            cond:
              $or:
              - {$not: {$exists: {$var: body}}}
              - {$ne: [{$nodeBlueId: {$var: body}}, {$var: canonical}]}
            then:
            - $return: {$var: definition}
        - $set:
            name: selected
            expr:
              $objectSet:
                object: {$var: selected}
                key: {$var: functionName}
                val: {$var: body}
    - $return:
        $merge:
        - type: Contracts/Compute Definition
        - functions: {$var: selected}
          constants:
            $choose:
              cond: {$exists: {$document: {$concat: [{$var: definitionPath}, /constants]}}}
              then: {$document: {$concat: [{$var: definitionPath}, /constants]}}
              else: {}
  assembleAdmissionDefinition:
    args:
      definition: {}
      names: []
      definitionPath:
        type: Text
      canonicalPath:
        type: Text
      clauses: {}
      clauseKey:
        type: Text
    do:
    - $return:
        $call:
          function: admissionDefinition
          args:
            definition:
              $var: definition
            names:
              $var: names
            definitionPath:
              $var: definitionPath
            canonicalPath:
              $var: canonicalPath
  admissionDefinition:
    args:
      definition: {}
      definitionPath: {type: Text}
      canonicalPath: {type: Text}
      names: []
    do:
    # Project only the canonical library. Custom subtype implementations keep their
    # complete definition, including any additional helper functions they introduce.
    - $if:
        cond: {$not: {$exists: {$document: {$var: canonicalPath}}}}
        then:
        - $return: {$var: definition}
    - $if:
        cond:
          $ne:
          - {$nodeBlueId: {$document: {$var: canonicalPath}}}
          - $nodeBlueId:
              $get:
                object: {$literal: {type: Documents/Admission Functions}}
                key: type
        then:
        - $return: {$var: definition}
    - $let: {name: selected, expr: {}}
    - $forEach:
        item: functionName
        in: {$var: names}
        do:
        - $let:
            name: body
            expr:
              $document:
                $concat: [{$var: definitionPath}, /functions/, {$var: functionName}]
        - $if:
            cond: {$not: {$exists: {$var: body}}}
            then:
            - $return: {$var: definition}
        - $if:
            cond:
              $ne:
              - {$nodeBlueId: {$var: body}}
              - $nodeBlueId:
                  $document:
                    $concat: [{$var: canonicalPath}, /functions/, {$var: functionName}]
            then:
            - $return: {$var: definition}
        - $set:
            name: selected
            expr:
              $objectSet:
                object: {$var: selected}
                key: {$var: functionName}
                val: {$var: body}
    - $return:
        $merge:
        - type: Contracts/Compute Definition
        - constants:
            $choose:
              cond: {$exists: {$document: {$concat: [{$var: definitionPath}, /constants]}}}
              then: {$document: {$concat: [{$var: definitionPath}, /constants]}}
              else: {}
          functions: {$var: selected}
  validateConfiguration:
    args: {}
    do:
    - $return:
        $call:
          function: validateConnectionsConfiguration
          args: {}
  validateTransition:
    args: {}
    do:
    - $return:
        allowed: false
        code: PREPARATION_IMMUTABLE_WHILE_OBLIGATIONS_EXIST
  plan:
    args: {}
    do:
    - $let:
        name: plan
        expr:
          $call:
            function: planConnections
            args: {}
    - $let:
        name: statePath
        expr:
          $concat:
          - /process_
          - $const: clauseKey
    - $let:
        name: clause
        expr:
          $document:
            $concat:
            - /clauseRuntime/work/candidate/
            - $const: clauseKey
    # Refresh handlers need the same exact clause and frozen template context
    # as action connections, without copying any action's execution bindings.
    - $let: {name: refreshSnapshots, expr: {}}
    - $forEach:
        item: snapshotName
        in: {$list: {$document: {$concat: [/clauseRuntime/work/candidate/, {$const: clauseKey}, /type/snapshotBindings]}}}
        do:
        - $let:
            name: snapshotPath
            expr: {$get: {object: {$pointerGet: {object: {$var: clause}, path: /bindings, default: {}}}, key: {$var: snapshotName}}}
        - $if:
            cond: {$exists: {$var: snapshotPath}}
            then:
            - $failIf:
                cond: {$not: {$isKind: {val: {$var: snapshotPath}, kind: text}}}
                message: SNAPSHOT_BINDING_PATH_REQUIRED
            - $let: {name: snapshot, expr: {$document: {$var: snapshotPath}}}
            - $failIf:
                cond: {$not: {$exists: {$var: snapshot}}}
                message: SNAPSHOT_BINDING_MISSING
            - $set:
                name: refreshSnapshots
                expr: {$objectSet: {object: {$var: refreshSnapshots}, key: {$var: snapshotName}, val: {$var: snapshot}}}
    - $let:
        name: refreshFunctions
        expr:
          connectionConfiguration:
            args: {}
            expr: {$objectFromEntries: [{key: $literal, val: {$var: clause}}]}
          connectionSnapshots:
            args: {}
            expr: {$objectFromEntries: [{key: $literal, val: {$var: refreshSnapshots}}]}
    - $let:
        name: refreshBindings
        expr:
          $choose:
            cond: {$exists: {$pointerGet: {object: {$var: clause}, path: /bindings/sources}}}
            then:
              sources: {$pointerGet: {object: {$var: clause}, path: /bindings/sources}}
            else: {}
    - $let:
        name: destinationBinding
        expr:
          $document:
            $concat:
            - /clauseRuntime/work/candidate/
            - $const: clauseKey
            - /type/destinationBinding
    - $let:
        name: destination
        expr:
          $get:
            object:
              $pointerGet:
                object:
                  $var: clause
                path: /bindings
            key:
              $var: destinationBinding
    - $let:
        name: definition
        expr:
          $objectFromEntries:
          - key: blueId
            val:
              $nodeBlueId:
                $document:
                  $concat:
                  - /clauseRuntime/work/candidate/
                  - $const: clauseKey
                  - /type/actionDefinition/type
    - $let:
        name: refreshDefinition
        expr:
          $call:
            function: refreshDefinition
            args:
              definition: {$var: definition}
              definitionPath:
                $concat: [/clauseRuntime/work/candidate/, {$const: clauseKey}, /type/actionDefinition/type]
    - $set:
        name: plan
        expr:
          $pointerSet:
            object:
              $var: plan
            path: /states/process
            val:
              path:
                $var: statePath
              kind: object
              initial:
                entries: {}
    - $set:
        name: plan
        expr:
          $pointerSet:
            object:
              $var: plan
            path:
              $concat:
              - /contracts/processUpdate_
              - $const: clauseKey
            val:
              kind: channel
              contract:
                $merge:
                - type: Contracts/Document Update Channel
                - path:
                    $var: destination
    - $set:
        name: plan
        expr:
          $pointerSet:
            object:
              $var: plan
            path:
              $concat:
              - /contracts/refreshProcesses_
              - $const: clauseKey
            val:
              kind: handler
              contract:
                $merge:
                - type: Contracts/Sequential Workflow
                - channel:
                    $concat:
                    - processUpdate_
                    - $const: clauseKey
                  steps:
                  - $merge:
                    - type: Contracts/Compute
                    - definition:
                        $var: refreshDefinition
                      functions: {$var: refreshFunctions}
                      constants:
                        clauseKey:
                          $const: clauseKey
                        bindings: {$var: refreshBindings}
                      do:
                        $literal:
                        - $call:
                            function: sharedRefresh
                            args: {}
    - $set:
        name: plan
        expr:
          $pointerSet:
            object:
              $var: plan
            path:
              $concat:
              - /contracts/processEmbedded_
              - $const: clauseKey
            val:
              kind: channel
              contract:
                type: Contracts/Embedded Node Channel
    - $set:
        name: plan
        expr:
          $pointerSet:
            object:
              $var: plan
            path:
              $concat:
              - /contracts/refreshEmbeddedProcesses_
              - $const: clauseKey
            val:
              $pointerSet:
                object:
                  $pointerGet:
                    object:
                      $var: plan
                    path:
                      $concat:
                      - /contracts/refreshProcesses_
                      - $const: clauseKey
                path: /contract/channel
                val:
                  $concat:
                  - processEmbedded_
                  - $const: clauseKey
    # A destination update denied before activation is not replayed. Re-evaluate
    # on the later local transition using ordinary dispatch and the same guards.
    # Refresh writes process state only, so it cannot trigger this channel itself.
    - $set:
        name: plan
        expr:
          $pointerSet:
            object: {$var: plan}
            path: {$concat: [/contracts/processActivation_, {$const: clauseKey}]}
            val:
              kind: channel
              contract:
                $merge:
                - type: Contracts/Document Update Channel
                - path: /activation
    - $set:
        name: plan
        expr:
          $pointerSet:
            object: {$var: plan}
            path: {$concat: [/contracts/refreshActivationProcesses_, {$const: clauseKey}]}
            val:
              $pointerSet:
                object:
                  $pointerGet:
                    object: {$var: plan}
                    path: {$concat: [/contracts/refreshProcesses_, {$const: clauseKey}]}
                path: /contract/channel
                val: {$concat: [processActivation_, {$const: clauseKey}]}
    # Reuse Activation's exact ordered access channels. No generic child or
    # financial handler is admitted while access is unavailable.
    - $let: {name: accessIndex, expr: 0}
    - $forEach:
        item: accessPath
        in:
          $pointerGet:
            object: {$document: /clauseRuntime/work/candidate/activation/parameters}
            path: /accessPaths
            default: []
        do:
        - $set:
            name: plan
            expr:
              $pointerSet:
                object: {$var: plan}
                path: {$concat: [/contracts/rootSourceAccess_, {$const: clauseKey}, _, {$text: {$var: accessIndex}}]}
                val:
                  kind: handler
                  contract:
                    $merge:
                    - type: Contracts/Sequential Workflow
                    - channel: {$concat: [activationAccess, {$text: {$var: accessIndex}}]}
                      steps:
                      - $merge:
                        - type: Contracts/Compute
                        - definition: {$var: refreshDefinition}
                          functions: {$var: refreshFunctions}
                          constants:
                            clauseKey: {$const: clauseKey}
                            bindings: {$var: refreshBindings}
                          do:
                            $literal:
                            - $call:
                                function: rootSourceAccessLost
                                args: {}
        - $set: {name: accessIndex, expr: {$add: [{$var: accessIndex}, 1]}}
    - $set:
        name: plan
        expr:
          $call:
            function: planAdmission
            args:
              base:
                $var: plan
              definition:
                $var: definition
    - $set:
        name: plan
        expr:
          $call:
            function: planDocumentAccess
            args:
              base:
                $var: plan
              definition:
                $var: definition
    - $set:
        name: plan
        expr:
          $call:
            function: planSourceValidators
            args:
              base:
                $var: plan
    - $return:
        $var: plan
  planAdmission:
    args:
      base: {}
      definition: {}
    do:
    - $return:
        $call:
          function: assembleAdmissionPlan
          args:
            base:
              $var: base
            definition:
              $var: definition
            clauses:
              $document: /clauseRuntime/work/candidate
            clauseKey:
              $const: clauseKey
  assembleAdmissionPlan:
    $blue:functionFrom:
      type: Documents/Admission Plan Function
  planDocumentAccess:
    args:
      base: {}
      definition: {}
    do:
    - $let:
        name: result
        expr:
          $var: base
    - $let:
        name: basePath
        expr:
          $concat:
          - /processAccess_
          - $const: clauseKey
    - $forEach:
        item: party
        in:
          $document: /clauseRuntime/work/candidate/activation/parameters/parties
        do:
        - $set:
            name: result
            expr:
              $pointerSet:
                object:
                  $var: result
                path:
                  $concat:
                  - /contracts/registerAccess_
                  - $const: clauseKey
                  - _
                  - $var: role
                val:
                  kind: handler
                  contract:
                    $merge:
                    - type: Contracts/Sequential Workflow Operation
                    - channel:
                        $var: role
                      steps:
                      - $merge:
                        - type: Contracts/Compute
                        - definition:
                            $var: definition
                          do:
                            $literal:
                            - $call:
                                function: registerDocumentAccessPublic
                                args:
                                  input:
                                    $merge:
                                    - $binding: call/request
                                    - basePath:
                                        $const: accessBasePath
                          constants:
                            accessBasePath:
                              $var: basePath
                            clauseKey:
                              $const: clauseKey
                            bindings: {}
                      - type: Activation/Refresh Activation
                    - $literal:
                        $blue:requestFrom:
                          definition:
                            type: Documents/Document Access Functions
                          function: registerDocumentAccessPublic
                          argument: input
        key: role
    - $let:
        name: embedded
        expr:
          $pointerGet:
            object:
              $var: result
            path: /contracts/embedded
            default:
              kind: embedding
              contract:
                type: Contracts/Process Embedded
                paths: []
                collectionPaths: []
    - $set:
        name: embedded
        expr:
          $pointerSet:
            object:
              $var: embedded
            path: /contract/collectionPaths
            val:
              $listConcat:
              - $pointerGet:
                  object:
                    $var: embedded
                  path: /contract/collectionPaths
                  default: []
              - - $var: basePath
    - $set:
        name: result
        expr:
          $pointerSet:
            object:
              $var: result
            path: /contracts/embedded
            val:
              $var: embedded
    - $return:
        $var: result
  planSourceValidators:
    args:
      base: {}
    do:
    - $forEach:
        key: contractId
        item: entry
        in:
          $pointerGet:
            object:
              $var: base
            path: /contracts
        do:
        - $forEach:
            index: stepIndex
            item: compute
            in:
              $pointerGet:
                object:
                  $var: entry
                path: /contract/steps
                default: []
            do:
            - $if:
                cond:
                  $exists:
                    $pointerGet:
                      object:
                        $var: compute
                      path: /functions/connectionConfiguration
                then:
                - $let:
                    name: configuration
                    expr:
                      $pointerGet:
                        object:
                          $var: compute
                        path: /functions/connectionConfiguration/expr/$literal
                - $let:
                    name: template
                    expr:
                      $choose:
                        cond:
                          $exists:
                            $pointerGet:
                              object:
                                $var: configuration
                              path: /parameters/template
                        then:
                          $pointerGet:
                            object:
                              $var: configuration
                            path: /parameters/template
                        else:
                          $pointerGet:
                            object:
                              $var: compute
                            path: /functions/connectionSnapshots/expr/$literal/template
                - $let:
                    name: declarations
                    expr:
                      $pointerGet:
                        object:
                          $var: template
                        path: /sources
                        default: {}
                - $forEach:
                    key: clauseId
                    item: clause
                    in:
                      $pointerGet:
                        object:
                          $var: template
                        path: /clauses
                        default: {}
                    do:
                    - $forEach:
                        key: alias
                        item: sourceDeclaration
                        in:
                          $pointerGet:
                            object:
                              $var: clause
                            path: /parameters/sources
                            default: {}
                        do:
                        - $if:
                            cond:
                              $hasKey:
                                object:
                                  $var: declarations
                                key:
                                  $var: alias
                            then:
                            - $failIf:
                                cond:
                                  $ne:
                                  - $get:
                                      object:
                                        $var: declarations
                                      key:
                                        $var: alias
                                  - $var: sourceDeclaration
                                message: SOURCE_DECLARATION_CONFLICT
                        - $set:
                            name: declarations
                            expr:
                              $objectSet:
                                object:
                                  $var: declarations
                                key:
                                  $var: alias
                                val:
                                  $var: sourceDeclaration
                - $let:
                    name: matcherBody
                    expr: []
                - $forEach:
                    key: alias
                    item: declaration
                    in:
                      $var: declarations
                    do:
                    - $let:
                        name: branch
                        expr:
                          $pointerSet:
                            object:
                              $pointerSet:
                                object:
                                  $literal:
                                    $if:
                                      cond:
                                        $eq:
                                        - $var: alias
                                        - ''
                                      then:
                                      - $return:
                                          $is:
                                            node:
                                              $var: source
                                            pattern: {}
                                path: /$if/cond/$eq/1
                                val:
                                  $var: alias
                            path: /$if/then/0/$return/$is/pattern
                            val:
                              $var: declaration
                    - $set:
                        name: matcherBody
                        expr:
                          $listConcat:
                          - $var: matcherBody
                          - - $var: branch
                - $set:
                    name: matcherBody
                    expr:
                      $listConcat:
                      - $var: matcherBody
                      - $literal:
                        - $return: false
                - $set:
                    name: compute
                    expr:
                      $pointerSet:
                        object:
                          $var: compute
                        path: /functions/configuredSources
                        val:
                          args: {}
                          expr:
                            $objectFromEntries:
                            - key: $literal
                              val:
                                $var: declarations
                - $set:
                    name: compute
                    expr:
                      $pointerSet:
                        object:
                          $var: compute
                        path: /functions/sourceDeclarationMatches
                        val:
                          args:
                            alias:
                              type: Text
                            source: {}
                          do:
                            $var: matcherBody
                - $set:
                    name: base
                    expr:
                      $pointerSet:
                        object:
                          $var: base
                        path:
                          $concat:
                          - /contracts/
                          - $var: contractId
                          - /contract/steps/
                          - $text:
                              $var: stepIndex
                        val:
                          $var: compute
    - $return:
        $var: base
