name: Bootstrap Preparation Functions
type: Documents/Source Functions
description: Prepare fresh child transports while retaining mapped parties and validating native access evidence. This does not bootstrap a document or change activation rules.
functions:
  preparationMode:
    args: {}
    do:
    - $let:
        name: parameters
        expr: {$call: {function: configurationParameters, args: {}}}
    - $if:
        cond: {$exists: {$pointerGet: {object: {$var: parameters}, path: /prepareFor}}}
        then:
        - $failIf:
            cond: {$ne: [{$pointerGet: {object: {$var: parameters}, path: /prepareFor}}, bootstrap]}
            message: PREPARATION_MODE_INVALID
        - $failIf:
            cond: {$ne: [{$pointerGet: {object: {$var: parameters}, path: /obtain, default: create}}, provide]}
            message: PREPARATION_BOOTSTRAP_REQUIRES_PROVIDE
        - $failIf:
            cond: {$gt: [{$size: {$pointerGet: {object: {$var: parameters}, path: /inheritChannels, default: []}}}, 0]}
            message: PREPARATION_BOOTSTRAP_CANNOT_INHERIT_CHANNELS
        - $return: bootstrap
    - $return: inherited
  prepareMappedChild:
    args:
      child: {}
      mapping: {}
      suppliedRoles: []
    do:
    - $if:
        cond: {$ne: [{$call: {function: preparationMode, args: {}}}, bootstrap]}
        then:
        - $return:
            $call:
              function: prepareChild
              args:
                child: {$var: child}
                mapping: {$var: mapping}
                suppliedRoles: {$var: suppliedRoles}
    - $failIf:
        cond: {$exists: {$pointerGet: {object: {$var: child}, path: /contracts/initialized}}}
        message: CHILD_ALREADY_INITIALIZED
    - $failIf:
        cond:
          $ne:
          - {$nodeBlueId: {$pointerGet: {object: {$var: child}, path: /clauses/activation/type}}}
          - {$nodeBlueId: {$pointerGet: {object: {type: Activation/Activation Clause}, path: /type}}}
        message: CHILD_ACTIVATION_REQUIRED
    - $forEach:
        item: path
        in: [/timelineAccess, /clauses/activation/parameters/accessPaths]
        do:
        - $failIf:
            cond: {$exists: {$pointerGet: {object: {$var: child}, path: {$var: path}}}}
            message: PREPARATION_BOOTSTRAP_TEMPLATE_HAS_ACCESS
    - $let:
        name: roster
        expr:
          $call:
            function: resolvePartyMappings
            args:
              parties: {$document: /activation/parties}
              declarations: {$pointerGet: {object: {$var: child}, path: /clauses/activation/parameters/parties, default: {}}}
              mapping: {$var: mapping}
              suppliedRoles: {$var: suppliedRoles}
    - $forEach:
        item: party
        key: role
        in: {$var: roster}
        do:
        - $if:
            cond: {$not: {$includes: {list: {$var: suppliedRoles}, val: {$var: role}}}}
            then:
            - $set:
                name: roster
                expr:
                  $objectSet:
                    object: {$var: roster}
                    key: {$var: role}
                    val: {$call: {function: unboundParty, args: {party: {$var: party}}}}
    - $return:
        $pointerSet:
          object: {$var: child}
          path: /clauses/activation/parameters/parties
          val: {$var: roster}
  unboundParty:
    args:
      party: {}
    do:
    - $let:
        name: result
        expr: {$var: party}
    - $if:
        cond: {$exists: {$pointerGet: {object: {$var: result}, path: /lead/channel}}}
        then:
        - $set:
            name: result
            expr: {$pointerSet: {object: {$var: result}, path: /lead/channel, op: remove}}
    - $forEach:
        item: representative
        key: representativeName
        in: {$pointerGet: {object: {$var: result}, path: /representatives, default: {}}}
        do:
        - $if:
            cond: {$exists: {$pointerGet: {object: {$var: representative}, path: /channel}}}
            then:
            - $set:
                name: result
                expr:
                  $pointerSet:
                    object: {$var: result}
                    path: {$concat: [/representatives/, {$var: representativeName}, /channel]}
                    op: remove
    - $return: {$var: result}
  requireSameBootstrapParty:
    args:
      expected: {}
      actual: {}
    do:
    # Keep the existing primary reader-set validation, substituting only the
    # new channel after verifying that both channels name the same native actor.
    - $failIf:
        cond:
          $or:
          - {$not: {$exists: {$pointerGet: {object: {$var: expected}, path: /lead/channel/actor}}}}
          - {$ne: [{$pointerGet: {object: {$var: expected}, path: /lead/channel/actor}}, {$pointerGet: {object: {$var: actual}, path: /lead/channel/actor}}]}
        message: PREPARATION_BOOTSTRAP_ACTOR_MISMATCH
    - $call:
        function: requireSameMainParty
        args:
          left:
            $pointerSet:
              object: {$var: expected}
              path: /lead/channel
              val: {$pointerGet: {object: {$var: actual}, path: /lead/channel}}
          right: {$var: actual}
    - $return: true
  normalizeBootstrapSource:
    args:
      source: {}
      slots: []
    do:
    - $let:
        name: normalized
        expr: {$call: {function: normalizeSlots, args: {source: {$var: source}, slots: {$var: slots}}}}
    # Bootstrap's access publications and representative channels are checked
    # separately. Never remove arbitrary executable contracts from comparison.
    - $forEach:
        item: slot
        in: {$var: slots}
        do:
        - $if:
            cond: {$eq: [{$pointerGet: {object: {$var: slot}, path: /kind}}, party]}
            then:
            - $forEach:
                item: representative
                key: representativeName
                in: {$pointerGet: {object: {$var: source}, path: {$concat: [{$pointerGet: {object: {$var: slot}, path: /path}}, /representatives]}, default: {}}}
                do:
                - $let:
                    name: path
                    expr: {$concat: [/contracts/, {$pointerGet: {object: {$var: slot}, path: /role}}, __, {$var: representativeName}]}
                - $if:
                    cond: {$exists: {$pointerGet: {object: {$var: normalized}, path: {$var: path}}}}
                    then:
                    - $failIf:
                        cond: {$ne: [{$pointerGet: {object: {$var: normalized}, path: {$var: path}}}, {$pointerGet: {object: {$var: representative}, path: /channel}}]}
                        message: PREPARATION_PARTY_CHANNEL_MISMATCH
                    - $set:
                        name: normalized
                        expr: {$pointerSet: {object: {$var: normalized}, path: {$var: path}, op: remove}}
    - $forEach:
        item: path
        in: [/timelineAccess, /clauses/activation/parameters/accessPaths]
        do:
        - $if:
            cond: {$exists: {$pointerGet: {object: {$var: normalized}, path: {$var: path}}}}
            then:
            - $set:
                name: normalized
                expr: {$pointerSet: {object: {$var: normalized}, path: {$var: path}, op: remove}}
    - $if:
        cond: {$eq: [{$pointerGet: {object: {$var: normalized}, path: /clauses/activation/parameters/readers, default: {}}}, {}]}
        then:
        - $if:
            cond: {$exists: {$pointerGet: {object: {$var: normalized}, path: /clauses/activation/parameters/readers}}}
            then:
            - $set:
                name: normalized
                expr: {$pointerSet: {object: {$var: normalized}, path: /clauses/activation/parameters/readers, op: remove}}
    - $return: {$var: normalized}
  normalizeProvisionSource:
    args:
      source: {}
      slots: []
      mode: {type: Text}
    do:
    - $if:
        cond: {$eq: [{$var: mode}, bootstrap]}
        then:
        - $return: {$call: {function: normalizeBootstrapSource, args: {source: {$var: source}, slots: {$var: slots}}}}
    - $return: {$call: {function: normalizeSlots, args: {source: {$var: source}, slots: {$var: slots}}}}
  provisionClausePolicy:
    args:
      candidate: {}
      slots: []
      mode: {type: Text}
    do:
    - $let:
        name: policy
        expr: {$call: {function: candidateClausePolicy, args: {candidate: {$var: candidate}, slots: {$var: slots}}}}
    - $if:
        cond: {$eq: [{$var: mode}, bootstrap]}
        then:
        - $if:
            cond: {$exists: {$pointerGet: {object: {$var: policy}, path: /activation/parameters/accessPaths}}}
            then:
            - $set:
                name: policy
                expr: {$pointerSet: {object: {$var: policy}, path: /activation/parameters/accessPaths, op: remove}}
        - $if:
            cond: {$eq: [{$pointerGet: {object: {$var: policy}, path: /activation/parameters/readers, default: {}}}, {}]}
            then:
            - $if:
                cond: {$exists: {$pointerGet: {object: {$var: policy}, path: /activation/parameters/readers}}}
                then:
                - $set:
                    name: policy
                    expr: {$pointerSet: {object: {$var: policy}, path: /activation/parameters/readers, op: remove}}
    - $return: {$var: policy}
  validateBootstrapAccess:
    args:
      candidate: {}
    do:
    - $let:
        name: transportNames
        expr:
          $keys:
            $call:
              function: transports
              args:
                roster: {$pointerGet: {object: {$var: candidate}, path: /activation/parties}}
    - $let:
        name: accessPaths
        expr: {$pointerGet: {object: {$var: candidate}, path: /activation/accessPaths, default: []}}
    - $failIf:
        cond:
          $or:
          - {$ne: [{$size: {$var: transportNames}}, {$size: {$pointerGet: {object: {$var: candidate}, path: /timelineAccess, default: {}}}}]}
          - {$ne: [{$size: {$var: transportNames}}, {$size: {$var: accessPaths}}]}
        message: PREPARATION_BOOTSTRAP_ACCESS_SHAPE
    - $forEach:
        item: transportName
        in: {$var: transportNames}
        do:
        - $failIf:
            cond:
              $not:
                $includes:
                  list: {$var: accessPaths}
                  val: {$concat: [/timelineAccess/, {$var: transportName}]}
            message: PREPARATION_BOOTSTRAP_ACCESS_SHAPE
    - $let:
        name: accessDocuments
        expr: []
    - $forEach:
        item: path
        in: {$var: accessPaths}
        do:
        - $let:
            name: access
            expr: {$pointerGet: {object: {$var: candidate}, path: {$var: path}}}
        - $failIf:
            cond: {$not: {$exists: {$pointerGet: {object: {$var: access}, path: /contracts/initialized}}}}
            message: PREPARATION_BOOTSTRAP_ACCESS_NOT_INITIALIZED
        - $set:
            name: accessDocuments
            expr: {$listConcat: [{$var: accessDocuments}, [{$var: access}]]}
    - $failIf:
        cond:
          $not:
            $call:
              function: accessRecordsValid
              args:
                roster: {$pointerGet: {object: {$var: candidate}, path: /activation/parties}}
                readers: {$pointerGet: {object: {$var: candidate}, path: /activation/readers, default: {}}}
                accessDocuments: {$var: accessDocuments}
        message: PREPARATION_BOOTSTRAP_ACCESS_MISSING
    - $return: true
