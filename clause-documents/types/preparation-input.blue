name: Preparation Input
key:
  type: Text
  description: Preparation entry key. Optional for singleton; required for keyed collections unless configured mapping
    supplies it.
requestId:
  type: Text
  description: Request correlation identifier. Defaults to the resolved key when omitted.
fields:
  description: User-provided fields accepted by the configured document template.
values:
  description: User-provided values accepted by the configured template.
