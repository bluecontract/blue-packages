name: Document Preparation Functions
type: Documents/Preparation Functions
functions:
  domainPrepare:
    args:
      prepared: {}
    do:
    - $return: {}
  domainValidateCandidate:
    args:
      frozenTerms: {}
      candidate: {}
    do:
    - $return: true
  domainNextActions:
    $blue:functionFrom:
      type: Documents/Refresh Functions
      function: domainNextActions
