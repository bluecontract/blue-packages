name: Refresh Functions
type: Contracts/Compute Definition
functions:
  processStatePath:
    args: {}
    do:
    - $return:
        $concat:
        - /process_
        - $const: clauseKey
  sharedRefresh:
    args: {}
    do:
    - $forEach:
        item: item
        in:
          $pointerGet:
            object:
              $document:
                $call:
                  function: processStatePath
                  args: {}
            path: /entries
            default: {}
        do:
        - $if:
            cond:
              $exists:
                $var:
                  name: item
                  path: /documentOrigin
            then:
            - $let:
                name: selected
                expr:
                  $document:
                    $var:
                      name: item
                      path: /path
            - $if:
                cond:
                  $exists:
                    $pointerGet:
                      object:
                        $var: selected
                      path: /contracts/initialized/document
                then:
                - $let:
                    name: origin
                    expr:
                      $nodeBlueId:
                        $pointerGet:
                          object:
                            $var: selected
                          path: /contracts/initialized/document
                - $failIf:
                    cond:
                      $ne:
                      - $var: origin
                      - $var:
                          name: item
                          path: /documentOrigin
                    message: PREPARATION_SELECTED_IDENTITY_CHANGED
                - $let:
                    name: ready
                    expr:
                      $and:
                      - $eq:
                        - $pointerGet:
                            object:
                              $var: selected
                            path: /activation/active
                        - true
                      - $call:
                          function: namedSourcesReady
                          args:
                            document:
                              $var: selected
                      - $call:
                          function: rootSourceReadersReady
                          args:
                            item: {$var: item}
                            candidate: {$var: selected}
                - $let:
                    name: status
                    expr:
                      $choose:
                        cond:
                          $var: ready
                        then: usable
                        else: selected
                - $if:
                    cond:
                      $ne:
                      - $var:
                          name: item
                          path: /status
                      - $var: status
                    then:
                    - $appendChange:
                        op: add
                        path:
                          $var:
                            name: item
                            path: /itemPath
                        val:
                          $merge:
                          - $var: item
                          - status:
                              $var: status
                    - $if:
                        cond:
                          $var: ready
                        then:
                        - $appendEvent:
                            $merge:
                            - type: Documents/Document Attached
                            - clauseId:
                                $const: clauseKey
                              itemKey:
                                $var:
                                  name: item
                                  path: /key
                              inResponseTo:
                                $var:
                                  name: item
                                  path: /requestId
                              documentOrigin:
                                $var: origin
                - $let:
                    name: actions
                    expr:
                      $choose:
                        cond:
                          $var: ready
                        then:
                          $call:
                            function: checkedDomainNextActions
                            args:
                              documentRef:
                                path:
                                  $var:
                                    name: item
                                    path: /path
                                documentOrigin:
                                  $var: origin
                        else: []
                - $if:
                    cond:
                      $ne:
                      - $pointerGet:
                          object:
                            $var: item
                          path: /nextActions
                          default: []
                      - $var: actions
                    then:
                    - $appendChange:
                        op: add
                        path:
                          $concat:
                          - $var:
                              name: item
                              path: /itemPath
                          - /nextActions
                        val:
                          $var: actions
                    - $forEach:
                        item: actionDescription
                        in:
                          $var: actions
                        do:
                        - $failIf:
                            cond:
                              $not:
                                $hasKey:
                                  object:
                                    $pointerGet:
                                      object:
                                        $var: selected
                                      path: /activation/parties
                                  key:
                                    $pointerGet:
                                      object:
                                        $var: actionDescription
                                      path: /party
                            message: PREPARATION_ACTION_PARTY_NOT_DECLARED
                        - $appendEvent:
                            $merge:
                            - $var: actionDescription
                            - clauseId:
                                $const: clauseKey
                              itemKey:
                                $var:
                                  name: item
                                  path: /key
                              inResponseTo:
                                $var:
                                  name: item
                                  path: /requestId
                              documentOrigin:
                                $var: origin
        key: itemId
    - $return:
        outcome: acceptedNew
  checkedDomainNextActions:
    args:
      documentRef: {}
    do:
    - $let:
        name: priorChanges
        expr:
          $size:
            $changeset: {}
    - $let:
        name: priorEvents
        expr:
          $size:
            $events: {}
    - $let:
        name: answer
        expr:
          $call:
            function: domainNextActions
            args:
              documentRef:
                $var: documentRef
    - $failIf:
        cond:
          $or:
          - $ne:
            - $var: priorChanges
            - $size:
                $changeset: {}
          - $ne:
            - $var: priorEvents
            - $size:
                $events: {}
        message: PREPARATION_DOMAIN_HOOK_MUST_BE_PURE
    - $failIf:
        cond:
          $not:
            $isKind:
              val:
                $var: answer
              kind: list
        message: PREPARATION_DOMAIN_RESULT_INVALID
    - $failIf:
        cond:
          $gt:
          - $size:
              $var: answer
          - 16
        message: PREPARATION_TOO_MANY_NEXT_ACTIONS
    - $forEach:
        item: actionDescription
        in:
          $var: answer
        do:
        - $failIf:
            cond:
              $not:
                $is:
                  node:
                    $var: actionDescription
                  pattern:
                    type: Documents/Clause Response
            message: PREPARATION_ACTION_DESCRIPTION_INVALID
    - $return:
        $var: answer
  domainNextActions:
    args:
      documentRef: {}
    do:
    - $return: []
  namedSourcesReady:
    $blue:functionFrom:
      type: Documents/Source Functions
      function: namedSourcesReady
  processOrigin:
    $blue:functionFrom:
      type: Documents/Source Functions
      function: processOrigin
  rosterCovers:
    $blue:functionFrom:
      type: Documents/Source Functions
      function: rosterCovers
  accessRecordsValid:
    $blue:functionFrom:
      type: Documents/Admission Functions
      function: accessRecordsValid
  configurationParameters:
    $blue:functionFrom:
      type: Documents/Admission Functions
      function: configurationParameters
  configuredSources:
    $blue:functionFrom:
      type: Documents/Admission Functions
      function: configuredSources
  connectionConfiguration:
    # Supplied by connection planning, matching the original declaration.
    args: {}
  mappedBootstrapPartyCovered:
    $blue:functionFrom:
      type: Documents/Admission Functions
      function: mappedBootstrapPartyCovered
  readerGroups:
    $blue:functionFrom:
      type: Documents/Admission Functions
      function: readerGroups
  requireSameBootstrapParty:
    $blue:functionFrom:
      type: Documents/Admission Functions
      function: requireSameBootstrapParty
  requireSameBootstrapPrimary:
    $blue:functionFrom:
      type: Documents/Admission Functions
      function: requireSameBootstrapPrimary
  requireSameMainParty:
    $blue:functionFrom:
      type: Documents/Admission Functions
      function: requireSameMainParty
  rootSourceReaderGroupsMatch:
    $blue:functionFrom:
      type: Documents/Admission Functions
      function: rootSourceReaderGroupsMatch
  rootSourceReaderPartyCovered:
    $blue:functionFrom:
      type: Documents/Admission Functions
      function: rootSourceReaderPartyCovered
  rootSourceReaderScope:
    $blue:functionFrom:
      type: Documents/Admission Functions
      function: rootSourceReaderScope
  rootSourceReadersReady:
    $blue:functionFrom:
      type: Documents/Admission Functions
      function: rootSourceReadersReady
  sourceDeclarationMatches:
    $blue:functionFrom:
      type: Documents/Admission Functions
      function: sourceDeclarationMatches
  transports:
    $blue:functionFrom:
      type: Documents/Admission Functions
      function: transports
